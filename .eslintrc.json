{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:astro/recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": [
    "astro",
    "@typescript-eslint"
  ],
  "rules": {
    "astro/jsx-a11y-alt-text": "off",
    "astro/jsx-a11y-anchor-has-content": "warn",
    "astro/jsx-a11y-aria-props": "warn",
    "astro/jsx-a11y-html-has-lang": "warn",
    "astro/jsx-a11y-img-redundant-alt": "warn",
    "astro/jsx-a11y-tabindex-no-positive": "warn",
    "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "@typescript-eslint/no-explicit-any": "warn",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": "error",
    "curly": "error"
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    ".astro",
    "*.js",
    "*.mjs"
  ],
  "overrides": [
    {
      "files": ["*.astro"],
      "parser": "astro-eslint-parser",
      "parserOptions": {
        "parser": "@typescript-eslint/parser",
        "extraFileExtensions": [".astro"]
      }
    }
  ]
}
