---

<Layout title={title} description={description}>
  <Header activeNav="news" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>News & Media</h1>
      <p>Latest updates, industry insights, and company announcements</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>News</span>
      </nav>
    </div>
  </section>

  <!-- Content -->
  <section class="content-section">
    <div class="container">

      <!-- News Grid -->
      <div class="news-grid">

        {newsArticles.map((article) => (
          <a href={`/news/${article.slug}`} class="news-card" style="text-decoration: none; color: inherit;">
            <article>
              <div class="news-card-image" style={`background: ${article.gradient};`}>
                {article.image && (
                  <img src={article.image} alt={article.title} class="news-card-img" loading="lazy" />
                )}
              </div>
              <div class="news-card-body">
                <span class="news-card-category" data-category={article.category}>{article.category}</span>
                <h3 class="news-card-title">{article.title}</h3>
                <p class="news-card-excerpt">{article.excerpt}</p>
                <div class="news-card-meta">
                  <span class="news-card-date">📅 {article.date}</span>
                </div>
              </div>
            </article>
          </a>
        ))}

      </div>

    </div>
  </section>

  <Footer />
</Layout>

<style>
  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--spacing-lg);
  }

  .news-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: white;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .news-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
  }

  .news-card-image {
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .news-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .news-card:hover .news-card-img {
    opacity: 1;
    transform: scale(1.03);
  }

  .news-card-body {
    padding: var(--spacing-md);
  }

  .news-card-category {
    display: inline-block;
    padding: 4px 12px;
    background: var(--color-bg);
    color: var(--color-accent);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: var(--spacing-xs);
  }

  .news-card-category[data-category="Awards"] {
    color: #dc2626;
  }

  .news-card-category[data-category="Business"] {
    color: #059669;
  }

  .news-card-category[data-category="Technology"] {
    color: #7c3aed;
  }

  .news-card-category[data-category="Sustainability"] {
    color: #0891b2;
  }

  .news-card-category[data-category="Event"] {
    color: #ea580c;
  }

  .news-card-category[data-category="Certification"] {
    color: #dc2626;
  }

  .news-card-category[data-category="Innovation"] {
    color: #0ea5e9;
  }

  .news-card-category[data-category="Quality"] {
    color: #ca8a04;
  }

  .news-card-category[data-category="Case Study"] {
    color: #1e40af;
  }

  .news-card-category[data-category="Milestone"] {
    color: #ca8a04;
  }

  .news-card-title {
    font-size: var(--font-size-lg);
    color: var(--color-primary);
    margin: var(--spacing-xs) 0;
    line-height: 1.4;
  }

  .news-card-excerpt {
    color: var(--color-text-light);
    font-size: var(--font-size-sm);
    line-height: 1.6;
    margin: var(--spacing-xs) 0;
  }

  .news-card-meta {
    margin-top: var(--spacing-sm);
    font-size: var(--font-size-xs);
    color: var(--color-text-light);
  }

  .news-card-date {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  @media (max-width: 768px) {
    .news-grid {
      grid-template-columns: 1fr;
    }
  }
</style>