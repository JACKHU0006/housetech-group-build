---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'News - HouseTech Group | Latest Updates & Industry Insights';
const description = 'Stay updated with HouseTech Group latest news, product launches, industry trends, and company events in the kitchen appliance sector.';

// News articles data - auto-generated by news-auto-generator
// Last updated: 2026-06-11
// Total articles: 5
const newsArticles = [
  {
    slug: 'electric-water-heater-safety-standards-guide',
    title: 'Electric Water Heater Safety Standards — Pressure Relief & Leakage Protection',
    category: 'Technical Guide',
    date: 'May 2026',
    excerpt: 'Electric water heaters require 0.7-0.8MPa pressure relief valves and ≤30mA ELCB protection. Learn safety thresholds, installation requirements, and maintenance schedules.',
    image: '/images/news/electric-water-heater-safety-standards-guide.svg',
    gradient: 'linear-gradient(135deg, #0d3b66, #145a8a)',
  },
  {
    slug: 'gas-stove-thermal-efficiency-tier-1-guide',
    title: 'Gas Stove Thermal Efficiency Guide — Achieving China Tier-1 Energy Rating',
    category: 'Technical Guide',
    date: 'April 2026',
    excerpt: 'China Tier-1 gas stoves require ≥63% thermal efficiency. Learn how burner design, flame distribution, and combustion optimization achieve this threshold.',
    image: '/images/news/gas-stove-thermal-efficiency-tier-1-guide.svg',
    gradient: 'linear-gradient(135deg, #1a3a5c, #0d3b66)',
  },
  {
    slug: 'kitchen-range-hood-static-pressure-guide',
    title: 'Kitchen Range Hood Static Pressure Guide — Solving High-Rise Building Smoke Issues',
    category: 'Technical Guide',
    date: 'March 2026',
    excerpt: 'High-rise buildings require range hoods with ≥380Pa static pressure. Learn how static pressure, airflow rate, and duct design affect kitchen ventilation performance.',
    image: '/images/news/kitchen-range-hood-static-pressure-guide.svg',
    gradient: 'linear-gradient(135deg, #0a2540, #1a3a5c)',
  },
  {
    slug: '2026-06-housetech-develops-breakthrough-airpure-plus-technology-for-kitchen-appliances',
    title: 'HouseTech Develops Breakthrough AirPure Plus Technology for Kitchen Appliances',
    category: 'Technology',
    date: 'June 2026',
    excerpt: 'HouseTech Group announces the successful development of AirPure Plus technology, delivering measurable improvements in Noise Reduction for next-generation kitchen appliances.',
    image: '/images/news/2026-06-housetech-develops-breakthrough-airpure-plus-technology-for-kitchen-appliances.svg',
    gradient: 'linear-gradient(135deg, #0066ff, #0a2540)',
  },
  {
    slug: '2026-06-housetech-introduces-premium-kitchen-set-collection-for-international-markets',
    title: 'HouseTech Introduces Premium Kitchen Set Collection for International Markets',
    category: 'Product Launch',
    date: 'June 2026',
    excerpt: 'HouseTech Group unveils its latest Kitchen Set series featuring Inverter Technology, designed specifically for OEM/ODM partners and global B2B distributors.',
    image: '/images/news/2026-06-housetech-introduces-premium-kitchen-set-collection-for-international-markets.svg',
    gradient: 'linear-gradient(135deg, #0066ff, #0a2540)',
  },
];
---

<Layout title={title} description={description}>
  <Header activeNav="news" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1 class="hero-title">News & Insights</h1>
      <p class="hero-subtitle">Stay updated with HouseTech Group latest product launches, technology innovations, and global partnerships</p>
      <nav class="breadcrumb">
        <a href="/">Home</a> / <span>News</span>
      </nav>
    </div>
  </section>

  <!-- News List -->
  <section class="content-section">
    <div class="container">
      <div class="news-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:var(--spacing-lg);">
        {newsArticles.map((article) => (
          <a href={`/news/${article.slug}`} class="news-card" style="background:var(--color-bg-elevated);border-radius:var(--radius-lg);overflow:hidden;transition:transform 0.2s,box-shadow 0.2s;box-shadow:var(--shadow-sm);text-decoration:none;color:inherit;display:flex;flex-direction:column;">
            <div style={`width:100%;aspect-ratio:16/9;background:${article.gradient};display:flex;align-items:center;justify-content:center;`}>
              <img src={article.image} alt={article.title} loading="lazy" width="400" height="225" style="width:100%;height:100%;object-fit:cover;"/>
            </div>
            <div style="padding:var(--spacing-md);display:flex;flex-direction:column;flex:1;">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--spacing-xs);">
                <span style="font-size:0.8rem;color:var(--color-accent);font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">{article.category}</span>
                <span style="font-size:0.8rem;color:var(--color-text-muted);">{article.date}</span>
              </div>
              <h3 style="font-size:1.1rem;font-weight:700;margin:0 0 var(--spacing-xs);line-height:1.4;">{article.title}</h3>
              <p style="font-size:0.9rem;color:var(--color-text-secondary);margin:0;line-height:1.5;flex:1;">{article.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
