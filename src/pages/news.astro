---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'News - HouseTech Group | Latest Updates & Industry Insights';
const description = 'Stay updated with HouseTech Group latest news, product launches, industry trends, and company events in the kitchen appliance sector.';
---

<Layout title={title} description={description}>
  <Header activeNav="news" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>News & Media</h1>
      <p>Latest updates, industry insights, and company announcements</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>News</span>
      </nav>
    </div>
  </section>

  <!-- Content -->
  <section class="content-section">
    <div class="container">

      <!-- News Grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: var(--spacing-lg);">

        <!-- News Item 1 -->
        <article style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; background: white;">
          <div style="height: 200px; background: linear-gradient(135deg, #0a2540, #1a3a5c); display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.2);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
          </div>
          <div style="padding: var(--spacing-md);">
            <small style="color: var(--color-accent); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Product Launch</small>
            <h3 style="font-size: var(--font-size-lg); margin-top: var(--spacing-xs); color: var(--color-primary);">New Smart Range Hood Series with Touch Control Launched</h3>
            <p style="color: var(--color-text-light); font-size: var(--font-size-sm); margin-top: var(--spacing-xs); line-height: 1.6;">Introducing our latest smart range hood series featuring intuitive touch controls, LED display, and ultra-quiet operation at just 45dB.</p>
            <span style="display: inline-block; margin-top: var(--spacing-sm); font-size: var(--font-size-xs); color: var(--color-text-light);">April 2024</span>
          </div>
        </article>

        <!-- News Item 2 -->
        <article style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; background: white;">
          <div style="height: 200px; background: linear-gradient(135deg, #0066ff, #0052cc); display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.2);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <div style="padding: var(--spacing-md);">
            <small style="color: var(--color-accent); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Industry News</small>
            <h3 style="font-size: var(--font-size-lg); margin-top: var(--spacing-xs); color: var(--color-primary);">Global Kitchen Appliance Market Trends for 2024</h3>
            <p style="color: var(--color-text-light); font-size: var(--font-size-sm); margin-top: var(--spacing-xs); line-height: 1.6;">Analysis of emerging trends in the global kitchen appliance market including energy efficiency standards, smart home integration, and design innovations.</p>
            <span style="display: inline-block; margin-top: var(--spacing-sm); font-size: var(--font-size-xs); color: var(--color-text-light);">March 2024</span>
          </div>
        </article>

        <!-- News Item 3 -->
        <article style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; background: white;">
          <div style="height: 200px; background: linear-gradient(135deg, #f7931e, #d97706); display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.2);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <div style="padding: var(--spacing-md);">
            <small style="color: var(--color-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Certification</small>
            <h3 style="font-size: var(--font-size-lg); margin-top: var(--spacing-xs); color: var(--color-primary);">HouseTech Receives ETL Certification for North American Market</h3>
            <p style="color: var(--color-text-light); font-size: var(--font-size-sm); margin-top: var(--spacing-xs); line-height: 1.6;">Our gas stove and range hood products have successfully obtained ETL certification, opening new opportunities in the North American B2B market.</p>
            <span style="display: inline-block; margin-top: var(--spacing-sm); font-size: var(--font-size-xs); color: var(--color-text-light);">February 2024</span>
          </div>
        </article>

        <!-- News Item 4 -->
        <article style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; background: white;">
          <div style="height: 200px; background: linear-gradient(135deg, #059669, #047857); display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.2);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
          </div>
          <div style="padding: var(--spacing-md);">
            <small style="color: #059669; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Event</small>
            <h3 style="font-size: var(--font-size-lg); margin-top: var(--spacing-xs); color: var(--color-primary);">HouseTech to Exhibit at Canton Fair 2024</h3>
            <p style="color: var(--color-text-light); font-size: var(--font-size-sm); margin-top: var(--spacing-xs); line-height: 1.6;">We are excited to announce our participation in the upcoming Canton Fair (Phase 2). Visit us to see our latest products and discuss partnership opportunities.</p>
            <span style="display: inline-block; margin-top: var(--spacing-sm); font-size: var(--font-size-xs); color: var(--color-text-light);">January 2024</span>
          </div>
        </article>

        <!-- News Item 5 -->
        <article style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; background: white;">
          <div style="height: 200px; background: linear-gradient(135deg, #8b5cf6, #7c3aed); display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.2);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
          </div>
          <div style="padding: var(--spacing-md);">
            <small style="color: #8b5cf6; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Company Update</small>
            <h3 style="font-size: var(--font-size-lg); margin-top: var(--spacing-xs); color: var(--color-primary);">Factory Expansion Completed — Production Capacity Doubled</h3>
            <p style="color: var(--color-text-light); font-size: var(--font-size-sm); margin-top: var(--spacing-xs); line-height: 1.6;">After months of construction and equipment installation, our expanded facility is now fully operational with doubled annual production capacity.</p>
            <span style="display: inline-block; margin-top: var(--spacing-sm); font-size: var(--font-size-xs); color: var(--color-text-light);">November 2023</span>
          </div>
        </article>

        <!-- News Item 6 -->
        <article style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; background: white;">
          <div style="height: 200px; background: linear-gradient(135deg, #ec4899, #db2777); display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.2);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4a2 2 0 012 2v9a2 2 0 01-2 2H6a2 2 0 01-2-2v-1"/></svg>
          </div>
          <div style="padding: var(--spacing-md);">
            <small style="color: #ec4899; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Sustainability</small>
            <h3 style="font-size: var(--font-size-lg); margin-top: var(--spacing-xs); color: var(--color-primary);">Commitment to Energy-Efficient Product Development</h3>
            <p style="color: var(--color-text-light); font-size: var(--font-size-sm); margin-top: var(--spacing-xs); line-height: 1.6;">HouseTech announces a strategic initiative to develop more energy-efficient appliances aligned with global sustainability goals and EU Ecodesign regulations.</p>
            <span style="display: inline-block; margin-top: var(--spacing-sm); font-size: var(--font-size-xs); color: var(--color-text-light);">October 2023</span>
          </div>
        </article>

      </div>

    </div>
  </section>

  <Footer />
</Layout>
