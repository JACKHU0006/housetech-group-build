---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'About HouseTech Group - Premium Kitchen Appliance B2B Manufacturer Since 2010';
const description = 'HouseTech Group: 15+ years B2B kitchen appliance manufacturer. 30,000 sqm factory, 500+ employees, ISO9001/CE/CB/ETL certified. OEM/ODM partner for Range Hoods, Gas Stoves, Ovens, Air Fryers serving 50+ countries.';
---

<Layout title={title} description={description}>
  <Header activeNav="about" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <p class="section-tag" style="display: inline-block; margin-bottom: var(--spacing-sm);">Since 2010</p>
      <h1>About <span class="accent-word">HouseTech Group</span></h1>
      <p>Your trusted B2B manufacturing partner for premium kitchen appliances — from Guangdong, China to the world</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>About HouseTech</span>
      </nav>
    </div>
  </section>

  <!-- Company Overview -->
  <section class="content-section">
    <div class="container">
      <div class="content-area">

        <h2>Company Overview</h2>
        <p><strong>HouseTech Group</strong> is a leading B2B manufacturer specializing in the research, development, and production of high-quality kitchen appliances. Established in 2010, <strong>HouseTech</strong> has grown from a specialized range hood factory into a comprehensive kitchen appliance manufacturer serving global markets.</p>
        <p>With over 15 years of industry experience, <strong>HouseTech Group</strong> has established itself as a reliable B2B partner for businesses across more than 50 countries worldwide. Our product portfolio includes <strong>Range Hoods</strong> (Kitchen Hoods, Cooker Hoods, Extractor Hoods, Chimney Hoods, Commercial Hoods), <strong>Gas Stoves & Built-in Hobs</strong> (Gas/Electric/Ceramic/Induction Hobs), <strong>Built-in Ovens</strong> (Electric/Gas/Convection/Steam Ovens), <strong>Air Fryers</strong>, <strong>Induction Cookers</strong>, <strong>Ceramic Cookers</strong>, and <strong>Gas Water Heaters</strong> — covering all essential kitchen appliance categories for residential and commercial applications.</p>

        <!-- Factory & Team Visual Block -->
        <div style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); border-radius: var(--radius-lg); padding: var(--spacing-3xl); margin: var(--spacing-2xl) 0; text-align: center; color: white; position: relative; overflow: hidden;">
          <svg width="100%" height="180" viewBox="0 0 800 180" xmlns="http://www.w3.org/2000/svg" style="position:absolute; top:0; left:0; opacity:0.15;" preserveAspectRatio="xMidYMid slice">
            <rect x="200" y="40" width="400" height="100" rx="6" fill="none" stroke="white" stroke-width="1"/>
            <rect x="240" y="65" width="60" height="45" rx="3" fill="none" stroke="white" stroke-width="0.8"/>
            <rect x="320" y="65" width="60" height="45" rx="3" fill="none" stroke="white" stroke-width="0.8"/>
            <rect x="400" y="65" width="60" height="45" rx="3" fill="none" stroke="white" stroke-width="0.8"/>
            <rect x="480" y="65" width="60" height="45" rx="3" fill="none" stroke="white" stroke-width="0.8"/>
            <polygon points="170,45 400,10 630,45" fill="none" stroke="white" stroke-width="0.8"/>
            <circle cx="350" cy="155" r="4" fill="white"/><circle cx="400" cy="155" r="4" fill="white"/><circle cx="450" cy="155" r="4" fill="white"/>
          </svg>
          <p style="font-size: var(--font-size-sm); text-transform: uppercase; letter-spacing: 2px; opacity: 0.7; margin-bottom: var(--spacing-sm); position: relative;">Factory & Team</p>
          <p style="font-size: var(--font-size-lg); opacity: 0.9; position: relative;">HouseTech Group Manufacturing Facility</p>
          <p style="font-size: var(--font-size-sm); opacity: 0.7; margin-top: var(--spacing-sm); position: relative;">30,000+ sqm Modern Production Base • Zhongshan, Guangdong</p>
        </div>

        <h2>Our Mission</h2>
        <p><strong>HouseTech Group's</strong> mission is to provide innovative, high-quality kitchen appliance solutions at competitive factory-direct prices while delivering exceptional OEM/ODM services to our global partners. We aim to be the most trusted manufacturing backbone for kitchen appliance brands worldwide.</p>

        <h2>Our Vision</h2>
        <p><strong>HouseTech Group's</strong> vision is to become the world's most trusted kitchen appliance manufacturer, recognized for innovation, quality, and customer-centric service. We envision a future where every kitchen, in every home and commercial space globally, benefits from HouseTech's reliable and efficient appliances.</p>

        <h2>Core Values</h2>
        <ul>
          <li><strong>Quality First:</strong> Every HouseTech product meets international standards with rigorous quality control processes from raw materials to final inspection.</li>
          <li><strong>Innovation:</strong> HouseTech continuously invests in R&D to develop cutting-edge products that meet evolving market demands and consumer preferences.</li>
          <li><strong>Integrity:</strong> HouseTech maintains transparent business practices and honest communication with all stakeholders and partners.</li>
          <li><strong>Customer Focus:</strong> HouseTech understands and exceeds customer expectations through personalized solutions and dedicated support.</li>
          <li><strong>Sustainability:</strong> HouseTech is committed to environmentally friendly manufacturing practices and energy-efficient product development.</li>
        </ul>

        <!-- Our Advantages - Data Visualization -->
        <h2>HouseTech Group by the Numbers</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--spacing-lg); margin: var(--spacing-xl) 0;">
          <div style="background: var(--color-primary); color: white; padding: var(--spacing-xl); border-radius: var(--radius-lg); text-align: center;">
            <p style="font-size: var(--font-size-3xl); font-weight: 700; margin-bottom: var(--spacing-xs);">15+</p>
            <p style="font-size: var(--font-size-sm); opacity: 0.9;">Years in Business</p>
          </div>
          <div style="background: var(--color-accent); color: white; padding: var(--spacing-xl); border-radius: var(--radius-lg); text-align: center;">
            <p style="font-size: var(--font-size-3xl); font-weight: 700; margin-bottom: var(--spacing-xs);">30,000<span style="font-size: var(--font-size-lg);">m²</span></p>
            <p style="font-size: var(--font-size-sm); opacity: 0.9;">Factory Size</p>
          </div>
          <div style="background: #1a1a2e; color: white; padding: var(--spacing-xl); border-radius: var(--radius-lg); text-align: center;">
            <p style="font-size: var(--font-size-3xl); font-weight: 700; margin-bottom: var(--spacing-xs);">500+</p>
            <p style="font-size: var(--font-size-sm); opacity: 0.9;">Team Members</p>
          </div>
          <div style="background: #059669; color: white; padding: var(--spacing-xl); border-radius: var(--radius-lg); text-align: center;">
            <p style="font-size: var(--font-size-3xl); font-weight: 700; margin-bottom: var(--spacing-xs);">1M+</p>
            <p style="font-size: var(--font-size-sm); opacity: 0.9;">Annual Capacity</p>
          </div>
          <div style="background: #7c3aed; color: white; padding: var(--spacing-xl); border-radius: var(--radius-lg); text-align: center;">
            <p style="font-size: var(--font-size-3xl); font-weight: 700; margin-bottom: var(--spacing-xs);">50+</p>
            <p style="font-size: var(--font-size-sm); opacity: 0.9;">Countries Served</p>
          </div>
          <div style="background: #dc2626; color: white; padding: var(--spacing-xl); border-radius: var(--radius-lg); text-align: center;">
            <p style="font-size: var(--font-size-3xl); font-weight: 700; margin-bottom: var(--spacing-xs);">1000+</p>
            <p style="font-size: var(--font-size-sm); opacity: 0.9;">Global Clients</p>
          </div>
        </div>

        <h2>Key Facts</h2>
        <ul>
          <li><strong>Established:</strong> HouseTech Group founded in 2010 with focus on range hood manufacturing</li>
          <li><strong>Factory Size:</strong> 30,000+ square meters of modern production facility in Zhongshan</li>
          <li><strong>Employees:</strong> 500+ skilled workers, engineers, and management professionals</li>
          <li><strong>Production Capacity:</strong> 1 million+ units per year across all product categories</li>
          <li><strong>Export Markets:</strong> 50+ countries across Europe, Middle East, Southeast Asia, Africa, Latin America, and North America</li>
          <li><strong>Certifications:</strong> ISO9001:2015, CE, CB, ETL, SASO, GCC, NOM, RoHS</li>
          <li><strong>R&D Team:</strong> 50+ engineers dedicated to product innovation and new development</li>
          <li><strong>Quality Control:</strong> 99.5% on-time delivery rate with comprehensive QC at every stage</li>
        </ul>

        <!-- Product Categories Visual Block -->
        <div style="background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border-radius: var(--radius-lg); padding: var(--spacing-3xl); margin: var(--spacing-2xl) 0; text-align: center; position: relative; overflow: hidden;">
          <svg width="100%" height="100" viewBox="0 0 700 100" xmlns="http://www.w3.org/2000/svg" style="position:absolute; bottom:0; left:50%; transform:translateX(-50%);" preserveAspectRatio="xMidYMid slice" opacity="0.3">
            <rect x="20" y="30" width="60" height="50" rx="4" fill="#92400e"/>
            <rect x="100" y="35" width="60" height="45" rx="4" fill="#92400e"/>
            <rect x="180" y="32" width="60" height="48" rx="4" fill="#92400e"/>
            <rect x="260" y="38" width="60" height="42" rx="4" fill="#92400e"/>
            <rect x="340" y="28" width="60" height="52" rx="4" fill="#92400e"/>
            <rect x="420" y="36" width="60" height="44" rx="4" fill="#92400e"/>
            <rect x="500" y="34" width="60" height="46" rx="4" fill="#92400e"/>
            <rect x="580" y="30" width="60" height="50" rx="4" fill="#92400e"/>
          </svg>
          <p style="font-size: var(--font-size-sm); text-transform: uppercase; letter-spacing: 2px; color: #92400e; margin-bottom: var(--spacing-sm); position: relative;">Product Showcase</p>
          <p style="font-size: var(--font-size-xl); color: #78350f; margin-bottom: var(--spacing-md); position: relative;">HouseTech Product Categories</p>
          <p style="font-size: var(--font-size-sm); color: #92400e; position: relative;">Range Hoods • Gas Stoves • Induction Cookers • Ceramic Cookers • Ovens • Air Fryers • Water Heaters</p>
        </div>

        <h2>Milestones</h2>
        <ul>
          <li><strong>2010</strong> — HouseTech Group founded with focus on range hood manufacturing</li>
          <li><strong>2013</strong> — HouseTech expanded product line to gas stoves and built-in hobs</li>
          <li><strong>2015</strong> — HouseTech added oven production line; factory expanded to 10,000 sqm</li>
          <li><strong>2017</strong> — HouseTech achieved ISO9001 certification; officially entered Middle East market</li>
          <li><strong>2019</strong> — HouseTech launched air fryer product series; R&D center established with 30+ engineers</li>
          <li><strong>2021</strong> — HouseTech factory expansion to 30,000 sqm; obtained ETL certification for North American market</li>
          <li><strong>2023</strong> — HouseTech launched water heater product line; achieved 50+ countries export milestone</li>
          <li><strong>2024</strong> — HouseTech digital transformation; initiated smart appliance R&D with IoT connectivity</li>
        </ul>

        <!-- Certifications Visual Block -->
        <div style="background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%); border-radius: var(--radius-lg); padding: var(--spacing-2xl); margin: var(--spacing-2xl) 0; text-align: center; position: relative; overflow: hidden;">
          <svg width="100%" height="80" viewBox="0 0 600 80" xmlns="http://www.w3.org/2000/svg" style="position:absolute; top:0; left:50%; transform:translateX(-50%);" preserveAspectRatio="xMidYMid slice" opacity="0.2">
            <circle cx="80" cy="40" r="25" fill="none" stroke="#1e40af" stroke-width="2"/>
            <circle cx="180" cy="40" r="25" fill="none" stroke="#1e40af" stroke-width="2"/>
            <circle cx="280" cy="40" r="25" fill="none" stroke="#1e40af" stroke-width="2"/>
            <circle cx="380" cy="40" r="25" fill="none" stroke="#1e40af" stroke-width="2"/>
            <circle cx="480" cy="40" r="25" fill="none" stroke="#1e40af" stroke-width="2"/>
            <polyline points="72,32 78,40 88,28" fill="none" stroke="#1e40af" stroke-width="2"/>
            <polyline points="172,32 178,40 188,28" fill="none" stroke="#1e40af" stroke-width="2"/>
            <polyline points="272,32 278,40 288,28" fill="none" stroke="#1e40af" stroke-width="2"/>
            <polyline points="372,32 378,40 388,28" fill="none" stroke="#1e40af" stroke-width="2"/>
            <polyline points="472,32 478,40 488,28" fill="none" stroke="#1e40af" stroke-width="2"/>
          </svg>
          <p style="font-size: var(--font-size-sm); text-transform: uppercase; letter-spacing: 2px; color: #1e40af; margin-bottom: var(--spacing-md); position: relative;">International Recognition</p>
          <p style="font-size: var(--font-size-xl); color: #1e3a8a; margin-bottom: var(--spacing-lg); position: relative;">HouseTech Group Certifications</p>
          <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: var(--spacing-md); position: relative;">
            <span style="background: white; padding: var(--spacing-sm) var(--spacing-md); border-radius: var(--radius-md); font-weight: 600; color: var(--color-primary);">ISO 9001:2015</span>
            <span style="background: white; padding: var(--spacing-sm) var(--spacing-md); border-radius: var(--radius-md); font-weight: 600; color: var(--color-primary);">CE</span>
            <span style="background: white; padding: var(--spacing-sm) var(--spacing-md); border-radius: var(--radius-md); font-weight: 600; color: var(--color-primary);">CB</span>
            <span style="background: white; padding: var(--spacing-sm) var(--spacing-md); border-radius: var(--radius-md); font-weight: 600; color: var(--color-primary);">ETL</span>
            <span style="background: white; padding: var(--spacing-sm) var(--spacing-md); border-radius: var(--radius-md); font-weight: 600; color: var(--color-primary);">SASO</span>
            <span style="background: white; padding: var(--spacing-sm) var(--spacing-md); border-radius: var(--radius-md); font-weight: 600; color: var(--color-primary);">GCC</span>
            <span style="background: white; padding: var(--spacing-sm) var(--spacing-md); border-radius: var(--radius-md); font-weight: 600; color: var(--color-primary);">NOM</span>
            <span style="background: white; padding: var(--spacing-sm) var(--spacing-md); border-radius: var(--radius-md); font-weight: 600; color: var(--color-primary);">RoHS</span>
          </div>
        </div>

        <div style="margin-top: var(--spacing-2xl); text-align: center;">
          <a href="/factory" class="btn btn-primary">Visit Our Factory →</a>
          <a href="/contact" class="btn btn-outline" style="margin-left: var(--spacing-sm); background-color: transparent; color: var(--color-accent); border-color: var(--color-accent);">Contact HouseTech</a>
        </div>

      </div>
    </div>
  </section>

  <Footer />
</Layout>
