---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'About Us - HouseTech Group | Professional Kitchen Appliance Manufacturer';
const description = 'Learn about HouseTech Group - a leading B2B manufacturer of kitchen appliances with 15+ years experience, serving clients in 50+ countries worldwide.';
---

<Layout title={title} description={description}>
  <Header activeNav="about" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>About HouseTech Group</h1>
      <p>Your trusted partner in professional kitchen appliance manufacturing</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>About Us</span>
      </nav>
    </div>
  </section>

  <!-- Content -->
  <section class="content-section">
    <div class="container">
      <div class="content-area">

        <h2>Company Overview</h2>
        <p>HouseTech Group is a leading manufacturer specializing in the research, development, and production of high-quality kitchen appliances. With over 15 years of industry experience, we have established ourselves as a reliable B2B partner for businesses across more than 50 countries worldwide.</p>
        <p>Our product portfolio includes Range Hoods (Kitchen Hoods, Cooker Hoods, Extractor Hoods, Chimney Hoods), Gas Stoves & Hobs (Built-in Gas/Electric/Ceramic/Induction Hobs), Built-in Ovens (Electric/Gas/Convection/Steam Ovens), Air Fryers, and Gas Water Heaters — covering all essential kitchen appliance categories.</p>

        <h2>Our Mission</h2>
        <p>To provide innovative, high-quality kitchen appliance solutions at competitive factory-direct prices while delivering exceptional OEM/ODM services to our global partners.</p>

        <h2>Our Vision</h2>
        <p>To become the world's most trusted kitchen appliance manufacturer, recognized for innovation, quality, and customer-centric service.</p>

        <h2>Core Values</h2>
        <ul>
          <li><strong>Quality First:</strong> Every product meets international standards with rigorous quality control processes.</li>
          <li><strong>Innovation:</strong> Continuous R&D investment to develop cutting-edge products that meet evolving market demands.</li>
          <li><strong>Integrity:</strong> Transparent business practices and honest communication with all stakeholders.</li>
          <li><strong>Customer Focus:</strong> Understanding and exceeding customer expectations through personalized solutions.</li>
          <li><strong>Sustainability:</strong> Committed to environmentally friendly manufacturing practices and energy-efficient products.</li>
        </ul>

        <h2>Key Facts</h2>
        <ul>
          <li><strong>Established:</strong> Over 15 years in kitchen appliance manufacturing</li>
          <li><strong>Factory Size:</strong> 30,000+ square meters of modern production facility</li>
          <li><strong>Employees:</strong> 500+ skilled workers and engineers</li>
          <li><strong>Production Capacity:</strong> 1 million units per year</li>
          <li><strong>Export Markets:</strong> 50+ countries across Europe, Middle East, Southeast Asia, Africa, and Americas</li>
          <li><strong>Certifications:</strong> ISO9001, CE, CB, ETL, SASO, GCC</li>
          <li><strong>R&D Team:</strong> 50+ engineers dedicated to product innovation</li>
        </ul>

        <h2>Milestones</h2>
        <ul>
          <li>2010 — Company founded with focus on range hood manufacturing</li>
          <li>2013 — Expanded product line to gas stoves/hobs</li>
          <li>5 — Added oven production line</li>
          <li>2017 — Achieved ISO9001 certification; entered Middle East market</li>
          <li>2019 — Launched air fryer product series; R&D center established</li>
          <li>2021 — Factory expansion to 30,000 sqm; ETL certification obtained</li>
          <li>2023 — Water heater line launched; export to 50+ countries milestone</li>
          <li>2024 — Digital transformation; smart appliance R&D initiated</li>
        </ul>

        <div style="margin-top: var(--spacing-2xl); text-align: center;">
          <a href="/factory" class="btn btn-primary">Visit Our Factory →</a>
          <a href="/contact" class="btn btn-outline" style="margin-left: var(--spacing-sm); background-color: transparent; color: var(--color-accent); border-color: var(--color-accent);">Contact Us</a>
        </div>

      </div>
    </div>
  </section>

  <Footer />
</Layout>
