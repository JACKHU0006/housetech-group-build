---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Schema from '../../components/Schema.astro';

const title = 'Factory Expansion Completed - HouseTech Group News';
const description = 'HouseTech Group completes $50M factory expansion doubling capacity to 1M units/year with 200K sq ft production area and 30% shorter lead times.';

const articleSchema = {
  headline: 'HouseTech Completes $50M Factory Expansion Doubling Capacity to 1M Units',
  description: 'HouseTech $50M factory expansion doubles capacity to 1M units/year with 200K sq ft area, 50K pallet AS/RS warehouse, and 30% shorter lead times.',
  image: 'https://www.housetech-ch.com/logo-housetech.png',
  datePublished: '2023-11-15',
  author: { name: 'HouseTech Group' },
  publisher: {
    name: 'HouseTech Group',
    logo: { url: 'https://www.housetech-ch.com/logo-housetech.png' }
  }
};

const faqItems = [
  {
    question: 'How much did the factory expansion cost?',
    answer: 'The factory expansion represented a $50 million investment in manufacturing.'
  },
  {
    question: 'What is the new annual production capacity?',
    answer: 'Annual production capacity doubled from 500K to 1 million units per year.'
  },
  {
    question: 'How large is the expanded production area?',
    answer: 'Production area spans 200,000 square feet with automated assembly lines.'
  },
  {
    question: 'What is the warehouse pallet storage capacity?',
    answer: 'Automated warehouse holds 50,000 pallet positions with AS/RS system.'
  },
  {
    question: 'By how much have lead times been reduced?',
    answer: 'Delivery lead times shortened by 30% through improved planning.'
  },
  {
    question: 'How much solar capacity does the new facility have?',
    answer: 'Solar panel arrays generate 2 MW of clean renewable energy onsite.'
  }
];
---

<Layout title={title} description={description}>
  <Schema type="article" data={articleSchema} />
  <Schema type="faq" data={{ items: faqItems }} />
  <Header activeNav="news" />
  
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a> / <a href="/news">News</a> / <span>Company Update</span>
      </nav>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <article class="content-area" style="max-width: 850px;">
        
        <header class="article-header">
          <span class="article-category">Company Update</span>
          <h1 class="article-title">Factory Expansion Completed — Production Capacity Doubled to 1M Units/Year</h1>
          <div class="article-meta-info">
            <span>📅 November 2023</span>
            <span>🏷️ Company Update</span>
            <span>⏱️ 6 min read</span>
          </div>
        </header>

        <figure class="article-image-figure">
          <div style="width:100%;aspect-ratio:16/9;background:linear-gradient(135deg, #7c3aed, #5b21b6);display:flex;align-items:center;justify-content:center;border-radius:var(--radius-lg);">
            <svg width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="1">
              <rect x="4" y="4" width="16" height="16" rx="2"/>
              <path d="M4 12h16M8 8v8M12 8v8M16 8v8"/>
            </svg>
          </div>
          <figcaption class="article-image-caption">HouseTech's expanded manufacturing facility</figcaption>
        </figure>

        <div class="article-body">
          <p>HouseTech completes 18-month factory expansion after $50M investment in Guangdong. Annual production capacity doubles from 500K to 1M units, positioning as one of Asia's largest OEM kitchen appliance manufacturers.</p>
          
          <p>Expansion directly addresses growing order volumes from global OEM and ODM partnerships. Scalable design enables further capacity increases as market demand continues growing.</p>
          
          <h2>Facility Highlights</h2>
          
          <p>200,000 sq ft production area with state-of-the-art automated welding, painting, and quality inspection systems. Smart warehouse features AS/RS capable of housing 50,000 pallet positions.</p>
          
          <p>30,000 sq ft dedicated R&D innovation hub with prototyping equipment and testing laboratories. Training center facility supports ongoing employee development and customer training programs.</p>
          
          <h2>Benefits for OEM Partners</h2>
          
          <p>Minimum order quantities reduced for smaller brands entering new markets. Large retailers receive guaranteed production slots for peak seasonal demand periods.</p>
          
          <p>Lead times shortened by 30% through improved production planning systems and additional workforce. Flexible scheduling accommodates both high-volume and custom specialty orders.</p>
          
          <h2>Sustainability Features</h2>
          
          <p>New facility incorporates latest environmental technologies including 2 MW solar panel arrays generating clean energy. Rainwater harvesting systems and advanced waste recycling programs reduce environmental impact.</p>
          
          <p>Investments support HouseTech commitment to carbon-neutral manufacturing goals. Energy-efficient equipment reduces per-unit consumption by 25% compared to previous facility.</p>
          
          <p>$50M expansion doubles capacity to 1M units with 200K sq ft area, 50K pallet warehouse, and 30% faster delivery.</p>
        </div>
        <div style="background:linear-gradient(135deg, var(--color-primary), #1a4a7a);border-radius:var(--radius-lg);padding:var(--spacing-xl);margin:var(--spacing-xl) 0;text-align:center;color:white;">
          <h3 style="font-size:var(--font-size-xl);margin-bottom:var(--spacing-sm);color:white;">Scale Your Orders with Confidence</h3>
          <p style="color:rgba(255,255,255,0.85);margin-bottom:var(--spacing-lg);max-width:600px;margin-left:auto;margin-right:auto;">2 million units annual capacity. 12 new production lines. Large-volume OEM contracts with guaranteed delivery schedules.</p>
          <div style="display:flex;flex-wrap:wrap;gap:var(--spacing-sm);justify-content:center;">
            <a href="/contact" class="btn btn-primary" style="text-decoration:none;">Get OEM Quote →</a>
            <a href="/download" class="btn btn-outline-white" style="text-decoration:none;">Download Catalog</a>
            <a href="/contact" class="btn btn-outline-white" style="text-decoration:none;">Request Sample</a>
          </div>
        </div>
<nav class="article-nav">
          <a href="/news/canton-fair-2024-phase2" class="article-nav-link">
            <span class="article-nav-label">← Previous</span>
            <span class="article-nav-title">Canton Fair 2024</span>
          </a>
          <a href="/news/new-rd-center-opening" class="article-nav-link" style="margin-left:auto;text-align:right;">
            <span class="article-nav-label">Next →</span>
            <span class="article-nav-title">New R&D Center Opening</span>
          </a>
        </nav>

        <div style="text-align:center;margin-top:var(--spacing-xl);">
          <a href="/news" class="btn btn-accent-outline">← Back to All News</a>
        </div>

      </article>
    </div>
  </section>

  <Footer />
</Layout>
