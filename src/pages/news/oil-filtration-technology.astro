const title = 'Revolutionary Oil-Filtration Technology - HouseTech Group News';
const description = 'HouseTech Group debuts breakthrough oil-filtration technology in latest range hood models, featuring 99.8% grease separation efficiency and washable filter systems for sustainable kitchen ventilation.';
---

<Layout title={title} description={description}>
