const title = 'HouseTech Achieves Carbon Neutral Status - HouseTech Group News';
const description = 'HouseTech Group announces carbon neutral certification for manufacturing operations, committing to sustainable production of range hoods and kitchen appliances with net-zero carbon emissions.';
