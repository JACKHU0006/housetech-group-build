---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Schema from '../../components/Schema.astro';

const title = 'Celebrating 10 Years of Excellence - HouseTech Group News';
const description = 'HouseTech Group celebrates 10 years of kitchen appliance manufacturing excellence with 1M annual capacity, 40-country global reach, and 50-engineer R&D team.';

const articleSchema = {
  headline: 'HouseTech Celebrates 10 Years with 1M Unit Capacity and 40-Country Global Reach',
  description: 'HouseTech 10-year anniversary marks 1M unit annual capacity, 40-country distribution, and 50-engineer R&D team from 50-person startup in 2012.',
  image: 'https://www.housetech-ch.com/logo-housetech.png',
  datePublished: '2022-04-15',
  author: { name: 'HouseTech Group' },
  publisher: {
    name: 'HouseTech Group',
    logo: { url: 'https://www.housetech-ch.com/logo-housetech.png' }
  }
};

const faqItems = [
  {
    question: 'When was HouseTech Group founded?',
    answer: 'HouseTech Group was founded in April 2012 in Shenzhen, China.'
  },
  {
    question: 'What is the current annual production capacity?',
    answer: 'Current annual production capacity reaches 1 million units per year.'
  },
  {
    question: 'How many countries does HouseTech serve globally?',
    answer: 'HouseTech serves partners and customers in 40 countries worldwide.'
  },
  {
    question: 'How many engineers work in the R&D center?',
    answer: 'The R&D center employs 50 engineers driving product innovation.'
  },
  {
    question: 'When was ISO 9001 certification achieved?',
    answer: 'ISO 9001 quality management certification was achieved in 2018.'
  },
  {
    question: 'What was the initial facility size in 2012?',
    answer: 'HouseTech started in a 10,000 sq ft facility with 50 employees.'
  }
];
---

<Layout title={title} description={description}>
  <Schema type="article" data={articleSchema} />
  <Schema type="faq" data={{ items: faqItems }} />
  <Header activeNav="news" />
  
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a> / <a href="/news">News</a> / <span>Milestone</span>
      </nav>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <article class="content-area" style="max-width: 850px;">
        
        <header class="article-header">
          <span class="article-category">Milestone</span>
          <h1 class="article-title">Celebrating 10 Years of Excellence in Kitchen Appliance Manufacturing</h1>
          <div class="article-meta-info">
            <span>📅 April 2022</span>
            <span>🏷️ Milestone</span>
            <span>⏱️ 6 min read</span>
          </div>
        </header>

        <figure class="article-image-figure">
          <div style="width:100%;aspect-ratio:16/9;background:linear-gradient(135deg, #ca8a04, #a16207);display:flex;align-items:center;justify-content:center;border-radius:var(--radius-lg);">
            <svg width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="1">
              <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
            </svg>
          </div>
          <figcaption class="article-image-caption">10 Years of Excellence</figcaption>
        </figure>

        <div class="article-body">
          <p>HouseTech Group celebrates 10-year anniversary founded April 2012. Grown from 50 employees in 10,000 sq ft facility to global enterprise with 1M unit annual capacity and 40-country distribution network.</p>
          
          <p>Ten-year journey reflects team dedication and partner trust worldwide. From domestic Chinese manufacturer to internationally recognized OEM kitchen appliance partner serving premium brands across six continents.</p>
          
          <h2>A Decade of Growth</h2>
          
          <p>2012 founded with 50 employees focusing on domestic Chinese market. 2015 began international expansion with Southeast Asian export partnerships establishing initial global presence.</p>
          
          <p>2018 achieved ISO 9001 certification validating quality management systems. 2020 established R&D center with 50 engineers driving innovation and new product development.</p>
          
          <p>2022 completed factory expansion reaching 1 million units annual capacity. Now serves 40 countries with OEM partnerships spanning Europe, North America, Asia, and beyond.</p>
          
          <h2>Commitment to Partners</h2>
          
          <p>HouseTech success inseparable from OEM partner success over 10 years. Built lasting relationships with brands trusting manufacturing to represent their brand values globally.</p>
          
          <p>B2B partners benefit from manufacturing excellence, engineering expertise, and global market understanding. Whether new private label or expanding range, HouseTech provides foundation for success.</p>
          
          <h2>Looking Forward</h2>
          
          <p>Next decade brings smart home integration, sustainability requirements, and evolving consumer preferences. HouseTech prepared to lead through continued R&D investment and manufacturing capability expansion.</p>
          
          <p>Sustainability remains particular focus with carbon-neutral operations targets. Products designed for longevity and recyclability demonstrate responsible manufacturing drives business success.</p>
          
          <p>Ten-year growth from 50 to 500+ employees, 10K to 200K sq ft, 1 to 40 countries validated.</p>
        </div>
        <div style="background:linear-gradient(135deg, var(--color-primary), #1a4a7a);border-radius:var(--radius-lg);padding:var(--spacing-xl);margin:var(--spacing-xl) 0;text-align:center;color:white;">
          <h3 style="font-size:var(--font-size-xl);margin-bottom:var(--spacing-sm);color:white;">Partner with a Proven Manufacturer</h3>
          <p style="color:rgba(255,255,255,0.85);margin-bottom:var(--spacing-lg);max-width:600px;margin-left:auto;margin-right:auto;">Decade of consistent delivery. Financial stability. Multi-year contracts welcomed. Your supply chain secured.</p>
          <div style="display:flex;flex-wrap:wrap;gap:var(--spacing-sm);justify-content:center;">
            <a href="/contact" class="btn btn-primary" style="text-decoration:none;">Get OEM Quote →</a>
            <a href="/download" class="btn btn-outline-white" style="text-decoration:none;">Download Catalog</a>
            <a href="/contact" class="btn btn-outline-white" style="text-decoration:none;">Request Sample</a>
          </div>
        </div>
<nav class="article-nav">
          <a href="/news/18-month-product-development" class="article-nav-link">
            <span class="article-nav-label">← Previous</span>
            <span class="article-nav-title">18-Month Development Cycle</span>
          </a>
          <a href="/news/ces-2025-smart-kitchen-launch" class="article-nav-link" style="margin-left:auto;text-align:right;">
            <span class="article-nav-label">Next →</span>
            <span class="article-nav-title">CES 2025 Launch</span>
          </a>
        </nav>

        <div style="text-align:center;margin-top:var(--spacing-xl);">
          <a href="/news" class="btn btn-accent-outline">← Back to All News</a>
        </div>

      </article>
    </div>
  </section>

  <Footer />
</Layout>
