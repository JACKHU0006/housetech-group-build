---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'FAQ - HouseTech Group | Frequently Asked Questions';
const description = 'Find answers to common questions about HouseTech Group products, OEM/ODM services, MOQ, pricing, shipping, and more.';
---

<Layout title={title} description={description}>
  <Header activeNav="faq" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>Frequently Asked Questions</h1>
      <p>Everything you need to know about working with HouseTech Group</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>FAQ</span>
      </nav>
    </div>
  </section>

  <!-- Content -->
  <section class="content-section" style="background-color: var(--color-bg-alt);">
    <div class="container">
      <div class="content-area">

        <!-- FAQ Categories -->
        <h2>General Questions</h2>

        <details style="margin-bottom: var(--spacing-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
          <summary style="font-weight: 600; font-size: var(--font-size-lg); cursor: pointer; color: var(--color-primary);">What is HouseTech Group?</summary>
          <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">HouseTech Group is a leading B2B manufacturer of kitchen appliances with over 15 years of experience. We produce Range Hoods, Gas Stoves/Hobs, Ovens, Air Fryers, and Gas Water Heaters for global markets, serving clients in more than 50 countries.</p>
        </details>

        <details style="margin-bottom: var(--spacing-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
          <summary style="font-weight: 600; font-size: var(--font-size-lg); cursor: pointer; color: var(--color-primary);">Where is your factory located?</summary>
          <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">Our manufacturing facility is located in China, spanning over 30,000 square meters with modern production lines. We welcome factory visits from potential partners.</p>
        </details>

        <details style="margin-bottom: var(--spacing-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
          <summary style="font-weight: 600; font-size: var(--font-size-lg); cursor: pointer; color: var(--color-primary);">What certifications do your products have?</summary>
          <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">We hold multiple international certifications including ISO9001, CE, CB, ETL, SASO, and GCC. Additional certifications can be arranged for specific market requirements.</p>
        </details>

        <h2>Orders & Pricing</h2>

        <details style="margin-bottom: var(--spacing-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
          <summary style="font-weight: 600; font-size: var(--font-size-lg); cursor: pointer; color: var(--color-primary);">What is the Minimum Order Quantity (MOQ)?</summary>
          <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">MOQ varies by product type and customization level. Standard product MOQ starts from as low as 100 units. Customized/OEM orders typically start at 300-500 units per model. Contact us for specific requirements.</p>
        </details>

        <details style="margin-bottom: var(--spacing-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
          <summary style="font-weight: 600; font-size: var(--font-size-lg); cursor: pointer; color: var(--color-primary);">How can I get a price quote?</summary>
          <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">You can request a quote through our Contact Us page or by emailing sales@housetech-ch.com. Please include product models, quantities, destination country, and any customization requirements. We respond within 24 hours.</p>
        </details>

        <details style="margin-bottom: var(--spacing-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
          <summary style="font-weight: 600; font-size: var(--font-size-lg); cursor: pointer; color: var(--color-primary);">What payment terms do you accept?</summary>
          <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">We accept T/T (Telegraphic Transfer), L/C (Letter of Credit) for large orders, and other negotiable terms based on order size and relationship. Typically: 30% deposit, 70% before shipment.</p>
        </details>

        <h2>OEM / ODM Services</h2>

        <details style="margin-bottom: var(--spacing-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
          <summary style="font-weight: 600; font-size: var(--font-size-lg); cursor: pointer; color: var(--color-primary);">Do you offer OEM/ODM services?</summary>
          <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">Yes! We offer comprehensive OEM and ODM services including custom branding, logo placement, packaging design, product specification modifications, and new product development. Our R&D team has 50+ engineers ready to support your projects.</p>
        </details>

        <details style="margin-bottom: var(--spacing-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
          <summary style="font-weight: 600; font-size: var(--font-size-lg); cursor: pointer; color: var(--color-primary);">How long is the lead time?</summary>
          <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">Standard products: 15-25 days after order confirmation. Custom/OEM orders: 30-45 days depending on complexity. We always strive to meet urgent deadlines when possible.</p>
        </details>

        <details style="margin-bottom: var(--spacing-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
          <summary style="font-weight: 600; font-size: var(--font-size-lg); cursor: pointer; color: var(--color-primary);">Can I get samples before placing a bulk order?</summary>
          <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">Yes, we provide samples for evaluation. Sample fees apply and are refundable when the bulk order reaches a certain quantity. Sample delivery time is 5-10 days by express courier.</p>
        </details>

        <h2>Shipping & Logistics</h2>

        <details style="margin-bottom: var(--spacing-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
          <summary style="font-weight: 600; font-size: var(--font-size-lg); cursor: pointer; color: var(--color-primary);">How long does shipping take?</summary>
          <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">Shipping time depends on the destination and method:</p>
          <ul style="margin-top: 0.5rem;">
            <li>Sea freight to major ports: 15-40 days</li>
            <li>Air freight: 3-7 days</li>
            <li>Railway (Europe): 18-25 days</li>
            <li>We ship FOB, CIF, EXW — you choose what works best for you.</li>
          </ul>
        </details>

        <details style="margin-bottom: var(--spacing-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
          <summary style="font-weight: 600; font-size: var(--font-size-lg); cursor: pointer; color: var(--color-primary);">Do you handle export documentation?</summary>
          <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">Yes, we handle all export documentation including commercial invoice, packing list, certificate of origin (CO), bill of lading, and any special documentation required by your country's customs authorities.</p>
        </details>

        <h2>After-Sales & Warranty</h2>

        <details style="margin-bottom: var(--spacing-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
          <summary style="font-weight: 600; font-size: var(--font-size-lg); cursor: pointer; color: var(--color-primary);">What warranty do you offer?</summary>
          <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">We offer 1-3 year warranty depending on the product category and agreement terms. Spare parts are available throughout the warranty period and beyond. Detailed warranty terms are specified in each purchase contract.</p>
        </details>

        <details style="margin-bottom: var(--spacing-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
          <summary style="font-weight: 600; font-size: var(--font-size-lg); cursor: pointer; color: var(--color-primary);">How do you handle quality issues?</summary>
          <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">If you receive defective products, please contact us within 7 days of receipt with photos and details. We will investigate promptly and arrange replacement, repair, or credit depending on the situation. Customer satisfaction is our priority.</p>
        </details>

        <!-- CTA -->
        <div style="margin-top: var(--spacing-2xl); text-align: center; background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light)); padding: var(--spacing-xl); border-radius: var(--radius-lg);">
          <h3 style="color: white; margin-bottom: var(--spacing-sm);">Still Have Questions?</h3>
          <p style="opacity: 0.85; margin-bottom: var(--spacing-md);">Our team is here to help!</p>
          <a href="/contact" class="btn btn-white">Contact Us →</a>
        </div>

      </div>
    </div>
  </section>

  <Footer />
</Layout>
