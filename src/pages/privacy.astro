---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Privacy Policy - HouseTech Group';
const description = 'HouseTech Group privacy policy explaining how we collect, use, and protect your personal information.';
---

<Layout title={title} description={description}>
  <Header activeNav="" />

  <section class="page-hero">
    <div class="container">
      <h1>Privacy Policy</h1>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Privacy Policy</span>
      </nav>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <div class="content-area">
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-xl);"><em>Last updated: April 2024</em></p>

        <h2>1. Introduction</h2>
        <p>HouseTech Group ("we," "our," or "us") is committed to protecting your privacy. This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you visit our website (housetech-ch.com) or interact with our business.</p>

        <h2>2. Information We Collect</h2>
        <h3>Personal Information</h3>
        <ul>
          <li>Name, email address, phone number, and company name provided through our contact forms</li>
          <li>Inquiry details including product interests, quantities, and specifications</li>
          <li>Communication records with our sales team</li>
        </ul>

        <h3>Non-Personal Information</h3>
        <ul>
          <li>Browser type, device information, and IP address</li>
          <li>Pages visited, time spent on site, and navigation patterns</li>
          <li>Referring website and search terms used to find us</li>
        </ul>

        <h2>3. How We Use Your Information</h2>
        <ul>
          <li>To respond to inquiries and provide requested product information</li>
          <li>To process quotes and facilitate business transactions</li>
          <li>To improve our website and services based on visitor behavior</li>
          <li>To send relevant business updates (with your consent)</li>
          <li>To comply with legal obligations</li>
        </ul>

        <h2>4. Information Sharing</h2>
        <p>We do not sell or rent your personal information to third parties. We may share your information with:</p>
        <ul>
          <li>Trusted service providers who assist in operating our business</li>
          <li>Shipping and logistics partners for order fulfillment</li>
          <li>Legal authorities when required by law</li>
        </ul>

        <h2>5. Data Security</h2>
        <p>We implement appropriate technical and organizational measures to protect your data against unauthorized access, alteration, disclosure, or destruction. However, no method of electronic transmission is 100% secure.</p>

        <h2>6. Cookies</h2>
        <p>Our website uses cookies to enhance user experience. You can control cookies through your browser settings. Disabling cookies may affect some features of the site.</p>

        <h2>7. Your Rights</h2>
        <ul>
          <li><strong>Access:</strong> Request a copy of the data we hold about you</li>
          <li><strong>Correction:</strong> Update inaccurate or incomplete information</li>
          <li><strong>Deletion:</strong> Request deletion of your personal data</li>
          <li><strong>Opt-out:</strong> Unsubscribe from marketing communications</li>
        </ul>

        <h2>8. Contact Us</h2>
        <p>For questions about this Privacy Policy or our practices, please contact us at:</p>
        <ul>
          <li>Email: <a href="mailto:privacy@housetech-ch.com" style="color: var(--color-accent);">privacy@housetech-ch.com</a></li>
          <li>Address: HouseTech Group, Zhongshan City, Guangdong Province, China</li>
        </ul>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
