---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Support - HouseTech Group | Technical Support & Documentation';
const description='Access technical support resources, installation guides, troubleshooting documentation, and spare parts information for HouseTech Group kitchen appliances.';
---

<Layout title={title} description={description}>
  <Header activeNav="" />

  <section class="page-hero">
    <div class="container">
      <h1>Support Center</h1>
      <p>Technical support, documentation, and resources for HouseTech products</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Support</span>
      </nav>
    </div>
  </section>

  <!-- Support Category Navigation -->
  <section class="stats-banner" style="background: linear-gradient(135deg, #1e3a5f, #2d5a87);">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--spacing-md); text-align: center;">
        <a href="#installation" style="text-decoration: none; color: white; padding: var(--spacing-md); border-radius: var(--radius-md); background: rgba(255,255,255,0.1); transition: background 0.2s;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin: 0 auto var(--spacing-sm); display: block;"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          <span style="font-weight: 600;">Installation Guides</span>
        </a>
        <a href="#troubleshooting" style="text-decoration: none; color: white; padding: var(--spacing-md); border-radius: var(--radius-md); background: rgba(255,255,255,0.1); transition: background 0.2s;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin: 0 auto var(--spacing-sm); display: block;"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3m.08 4h.01"/></svg>
          <span style="font-weight: 600;">Troubleshooting</span>
        </a>
        <a href="#spareparts" style="text-decoration: none; color: white; padding: var(--spacing-md); border-radius: var(--radius-md); background: rgba(255,255,255,0.1); transition: background 0.2s;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin: 0 auto var(--spacing-sm); display: block;"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
          <span style="font-weight: 600;">Spare Parts</span>
        </a>
        <a href="#warranty" style="text-decoration: none; color: white; padding: var(--spacing-md); border-radius: var(--radius-md); background: rgba(255,255,255,0.1); transition: background 0.2s;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin: 0 auto var(--spacing-sm); display: block;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span style="font-weight: 600;">Warranty Info</span>
        </a>
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="container">

      <!-- Installation Guides -->
      <div id="installation" style="margin-bottom: var(--spacing-3xl);">
        <span class="section-tag">Installation</span>
        <h2 style="margin-top: var(--spacing-sm); margin-bottom: var(--spacing-xl);">Installation Guides by Product Category</h2>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--spacing-lg);">
          <div class="feature-card">
            <div class="feature-icon"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>
            <h3>Range Hoods</h3>
            <p>Wall mount, island, built-in, and slim hood installation — ducting setup, electrical requirements, and mounting templates.</p>
            <a href="/download" class="btn btn-accent-outline btn-sm" style="margin-top: var(--spacing-sm);">View Manuals</a>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
            <h3>Gas Stoves & Hobs</h3>
            <p>Cut-out dimensions, gas connection procedures, LPG/NG type conversion, and safety clearances for all hob types.</p>
            <a href="/download" class="btn btn-accent-outline btn-sm" style="margin-top: var(--spacing-sm);">View Manuals</a>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8m-4-4v4"/></svg></div>
            <h3>Ovens</h3>
            <p>Built-in oven cabinet preparation, electrical connection specs, ventilation requirements, and built-in dimension guides.</p>
            <a href="/download" class="btn btn-accent-outline btn-sm" style="margin-top: var(--spacing-sm);">View Manuals</a>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
            <h3>Air Fryers</h3>
            <p>Counter placement, electrical requirements, first-use seasoning instructions, and maintenance for air fryer products.</p>
            <a href="/download" class="btn btn-accent-outline btn-sm" style="margin-top: var(--spacing-sm);">View Manuals</a>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></div>
            <h3>Water Heaters</h3>
            <p>Gas water heater mounting, gas line connection, water piping setup, and first ignition procedure for instant heaters.</p>
            <a href="/download" class="btn btn-accent-outline btn-sm" style="margin-top: var(--spacing-sm);">View Manuals</a>
          </div>
        </div>
      </div>

      <!-- Troubleshooting Q&A -->
      <div id="troubleshooting" style="margin-bottom: var(--spacing-3xl);">
        <span class="section-tag">Troubleshooting</span>
        <h2 style="margin-top: var(--spacing-sm); margin-bottom: var(--spacing-xl);">Common Issues & Solutions</h2>

        <div style="max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--spacing-md);">

          <details style="border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
            <summary style="font-weight: 600; cursor: pointer; color: var(--color-primary);">Range Hood — Not extracting smoke effectively</summary>
            <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">Check if the ducting is properly connected and not blocked. Ensure the correct extraction mode (ducted vs recirculating) is selected. Clean or replace the grease filter if it is saturated. For HouseTech range hoods, check that the fan speed setting matches your cooking intensity.</p>
          </details>

          <details style="border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
            <summary style="font-weight: 600; cursor: pointer; color: var(--color-primary);">Gas Stove — Burner won't ignite</summary>
            <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">Verify the gas supply is on and check the gas type matches the unit's specification (LPG vs Natural Gas). Clean the burner ports with a needle to remove blockages. Check the igniter electrode is clean and properly positioned. Replace the battery for electronic ignition models if needed.</p>
          </details>

          <details style="border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
            <summary style="font-weight: 600; cursor: pointer; color: var(--color-primary);">Oven — Uneven cooking results</summary>
            <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">Preheat the HouseTech oven fully (10-15 minutes) before use. Use the recommended rack position for the food type. Ensure proper spacing between items for air circulation. Calibrate temperature if consistently off — most HouseTech ovens have a ±15°C tolerance. Clean the interior after extended use.</p>
          </details>

          <details style="border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
            <summary style="font-weight: 600; cursor: pointer; color: var(--color-primary);">Air Fryer — Food not crispy enough</summary>
            <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">Do not overcrowd the basket — cook in batches for best results. Lightly coat food with oil before cooking. Shake the basket halfway through cooking time. Increase temperature by 5-10°C if needed. Ensure the air fryer is preheated for 3 minutes before adding food.</p>
          </details>

          <details style="border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
            <summary style="font-weight: 600; cursor: pointer; color: var(--color-primary);">Water Heater — No hot water output</summary>
            <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">Check that the water and gas supplies are turned on. Verify the power source (batteries or electricity). Check if any error codes are displayed on the panel. Inspect the water pressure regulator. For HouseTech gas water heaters, the display will show an error code — refer to the manual for specific code meanings.</p>
          </details>

          <details style="border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
            <summary style="font-weight: 600; cursor: pointer; color: var(--color-primary);">Range Hood — LED lights not working</summary>
            <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">HouseTech range hood LED lights are rated for long life. If lights fail, first check that the light switch is activated. Replace the LED module with the HouseTech-approved replacement part — do not use third-party LED modules as they may void the warranty and cause electrical issues.</p>
          </details>

          <details style="border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
            <summary style="font-weight: 600; cursor: pointer; color: var(--color-primary);">Gas Hob — Flame too yellow or sooty</summary>
            <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">Yellow flame indicates incomplete combustion, usually caused by incorrect gas type or clogged burner ports. Verify that your HouseTech gas hob is set for the correct gas type (LPG requires different injectors from Natural Gas). Clean the burner with water and a soft brush. If the problem persists, contact HouseTech technical support for injector replacement.</p>
          </details>

          <details style="border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
            <summary style="font-weight: 600; cursor: pointer; color: var(--color-primary);">Built-in Oven — Display not responding</summary>
            <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">For HouseTech built-in ovens with touch controls, try a power reset: turn off the circuit breaker for 30 seconds, then restore power. If the display still does not respond, contact HouseTech after-sales support. Do not attempt to open the oven control panel yourself as it may affect the warranty coverage.</p>
          </details>

        </div>
      </div>

      <!-- Spare Parts -->
      <div id="spareparts" style="margin-bottom: var(--spacing-3xl);">
        <span class="section-tag">Spare Parts</span>
        <h2 style="margin-top: var(--spacing-sm); margin-bottom: var(--spacing-lg);">Ordering Replacement Parts</h2>
        <div class="feature-card">
          <p style="color: var(--color-text-light); line-height: 1.7;">HouseTech Group guarantees spare parts availability for a minimum of 3 years after the last production date of each model. Available spare parts include:</p>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--spacing-md); margin-top: var(--spacing-lg);">
            <div>
              <h4 style="color: var(--color-primary); font-size: var(--font-size-sm); margin-bottom: var(--spacing-xs);">Range Hoods</h4>
              <p style="font-size: var(--font-size-sm); color: var(--color-text-light);">Charcoal filters, grease filters, LED modules, fan motors, control boards</p>
            </div>
            <div>
              <h4 style="color: var(--color-primary); font-size: var(--font-size-sm); margin-bottom: var(--spacing-xs);">Gas Stoves</h4>
              <p style="font-size: var(--font-size-sm); color: var(--color-text-light);">Burner caps, ignition electrodes, trivets, control knobs, gas valves</p>
            </div>
            <div>
              <h4 style="color: var(--color-primary); font-size: var(--font-size-sm); margin-bottom: var(--spacing-xs);">Ovens</h4>
              <p style="font-size: var(--font-size-sm); color: var(--color-text-light);">Heating elements, thermostat sensors, fan motors, door seals, glass panels</p>
            </div>
            <div>
              <h4 style="color: var(--color-primary); font-size: var(--font-size-sm); margin-bottom: var(--spacing-xs);">Air Fryers</h4>
              <p style="font-size: var(--font-size-sm); color: var(--color-text-light);">Frying baskets, heating coils, fans, control panels, non-stick coatings</p>
            </div>
          </div>
          <p style="margin-top: var(--spacing-lg); font-size: var(--font-size-sm); color: var(--color-text-light);">To order HouseTech spare parts, contact our after-sales team with your product model number (found on the product nameplate) and the required part description.</p>
        </div>
      </div>

      <!-- Warranty Policy -->
      <div id="warranty" style="margin-bottom: var(--spacing-3xl);">
        <span class="section-tag">Warranty</span>
        <h2 style="margin-top: var(--spacing-sm); margin-bottom: var(--spacing-lg);">HouseTech Warranty Policy</h2>
        <div class="feature-card">
          <h3>Warranty Coverage Summary</h3>
          <ul style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.8;">
            <li><strong>Electronic Components:</strong> 1-year warranty for control panels, motors, fans, and PCBs</li>
            <li><strong>Structural Components:</strong> 2-year warranty for stainless steel body, glass panels, and mechanical parts</li>
            <li><strong>Gas Components:</strong> 2-year warranty for gas valves, burners, and safety devices</li>
            <li><strong>Extended Warranty:</strong> Available for OEM/ODM partners upon agreement — up to 3 years</li>
          </ul>
          <h3 style="margin-top: var(--spacing-lg);">Warranty Process</h3>
          <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">If your HouseTech product requires warranty service: 1) Contact our after-sales team with photos and product model; 2) HouseTech technical team will diagnose the issue remotely within 48 hours; 3) We arrange replacement parts shipment or unit replacement as appropriate; 4) Warranty claims are processed within 7 business days of receiving defective parts.</p>
        </div>
      </div>

      <!-- CTA -->
      <div id="contact" style="text-align: center; background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light)); padding: var(--spacing-2xl); border-radius: var(--radius-lg); color: white;">
        <h2 style="margin-bottom: var(--spacing-sm); color: white;">Need Additional Support?</h2>
        <p style="opacity: 0.85; margin-bottom: var(--spacing-lg); max-width: 500px; margin-left: auto; margin-right: auto;">HouseTech technical support team is available to assist with complex issues, warranty claims, and spare parts ordering.</p>
        <a href="/contact" class="btn btn-white">Contact HouseTech Support</a>
      </div>

    </div>
  </section>

  <Footer />
</Layout>
