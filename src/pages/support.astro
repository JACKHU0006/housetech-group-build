---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Support - HouseTech Group | Technical Support & Documentation';
const description='Access technical support resources, installation guides, troubleshooting documentation, and spare parts information for HouseTech Group kitchen appliances.';
---

<Layout title={title} description={description}>
  <Header activeNav="" />

  <section class="page-hero">
    <div class="container">
      <h1>Support Center</h1>
      <p>Technical support, documentation, and resources</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Support</span>
      </nav>
    </div>
  </section>

  <section class="content-section" style="background: var(--color-bg-alt);">
    <div class="container">

      <!-- Quick Links -->
      <div class="features-grid" style="margin-bottom: var(--spacing-3xl);">

        <a href="/download" class="feature-card" style="text-decoration: none;">
          <div class="feature-icon" style="margin: 0 auto var(--spacing-md);">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          </div>
          <h3 style="text-align: center;">Product Manuals</h3>
          <p style="text-align: center; color: var(--color-text-light);">Download installation guides, user manuals, and technical specifications for all product lines.</p>
          <span style="display: block; text-align: center; color: var(--color-accent); font-weight: 600; font-size: var(--font-size-sm); margin-top: var(--spacing-sm);">Download →</span>
        </a>

        <div class="feature-card" style="text-align: center;">
          <div class="feature-icon" style="margin: 0 auto var(--spacing-md); background: linear-gradient(135deg, #10b981, #059669);">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3>Spare Parts</h3>
          <p style="color: var(--color-text-light);">Order replacement parts, filters, accessories, and consumables for your products.</p>
        </div>

        <div class="feature-card" style="text-align: center;">
          <div class="feature-icon" style="margin: 0 auto var(--spacing-md); background: linear-gradient(135deg, #f59e0b, #d97706);">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3m.08 4h.01"/></svg>
          </div>
          <h3>Troubleshooting</h3>
          <p style="color: var(--color-text-light);">Common issues and solutions for range hoods, gas stoves, ovens, air fryers, and water heaters.</p>
        </div>

        <div class="feature-card" style="text-align: center;">
          <div class="feature-icon" style="margin: 0 auto var(--spacing-md); background: linear-gradient(135deg, #ec4899, #db2777);">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          </div>
          <h3>Contact Support</h3>
          <p style="color: var(--color-text-light);">Reach our technical team for complex issues requiring expert assistance.</p>
        </div>

      </div>

      <!-- Common Issues -->
      <h2 style="text-align: center;">Common Troubleshooting Topics</h2>

      <div style="max-width: 800px; margin: var(--spacing-xl) auto 0; display: flex; flex-direction: column; gap: var(--spacing-md);">

        <details style="border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
          <summary style="font-weight: 600; cursor: pointer; color: var(--color-primary);">Range Hood — Not extracting smoke effectively</summary>
          <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">Check if the ducting is properly connected and not blocked. Ensure the correct extraction mode (ducted vs recirculating) is selected. Clean or replace the grease filter if it is saturated.</p>
        </details>

        <details style="border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
          <summary style="font-weight: 600; cursor: pointer; color: var(--color-primary);">Gas Stove — Burner won't ignite</summary>
          <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">Verify the gas supply is on and check the gas type matches the unit's specification. Clean the burner ports with a needle to remove blockages. Check the igniter electrode is clean and properly positioned.</p>
        </details>

        <details style="border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
          <summary style="font-weight: 600; cursor: pointer; color: var(--color-primary);">Oven — Uneven cooking results</summary>
          <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">Preheat the oven fully before use. Use the recommended rack position for the food type. Ensure proper spacing between items for air circulation. Calibrate temperature if consistently off.</p>
        </details>

        <details style="border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
          <summary style="font-weight: 600; cursor: pointer; color: var(--color-primary);">Air Fryer — Food not crispy enough</summary>
          <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">Do not overcrowd the basket — cook in batches. Lightly coat food with oil before cooking. Shake the basket halfway through cooking time. Increase temperature by 5-10°C if needed.</p>
        </details>

        <details style="border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-md); background: white;">
          <summary style="font-weight: 600; cursor: pointer; color: var(--color-primary);">Water Heater — No hot water output</summary>
          <p style="margin-top: var(--spacing-sm); color: var(--color-text-light); line-height: 1.7;">Check that the water and gas supplies are turned on. Verify the power source (batteries or electricity). Check if any error codes are displayed on the panel. Inspect the water pressure regulator.</p>
        </details>

      </div>

      <!-- CTA -->
      <div style="margin-top: var(--spacing-2xl); text-align: center;">
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-md);">Can't find what you need? Our support team is here to help.</p>
        <a href="/contact" class="btn btn-primary">Contact Technical Support →</a>
      </div>

    </div>
  </section>

  <Footer />
</Layout>
