---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';

const title = 'Contact HouseTech Group - B2B Kitchen Appliance Manufacturer | Get a Quote';
const description = 'Contact HouseTech Group for B2B kitchen appliance inquiries, OEM/ODM quotes, and factory visits. Professional export team ready to assist. Fast response within 24 hours. Range Hoods, Gas Stoves, Ovens, Air Fryers.';
---

<Layout title={title} description={description}>
  <Schema type="LocalBusiness" data={{
    name: 'HouseTech Group',
    description: 'B2B kitchen appliance manufacturer specializing in Range Hoods, Gas Stoves, Ovens, and Air Fryers',
    url: 'https://www.housetech-ch.com',
    telephone: '+86 137 0299 5368',
    email: 'sales@housetech-ch.com',
    address: {
      streetAddress: 'No. 888, Industrial Park, Xiaolan',
      addressLocality: 'Zhongshan',
      addressRegion: 'Guangdong',
      postalCode: '528415',
      addressCountry: 'CN'
    },
    openingHoursSpecification: {
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '08:30',
      closes: '18:00'
    },
    priceRange: '$$',
    areaServed: ['US', 'UK', 'DE', 'FR', 'AE', 'SA', 'AU', 'CA', 'BR', 'MX', 'IN', 'ID', 'TH', 'VN', 'PH', 'MY', 'SG', 'NG', 'ZA', 'EG', 'KE']
  }} />
  <Header activeNav="contact" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <p class="section-tag" style="display: inline-block; margin-bottom: var(--spacing-sm);">Get in Touch</p>
      <h1>Contact <span class="accent-word">HouseTech Group</span></h1>
      <p>Your trusted B2B kitchen appliance manufacturer awaits. Get quotes, discuss OEM/ODM projects, or schedule a factory visit.</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Contact Us</span>
      </nav>
    </div>
  </section>

  <!-- Content -->
  <section class="content-section">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-2xl);">

        <!-- Contact Info -->
        <div>
          <h2 style="margin-bottom: var(--spacing-md);">Get In Touch with HouseTech</h2>
          <p style="color: var(--color-text-light); margin-bottom: var(--spacing-xl); line-height: 1.7;">Whether you need a product quote, want to discuss OEM/ODM projects, or plan a factory visit, HouseTech Group's professional export team is ready to assist you within 24 hours.</p>

          <div style="display: flex; flex-direction: column; gap: var(--spacing-lg);">

            <div style="display: flex; gap: var(--spacing-md); align-items: flex-start;">
              <div style="width: 48px; height: 48px; border-radius: var(--radius-md); background: var(--color-accent-light); display: flex; align-items: center; justify-content: center; color: var(--color-accent); flex-shrink: 0;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div>
                <h3 style="font-size: var(--font-size-base); margin-bottom: 0.25rem;">Email</h3>
                <p style="color: var(--color-text-light); font-size: var(--font-size-sm);"><a href="mailto:sales@housetech-ch.com" style="color: var(--color-accent);">sales@housetech-ch.com</a> (Sales Inquiries)</p>
                <p style="color: var(--color-text-light); font-size: var(--font-size-sm);"><a href="mailto:info@housetech-ch.com" style="color: var(--color-accent);">info@housetech-ch.com</a> (General Inquiries)</p>
              </div>
            </div>

            <div style="display: flex; gap: var(--spacing-md); align-items: flex-start;">
              <div style="width: 48px; height: 48px; border-radius: var(--radius-md); background: #dcfce7; display: flex; align-items: center; justify-content: center; color: #16a34a; flex-shrink: 0;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
              </div>
              <div>
                <h3 style="font-size: var(--font-size-base); margin-bottom: 0.25rem;">WhatsApp / Phone</h3>
                <p style="color: var(--color-text-light); font-size: var(--font-size-sm);"><strong>Sales:</strong> <a href="https://wa.me/8613702995368" style="color: var(--color-accent);">+86 137 0299 5368</a></p>
                <p style="color: var(--color-text-light); font-size: var(--font-size-sm);"><strong>OEM Support:</strong> <a href="https://wa.me/8613702995368" style="color: var(--color-accent);">+86 137 0299 5368</a></p>
              </div>
            </div>

            <div style="display: flex; gap: var(--spacing-md); align-items: flex-start;">
              <div style="width: 48px; height: 48px; border-radius: var(--radius-md); background: #fef3c7; display: flex; align-items: center; justify-content: center; color: #d97706; flex-shrink: 0;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div>
                <h3 style="font-size: var(--font-size-base); margin-bottom: 0.25rem;">Business Hours</h3>
                <p style="color: var(--color-text-light); font-size: var(--font-size-sm);">Monday - Saturday</p>
                <p style="color: var(--color-text-light); font-size: var(--font-size-sm);">8:30 AM - 6:00 PM (CST / UTC+8)</p>
              </div>
            </div>

            <div style="display: flex; gap: var(--spacing-md); align-items: flex-start;">
              <div style="width: 48px; height: 48px; border-radius: var(--radius-md); background: #ede9fe; display: flex; align-items: center; justify-content: center; color: #7c3aed; flex-shrink: 0;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <h3 style="font-size: var(--font-size-base); margin-bottom: 0.25rem;">Factory Address</h3>
                <p style="color: var(--color-text-light); font-size: var(--font-size-sm);">No. 888, Industrial Park, Xiaolan, Zhongshan</p>
                <p style="color: var(--color-text-light); font-size: var(--font-size-sm);">Guangdong Province, P.R. China</p>
              </div>
            </div>

            <!-- Quick Response Promise -->
            <div style="background: linear-gradient(135deg, var(--color-primary) 0%, #1a365d 100%); color: white; padding: var(--spacing-lg); border-radius: var(--radius-lg); margin-top: var(--spacing-md);">
              <p style="font-weight: 600; margin-bottom: var(--spacing-xs);">⚡ Quick Response Promise</p>
              <p style="font-size: var(--font-size-sm); opacity: 0.9;">HouseTech Group guarantees response within 24 hours for all B2B inquiries. For urgent matters, contact us via WhatsApp directly.</p>
            </div>

          </div>
        </div>

        <!-- Contact Form -->
        <div>
          <div style="background: white; padding: var(--spacing-xl); border-radius: var(--radius-lg); border: 1px solid var(--color-border); box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
            <h2 style="margin-bottom: var(--spacing-lg);">Send Us a Message</h2>

            <form id="contactForm" style="display: flex; flex-direction: column; gap: var(--spacing-md);">
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-md);">
                <div>
                  <label for="firstName" style="display: block; font-size: var(--font-size-sm); font-weight: 600; margin-bottom: 0.35rem; color: var(--color-primary);">First Name *</label>
                  <input type="text" id="firstName" name="firstName" required placeholder="John" style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); font-family: inherit; font-size: var(--font-size-base);" />
                </div>
                <div>
                  <label for="lastName" style="display: block; font-size: var(--font-size-sm); font-weight: 600; margin-bottom: 0.35rem; color: var(--color-primary);">Last Name *</label>
                  <input type="text" id="lastName" name="lastName" required placeholder="Smith" style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); font-family: inherit; font-size: var(--font-size-base);" />
                </div>
              </div>

              <div>
                <label for="email" style="display: block; font-size: var(--font-size-sm); font-weight: 600; margin-bottom: 0.35rem; color: var(--color-primary);">Email Address *</label>
                <input type="email" id="email" name="email" required placeholder="john@company.com" style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); font-family: inherit; font-size: var(--font-size-base);" />
              </div>

              <div>
                <label for="country" style="display: block; font-size: var(--font-size-sm); font-weight: 600; margin-bottom: 0.35rem; color: var(--color-primary);">Country / Region *</label>
                <select id="country" name="country" required style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); font-family: inherit; font-size: var(--font-size-base); background: white;">
                  <option value="">Select country/region...</option>
                  <option value="US">United States</option>
                  <option value="UK">United Kingdom</option>
                  <option value="DE">Germany</option>
                  <option value="FR">France</option>
                  <option value="AE">United Arab Emirates</option>
                  <option value="SA">Saudi Arabia</option>
                  <option value="AU">Australia</option>
                  <option value="CA">Canada</option>
                  <option value="BR">Brazil</option>
                  <option value="MX">Mexico</option>
                  <option value="IN">India</option>
                  <option value="ID">Indonesia</option>
                  <option value="TH">Thailand</option>
                  <option value="VN">Vietnam</option>
                  <option value="PH">Philippines</option>
                  <option value="MY">Malaysia</option>
                  <option value="SG">Singapore</option>
                  <option value="NG">Nigeria</option>
                  <option value="ZA">South Africa</option>
                  <option value="EG">Egypt</option>
                  <option value="KE">Kenya</option>
                  <option value="OTHER">Other</option>
                </select>
              </div>

              <div>
                <label for="company" style="display: block; font-size: var(--font-size-sm); font-weight: 600; margin-bottom: 0.35rem; color: var(--color-primary);">Company Name</label>
                <input type="text" id="company" name="company" placeholder="Your Company Ltd." style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); font-family: inherit; font-size: var(--font-size-base);" />
              </div>

              <div>
                <label style="display: block; font-size: var(--font-size-sm); font-weight: 600; margin-bottom: 0.35rem; color: var(--color-primary);">Inquiry Type *</label>
                <select name="inquiryType" required style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); font-family: inherit; font-size: var(--font-size-base); background: white;">
                  <option value="">Select an option...</option>
                  <option value="quote">Product Quote Request</option>
                  <option value="oem">OEM / ODM Inquiry</option>
                  <option value="sample">Sample Request</option>
                  <option value="factory">Factory Visit</option>
                  <option value="partnership">Partnership Discussion</option>
                  <option value="support">Technical Support</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div>
                <label for="product" style="display: block; font-size: var(--font-size-sm); font-weight: 600; margin-bottom: 0.35rem; color: var(--color-primary);">Product Interest</label>
                <select id="product" name="product" style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); font-family: inherit; font-size: var(--font-size-base); background: white;">
                  <option value="">Select product category...</option>
                  <option value="range-hood">Range Hoods / Kitchen Hoods</option>
                  <option value="gas-stove">Gas Stoves & Built-in Hobs</option>
                  <option value="induction-cooker">Induction Cookers</option>
                  <option value="ceramic-cooker">Ceramic Cookers / Radiant Hobs</option>
                  <option value="oven">Built-in Ovens</option>
                  <option value="air-fryer">Air Fryers</option>
                  <option value="water-heater">Gas Water Heaters</option>
                  <option value="multiple">Multiple Categories</option>
                </select>
              </div>

              <div>
                <label for="message" style="display: block; font-size: var(--font-size-sm); font-weight: 600; margin-bottom: 0.35rem; color: var(--color-primary);">Message *</label>
                <textarea id="message" name="message" required rows="5" placeholder="Please describe your requirements including quantity, specifications, target market, certifications needed, etc." style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); font-family: inherit; font-size: var(--font-size-base); resize: vertical;"></textarea>
              </div>

              <div id="formStatus" style="display: none; padding: var(--spacing-md); border-radius: var(--radius-md); margin-bottom: var(--spacing-sm);"></div>

              <button type="submit" id="submitBtn" class="btn btn-primary" style="width: 100%; padding: 0.875rem;">Send Message to HouseTech</button>
              <p style="text-align: center; font-size: var(--font-size-xs); color: var(--color-text-light);">HouseTech Group typically responds within 24 business hours.</p>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section style="background: var(--color-bg-alt); padding: var(--spacing-2xl) 0;">
    <div class="container">
      <div class="section-header" style="margin-bottom: var(--spacing-xl);">
        <p class="section-tag">Location</p>
        <h2>HouseTech Factory Location</h2>
        <p>Visit our manufacturing facility in Zhongshan, Guangdong Province</p>
      </div>
      <div style="background: linear-gradient(135deg, #1a365d 0%, #2d3748 100%); border-radius: var(--radius-lg); padding: var(--spacing-4xl); text-align: center; min-height: 350px; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);">
        <div style="width: 80px; height: 80px; background: rgba(255,255,255,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: var(--spacing-lg);">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" style="opacity: 0.9;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3" fill="none"/></svg>
        </div>
        <p style="color: white; font-size: var(--font-size-xl); font-weight: 600; margin-bottom: var(--spacing-sm);">HouseTech Group Factory</p>
        <p style="color: rgba(255,255,255,0.8); font-size: var(--font-size-base); margin-bottom: var(--spacing-md);">No. 888, Industrial Park, Xiaolan, Zhongshan</p>
        <p style="color: rgba(255,255,255,0.6); font-size: var(--font-size-sm);">Guangdong Province, P.R. China</p>
        <div style="margin-top: var(--spacing-xl); display: flex; gap: var(--spacing-md); flex-wrap: wrap; justify-content: center;">
          <span style="background: rgba(255,255,255,0.1); padding: var(--spacing-xs) var(--spacing-md); border-radius: var(--radius-full); color: white; font-size: var(--font-size-xs);">30 min from Guangzhou</span>
          <span style="background: rgba(255,255,255,0.1); padding: var(--spacing-xs) var(--spacing-md); border-radius: var(--radius-full); color: white; font-size: var(--font-size-xs);">1 hour from Shenzhen</span>
          <span style="background: rgba(255,255,255,0.1); padding: var(--spacing-xs) var(--spacing-md); border-radius: var(--radius-full); color: white; font-size: var(--font-size-xs);">Factory Tours Available</span>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('contactForm') as HTMLFormElement;
      const formStatus = document.getElementById('formStatus');
      const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;

      if (form && formStatus && submitBtn) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();

          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending...';

          const formData = new FormData(form);
          const data = Object.fromEntries(formData.entries());

          console.log('Form submitted:', data);

          if (typeof gtag !== 'undefined') {
            gtag('event', 'generate_lead', {
              event_category: 'engagement',
              event_label: data.product as string || 'general',
              value: 1
            });
          }

          const mailtoLink = `mailto:sales@housetech-ch.com?subject=Inquiry from ${data.firstName} ${data.lastName} - ${data.company || 'N/A'}&body=Name: ${data.firstName} ${data.lastName}%0ACompany: ${data.company || 'N/A'}%0ACountry: ${data.country}%0AEmail: ${data.email}%0AProduct Interest: ${data.product || 'N/A'}%0A%0AMessage:%0A${data.message}`;

          window.location.href = mailtoLink;

          formStatus.style.display = 'block';
          formStatus.style.background = '#dcfce7';
          formStatus.style.color = '#166534';
          formStatus.innerHTML = '<strong>✓ Message prepared!</strong> Your email client should open. If not, please email us directly at <a href="mailto:sales@housetech-ch.com" style="color: #166534; text-decoration: underline;">sales@housetech-ch.com</a>';

          submitBtn.textContent = 'Send Message to HouseTech';
          submitBtn.disabled = false;

          form.reset();
        });
      }
    });
  </script>
</Layout>
