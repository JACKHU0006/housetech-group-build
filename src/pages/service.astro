---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Service - HouseTech Group | OEM/ODM, After-Sales, Technical Support';
const description = 'Comprehensive services from HouseTech Group: OEM/ODM customization, after-sales support, technical assistance, and global logistics for kitchen appliance B2B partners.';
---

<Layout title={title} description={description}>
  <Header activeNav="service" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>Our Services</h1>
      <p>End-to-end solutions for your kitchen appliance business needs</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Service</span>
      </nav>
    </div>
  </section>

  <!-- Content -->
  <section class="content-section">
    <div class="container">

      <div class="features-grid" style="margin-bottom: var(--spacing-3xl);">

        <div class="feature-card">
          <div class="feature-icon"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg></div>
          <h3>OEM / ODM Manufacturing</h3>
          <p><strong>OEM Services:</strong> Produce products under your brand with your specifications. We handle manufacturing while you focus on marketing and distribution.</p>
          <p style="margin-top: var(--spacing-sm);"><strong>ODM Services:</strong> Choose from our existing designs and customize them to fit your market needs — including appearance, features, and packaging.</p>
          <ul style="margin-top: var(--spacing-sm);">
            <li>Custom logo and branding</li>
            <li>Color and finish options</li>
            <li>Packaging design (retail & bulk)</li>
            <li>Product specification adjustments</li>
            <li>Certification support for target markets</li>
          </ul>
        </div>

        <div class="feature-card">
          <div class="feature-icon"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg></div>
          <h3>Product Customization</h3>
          <p>We offer flexible customization to meet diverse market requirements:</p>
          <ul style="margin-top: var(--spacing-sm);">
            <li>Size and dimension modifications</li>
            <li>Control panel design (mechanical, touch, digital)</li>
            <li>Voltage adaptation (110V, 220V, 240V)</li>
            <li>Gas type compatibility (LPG, NG, etc.)</li>
            <li>Language localization on controls and manuals</li>
            <li>Safety feature additions per regional requirements</li>
          </ul>
        </div>

        <div class="feature-card">
          <div class="feature-icon"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div>
          <h3>After-Sales Support</h3>
          <p>Our commitment extends beyond delivery:</p>
          <ul style="margin-top: var(--spacing-sm);">
            <li>Installation guides and video tutorials</li>
            <li>Technical troubleshooting assistance</li>
            <li>Spare parts supply (1-3 year availability guarantee)</li>
            <li>Warranty management support</li>
            <li>Remote diagnosis for technical issues</li>
            <li>On-site service coordination where available</li>
          </ul>
        </div>

        <div class="feature-card">
          <div class="feature-icon"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></div>
          <h3>R&D Partnership</h3>
          <p>Collaborate with our R&D team for innovative product development:</p>
          <ul style="margin-top: var(--spacing-sm);">
            <li>New product co-development projects</li>
            <li>Market-specific feature integration</li>
            <li>Prototype development and testing</li>
            <li>Technology licensing opportunities</li>
            <li>Patent collaboration programs</li>
          </ul>
        </div>

        <div class="feature-card">
          <div class="feature-icon"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13" rx="2" ry="2"/><path d="M16 8h4a2 2 0 012 2v9a2 2 0 01-2 2H8a2 2 0 01-2-2v-2"/></svg></div>
          <h3>Global Logistics</h3>
          <p>Hassle-free shipping worldwide:</p>
          <ul style="margin-top: var(--spacing-sm);">
            <li>FOB / CIF / EXW shipping terms available</li>
            <li>Multiple port options in China</li>
            <li>Consolidation services for mixed orders</li>
            <li>Export documentation handling</li>
            <li>Customs declaration support</li>
            <li>Door-to-door delivery options</li>
          </ul>
        </div>

        <div class="feature-card">
          <div class="feature-icon"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
          <h3>Certification Support</h3>
          <p>We help you meet regulatory requirements in any target market:</p>
          <ul style="margin-top: var(--spacing-sm);">
            <li>CE certification (Europe)</li>
            <li>CB scheme (international)</li>
            <li>ETL listing (North America)</li>
            <li>SASO / GCC (Middle East)</li>
            <li>Energy efficiency labeling</li>
            <li>Country-specific compliance guidance</li>
          </ul>
        </div>

      </div>

      <!-- CTA -->
      <div style="text-align: center; background: var(--color-accent-light); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm); color: var(--color-primary);">Discuss Your Requirements</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 500px; margin-left: auto; margin-right: auto;">Tell us about your project and we'll provide a customized solution proposal within 48 hours.</p>
        <a href="/contact" class="btn btn-primary">Contact Our Team →</a>
      </div>

    </div>
  </section>

  <Footer />
</Layout>
