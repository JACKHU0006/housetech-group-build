---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';

const title = 'Service - HouseTech Group | OEM/ODM, After-Sales, Technical Support';
const description = 'Comprehensive services from HouseTech Group: OEM/ODM customization, after-sales support, technical assistance, and global logistics for kitchen appliance B2B partners.';
---

<Layout title={title} description={description}>
  <Schema type="service" data={{
    name: 'OEM/ODM Customization Services',
    description: 'HouseTech Group provides comprehensive OEM and ODM services for kitchen appliance brands worldwide. Services include custom logo branding, color and finish options, specification adjustments, packaging design, and full product development support.',
    provider: {
      name: 'HouseTech Group',
      url: 'https://www.housetech-ch.com'
    },
    serviceType: 'Manufacturing Services',
    areaServed: ['Worldwide', 'Europe', 'Middle East', 'North America', 'Southeast Asia', 'Oceania'],
    availableChannel: ['Online', 'Email', 'Phone', 'Factory Visit'],
    priceRange: '$$$',
    termsOfService: 'https://www.housetech-ch.com/privacy',
    serviceOutput: 'Custom kitchen appliances including Range Hoods, Gas Stoves, Ovens, Air Fryers, and Water Heaters'
  }} />
  <Schema type="course" data={{
    name: 'HouseTech Product Training Program',
    description: 'Comprehensive training courses for HouseTech kitchen appliances including installation, maintenance, and troubleshooting. Learn from expert technicians with step-by-step video tutorials.',
    provider: {
      name: 'HouseTech Group',
      url: 'https://www.housetech-ch.com'
    },
    courseCode: 'HT-Training-001',
    educationalLevel: 'Professional',
    numberOfLessons: 12,
    duration: '8 hours',
    instructor: {
      name: 'HouseTech Technical Team'
    }
  }} />
  <Header activeNav="service" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>Our Services</h1>
      <p>End-to-end solutions for your kitchen appliance business needs</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Service</span>
      </nav>
    </div>
  </section>

  <!-- Content -->
  <section class="content-section">
    <div class="container">

      <div style="text-align: center; margin-bottom: var(--spacing-2xl);">
        <span class="section-tag">What We Offer</span>
        <h2 style="margin-top: var(--spacing-sm);">HouseTech Group Service Portfolio</h2>
        <p style="color: var(--color-text-light); max-width: 600px; margin: var(--spacing-md) auto 0;">From product design to global delivery, HouseTech Group provides comprehensive services tailored for international kitchen appliance brands.</p>
      </div>

      <div class="features-grid" style="margin-bottom: var(--spacing-3xl);">

        <div class="feature-card">
          <div class="feature-icon"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg></div>
          <span class="section-tag" style="margin-bottom: var(--spacing-sm);">Core Service</span>
          <h3>OEM / ODM Customization</h3>
          <p>HouseTech Group offers comprehensive OEM and ODM services for kitchen appliance brands worldwide. Customize your products with precision to match your market requirements.</p>
          <ul style="margin-top: var(--spacing-sm);">
            <li><strong>Custom Logo & Branding:</strong> Your brand identity on HouseTech quality products</li>
            <li><strong>Color & Finish Options:</strong> Wide range of colors, materials, and surface treatments</li>
            <li><strong>Specification Adjustments:</strong> Modify dimensions, power ratings, voltage, and features</li>
            <li><strong>Packaging Design:</strong> Retail packaging, bulk packaging, and gift box options</li>
          </ul>
        </div>

        <div class="feature-card">
          <div class="feature-icon"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
          <span class="section-tag" style="margin-bottom: var(--spacing-sm);">Quality</span>
          <h3>Quality Assurance</h3>
          <p>HouseTech Group's rigorous ISO9001-certified quality system guarantees every product meets the highest international standards through our 5-stage QC process.</p>
          <ul style="margin-top: var(--spacing-sm);">
            <li><strong>ISO9001 Certified Processes:</strong> Systematic quality management across all HouseTech production</li>
            <li><strong>Multi-Stage Testing:</strong> Incoming, in-process, and final product inspections</li>
            <li><strong>Function & Safety Testing:</strong> Every unit tested for performance and safety compliance</li>
            <li><strong>Certification Support:</strong> CE, CB, ETL, SASO, GCC and more for target markets</li>
          </ul>
        </div>

        <div class="feature-card">
          <div class="feature-icon"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13" rx="2" ry="2"/><path d="M16 8h4a2 2 0 012 2v9a2 2 0 01-2 2H8a2 2 0 01-2-2v-2"/></svg></div>
          <span class="section-tag" style="margin-bottom: var(--spacing-sm);">Logistics</span>
          <h3>Global Logistics</h3>
          <p>HouseTech Group handles worldwide shipping with flexible terms and comprehensive logistics support for kitchen appliance deliveries to any destination.</p>
          <ul style="margin-top: var(--spacing-sm);">
            <li><strong>DDP (Delivered Duty Paid):</strong> HouseTech arranges door-to-door delivery including customs clearance</li>
            <li><strong>FOB / CIF / EXW:</strong> Multiple shipping terms available per your preference</li>
            <li><strong>Multi-Port Options:</strong> Ship from major Chinese ports with consolidation services</li>
            <li><strong>Documentation Support:</strong> Commercial invoice, packing list, CO, BL handling</li>
          </ul>
        </div>

        <div class="feature-card">
          <div class="feature-icon"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div>
          <span class="section-tag" style="margin-bottom: var(--spacing-sm);">Support</span>
          <h3>After-Sales Support</h3>
          <p>HouseTech Group's commitment extends well beyond the point of delivery. We provide comprehensive after-sales services to protect your business and end customers.</p>
          <ul style="margin-top: var(--spacing-sm);">
            <li><strong>2-Year Warranty:</strong> Standard warranty with optional extension available</li>
            <li><strong>Spare Parts Supply:</strong> Guaranteed spare parts availability for 3+ years</li>
            <li><strong>Technical Documentation:</strong> Manuals, installation guides, and troubleshooting docs</li>
            <li><strong>Remote Assistance:</strong> Online diagnosis and support from HouseTech technicians</li>
          </ul>
        </div>

        <div class="feature-card">
          <div class="feature-icon"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
          <span class="section-tag" style="margin-bottom: var(--spacing-sm);">Certifications</span>
          <h3>Custom Certification Support</h3>
          <p>HouseTech Group assists international partners in obtaining all necessary certifications for their target markets, ensuring full regulatory compliance.</p>
          <ul style="margin-top: var(--spacing-sm);">
            <li><strong>CE (Europe):</strong> Full CE compliance testing and documentation for HouseTech products</li>
            <li><strong>ETL / UL (North America):</strong> ETL listed and UL recognized components for US/Canada markets</li>
            <li><strong>SASO / GCC (Middle East):</strong> SASO certification and GCC conformity for Saudi Arabia and Gulf states</li>
            <li><strong>CB Scheme:</strong> International CB certification facilitating multi-country approvals</li>
            <li><strong>Additional Markets:</strong> INMETRO (Brazil), PSE (Japan), and more available on request</li>
          </ul>
        </div>

        <div class="feature-card">
          <div class="feature-icon"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg></div>
          <span class="section-tag" style="margin-bottom: var(--spacing-sm);">Brand Solutions</span>
          <h3>Private Label / White Label</h3>
          <p>HouseTech Group offers private label and white label solutions for businesses looking to launch their own kitchen appliance brand without manufacturing complexity.</p>
          <ul style="margin-top: var(--spacing-sm);">
            <li><strong>White Label:</strong> HouseTech existing designs with your brand — fastest time to market</li>
            <li><strong>Private Label:</strong> Fully customized products built exclusively for your brand identity</li>
            <li><strong>MOQ Flexibility:</strong> Starting from 100 units for standard white label products</li>
            <li><strong>Full-Service Package:</strong> From design to delivery, HouseTech handles everything</li>
          </ul>
        </div>

      </div>

      <!-- CTA -->
      <div style="text-align: center; background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light)); padding: var(--spacing-2xl); border-radius: var(--radius-lg); color: white;">
        <h2 style="margin-bottom: var(--spacing-sm); color: white;">Discuss Your Requirements</h2>
        <p style="opacity: 0.85; margin-bottom: var(--spacing-lg); max-width: 500px; margin-left: auto; margin-right: auto;">Tell us about your project and HouseTech Group will provide a customized solution proposal within 48 hours.</p>
        <a href="/contact" class="btn btn-white">Contact HouseTech Team</a>
      </div>

    </div>
  </section>

  <Footer />
</Layout>
