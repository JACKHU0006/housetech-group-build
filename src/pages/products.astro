---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Products - HouseTech Group | Range Hoods, Gas Stoves, Ovens, Air Fryers, Water Heaters';
const description = 'Explore our complete range of kitchen appliances: Range Hoods, Gas Stoves/Hobs, Built-in Ovens, Air Fryers, and Gas Water Heaters. Factory direct B2B pricing available.';
---

<Layout title={title} description={description}>
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>Our Products</h1>
      <p>Comprehensive range of professional kitchen appliances for global B2B markets</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Products</span>
      </nav>
    </div>
  </section>

  <!-- Product Categories -->
  <section class="content-section">
    <div class="container">
      <div class="product-grid">

        <!-- Range Hoods -->
        <a href="/products/range-hood" class="product-card">
          <div class="product-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path d="M9 22V12h6v10"/></svg>
          </div>
          <h3>Range Hoods</h3>
          <p>Wall Mount Hood, Island Hood, Built-in Range Hood, Chimney Hood, Slim Hood, Stainless Steel Hood, Powerful Range Hood, Silent Range Hood, Energy Saving Hood, Ducted Hood, Ductless Hood, Kitchen Ventilation, Smoke Extractor, Oil Fume Extractor, Commercial Range Hood, Household Range Hood.</p>
          <span class="product-link">View All Models →</span>
        </a>

        <!-- Gas Stoves & Hobs -->
        <a href="/products/gas-stove" class="product-card">
          <div class="product-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M12 1v4m0 14v4M4.22 4.22l2.83 2.83m9.9 9.9l2.83 2.83M1 12h4m14 0h4M4.22 19.78l2.83-2.83m8.48-8.48l2.83-2.83"/></svg>
          </div>
          <h3>Gas Stoves & Hobs</h3>
          <p>Gas Stove, Built-in Hob, Gas Hob, Electric Hob, Ceramic Hob, Induction Hob, Built-in Stove, Countertop Stove, Stainless Steel Hob, 2 Burner Hob, 3 Burner Hob, 4 Burner Hob, 5 Burner Hob, Gas Cooker, Portable Gas Stove, Household Gas Stove, High Efficiency Stove, Safety Gas Stove.</p>
          <span class="product-link">View All Models →</span>
        </a>

        <!-- Ovens -->
        <a href="/products/oven" class="product-card">
          <div class="product-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          </div>
          <h3>Ovens</h3>
          <p>Built-in Oven, Electric Oven, Gas Oven, Convection Oven, Steam Oven, Multi-function Oven, Stainless Steel Oven, Large Capacity Oven, Home Baking Oven, Kitchen Oven, Built-in Electric Oven, Professional Oven.</p>
          <span class="product-link">View All Models →</span>
        </a>

        <!-- Air Fryers -->
        <a href="/products/air-fryer" class="product-card">
          <div class="product-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <h3>Air Fryers</h3>
          <p>Air Fryer, Digital Air Fryer, Electric Air Fryer, Oil Free Air Fryer, Large Air Fryer, Compact Air Fryer, Healthy Air Fryer, Multi-function Air Fryer, Home Air Fryer, Smart Air Fryer.</p>
          <span class="product-link">View All Models →</span>
        </a>

        <!-- Water Heaters -->
        <a href="/products/water-heater" class="product-card">
          <div class="product-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 8c0-2.76-2.24-5-5-5S7 5.24 7 8c0 1.88.94 3.54 2.38 4.53L9 19h6l-.38-6.47A5.99 5.99 0 0017 8z"/><path d="M9 20h6"/></svg>
          </div>
          <h3>Gas Water Heaters</h3>
          <p>Gas Heater, Instant Gas Heater, Gas Water Heater, Electric Water Heater, Instant Water Heater, Storage Water Heater, Household Water Heater, Energy Saving Heater, Tankless Water Heater.</p>
          <span class="product-link">View All Models →</span>
        </a>

      </div>

      <!-- OEM/ODM Section -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Need Custom Products?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">We offer full OEM/ODM services including custom design, logo branding, packaging, and product specifications tailored to your market requirements.</p>
        <a href="/service" class="btn btn-primary">Learn About OEM/ODM Services →</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
