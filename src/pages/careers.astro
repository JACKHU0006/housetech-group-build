---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Careers - HouseTech Group | Join Our Growing Team';
const description="Explore career opportunities at HouseTech Group. Join a leading kitchen appliance manufacturer with global impact and growth opportunities in Zhongshan, Guangdong.";
---

<Layout title={title} description={description}>
  <Header activeNav="" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>Careers</h1>
      <p>Build your future with HouseTech Group — a global leader in kitchen appliance manufacturing</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Careers</span>
      </nav>
    </div>
  </section>

  <!-- Content -->
  <section class="content-section">
    <div class="container">

      <div style="max-width: 700px; margin: 0 auto var(--spacing-2xl); text-align: center;">
        <span class="section-tag">Join Us</span>
        <h2 style="margin-top: var(--spacing-sm); margin-bottom: var(--spacing-sm);">Why Work at HouseTech Group?</h2>
        <p style="color: var(--color-text-light); line-height: 1.7;">Join a dynamic team at the forefront of kitchen appliance innovation. HouseTech Group offers competitive compensation, professional development opportunities, and a collaborative work environment where your contributions make a real difference across 50+ global markets.</p>
      </div>

      <!-- Benefits -->
      <div class="features-grid" style="margin-bottom: var(--spacing-3xl);">
        <div class="feature-card" style="text-align: center;">
          <div class="feature-icon" style="margin: 0 auto var(--spacing-md);">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
          </div>
          <h3>Competitive Salary</h3>
          <p>Above-market compensation packages based on experience and skills, with annual performance reviews and salary adjustments.</p>
        </div>
        <div class="feature-card" style="text-align: center;">
          <div class="feature-icon" style="margin: 0 auto var(--spacing-md); background: linear-gradient(135deg, #10b981, #059669);">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          </div>
          <h3>Growth Opportunities</h3>
          <p>Clear career paths and promotion opportunities within the HouseTech organization. Many team leaders started from entry-level positions.</p>
        </div>
        <div class="feature-card" style="text-align: center;">
          <div class="feature-icon" style="margin: 0 auto var(--spacing-md); background: linear-gradient(135deg, #f59e0b, #d97706);">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>
          </div>
          <h3>Training & Development</h3>
          <p>Continuous learning programs, skill enhancement opportunities, and professional certification support for all HouseTech employees.</p>
        </div>
        <div class="feature-card" style="text-align: center;">
          <div class="feature-icon" style="margin: 0 auto var(--spacing-md); background: linear-gradient(135deg, #ec4899, #db2777);">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M16.24 7.76l-2.12 6.36-6.36 2.12 2.12-6.36 6.36-2.12z"/></svg>
          </div>
          <h3>Global Exposure</h3>
          <p>Work with international clients and participate in global trade shows. HouseTech team members regularly attend Canton Fair, IFA, and other exhibitions worldwide.</p>
        </div>
      </div>

      <!-- Open Positions -->
      <div style="text-align: center; margin-bottom: var(--spacing-xl);">
        <span class="section-tag">Open Positions</span>
        <h2 style="margin-top: var(--spacing-sm);">Current Opportunities at HouseTech</h2>
      </div>

      <div style="display: flex; flex-direction: column; gap: var(--spacing-md); max-width: 850px; margin: 0 auto var(--spacing-3xl);">

        <!-- Senior R&D Engineer -->
        <details style="border: 1px solid var(--color-border); border-radius: var(--radius-md); background: white; overflow: hidden;">
          <summary style="padding: var(--spacing-lg); font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center; background: white;">
            <div>
              <h3 style="font-size: var(--font-size-base); color: var(--color-primary); margin: 0;">Senior R&D Engineer (Kitchen Appliances)</h3>
              <p style="color: var(--color-text-light); font-size: var(--font-size-sm); margin-top: 0.25rem;">R&D Department · Zhongshan, Guangdong · Full-time</p>
            </div>
            <span style="background: #dcfce7; color: #16a34a; padding: 0.25rem 0.75rem; border-radius: var(--radius-full); font-size: var(--font-size-xs); font-weight: 600; white-space: nowrap; margin-left: var(--spacing-md);">Open</span>
          </summary>
          <div style="padding: 0 var(--spacing-lg) var(--spacing-lg); border-top: 1px solid var(--color-border);">
            <p style="color: var(--color-text-light); line-height: 1.7; margin-top: var(--spacing-md);">Lead new product development projects for HouseTech kitchen appliances including range hoods, gas stoves, and ovens. Requires experience in product design, thermal dynamics, CAD software (SolidWorks/ProE), and understanding of kitchen appliance safety standards. You will work with HouseTech's 50+ engineering team on 20+ new models annually.</p>
            <p style="color: var(--color-text-light); font-size: var(--font-size-sm); margin-top: var(--spacing-sm);"><strong>Requirements:</strong> Bachelor's in Mechanical/Electrical Engineering, 5+ years product development experience, proficiency in 3D CAD, English communication skills.</p>
            <a href="mailto:careers@housetech-ch.com?subject=Application: Senior R&D Engineer" class="btn btn-primary btn-sm" style="margin-top: var(--spacing-md);">Apply via Email</a>
          </div>
        </details>

        <!-- International Sales Manager -->
        <details style="border: 1px solid var(--color-border); border-radius: var(--radius-md); background: white; overflow: hidden;">
          <summary style="padding: var(--spacing-lg); font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center; background: white;">
            <div>
              <h3 style="font-size: var(--font-size-base); color: var(--color-primary); margin: 0;">International Sales Manager</h3>
              <p style="color: var(--color-text-light); font-size: var(--font-size-sm); margin-top: 0.25rem;">Sales Department · Zhongshan, Guangdong · Full-time</p>
            </div>
            <span style="background: #dcfce7; color: #16a34a; padding: 0.25rem 0.75rem; border-radius: var(--radius-full); font-size: var(--font-size-xs); font-weight: 600; white-space: nowrap; margin-left: var(--spacing-md);">Open</span>
          </summary>
          <div style="padding: 0 var(--spacing-lg) var(--spacing-lg); border-top: 1px solid var(--color-border);">
            <p style="color: var(--color-text-light); line-height: 1.7; margin-top: var(--spacing-md);">Drive HouseTech Group's international sales growth across Europe, Middle East, and Southeast Asia markets. Develop new B2B partnerships, manage key accounts, and achieve annual sales targets. Requires proven track record in kitchen appliance or consumer electronics B2B sales with international experience.</p>
            <p style="color: var(--color-text-light); font-size: var(--font-size-sm); margin-top: var(--spacing-sm);"><strong>Requirements:</strong> 5+ years international B2B sales experience, fluent English (additional languages a plus), knowledge of export procedures, experience with trade shows.</p>
            <a href="mailto:careers@housetech-ch.com?subject=Application: International Sales Manager" class="btn btn-primary btn-sm" style="margin-top: var(--spacing-md);">Apply via Email</a>
          </div>
        </details>

        <!-- Quality Control Specialist -->
        <details style="border: 1px solid var(--color-border); border-radius: var(--radius-md); background: white; overflow: hidden;">
          <summary style="padding: var(--spacing-lg); font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center; background: white;">
            <div>
              <h3 style="font-size: var(--font-size-base); color: var(--color-primary); margin: 0;">Quality Control Specialist</h3>
              <p style="color: var(--color-text-light); font-size: var(--font-size-sm); margin-top: 0.25rem;">Quality Department · Zhongshan, Guangdong · Full-time</p>
            </div>
            <span style="background: #dcfce7; color: #16a34a; padding: 0.25rem 0.75rem; border-radius: var(--radius-full); font-size: var(--font-size-xs); font-weight: 600; white-space: nowrap; margin-left: var(--spacing-md);">Open</span>
          </summary>
          <div style="padding: 0 var(--spacing-lg) var(--spacing-lg); border-top: 1px solid var(--color-border);">
            <p style="color: var(--color-text-light); line-height: 1.7; margin-top: var(--spacing-md);">Ensure HouseTech products meet the highest quality standards through systematic inspection processes. Conduct incoming material inspections, in-process quality checks, and final product testing. Maintain ISO9001 compliance documentation and implement continuous improvement initiatives across HouseTech production lines.</p>
            <p style="color: var(--color-text-light); font-size: var(--font-size-sm); margin-top: var(--spacing-sm);"><strong>Requirements:</strong> ISO9001 experience, quality management knowledge, attention to detail, 2+ years QC experience in manufacturing. English reading for technical documentation.</p>
            <a href="mailto:careers@housetech-ch.com?subject=Application: Quality Control Specialist" class="btn btn-primary btn-sm" style="margin-top: var(--spacing-md);">Apply via Email</a>
          </div>
        </details>

        <!-- Industrial Designer -->
        <details style="border: 1px solid var(--color-border); border-radius: var(--radius-md); background: white; overflow: hidden;">
          <summary style="padding: var(--spacing-lg); font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center; background: white;">
            <div>
              <h3 style="font-size: var(--font-size-base); color: var(--color-primary); margin: 0;">Industrial Designer</h3>
              <p style="color: var(--color-text-light); font-size: var(--font-size-sm); margin-top: 0.25rem;">R&D Department · Zhongshan, Guangdong · Full-time</p>
            </div>
            <span style="background: #dcfce7; color: #16a34a; padding: 0.25rem 0.75rem; border-radius: var(--radius-full); font-size: var(--font-size-xs); font-weight: 600; white-space: nowrap; margin-left: var(--spacing-md);">Open</span>
          </summary>
          <div style="padding: 0 var(--spacing-lg) var(--spacing-lg); border-top: 1px solid var(--color-border);">
            <p style="color: var(--color-text-light); line-height: 1.7; margin-top: var(--spacing-md);">Shape the visual identity of HouseTech kitchen appliances — from concept sketches to production-ready designs. Create stunning product aesthetics that appeal to global markets while maintaining manufacturing feasibility. Collaborate with R&D and marketing to develop compelling product ranges for HouseTech's international brand partners.</p>
            <p style="color: var(--color-text-light); font-size: var(--font-size-sm); margin-top: var(--spacing-sm);"><strong>Requirements:</strong> Strong portfolio in industrial/product design, proficiency in Rhino, KeyShot, or similar, understanding of manufacturing processes, creative thinking.</p>
            <a href="mailto:careers@housetech-ch.com?subject=Application: Industrial Designer" class="btn btn-primary btn-sm" style="margin-top: var(--spacing-md);">Apply via Email</a>
          </div>
        </details>

        <!-- Production Supervisor -->
        <details style="border: 1px solid var(--color-border); border-radius: var(--radius-md); background: white; overflow: hidden;">
          <summary style="padding: var(--spacing-lg); font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center; background: white;">
            <div>
              <h3 style="font-size: var(--font-size-base); color: var(--color-primary); margin: 0;">Production Supervisor</h3>
              <p style="color: var(--color-text-light); font-size: var(--font-size-sm); margin-top: 0.25rem;">Production Department · Zhongshan, Guangdong · Full-time</p>
            </div>
            <span style="background: #dcfce7; color: #16a34a; padding: 0.25rem 0.75rem; border-radius: var(--radius-full); font-size: var(--font-size-xs); font-weight: 600; white-space: nowrap; margin-left: var(--spacing-md);">Open</span>
          </summary>
          <div style="padding: 0 var(--spacing-lg) var(--spacing-lg); border-top: 1px solid var(--color-border);">
            <p style="color: var(--color-text-light); line-height: 1.7; margin-top: var(--spacing-md);">Oversee daily operations of HouseTech production lines ensuring output targets, quality standards, and safety compliance. Manage teams of 30-50 workers, coordinate shift schedules, and drive production efficiency improvements. Work closely with QC and R&D departments to maintain HouseTech's 99.5%+ pass rate.</p>
            <p style="color: var(--color-text-light); font-size: var(--font-size-sm); margin-top: var(--spacing-sm);"><strong>Requirements:</strong> 3+ years production management experience, knowledge of lean manufacturing, leadership skills, ability to work in a fast-paced manufacturing environment.</p>
            <a href="mailto:careers@housetech-ch.com?subject=Application: Production Supervisor" class="btn btn-primary btn-sm" style="margin-top: var(--spacing-md);">Apply via Email</a>
          </div>
        </details>

        <!-- Marketing Specialist -->
        <details style="border: 1px solid var(--color-border); border-radius: var(--radius-md); background: white; overflow: hidden;">
          <summary style="padding: var(--spacing-lg); font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center; background: white;">
            <div>
              <h3 style="font-size: var(--font-size-base); color: var(--color-primary); margin: 0;">Marketing Specialist</h3>
              <p style="color: var(--color-text-light); font-size: var(--font-size-sm); margin-top: 0.25rem;">Marketing Department · Zhongshan / Remote · Full-time</p>
            </div>
            <span style="background: #dcfce7; color: #16a34a; padding: 0.25rem 0.75rem; border-radius: var(--radius-full); font-size: var(--font-size-xs); font-weight: 600; white-space: nowrap; margin-left: var(--spacing-md);">Open</span>
          </summary>
          <div style="padding: 0 var(--spacing-lg) var(--spacing-lg); border-top: 1px solid var(--color-border);">
            <p style="color: var(--color-text-light); line-height: 1.7; margin-top: var(--spacing-md);">Develop HouseTech Group's B2B marketing strategy and digital presence. Create content for trade shows, product catalogs, social media, and website. Support the sales team with marketing materials, case studies, and competitive analysis. Help position HouseTech as the premier kitchen appliance OEM/ODM partner globally.</p>
            <p style="color: var(--color-text-light); font-size: var(--font-size-sm); margin-top: var(--spacing-sm);"><strong>Requirements:</strong> Marketing or communications degree, 2+ years B2B marketing experience, strong writing skills in English, social media management, Photoshop/Canva proficiency.</p>
            <a href="mailto:careers@housetech-ch.com?subject=Application: Marketing Specialist" class="btn btn-primary btn-sm" style="margin-top: var(--spacing-md);">Apply via Email</a>
          </div>
        </details>

      </div>

      <!-- Application Note -->
      <div style="text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg); max-width: 850px; margin: 0 auto;">
        <h3 style="margin-bottom: var(--spacing-sm);">Don't See the Right Fit?</h3>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg);">Send your CV and a cover letter to <a href="mailto:careers@housetech-ch.com" style="color: var(--color-accent); font-weight: 600;">careers@housetech-ch.com</a> and let us know how you'd like to contribute to HouseTech Group. We are always interested in meeting talented individuals.</p>
        <a href="mailto:careers@housetech-ch.com" class="btn btn-dark">Send Your CV</a>
      </div>

    </div>
  </section>

  <Footer />
</Layout>
