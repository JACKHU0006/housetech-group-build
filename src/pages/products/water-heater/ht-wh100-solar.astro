---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'HT-WH100 Solar Water Heater - HouseTech Group | 100L Solar-Assisted, Photoelectric Dual-Use';
const description = 'HouseTech HT-WH100 Solar Water Heater: 100L capacity, solar-assisted with electric backup, photoelectric dual-use system, energy-saving and eco-friendly hot water solution.';

const product = {
  name: 'HT-WH100 Solar Water Heater',
  sku: 'HT-WH100',
  category: 'Water Heaters',
  price: 'Contact for Quote',
  image: '/images/products/water-heater/ht-wh100.jpg',
  shortDesc: '100L solar-assisted water heater with photoelectric dual-use system. Solar primary heating with electric backup ensures hot water availability in all weather conditions. Energy-efficient and environmentally friendly.',
  specs: {
    'Type': 'Solar-Assisted Water Heater',
    'Capacity': '100L',
    'Solar Collector': 'Evacuated Tube (18 tubes × Φ58 × 1800mm)',
    'Electric Backup Power': '1500W',
    'Voltage': '220-240V / 50Hz',
    'Mode': 'Photoelectric Dual-Use (Solar Primary + Electric Backup)',
    'Inner Tank Material': 'SUS304 Stainless Steel',
    'Insulation': 'Polyurethane Foam (50mm)',
    'Temperature Range': '40-80°C (Solar Mode)',
    'Max Temperature': '99°C',
    'Solar Absorption Rate': '≥92%',
    'Heat Loss Coefficient': '≤0.8W/(m²·K)',
    'Frame Material': 'Galvanized Steel (Anti-rust Coating)',
    'Hail Resistance': 'Φ25mm',
    'Wind Resistance': 'Level 10',
    'Installation': 'Roof-mounted',
    'Color': 'Silver / Dark Blue',
    'Gross Weight': '58kg',
    'Product Dimensions': 'Φ580 × 1580mm (Tank) / 2100 × 1700mm (Collector)'
  },
  features: [
    '100L capacity meets hot water needs for 4-5 person families',
    'Evacuated tube solar collector with ≥92% absorption rate',
    'Photoelectric dual-use ensures hot water in all weather',
    '1500W electric backup for cloudy days and peak demand',
    '50mm thick PU foam insulation minimizes overnight heat loss',
    'SUS304 stainless steel inner tank for corrosion resistance',
    'Galvanized steel frame with anti-rust coating for outdoor durability',
    'Hail-resistant evacuated tubes (Φ25mm impact resistance)',
    'Wind-resistant design rated for Level 10 storms',
    'Zero running cost in solar mode — significant energy savings'
  ],
  applications: [
    'Residential rooftop installations',
    'Villa and townhouse hot water systems',
    'Rural household hot water supply',
    'Eco-friendly housing projects',
    'Small hotel and guesthouse facilities'
  ]
};

const relatedProducts = [
  { name: 'HT-WH60 Electric Water Heater', slug: '/products/water-heater/ht-wh60-electric', sku: 'HT-WH60' },
  { name: 'HT-WH80 Instant Water Heater', slug: '/products/water-heater/ht-wh80-instant', sku: 'HT-WH80' },
  { name: 'HT-WH Mini Kitchen Water Heater', slug: '/products/water-heater/ht-wh-mini', sku: 'HT-WH-Mini' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": "https://housetech-ch.com/images/products/water-heater/ht-wh100.jpg",
    "description": description,
    "brand": { "@type": "Brand", "name": "HouseTech" },
    "manufacturer": { "@type": "Organization", "name": "HouseTech Group" },
    "sku": product.sku,
    "category": "Water Heaters",
    "offers": { "@type": "AggregateOffer", "priceCurrency": "USD", "lowPrice": "0", "highPrice": "0", "offerCount": "1", "availability": "https://schema.org/InStock" }
  })} />
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the warranty period for HT-WH100 Solar Water Heater?", "acceptedAnswer": { "@type": "Answer", "Text": "All HouseTech products come with a comprehensive warranty. The HT-WH100 includes a 2-year manufacturer warranty covering defects in materials and workmanship." } },
      { "@type": "Question", "name": "Does HouseTech offer OEM/ODM customization for the HT-WH100?", "acceptedAnswer": { "@type": "Answer", "Text": "Yes, HouseTech offers full OEM/ODM services including custom logo branding and packaging design." } },
      { "@type": "Question", "name": "What certifications does the HT-WH100 have?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-WH100 is certified with CE, CB, and SASO standards, meeting safety requirements for global markets." } },
      { "@type": "Question", "name": "What is the delivery time for HT-WH100 orders?", "acceptedAnswer": { "@type": "Answer", "Text": "Standard delivery time is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days." } },
      { "@type": "Question", "name": "Does the HT-WH100 work on cloudy days?", "acceptedAnswer": { "@type": "Answer", "Text": "Yes, the HT-WH100 features photoelectric dual-use with 1500W electric backup to ensure hot water availability even on cloudy days." } }
    ]
  })} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>{product.name}</h1>
      <p>SKU: {product.sku}</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <a href="/products/water-heater">Water Heaters</a>
        <span class="separator">/</span>
        <span>{product.name}</span>
      </nav>
    </div>
  </section>

  <!-- Product Detail -->
  <section class="content-section">
    <div class="container">
      <div class="product-detail-grid">
        <!-- Gallery -->
        <div class="product-gallery">
          <div class="product-gallery-main">
            <img src={product.image} alt={product.name} />
          </div>
          <div class="product-gallery-thumbs">
            <div class="product-thumb active">
              <img src={product.image} alt={`${product.name} - Main View`} />
            </div>
          </div>
        </div>

        <!-- Product Info -->
        <div class="product-info">
          <h1>{product.name}</h1>
          <p class="product-sku">SKU: {product.sku} | Category: {product.category}</p>
          <p class="product-short-desc">{product.shortDesc}</p>
          <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Engineered by HouseTech, the HT-WH100 Solar harnesses solar energy for eco-friendly water heating. As part of HouseTech's sustainable water heater lineup, it reduces energy costs while delivering reliable hot water. Every HouseTech product is CE/CB certified.</p>

          <!-- Specs Table -->
          <table class="product-specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr>
                  <th>{key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <!-- CTA Area -->
          <div class="product-cta-area">
            <a href="/contact" class="btn btn-primary">Get Quote</a>
            <a href="/download" class="btn btn-outline">Download Spec Sheet</a>
          </div>
        </div>
      </div>

      <!-- Features Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Key Features
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
          {product.features.map((feature) => (
            <div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="color: var(--color-text);">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Applications Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Applications
        </h2>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
          {product.applications.map((app) => (
            <span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">
              {app}
            </span>
          ))}
        </div>
      </div>

      <!-- Why Choose HouseTech -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p>
        <a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a>
      </div>

      <!-- Related Products -->
      <div class="related-products">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Related Products
        </h2>
        <div class="news-grid">
          {relatedProducts.map((rel) => (
            <a href={rel.slug} class="news-card">
              <div class="news-card-body">
                <h3>{rel.name}</h3>
                <p>SKU: {rel.sku}</p>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
