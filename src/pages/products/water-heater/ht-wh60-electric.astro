---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Schema from '../../../components/Schema.astro';

const title = 'HT-WH60 Electric Water Heater - HouseTech Group | 60L Storage Water Heater, 2000W, IPX4';
const description = 'HouseTech HT-WH60 Electric Water Heater: 60L storage capacity, 2000W heating element, IPX4 waterproof rating, digital temperature display. Reliable hot water solution for family bathrooms.';

const product = {
  name: 'HT-WH60 Electric Water Heater',
  sku: 'HT-WH60',
  category: 'Water Heaters',
  price: 'Contact for Quote',
  image: '/images/products/water-heater/ht-wh60.jpg',
  shortDesc: '60L storage electric water heater with 2000W heating element, IPX4 waterproof rating, digital temperature display, and enameled inner tank. Provides consistent hot water for family bathrooms.',
  specs: {
    'Type': 'Storage Water Heater',
    'Capacity': '60L',
    'Power': '2000W',
    'Voltage': '220-240V / 50Hz',
    'Heating Element': 'Incoloy 840 Alloy',
    'Inner Tank Material': 'Enameled Steel',
    'Insulation': 'PU Foam (35mm)',
    'Waterproof Rating': 'IPX4',
    'Temperature Range': '30-75°C',
    'Control Type': 'Digital Display',
    'Max Pressure': '0.8MPa',
    'Rated Pressure': '0.6MPa',
    'Safety Valve': 'Yes (0.7MPa)',
    'Anti-corrosion': 'Magnesium Anode Rod',
    'Installation': 'Wall-mounted (Vertical)',
    'Inlet/Outlet': 'G1/2"',
    'Standby Power Loss': '≤0.6kW·h/24h',
    'Color': 'White',
    'Gross Weight': '22kg',
    'Product Dimensions': 'Φ410 × 820mm'
  },
  features: [
    '60L capacity suitable for 3-4 person families',
    '2000W fast heating with Incoloy 840 alloy element',
    'IPX4 waterproof rating for safe bathroom installation',
    'Digital temperature display with precise control',
    'Enameled steel inner tank for superior corrosion resistance',
    '35mm PU foam insulation reduces standby heat loss',
    'Magnesium anode rod for active anti-corrosion protection',
    'Safety valve prevents excessive pressure build-up',
    'Over-temperature and dry-heating protection',
    'Wall-mounted vertical design saves floor space'
  ],
  applications: [
    'Family bathroom hot water supply',
    'Residential apartment bathrooms',
    'Hotel guest room bathrooms',
    'Small commercial washrooms',
    'Elderly care facilities'
  ]
};

const relatedProducts = [
  { name: 'HT-WH80 Instant Water Heater', slug: '/products/water-heater/ht-wh80-instant', sku: 'HT-WH80' },
  { name: 'HT-WH100 Solar Water Heater', slug: '/products/water-heater/ht-wh100-solar', sku: 'HT-WH100' },
  { name: 'HT-WH Mini Kitchen Water Heater', slug: '/products/water-heater/ht-wh-mini', sku: 'HT-WH-Mini' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema with ImageObject -->
  <Schema type="product" data={{
    name: product.name,
    description: description,
    image: [`https://www.housetech-ch.com${product.image}`],
    brand: 'HouseTech',
    model: product.sku,
    certifications: ['CE', 'CB', 'ETL', 'SASO', 'ISO9001'],
    price: 'Contact for Quote',
    currency: 'USD'
  }} />
  <!-- Image Gallery Schema -->
  <Schema type="imageGallery" data={{
    images: [{
      url: `https://www.housetech-ch.com${product.image}`,
      caption: `${product.name} - ${product.shortDesc}`,
      width: 800,
      height: 600
    }],
    mainEntityOfPage: `https://www.housetech-ch.com/products/water-heater/ht-wh60-electric`
  }} />
  <!-- FAQPage Schema -->
  <Schema type="faq" data={{
    items: [
      {
        question: 'What is the warranty period for HT-WH60 Electric Water Heater?',
        answer: 'All HouseTech products come with a comprehensive warranty. The HT-WH60 includes a 2-year manufacturer warranty covering defects in materials and workmanship.'
      },
      {
        question: 'Does HouseTech offer OEM/ODM customization for the HT-WH60?',
        answer: 'Yes, HouseTech offers full OEM/ODM services including custom logo branding, capacity options, and packaging design.'
      },
      {
        question: 'What certifications does the HT-WH60 have?',
        answer: 'The HT-WH60 is certified with CE, CB, ETL, and SASO standards, meeting safety requirements for European, Asian, Middle Eastern, and North American markets.'
      },
      {
        question: 'What safety features does the HT-WH60 include?',
        answer: 'The HT-WH60 includes IPX4 waterproof rating, over-temperature protection, dry-heating protection, safety valve, and magnesium anode rod for anti-corrosion.'
      },
      {
        question: 'What is the delivery time for HT-WH60 orders?',
        answer: 'Standard delivery time is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days.'
      }
    ]
  }} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>{product.name}</h1>
      <p>SKU: {product.sku}</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <a href="/products/water-heater">Water Heaters</a>
        <span class="separator">/</span>
        <span>{product.name}</span>
      </nav>
    </div>
  </section>

  <!-- Product Detail -->
  <section class="content-section">
    <div class="container">
      <div class="product-detail-grid">
        <!-- Gallery -->
        <div class="product-gallery">
          <div class="product-gallery-main">
            <img src={product.image} alt={product.name} />
          </div>
          <div class="product-gallery-thumbs">
            <div class="product-thumb active">
              <img src={product.image} alt={`${product.name} - Main View`} />
            </div>
          </div>
        </div>

        <!-- Product Info -->
        <div class="product-info">
          <h1>{product.name}</h1>
          <p class="product-sku">SKU: {product.sku} | Category: {product.category}</p>
          <p class="product-short-desc">{product.shortDesc}</p>
          <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Engineered by HouseTech, the HT-WH60 is a 60L electric storage water heater with energy-saving insulation. As part of HouseTech's water heater lineup, it provides consistent hot water for families. Every HouseTech product is CE/CB certified.</p>

          <!-- Specs Table -->
          <table class="product-specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr>
                  <th>{key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <!-- CTA Area -->
          <div class="product-cta-area">
            <a href="/contact" class="btn btn-primary">Get Quote</a>
            <a href="/download" class="btn btn-outline">Download Spec Sheet</a>
          </div>
        </div>
      </div>

      <!-- Features Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Key Features
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
          {product.features.map((feature) => (
            <div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="color: var(--color-text);">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Applications Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Applications
        </h2>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
          {product.applications.map((app) => (
            <span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">
              {app}
            </span>
          ))}
        </div>
      </div>

      <!-- Why Choose HouseTech -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p>
        <a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a>
      </div>

      <!-- Related Products -->
      <div class="related-products">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Related Products
        </h2>
        <div class="news-grid">
          {relatedProducts.map((rel) => (
            <a href={rel.slug} class="news-card">
              <div class="news-card-body">
                <h3>{rel.name}</h3>
                <p>SKU: {rel.sku}</p>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
