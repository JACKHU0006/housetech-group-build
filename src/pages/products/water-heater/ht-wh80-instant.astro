---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'HT-WH80 Instant Water Heater - HouseTech Group | Tankless Water Heater, 6500W, Constant Temperature';
const description = 'HouseTech HT-WH80 Instant Water Heater: tankless design, 6500W instant heating, constant temperature technology, LED display. On-demand hot water without waiting.';

const product = {
  name: 'HT-WH80 Instant Water Heater',
  sku: 'HT-WH80',
  category: 'Water Heaters',
  price: 'Contact for Quote',
  image: '/images/products/water-heater/ht-wh80.jpg',
  shortDesc: 'Tankless instant water heater with 6500W rapid heating, constant temperature technology, LED display, and compact design. Provides on-demand hot water without preheating wait time.',
  specs: {
    'Type': 'Instant (Tankless) Water Heater',
    'Power': '6500W',
    'Voltage': '220-240V / 50Hz',
    'Heating Element': 'Copper Heating Tube',
    'Waterproof Rating': 'IPX4',
    'Temperature Range': '30-55°C',
    'Temperature Control': 'Constant Temperature Technology',
    'Control Type': 'Touch + LED Display',
    'Flow Rate': '3-5L/min',
    'Min Activation Flow': '1.5L/min',
    'Max Pressure': '0.6MPa',
    'Safety Features': 'Dry-heating Protection, Over-temperature Protection, Leakage Protection',
    'Inner Material': 'Stainless Steel Chamber',
    'Installation': 'Wall-mounted',
    'Inlet/Outlet': 'G1/2"',
    'Wire Requirement': '≥4mm² Copper Wire',
    'Color': 'White / Silver',
    'Gross Weight': '4.5kg',
    'Product Dimensions': '340 × 220 × 80mm'
  },
  features: [
    '6500W instant heating for on-demand hot water',
    'No tank required — saves valuable bathroom space',
    'Constant temperature technology maintains stable water temperature',
    'LED digital display shows real-time temperature',
    'Copper heating tube for efficient heat transfer and durability',
    'Dry-heating protection prevents element damage',
    'Over-temperature auto shut-off for safety',
    'Built-in leakage protection device (RCCB)',
    'Compact design ideal for small bathrooms',
    'Stainless steel heating chamber resists scale buildup'
  ],
  applications: [
    'Modern apartment bathrooms',
    'Small bathroom renovations',
    'En-suite shower rooms',
    'Kitchen sink hot water supply',
    'Commercial washroom facilities'
  ]
};

const relatedProducts = [
  { name: 'HT-WH60 Electric Water Heater', slug: '/products/water-heater/ht-wh60-electric', sku: 'HT-WH60' },
  { name: 'HT-WH100 Solar Water Heater', slug: '/products/water-heater/ht-wh100-solar', sku: 'HT-WH100' },
  { name: 'HT-WH Mini Kitchen Water Heater', slug: '/products/water-heater/ht-wh-mini', sku: 'HT-WH-Mini' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": "https://housetech-ch.com/images/products/water-heater/ht-wh80.jpg",
    "description": description,
    "brand": { "@type": "Brand", "name": "HouseTech" },
    "manufacturer": { "@type": "Organization", "name": "HouseTech Group" },
    "sku": product.sku,
    "category": "Water Heaters",
    "offers": { "@type": "AggregateOffer", "priceCurrency": "USD", "lowPrice": "0", "highPrice": "0", "offerCount": "1", "availability": "https://schema.org/InStock" }
  })} />
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the warranty period for HT-WH80 Instant Water Heater?", "acceptedAnswer": { "@type": "Answer", "Text": "All HouseTech products come with a comprehensive warranty. The HT-WH80 includes a 2-year manufacturer warranty covering defects in materials and workmanship." } },
      { "@type": "Question", "name": "Does HouseTech offer OEM/ODM customization for the HT-WH80?", "acceptedAnswer": { "@type": "Answer", "Text": "Yes, HouseTech offers full OEM/ODM services including custom logo branding and packaging design." } },
      { "@type": "Question", "name": "What certifications does the HT-WH80 have?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-WH80 is certified with CE, CB, ETL, and SASO standards, meeting safety requirements for global markets." } },
      { "@type": "Question", "name": "What is the delivery time for HT-WH80 orders?", "acceptedAnswer": { "@type": "Answer", "Text": "Standard delivery time is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days." } },
      { "@type": "Question", "name": "What safety features does the HT-WH80 include?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-WH80 includes dry-heating protection, over-temperature protection, leakage protection, and IPX4 waterproof rating." } }
    ]
  })} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>{product.name}</h1>
      <p>SKU: {product.sku}</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <a href="/products/water-heater">Water Heaters</a>
        <span class="separator">/</span>
        <span>{product.name}</span>
      </nav>
    </div>
  </section>

  <!-- Product Detail -->
  <section class="content-section">
    <div class="container">
      <div class="product-detail-grid">
        <!-- Gallery -->
        <div class="product-gallery">
          <div class="product-gallery-main">
            <img src={product.image} alt={product.name} />
          </div>
          <div class="product-gallery-thumbs">
            <div class="product-thumb active">
              <img src={product.image} alt={`${product.name} - Main View`} />
            </div>
          </div>
        </div>

        <!-- Product Info -->
        <div class="product-info">
          <h1>{product.name}</h1>
          <p class="product-sku">SKU: {product.sku} | Category: {product.category}</p>
          <p class="product-short-desc">{product.shortDesc}</p>
          <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Engineered by HouseTech, the HT-WH80 is a high-performance instant gas water heater with digital temperature control. As part of HouseTech's premium water heater lineup, it delivers reliable hot water for large households. Every HouseTech product is CE/CB certified.</p>

          <!-- Specs Table -->
          <table class="product-specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr>
                  <th>{key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <!-- CTA Area -->
          <div class="product-cta-area">
            <a href="/contact" class="btn btn-primary">Get Quote</a>
            <a href="/download" class="btn btn-outline">Download Spec Sheet</a>
          </div>
        </div>
      </div>

      <!-- Features Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Key Features
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
          {product.features.map((feature) => (
            <div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="color: var(--color-text);">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Applications Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Applications
        </h2>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
          {product.applications.map((app) => (
            <span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">
              {app}
            </span>
          ))}
        </div>
      </div>

      <!-- Why Choose HouseTech -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p>
        <a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a>
      </div>

      <!-- Related Products -->
      <div class="related-products">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Related Products
        </h2>
        <div class="news-grid">
          {relatedProducts.map((rel) => (
            <a href={rel.slug} class="news-card">
              <div class="news-card-body">
                <h3>{rel.name}</h3>
                <p>SKU: {rel.sku}</p>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
