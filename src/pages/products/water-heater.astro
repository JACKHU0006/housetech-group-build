      'Constant temperature control',
      'Built-in CO (carbon monoxide) alarm',
      'Electronic ignition system',
      'Energy efficient - only heats water when needed',
      'Compact wall-mount design',
      'Overheat protection',
      'Anti-freeze function for cold climates'
    ],
    applications: [
      'Family bathrooms',
      'Kitchen use',
      'Shower systems',
      'Multiple outlet use'
    ]
  },
  {
    name: 'HT-WH20 High Efficiency Gas Heater',
    slug: 'ht-wh20-high-efficiency',
    sku: 'HT-WH20',
    category: 'Water Heaters',
    shortDesc: '20L high efficiency gas water heater with low NOx emissions technology.',
    image: '/images/products/water-heater/ht-wh20.jpg',
    specs: {
      'Type': 'High Efficiency',
      'Capacity': '20L/min',
      'Control': 'Digital Touch',
      'Emissions': 'Low NOx',
      'Efficiency': 'Class A',
      'Dimensions': '58 x 38 x 18cm',
      'Gas Type': 'Natural Gas / LPG'
    },
    features: [
      '20L/min high flow rate',
      'Low NOx emission technology',
      'Environmentally friendly',
      'Digital temperature control',
      'LED display for easy monitoring',
      'Auto-diagnosis system',
      'Quiet operation',
      'Long-lasting heat exchanger'
    ],
    applications: [
      'Large households',
      'Commercial use',
      'Multiple bathrooms',
      'High water demand'
    ]
  },
  {
    name: 'WH-EH50 Electric Storage Heater',
    slug: 'wh-eh50-electric',
    sku: 'WH-EH50',
    category: 'Water Heaters',
    shortDesc: '50L electric storage water heater with programmable timer function.',
    image: '/images/products/water-heater/wh-eh50.jpg',
    specs: {
      'Type': 'Storage Electric',
      'Capacity': '50L',
      'Control': 'Digital Timer',
      'Heating': 'Electric Heating Element',
      'Timer': '24-Hour Programmable',
      'Dimensions': '45 x 45 x 65cm',
      'Pressure': '0.8MPa'
    },
    features: [
      '50L storage capacity',
      '24-hour programmable timer',
      'Dual heating modes (normal/eco)',
      'Temperature display',
      'Safety valve included',
      'Enamel-coated tank for durability',
      'Foam insulation for energy saving',
      'Compact floor-standing design'
    ],
    applications: [
      'Apartments',
      'Remote locations without gas',
      'Backup hot water',
      'Off-grid living'
    ]
  },
  {
    name: 'HT-WH12 Compact Gas Water Heater',
    slug: 'ht-wh12-compact',
    sku: 'HT-WH12',
    category: 'Water Heaters',
    shortDesc: '12L compact instant gas water heater perfect for small apartments.',
    image: '/images/products/water-heater/ht-wh12.jpg',
    specs: {
      'Type': 'Compact Instant',
      'Capacity': '12L/min',
      'Control': 'Knob Control',
      'Dimensions': '45 x 28 x 12cm',
      'Gas Type': 'LPG (Propane)',
      'Ignition': 'Battery Ignition'
    },
    features: [
      'Compact 12L size',
      'Perfect for small spaces',
      'LPG compatible - ideal for apartments',
      'Simple knob control',
      'Battery-powered ignition',
      'Lightweight design',
      'Easy wall mounting',
      'Affordable solution'
    ],
    applications: [
      'Small apartments',
      'RVs and boats',
      'Rental properties',
      'Point-of-use heating'
    ]
