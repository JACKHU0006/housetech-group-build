---

<Layout title={title} description={description}>
  <!-- BreadcrumbList Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://housetech-ch.com/" },
      { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://housetech-ch.com/products/" },
      { "@type": "ListItem", "position": 3, "name": "Water Heaters", "item": "https://housetech-ch.com/products/water-heater/" }
    ]
  })} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>Gas Water Heaters</h1>
      <p>Hot water solutions - Gas Heaters, Instant Gas Heaters, Gas Water Heaters, Electric Water Heaters, Instant Water Heaters, Storage Water Heaters, Tankless Water Heaters, Energy Saving Heaters</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <span>Gas Water Heaters</span>
      </nav>
    </div>
  </section>

  <!-- Category Introduction -->
  <section class="content-section">
    <div class="container">
      <div style="max-width: 900px; margin: 0 auto;">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-md);">
          Premium Water Heaters by HouseTech Group
        </h2>
        <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">
          HouseTech Group is a leading water heater manufacturer offering comprehensive hot water solutions for global B2B partners. Our water heater collection includes Tankless Gas Water Heaters, High Efficiency Gas Heaters, Electric Storage Heaters, and Compact Instant Heaters designed for residential and commercial applications. As an experienced OEM/ODM factory, we provide custom manufacturing services including capacity options, control systems, safety features, and branding.
        </p>
        <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-lg);">
          HouseTech's tankless gas water heaters provide endless hot water on demand, heating water only when needed for maximum energy efficiency. Features include constant temperature control, CO safety alarms, low NOx emissions, and digital displays. From compact 12L models for single apartments to powerful 20L units for large households, HouseTech has the perfect water heating solution for every application. Every HouseTech water heater is tested to meet international safety standards.
        </p>
      </div>

      <!-- Products Grid -->
      <div class="news-grid" style="margin-top: var(--spacing-2xl);">
        {products.map((product) => (
          <a href={`/products/water-heater/${product.slug}`} class="news-card">
            <div class="news-card-image">
              <img src={product.image} alt={product.name} loading="lazy" />
              <span class="news-card-category">{product.category}</span>
            </div>
            <div class="news-card-body">
              <h3>{product.name}</h3>
              <p>{product.shortDesc}</p>
              <div class="news-card-meta">
                <span>SKU: {product.sku}</span>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- OEM/ODM Section -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Need Custom Water Heaters?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">
          HouseTech Group offers full OEM/ODM services for water heaters including custom capacities, heating technologies, control systems, and branding options. Contact us to discuss your requirements.
        </p>
        <a href="/service" class="btn btn-primary">Learn About OEM/ODM Services →</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>