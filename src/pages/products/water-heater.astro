---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = 'Gas Water Heaters - HouseTech Group | Instant Gas Heater, Tankless Water Heater Manufacturer';
const description = 'Discover HouseTech Group\'s premium water heater collection: Instant Gas Water Heaters, Tankless Water Heaters, Storage Water Heaters, Electric Water Heaters. OEM/ODM available for global B2B partners.';

// Products data
const products = [
  {
    name: 'HT-WH16 Tankless Gas Water Heater',
    slug: 'ht-wh16-tankless',
    sku: 'HT-WH16',
    category: 'Water Heaters',
    shortDesc: '16L instant tankless gas water heater with constant temperature control and CO alarm.',
    image: '/images/products/water-heater/ht-wh16.jpg',
    specs: {
      'Type': 'Tankless / Instant',
      'Capacity': '16L/min',
      'Control': 'Digital Display',
      'Features': 'Constant Temp, CO Alarm',
      'Ignition': 'Electronic Ignition',
      'Dimensions': '52 x 33 x 15cm',
      'Gas Type': 'Natural Gas / LPG'
