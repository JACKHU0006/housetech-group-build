---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'HT-PGH2 Portable Gas Stove - HouseTech Group | Outdoor Gas Stove, Camping Stove';
const description = 'HouseTech HT-PGH2 Portable Gas Stove: Compact dual burner design, butane/propane compatible. Perfect for outdoor cooking, camping, and food trucks.';

// Product data
const product = {
  name: 'HT-PGH2 Portable Gas Stove',
  sku: 'HT-PGH2',
  category: 'Gas Stoves & Hobs',
  price: 'Contact for Quote',
  image: '/images/products/gas-stove/ht-pgh2.jpg',
  shortDesc: 'Compact portable gas stove with dual burners. Perfect for outdoor cooking, camping, and temporary cooking setups.',
  specs: {
    'Type': 'Portable Gas Stove',
    'Burners': '2',
    'Fuel Type': 'Butane / Propane',
    'Control Type': 'Knob Control',
    'Ignition': 'Piezo Ignition',
    'Dimensions': '65 x 35cm',
    'Weight': '3.5kg',
    'Finish': 'Stainless Steel',
    'Pressure': '28-30mbar',
    'Gross Weight': '4.5kg'
  },
  features: [
    'Compact and portable design',
    'Dual burner for versatile cooking',
    'Butane/propane compatible',
    'Piezo ignition system',
    'Stainless steel body for durability',
    'Perfect for outdoor cooking',
    'Easy to transport and store',
    'Stable base design',
    'Adjustable flame control'
  ],
  applications: [
    'Outdoor cooking',
    'Camping',
    'Patios and balconies',
    'Emergency backup cooking',
    'Food trucks',
    'Catering events',
    'Picnics'
  ]
};

const relatedProducts = [
  { name: 'HT-GH354 5-Burner Gas Hob', slug: '/products/gas-stove/ht-gh354-5-burner', sku: 'HT-GH354' },
  { name: 'HT-GH243 4-Burner Gas Stove', slug: '/products/gas-stove/ht-gh243-4-burner', sku: 'HT-GH243' },
  { name: 'HT-EH32 Ceramic Electric Hob', slug: '/products/gas-stove/ht-eh32-ceramic', sku: 'HT-EH32' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": "https://housetech-ch.com/images/products/gas-stove/ht-pgh2.jpg",
    "description": description,
    "brand": { "@type": "Brand", "name": "HouseTech" },
    "manufacturer": { "@type": "Organization", "name": "HouseTech Group" },
    "sku": product.sku,
    "category": "Gas Stoves & Hobs",
    "offers": { "@type": "AggregateOffer", "priceCurrency": "USD", "lowPrice": "0", "highPrice": "0", "offerCount": "1", "availability": "https://schema.org/InStock" }
  })} />
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the warranty period for HT-PGH2 Portable Gas Stove?", "acceptedAnswer": { "@type": "Answer", "Text": "All HouseTech products come with a comprehensive warranty. The HT-PGH2 includes a 2-year manufacturer warranty covering defects in materials and workmanship." } },
      { "@type": "Question", "name": "Does HouseTech offer OEM/ODM customization for the HT-PGH2?", "acceptedAnswer": { "@type": "Answer", "Text": "Yes, HouseTech offers full OEM/ODM services including custom logo branding and packaging design for portable gas stoves." } },
      { "@type": "Question", "name": "What certifications does the HT-PGH2 have?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-PGH2 is certified with CE, CB, and ETL standards, meeting safety requirements for global markets." } },
      { "@type": "Question", "name": "What type of gas does the HT-PGH2 use?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-PGH2 is compatible with both Butane and Propane gas, and operates at 28-30mbar pressure." } },
      { "@type": "Question", "name": "What is the delivery time for HT-PGH2 orders?", "acceptedAnswer": { "@type": "Answer", "Text": "Standard delivery time is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days." } }
    ]
  })} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>{product.name}</h1>
      <p>SKU: {product.sku}</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <a href="/products/gas-stove">Gas Stoves & Hobs</a>
        <span class="separator">/</span>
        <span>{product.name}</span>
      </nav>
    </div>
  </section>

  <!-- Product Detail -->
  <section class="content-section">
    <div class="container">
      <div class="product-detail-grid">
        <!-- Gallery -->
        <div class="product-gallery">
          <div class="product-gallery-main">
            <img src={product.image} alt={product.name} />
          </div>
          <div class="product-gallery-thumbs">
            <div class="product-thumb active">
              <img src={product.image} alt={`${product.name} - Main View`} />
            </div>
          </div>
        </div>

        <!-- Product Info -->
        <div class="product-info">
          <h1>{product.name}</h1>
          <p class="product-sku">SKU: {product.sku} | Category: {product.category}</p>
          <p class="product-short-desc">{product.shortDesc}</p>
          <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Engineered by HouseTech, the HT-PGH2 is a compact portable gas stove perfect for outdoor cooking, camping, and emergency backup. As part of HouseTech's versatile cooking lineup, it offers dual burner convenience. Every HouseTech product is built to the highest quality standards.</p>

          <!-- Specs Table -->
          <table class="product-specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr>
                  <th>{key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <!-- CTA Area -->
          <div class="product-cta-area">
            <a href="/contact" class="btn btn-primary">Get Quote</a>
            <a href="/download" class="btn btn-outline">Download Spec Sheet</a>
          </div>
        </div>
      </div>

      <!-- Features Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Key Features
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
          {product.features.map((feature) => (
            <div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="color: var(--color-text);">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Applications Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Applications
        </h2>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
          {product.applications.map((app) => (
            <span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">
              {app}
            </span>
          ))}
        </div>
      </div>

      <!-- Why Choose HouseTech -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p>
        <a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a>
      </div>

      <!-- Related Products -->
      <div class="related-products">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Related Products
        </h2>
        <div class="news-grid">
          {relatedProducts.map((rel) => (
            <a href={rel.slug} class="news-card">
              <div class="news-card-body">
                <h3>{rel.name}</h3>
                <p>SKU: {rel.sku}</p>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
