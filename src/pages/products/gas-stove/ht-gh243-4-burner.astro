---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'HT-GH243 4-Burner Gas Stove - HouseTech Group | Tempered Glass Panel, Easy Clean Design';
const description = 'HouseTech HT-GH243 4-Burner Gas Stove: Stylish tempered glass panel, 4 versatile burners, FFD safety. Modern kitchen hob manufacturer for global B2B.';

// Product data
const product = {
  name: 'HT-GH243 4-Burner Gas Stove',
  sku: 'HT-GH243',
  category: 'Gas Stoves & Hobs',
  price: 'Contact for Quote',
  image: '/images/products/gas-stove/ht-gh243.jpg',
  shortDesc: 'Elegant 4-burner gas stove with stylish black tempered glass panel and easy-clean design. Perfect for modern kitchens.',
  specs: {
    'Burners': '4',
    'Burner Type': 'Steel',
    'Control Type': 'Knob Control',
    'Panel': 'Tempered Glass',
    'Ignition': 'Auto Ignition',
    'Safety': 'FFD (Flame Failure Device)',
    'Dimensions': '60 x 51cm',
    'Cut-out Size': '56 x 48cm',
    'Finish': 'Black Tempered Glass',
    'Voltage': '1.5V Battery (Ignition)',
    'Gross Weight': '12kg'
  },
  features: [
    'Stylish black tempered glass finish',
    '4 versatile burner configuration',
    'Easy-clean surface design',
    'FFD safety feature',
    'Auto ignition',
    'Compact 60cm width',
    'Modern kitchen aesthetic',
    'Durable construction',
    'Professional performance'
  ],
  applications: [
    'Modern kitchens',
    'Apartment kitchens',
    'Urban homes',
    'Contemporary renovations',
    'Family homes'
  ]
};

const relatedProducts = [
  { name: 'HT-GH354 5-Burner Gas Hob', slug: '/products/gas-stove/ht-gh354-5-burner', sku: 'HT-GH354' },
  { name: 'HT-EH32 Ceramic Electric Hob', slug: '/products/gas-stove/ht-eh32-ceramic', sku: 'HT-EH32' },
  { name: 'HT-PGH2 Portable Gas Stove', slug: '/products/gas-stove/ht-pgh2-portable', sku: 'HT-PGH2' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": "https://housetech-ch.com/images/products/gas-stove/ht-gh243.jpg",
    "description": description,
    "brand": { "@type": "Brand", "name": "HouseTech" },
    "manufacturer": { "@type": "Organization", "name": "HouseTech Group" },
    "sku": product.sku,
    "category": "Gas Stoves & Hobs",
    "offers": { "@type": "AggregateOffer", "priceCurrency": "USD", "lowPrice": "0", "highPrice": "0", "offerCount": "1", "availability": "https://schema.org/InStock" }
  })} />
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the warranty period for HT-GH243 Gas Stove?", "acceptedAnswer": { "@type": "Answer", "Text": "All HouseTech products come with a comprehensive warranty. The HT-GH243 includes a 2-year manufacturer warranty covering defects in materials and workmanship." } },
      { "@type": "Question", "name": "Does HouseTech offer OEM/ODM customization for the HT-GH243?", "acceptedAnswer": { "@type": "Answer", "Text": "Yes, HouseTech offers full OEM/ODM services including custom logo branding, panel finishes, and packaging design to meet your market requirements." } },
      { "@type": "Question", "name": "What safety features does the HT-GH243 include?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-GH243 includes Flame Failure Device (FFD) that automatically cuts gas supply if flame is extinguished, and auto ignition system." } },
      { "@type": "Question", "name": "What certifications does the HT-GH243 have?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-GH243 is certified with CE, CB, ETL, and RoHS standards, meeting safety requirements for European, Asian, and North American markets." } },
      { "@type": "Question", "name": "What is the delivery time for HT-GH243 orders?", "acceptedAnswer": { "@type": "Answer", "Text": "Standard delivery time is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days." } }
    ]
  })} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>{product.name}</h1>
      <p>SKU: {product.sku}</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <a href="/products/gas-stove">Gas Stoves & Hobs</a>
        <span class="separator">/</span>
        <span>{product.name}</span>
      </nav>
    </div>
  </section>

  <!-- Product Detail -->
  <section class="content-section">
    <div class="container">
      <div class="product-detail-grid">
        <!-- Gallery -->
        <div class="product-gallery">
          <div class="product-gallery-main">
            <img src={product.image} alt={product.name} />
          </div>
          <div class="product-gallery-thumbs">
            <div class="product-thumb active">
              <img src={product.image} alt={`${product.name} - Main View`} />
            </div>
          </div>
        </div>

        <!-- Product Info -->
        <div class="product-info">
          <h1>{product.name}</h1>
          <p class="product-sku">SKU: {product.sku} | Category: {product.category}</p>
          <p class="product-short-desc">{product.shortDesc}</p>
          <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Engineered by HouseTech, the HT-GH243 combines elegant tempered glass with 4 versatile burners. As part of HouseTech's gas hob lineup, this model delivers both style and performance for modern apartments. Every HouseTech product is CE/CB certified.</p>

          <!-- Specs Table -->
          <table class="product-specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr>
                  <th>{key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <!-- CTA Area -->
          <div class="product-cta-area">
            <a href="/contact" class="btn btn-primary">Get Quote</a>
            <a href="/download" class="btn btn-outline">Download Spec Sheet</a>
          </div>
        </div>
      </div>

      <!-- Features Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Key Features
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
          {product.features.map((feature) => (
            <div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="color: var(--color-text);">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Applications Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Applications
        </h2>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
          {product.applications.map((app) => (
            <span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">
              {app}
            </span>
          ))}
        </div>
      </div>

      <!-- Why Choose HouseTech -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p>
        <a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a>
      </div>

      <!-- Related Products -->
      <div class="related-products">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Related Products
        </h2>
        <div class="news-grid">
          {relatedProducts.map((rel) => (
            <a href={rel.slug} class="news-card">
              <div class="news-card-body">
                <h3>{rel.name}</h3>
                <p>SKU: {rel.sku}</p>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
