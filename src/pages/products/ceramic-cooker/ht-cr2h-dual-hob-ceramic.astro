---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'HT-CR2H Compact 30cm Ceramic Hob - HouseTech Group | 2-Zone Radiant Cooktop';
const description = 'HouseTech HT-CR2H 30cm Compact Ceramic Hob: 2 cooking zones, 3000W, knob controls, portable design. Space-saving ceramic cooker for small kitchens and RVs.';

const product = {
  name: 'HT-CR2H Compact 30cm Ceramic Hob',
  sku: 'HT-CR2H',
  category: 'Ceramic Cookers',
  shortDesc: 'Compact 30cm ceramic hob with 2 cooking zones. Knob controls, portable design, perfect for small kitchens, dorms, RVs, and mobile homes.',
  specs: {
    'Width': '30cm',
    'Type': 'Compact Ceramic Hob',
    'Burners': '2',
    'Heating Elements': 'Radiant',
    'Power': '3000W (total)',
    'Control Type': 'Knob Control',
    'Surface': 'Ceramic Glass',
    'Dimensions': '30 x 52 x 8cm',
    'Installation': 'Built-in or Freestanding',
    'Voltage': '220-240V / 50Hz',
    'Color': 'Black'
  },
  features: [
    'Compact 30cm width for space-saving',
    '2 radiant cooking zones',
    'Easy-to-use knob controls',
    'Can be built-in or used as tabletop',
    '3000W total power',
    'Portable design for flexibility',
    'Easy-clean ceramic surface',
    'Compact for small kitchens',
    'Ideal for RVs and mobile homes',
    'Modern minimalist design'
  ],
  applications: [
    'Small kitchens',
    'Studio apartments',
    'Dorm rooms',
    'Office pantries',
    'RVs and campers',
    'Mobile homes',
    'Studio kitchens',
    'Secondary cooking stations'
  ]
};

const relatedProducts = [
  { name: 'HT-CR60 60cm Radiant Ceramic Hob', slug: '/products/ceramic-cooker/ht-cr60-60cm-radiant', sku: 'HT-CR60' },
  { name: 'HT-CR90 90cm Ceramic Hob', slug: '/products/ceramic-cooker/ht-cr90-90cm-ceramic', sku: 'HT-CR90' },
  { name: 'HT-CR4Q 4-Burner Ceramic Hob', slug: '/products/ceramic-cooker/ht-cr4q-4-burner-ceramic', sku: 'HT-CR4Q' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": "https://housetech-ch.com/images/products/ceramic-cooker/ht-cr2h.jpg",
    "description": description,
    "brand": { "@type": "Brand", "name": "HouseTech" },
    "manufacturer": { "@type": "Organization", "name": "HouseTech Group" },
    "sku": product.sku,
    "category": "Ceramic Cookers",
    "offers": { "@type": "AggregateOffer", "priceCurrency": "USD", "lowPrice": "0", "highPrice": "0", "offerCount": "1", "availability": "https://schema.org/InStock" }
  })} />
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the warranty period for HT-CR2H Ceramic Hob?", "acceptedAnswer": { "@type": "Answer", "Text": "All HouseTech products come with a comprehensive warranty. The HT-CR2H includes a 2-year manufacturer warranty covering defects in materials and workmanship." } },
      { "@type": "Question", "name": "Does HouseTech offer OEM/ODM customization for the HT-CR2H?", "acceptedAnswer": { "@type": "Answer", "Text": "Yes, HouseTech offers full OEM/ODM services including custom logo branding and packaging design." } },
      { "@type": "Question", "name": "What certifications does the HT-CR2H have?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-CR2H is certified with CE, CB, ETL, and RoHS standards, meeting safety requirements for global markets." } },
      { "@type": "Question", "name": "What is the delivery time for HT-CR2H orders?", "acceptedAnswer": { "@type": "Answer", "Text": "Standard delivery time is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days." } },
      { "@type": "Question", "name": "Can the HT-CR2H be used as a portable stove?", "acceptedAnswer": { "@type": "Answer", "Text": "Yes, the HT-CR2H can be used as both built-in and tabletop portable design for flexible kitchen setups." } }
    ]
  })} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>{product.name}</h1>
      <p>SKU: {product.sku}</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <a href="/products/ceramic-cooker">Ceramic Cookers</a>
        <span class="separator">/</span>
        <span>{product.name}</span>
      </nav>
    </div>
  </section>

  <!-- Product Detail -->
  <section class="content-section">
    <div class="container">
      <div class="product-detail-grid">
        <div class="product-gallery">
          <div class="product-gallery-main">
            <img src="/images/products/ceramic-cooker/ht-cr2h.jpg" alt={product.name} />
          </div>
          <div class="product-gallery-thumbs">
            <div class="product-thumb active">
              <img src="/images/products/ceramic-cooker/ht-cr2h.jpg" alt={`${product.name} - Main View`} />
            </div>
          </div>
        </div>

        <div class="product-info">
          <h1>{product.name}</h1>
          <p class="product-sku">SKU: {product.sku} | Category: {product.category}</p>
          <p class="product-short-desc">{product.shortDesc}</p>
          <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Engineered by HouseTech, the HT-CR2H is a compact 30cm ceramic hob ideal for small kitchens, RVs, and mobile homes. As part of HouseTech's versatile ceramic cooker lineup, this portable model delivers big performance in a small package. Every HouseTech product is CE/CB certified.</p>

          <table class="product-specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr>
                  <th>{key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <div class="product-cta-area">
            <a href="/contact" class="btn btn-primary">Get Quote</a>
            <a href="/download" class="btn btn-outline">Download Spec Sheet</a>
          </div>
        </div>
      </div>

      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Key Features
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
          {product.features.map((feature) => (
            <div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="color: var(--color-text);">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Applications
        </h2>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
          {product.applications.map((app) => (
            <span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">
              {app}
            </span>
          ))}
        </div>
      </div>

      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p>
        <a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a>
      </div>

      <div class="related-products">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Related Products
        </h2>
        <div class="news-grid">
          {relatedProducts.map((rel) => (
            <a href={rel.slug} class="news-card">
              <div class="news-card-body">
                <h3>{rel.name}</h3>
                <p>SKU: {rel.sku}</p>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
