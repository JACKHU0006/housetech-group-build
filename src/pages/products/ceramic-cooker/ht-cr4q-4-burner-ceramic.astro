---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'HT-CR4Q 4-Burner Radiant Ceramic Hob - HouseTech Group | 75cm Built-in Ceramic Cooktop';
const description = 'HouseTech HT-CR4Q 4-Burner Radiant Ceramic Hob: 75cm width, bridge zones, 7200W power, halogen heating. Premium kitchen ceramic cooker with European design.';

const product = {
  name: 'HT-CR4Q 4-Burner Radiant Ceramic Hob',
  sku: 'HT-CR4Q',
  category: 'Ceramic Cookers',
  shortDesc: '75cm 4-burner radiant ceramic hob with bridge zones for flexible cooking. Halogen heating technology with sleek European-inspired design for modern kitchens.',
  specs: {
    'Width': '75cm',
    'Type': 'Radiant Ceramic Hob',
    'Burners': '4',
    'Heating Elements': 'Halogen',
    'Power': '7200W (total)',
    'Control Type': 'Touch Control',
    'Surface': 'Vitroceramic Glass',
    'Dimensions': '75 x 52 x 5.2cm',
    'Cut-out': '71 x 48cm',
    'Bridge Zones': '2',
    'Voltage': '220-240V / 50Hz',
    'Child Lock': 'Yes'
  },
  features: [
    '4 radiant cooking zones with halogen heating',
    '2 bridge zones for large cookware',
    '7200W total power output',
    'Halogen rapid heat technology',
    '9 power levels per zone',
    'Touch slider control',
    'Bridge function for elongated cookware',
    'Residual heat indicator',
    'Child safety lock',
    'Auto shut-off protection',
    'Timer function (99 minutes)'
  ],
  applications: [
    'Modern European kitchens',
    'Contemporary apartments',
    'Designer homes',
    'Premium renovations',
    'Minimalist kitchen designs'
  ]
};

const relatedProducts = [
  { name: 'HT-CR60 60cm Radiant Ceramic Hob', slug: '/products/ceramic-cooker/ht-cr60-60cm-radiant', sku: 'HT-CR60' },
  { name: 'HT-CR90 90cm Ceramic Hob', slug: '/products/ceramic-cooker/ht-cr90-90cm-ceramic', sku: 'HT-CR90' },
  { name: 'HT-CR2H Dual Zone Ceramic Hob', slug: '/products/ceramic-cooker/ht-cr2h-dual-hob-ceramic', sku: 'HT-CR2H' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": "https://housetech-ch.com/images/products/ceramic-cooker/ht-cr4q.jpg",
    "description": description,
    "brand": { "@type": "Brand", "name": "HouseTech" },
    "manufacturer": { "@type": "Organization", "name": "HouseTech Group" },
    "sku": product.sku,
    "category": "Ceramic Cookers",
    "offers": { "@type": "AggregateOffer", "priceCurrency": "USD", "lowPrice": "0", "highPrice": "0", "offerCount": "1", "availability": "https://schema.org/InStock" }
  })} />
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the warranty period for HT-CR4Q Ceramic Hob?", "acceptedAnswer": { "@type": "Answer", "Text": "All HouseTech products come with a comprehensive warranty. The HT-CR4Q includes a 2-year manufacturer warranty covering defects in materials and workmanship." } },
      { "@type": "Question", "name": "Does HouseTech offer OEM/ODM customization for the HT-CR4Q?", "acceptedAnswer": { "@type": "Answer", "Text": "Yes, HouseTech offers full OEM/ODM services including custom logo branding and packaging design." } },
      { "@type": "Question", "name": "What certifications does the HT-CR4Q have?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-CR4Q is certified with CE, CB, ETL, and RoHS standards, meeting safety requirements for global markets." } },
      { "@type": "Question", "name": "What is the delivery time for HT-CR4Q orders?", "acceptedAnswer": { "@type": "Answer", "Text": "Standard delivery time is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days." } },
      { "@type": "Question", "name": "What safety features does the HT-CR4Q include?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-CR4Q includes child lock, residual heat indicator, auto shut-off protection, and bridge zone function." } }
    ]
  })} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>{product.name}</h1>
      <p>SKU: {product.sku}</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <a href="/products/ceramic-cooker">Ceramic Cookers</a>
        <span class="separator">/</span>
        <span>{product.name}</span>
      </nav>
    </div>
  </section>

  <!-- Product Detail -->
  <section class="content-section">
    <div class="container">
      <div class="product-detail-grid">
        <div class="product-gallery">
          <div class="product-gallery-main">
            <img src="/images/products/ceramic-cooker/ht-cr4q.jpg" alt={product.name} />
          </div>
          <div class="product-gallery-thumbs">
            <div class="product-thumb active">
              <img src="/images/products/ceramic-cooker/ht-cr4q.jpg" alt={`${product.name} - Main View`} />
            </div>
          </div>
        </div>

        <div class="product-info">
          <h1>{product.name}</h1>
          <p class="product-sku">SKU: {product.sku} | Category: {product.category}</p>
          <p class="product-short-desc">{product.shortDesc}</p>
          <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Engineered by HouseTech, the HT-CR4Q features 4 burners with 2 bridge zones for versatile cooking. As part of HouseTech's premium ceramic hob lineup, its European-inspired design suits modern kitchens. Every HouseTech product is CE/CB certified for quality assurance.</p>

          <table class="product-specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr>
                  <th>{key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <div class="product-cta-area">
            <a href="/contact" class="btn btn-primary">Get Quote</a>
            <a href="/download" class="btn btn-outline">Download Spec Sheet</a>
          </div>
        </div>
      </div>

      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Key Features
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
          {product.features.map((feature) => (
            <div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="color: var(--color-text);">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Applications
        </h2>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
          {product.applications.map((app) => (
            <span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">
              {app}
            </span>
          ))}
        </div>
      </div>

      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p>
        <a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a>
      </div>

      <div class="related-products">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Related Products
        </h2>
        <div class="news-grid">
          {relatedProducts.map((rel) => (
            <a href={rel.slug} class="news-card">
              <div class="news-card-body">
                <h3>{rel.name}</h3>
                <p>SKU: {rel.sku}</p>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
