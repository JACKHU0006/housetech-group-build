---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'HT-KS05 Premium Kitchen Set - HouseTech Group | 5-Piece Kitchen Set, Range Hood + Stove + Sterilizer + Water Heater + Steamer';
const description = 'HouseTech HT-KS05 Premium Kitchen Set: 5-piece combo with range hood, gas stove, sterilizer, water heater, and steamer oven. Complete premium kitchen solution for discerning homeowners.';

const product = {
  name: 'HT-KS05 Premium Kitchen Set',
  sku: 'HT-KS05',
  category: 'Kitchen Sets',
  price: 'Contact for Quote',
  image: '/images/products/kitchen-set/ht-ks05.jpg',
  shortDesc: 'Premium 5-piece kitchen set featuring range hood, gas stove, sterilizer cabinet, water heater, and steamer oven. Comprehensive solution for homeowners seeking quality and convenience in one package.',
  specs: {
    'Set Type': '5-Piece Premium Kitchen Set',
    'Included Items': 'Range Hood + Gas Stove + Sterilizer + Water Heater + Steamer Oven',
    'Range Hood Model': 'HT-RH900 Wall Mount Range Hood',
    'Range Hood Extraction': '1100m³/h',
    'Range Hood Width': '90cm',
    'Gas Stove Model': 'HT-GS90 Triple Burner Gas Stove',
    'Gas Stove Power': 'Left 4.5kW + Center 1.8kW + Right 4.0kW',
    'Gas Stove Surface': 'Tempered Glass with Cast Iron Grates',
    'Sterilizer Model': 'HT-SC90 Large Sterilizer Cabinet',
    'Sterilizer Capacity': '90L',
    'Sterilization Method': 'UV + Ozone + Infrared Drying',
    'Water Heater Model': 'HT-WH60 Electric Water Heater',
    'Water Heater Capacity': '60L / 2000W',
    'Steamer Oven Model': 'HT-OV60 Steam & Bake Oven',
    'Steamer Capacity': '60L / Steam + Bake Dual Mode',
    'Overall Style': 'Premium Stainless Steel & Black Glass',
    'Warranty': '3 Years (Parts & Labor)',
    'Color': 'Silver / Black',
    'Set Savings': 'Up to 20% vs Individual Purchase'
  },
  features: [
    'Complete 5-piece premium kitchen solution',
    'Range hood with powerful 1100m³/h extraction for heavy cooking',
    'Triple burner gas stove with wok burner for Chinese cuisine',
    '90L large sterilizer with UV + Ozone + Infrared triple mode',
    '60L electric water heater with digital display',
    '60L steam & bake dual-mode oven for versatile cooking',
    'Coordinated premium design across all appliances',
    'Professional installation service included',
    'Up to 20% savings compared to individual purchases',
    '3-year warranty with dedicated after-sales support'
  ],
  applications: [
    'Premium home kitchen installations',
    'New home move-in packages',
    'Kitchen upgrade projects',
    'Interior designer kitchen specifications',
    'High-end residential developments'
  ]
};

const relatedProducts = [
  { name: 'HT-KS01 Starter Kitchen Set', slug: '/products/kitchen-set/ht-ks01-starter', sku: 'HT-KS01' },
  { name: 'HT-KS08 Luxury Kitchen Set', slug: '/products/kitchen-set/ht-ks08-luxury', sku: 'HT-KS08' },
  { name: 'HT-IC Integrated Induction Hob', slug: '/products/induction-cooker/ht-ic-integrated', sku: 'HT-IC' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": "https://housetech-ch.com/images/products/kitchen-set/ht-ks05.jpg",
    "description": description,
    "brand": { "@type": "Brand", "name": "HouseTech" },
    "manufacturer": { "@type": "Organization", "name": "HouseTech Group" },
    "sku": product.sku,
    "category": "Kitchen Sets",
    "offers": { "@type": "AggregateOffer", "priceCurrency": "USD", "lowPrice": "0", "highPrice": "0", "offerCount": "1", "availability": "https://schema.org/InStock" }
  })} />
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the warranty period for HT-KS05 Premium Kitchen Set?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-KS05 Premium Kitchen Set includes a 3-year manufacturer warranty covering all appliances in the set." } },
      { "@type": "Question", "name": "Does HouseTech offer OEM/ODM customization for the HT-KS05?", "acceptedAnswer": { "@type": "Answer", "Text": "Yes, HouseTech offers full OEM/ODM services for kitchen sets including custom logo branding, color options, and appliance configuration adjustments." } },
      { "@type": "Question", "name": "What certifications do the appliances in HT-KS05 have?", "acceptedAnswer": { "@type": "Answer", "Text": "All appliances in the HT-KS05 are certified with CE, CB, ETL, and RoHS standards, meeting safety requirements for global markets." } },
      { "@type": "Question", "name": "What is the delivery time for HT-KS05 orders?", "acceptedAnswer": { "@type": "Answer", "Text": "Standard delivery time is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days." } },
      { "@type": "Question", "name": "What is included in the HT-KS05 Premium Kitchen Set?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-KS05 includes: HT-RH900 Range Hood, HT-GS90 Gas Stove, HT-SC90 Sterilizer, HT-WH60 Water Heater, and HT-OV60 Steamer Oven." } }
    ]
  })} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>{product.name}</h1>
      <p>SKU: {product.sku}</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <a href="/products/kitchen-set">Kitchen Sets</a>
        <span class="separator">/</span>
        <span>{product.name}</span>
      </nav>
    </div>
  </section>

  <!-- Product Detail -->
  <section class="content-section">
    <div class="container">
      <div class="product-detail-grid">
        <!-- Gallery -->
        <div class="product-gallery">
          <div class="product-gallery-main">
            <img src={product.image} alt={product.name} />
          </div>
          <div class="product-gallery-thumbs">
            <div class="product-thumb active">
              <img src={product.image} alt={`${product.name} - Main View`} />
            </div>
          </div>
        </div>

        <!-- Product Info -->
        <div class="product-info">
          <h1>{product.name}</h1>
          <p class="product-sku">SKU: {product.sku} | Category: {product.category}</p>
          <p class="product-short-desc">{product.shortDesc}</p>
          <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Curated by HouseTech, the HT-KS05 Premium Set delivers a full-featured kitchen with smart-ready appliances. As part of HouseTech's premium kitchen solutions, it combines elegance with professional performance. Every HouseTech product is CE/CB certified.</p>

          <!-- Specs Table -->
          <table class="product-specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr>
                  <th>{key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <!-- CTA Area -->
          <div class="product-cta-area">
            <a href="/contact" class="btn btn-primary">Get Quote</a>
            <a href="/download" class="btn btn-outline">Download Spec Sheet</a>
          </div>
        </div>
      </div>

      <!-- Features Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Key Features
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
          {product.features.map((feature) => (
            <div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="color: var(--color-text);">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Applications Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Applications
        </h2>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
          {product.applications.map((app) => (
            <span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">
              {app}
            </span>
          ))}
        </div>
      </div>

      <!-- Why Choose HouseTech -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p>
        <a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a>
      </div>

      <!-- Related Products -->
      <div class="related-products">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Related Products
        </h2>
        <div class="news-grid">
          {relatedProducts.map((rel) => (
            <a href={rel.slug} class="news-card">
              <div class="news-card-body">
                <h3>{rel.name}</h3>
                <p>SKU: {rel.sku}</p>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
