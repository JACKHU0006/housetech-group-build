---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'HT-KS Commercial Kitchen Set - HouseTech Group | Professional Kitchen Equipment Package, Heavy-Duty';
const description = 'HouseTech HT-KS Commercial Kitchen Set: professional-grade equipment package including commercial range hood, high-power stove, commercial sterilizer, and water heater. Built for restaurant and catering use.';

const product = {
  name: 'HT-KS Commercial Kitchen Set',
  sku: 'HT-KS',
  category: 'Kitchen Sets',
  price: 'Contact for Quote',
  image: '/images/products/kitchen-set/ht-ks.jpg',
  shortDesc: 'Professional commercial kitchen equipment package featuring heavy-duty range hood, high-power gas stove, commercial sterilizer, and industrial water heater. Engineered for demanding restaurant and catering environments.',
  specs: {
    'Set Type': 'Commercial Kitchen Equipment Package',
    'Included Items': 'Commercial Range Hood + High-Power Gas Stove + Commercial Sterilizer + Industrial Water Heater',
    'Range Hood Model': 'HT-RH1500 Commercial Range Hood',
    'Range Hood Extraction': '2000m³/h',
    'Range Hood Width': '150cm',
    'Range Hood Features': 'Auto-clean, Fire-suppression System',
    'Gas Stove Model': 'HT-GS120 Commercial Gas Stove',
    'Gas Stove Configuration': '4 Burner + 1 Wok + 1 Griddle',
    'Gas Stove Total Power': '32kW',
    'Gas Stove Surface': 'Stainless Steel with Cast Iron Grates',
    'Sterilizer Model': 'HT-SC200 Commercial Sterilizer Cabinet',
    'Sterilizer Capacity': '200L',
    'Sterilization Method': 'High-temp + UV + Ozone',
    'Water Heater Model': 'HT-WH200 Commercial Water Heater',
    'Water Heater': '200L Storage / 6000W Commercial Grade',
    'Overall Build': 'SUS304 Stainless Steel, Heavy-duty Construction',
    'Compliance': 'CE / CCC / Commercial Kitchen Safety Standards',
    'Warranty': '2 Years Commercial Warranty + On-site Service',
    'Color': 'Stainless Steel',
    'Set Savings': 'Up to 18% vs Individual Purchase'
  },
  features: [
    'Complete commercial kitchen equipment package for food service operations',
    '2000m³/h commercial range hood with built-in fire-suppression system',
    '6-burner gas stove with 32kW total power for high-volume cooking',
    'Built-in griddle plate for breakfast and teppanyaki service',
    '200L commercial sterilizer with high-temperature + UV + Ozone triple mode',
    '200L / 6000W commercial water heater for continuous hot water supply',
    'SUS304 stainless steel construction throughout for hygiene and durability',
    'Auto-clean function on range hood reduces maintenance downtime',
    'CE and CCC certified for commercial kitchen safety compliance',
    'On-site warranty service with 24-hour response time'
  ],
  applications: [
    'Restaurant and hotel kitchens',
    'Catering service operations',
    'School and hospital canteens',
    'Food manufacturing facilities',
    'Large-scale dining hall kitchens'
  ]
};

const relatedProducts = [
  { name: 'HT-KS01 Starter Kitchen Set', slug: '/products/kitchen-set/ht-ks01-starter', sku: 'HT-KS01' },
  { name: 'HT-KS05 Premium Kitchen Set', slug: '/products/kitchen-set/ht-ks05-premium', sku: 'HT-KS05' },
  { name: 'HT-IC35 Commercial Induction Cooker', slug: '/products/induction-cooker/ht-ic35-commercial', sku: 'HT-IC35' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": "https://housetech-ch.com/images/products/kitchen-set/ht-ks.jpg",
    "description": description,
    "brand": { "@type": "Brand", "name": "HouseTech" },
    "manufacturer": { "@type": "Organization", "name": "HouseTech Group" },
    "sku": product.sku,
    "category": "Kitchen Sets",
    "offers": { "@type": "AggregateOffer", "priceCurrency": "USD", "lowPrice": "0", "highPrice": "0", "offerCount": "1", "availability": "https://schema.org/InStock" }
  })} />
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the warranty period for HT-KS Commercial Kitchen Set?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-KS Commercial Kitchen Set includes a 2-year commercial warranty with on-site service and 24-hour response time." } },
      { "@type": "Question", "name": "Does HouseTech offer OEM/ODM customization for the HT-KS Commercial?", "acceptedAnswer": { "@type": "Answer", "Text": "Yes, HouseTech offers full OEM/ODM services for commercial kitchen sets including custom configurations and branding." } },
      { "@type": "Question", "name": "What certifications does the HT-KS Commercial have?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-KS Commercial is CE and CCC certified for commercial kitchen safety compliance." } },
      { "@type": "Question", "name": "What is the delivery time for HT-KS Commercial orders?", "acceptedAnswer": { "@type": "Answer", "Text": "Standard delivery time is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days." } },
      { "@type": "Question", "name": "What is included in the HT-KS Commercial Kitchen Set?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-KS Commercial includes: HT-RH1500 Commercial Range Hood (2000m³/h), HT-GS120 Gas Stove (32kW), HT-SC200 Sterilizer (200L), and HT-WH200 Water Heater." } }
    ]
  })} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>{product.name}</h1>
      <p>SKU: {product.sku}</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <a href="/products/kitchen-set">Kitchen Sets</a>
        <span class="separator">/</span>
        <span>{product.name}</span>
      </nav>
    </div>
  </section>

  <!-- Product Detail -->
  <section class="content-section">
    <div class="container">
      <div class="product-detail-grid">
        <!-- Gallery -->
        <div class="product-gallery">
          <div class="product-gallery-main">
            <img src={product.image} alt={product.name} />
          </div>
          <div class="product-gallery-thumbs">
            <div class="product-thumb active">
              <img src={product.image} alt={`${product.name} - Main View`} />
            </div>
          </div>
        </div>

        <!-- Product Info -->
        <div class="product-info">
          <h1>{product.name}</h1>
          <p class="product-sku">SKU: {product.sku} | Category: {product.category}</p>
          <p class="product-short-desc">{product.shortDesc}</p>
          <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Curated by HouseTech, the HT-KS Commercial Set is designed for restaurant and hospitality environments. As part of HouseTech's commercial kitchen solutions, it includes heavy-duty appliances for intensive use. Every HouseTech product is built to the highest quality standards.</p>

          <!-- Specs Table -->
          <table class="product-specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr>
                  <th>{key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <!-- CTA Area -->
          <div class="product-cta-area">
            <a href="/contact" class="btn btn-primary">Get Quote</a>
            <a href="/download" class="btn btn-outline">Download Spec Sheet</a>
          </div>
        </div>
      </div>

      <!-- Features Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Key Features
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
          {product.features.map((feature) => (
            <div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="color: var(--color-text);">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Applications Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Applications
        </h2>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
          {product.applications.map((app) => (
            <span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">
              {app}
            </span>
          ))}
        </div>
      </div>

      <!-- Why Choose HouseTech -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p>
        <a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a>
      </div>

      <!-- Related Products -->
      <div class="related-products">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Related Products
        </h2>
        <div class="news-grid">
          {relatedProducts.map((rel) => (
            <a href={rel.slug} class="news-card">
              <div class="news-card-body">
                <h3>{rel.name}</h3>
                <p>SKU: {rel.sku}</p>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
