---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'HT-KS08 Luxury Kitchen Set - HouseTech Group | 8-Piece Full Kitchen Suite, Smart Interconnected';
const description = 'HouseTech HT-KS08 Luxury Kitchen Set: 8-piece full suite with smart interconnection, including range hood, gas stove, steamer, oven, sterilizer, water heater, induction hob, and dishwasher. Ultimate kitchen experience.';

const product = {
  name: 'HT-KS08 Luxury Kitchen Set',
  sku: 'HT-KS08',
  category: 'Kitchen Sets',
  price: 'Contact for Quote',
  image: '/images/products/kitchen-set/ht-ks08.jpg',
  shortDesc: 'Luxury 8-piece full kitchen suite with smart interconnection technology. Includes range hood, gas stove, steamer, oven, sterilizer, water heater, induction hob, and dishwasher. The ultimate all-in-one kitchen experience.',
  specs: {
    'Set Type': '8-Piece Luxury Kitchen Suite',
    'Included Items': 'Range Hood + Gas Stove + Steamer Oven + Built-in Oven + Sterilizer + Water Heater + Induction Hob + Dishwasher',
    'Smart Feature': 'HouseTech Smart Link — Centralized App Control',
    'Range Hood Model': 'HT-RH1200 Island Range Hood',
    'Range Hood Extraction': '1400m³/h, Auto-sensing',
    'Gas Stove Model': 'HT-GS90 Pro Triple Burner',
    'Gas Stove Power': '5.0kW Wok + 4.0kW + 1.8kW',
    'Steamer Oven Model': 'HT-OV90 Steam & Roast Combination',
    'Steamer Capacity': '90L / Steam + Roast + Air Fry',
    'Built-in Oven Model': 'HT-OV70 Built-in Electric Oven',
    'Oven Capacity': '70L / 8 Cooking Modes',
    'Sterilizer Model': 'HT-SC110 Premium Sterilizer',
    'Sterilizer Capacity': '110L / UV + Ozone + Infrared',
    'Water Heater Model': 'HT-WH80 Instant Water Heater',
    'Water Heater': 'Tankless 6500W',
    'Induction Hob Model': 'HT-IC Integrated Induction Hob',
    'Induction Hob': '3600W Dual Zone with Booster',
    'Dishwasher Model': 'HT-DW60 Built-in Dishwasher',
    'Dishwasher': '14 Place Settings / 8 Wash Programs',
    'Overall Style': 'Premium Unified Design Language',
    'Warranty': '5 Years (Parts & Labor) + Lifetime Technical Support',
    'Color': 'Customizable (Silver / Black / Champagne Gold)',
    'Set Savings': 'Up to 25% vs Individual Purchase'
  },
  features: [
    'Complete 8-piece luxury kitchen suite — nothing else needed',
    'HouseTech Smart Link technology for centralized App control of all appliances',
    'Range hood auto-activates when gas stove is turned on',
    '1400m³/h island range hood with auto-sensing technology',
    '5.0kW wok burner for authentic stir-fry cooking',
    'Steam & roast combination oven with air fry capability',
    '14-place setting dishwasher with 8 specialized wash programs',
    'Coordinated premium design language across all 8 appliances',
    'Customizable color options to match kitchen decor',
    '5-year warranty with lifetime technical support and priority service'
  ],
  applications: [
    'Luxury villa kitchen installations',
    'High-end residential developments',
    'Premium interior design projects',
    'Executive home kitchen builds',
    'Custom kitchen showcase installations'
  ]
};

const relatedProducts = [
  { name: 'HT-KS01 Starter Kitchen Set', slug: '/products/kitchen-set/ht-ks01-starter', sku: 'HT-KS01' },
  { name: 'HT-KS05 Premium Kitchen Set', slug: '/products/kitchen-set/ht-ks05-premium', sku: 'HT-KS05' },
  { name: 'HT-KS Commercial Kitchen Set', slug: '/products/kitchen-set/ht-ks-commercial', sku: 'HT-KS' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": "https://housetech-ch.com/images/products/kitchen-set/ht-ks08.jpg",
    "description": description,
    "brand": { "@type": "Brand", "name": "HouseTech" },
    "manufacturer": { "@type": "Organization", "name": "HouseTech Group" },
    "sku": product.sku,
    "category": "Kitchen Sets",
    "offers": { "@type": "AggregateOffer", "priceCurrency": "USD", "lowPrice": "0", "highPrice": "0", "offerCount": "1", "availability": "https://schema.org/InStock" }
  })} />
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the warranty period for HT-KS08 Luxury Kitchen Set?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-KS08 Luxury Kitchen Set includes a 5-year manufacturer warranty with lifetime technical support." } },
      { "@type": "Question", "name": "Does HouseTech offer OEM/ODM customization for the HT-KS08?", "acceptedAnswer": { "@type": "Answer", "Text": "Yes, HouseTech offers full OEM/ODM services including custom logo branding, color options (Silver/Black/Champagne Gold), and appliance configurations." } },
      { "@type": "Question", "name": "What smart features does the HT-KS08 include?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-KS08 features HouseTech Smart Link technology with centralized App control, and auto-activation where the range hood turns on when the gas stove is used." } },
      { "@type": "Question", "name": "What is the delivery time for HT-KS08 orders?", "acceptedAnswer": { "@type": "Answer", "Text": "Standard delivery time is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days." } },
      { "@type": "Question", "name": "What is included in the HT-KS08 Luxury Kitchen Set?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-KS08 includes 8 appliances: Range Hood, Gas Stove, Steamer Oven, Built-in Oven, Sterilizer, Water Heater, Induction Hob, and Dishwasher." } }
    ]
  })} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>{product.name}</h1>
      <p>SKU: {product.sku}</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <a href="/products/kitchen-set">Kitchen Sets</a>
        <span class="separator">/</span>
        <span>{product.name}</span>
      </nav>
    </div>
  </section>

  <!-- Product Detail -->
  <section class="content-section">
    <div class="container">
      <div class="product-detail-grid">
        <!-- Gallery -->
        <div class="product-gallery">
          <div class="product-gallery-main">
            <img src={product.image} alt={product.name} />
          </div>
          <div class="product-gallery-thumbs">
            <div class="product-thumb active">
              <img src={product.image} alt={`${product.name} - Main View`} />
            </div>
          </div>
        </div>

        <!-- Product Info -->
        <div class="product-info">
          <h1>{product.name}</h1>
          <p class="product-sku">SKU: {product.sku} | Category: {product.category}</p>
          <p class="product-short-desc">{product.shortDesc}</p>
          <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Curated by HouseTech, the HT-KS08 Luxury Set represents the finest in HouseTech's kitchen appliance collection. As part of HouseTech's luxury kitchen solutions, it features premium materials and smart technology. Every HouseTech product is CE/CB certified.</p>

          <!-- Specs Table -->
          <table class="product-specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr>
                  <th>{key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <!-- CTA Area -->
          <div class="product-cta-area">
            <a href="/contact" class="btn btn-primary">Get Quote</a>
            <a href="/download" class="btn btn-outline">Download Spec Sheet</a>
          </div>
        </div>
      </div>

      <!-- Features Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Key Features
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
          {product.features.map((feature) => (
            <div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="color: var(--color-text);">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Applications Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Applications
        </h2>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
          {product.applications.map((app) => (
            <span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">
              {app}
            </span>
          ))}
        </div>
      </div>

      <!-- Why Choose HouseTech -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p>
        <a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a>
      </div>

      <!-- Related Products -->
      <div class="related-products">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Related Products
        </h2>
        <div class="news-grid">
          {relatedProducts.map((rel) => (
            <a href={rel.slug} class="news-card">
              <div class="news-card-body">
                <h3>{rel.name}</h3>
                <p>SKU: {rel.sku}</p>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
