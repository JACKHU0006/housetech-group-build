---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'Premium Kitchen Set - HouseTech Group | Full Smart Kitchen Package';
const description = 'HouseTech Premium Kitchen Set: Full-featured package with HT-RH900 Hood, HT-GH354 Hob, HT-OV80 Oven, HT-AF80 Air Fryer, HT-WH16 Water Heater.';

const product = {
  name: 'Premium Kitchen Set',
  sku: 'HT-KS200',
  category: 'Kitchen Sets',
  image: '/images/products/kitchen-set/premium.jpg',
  shortDesc: 'Full-featured premium package with smart features across all appliances. Complete luxury kitchen solution.',
  specs: {
    'Package Includes': '5 Products',
    'Range Hood': 'HT-RH900 (90cm, 1100m³/h, touch control)',
    'Gas Hob': 'HT-GH354 (5-burner, brass burners, FFD)',
    'Oven': 'HT-OV80 (80L, pyrolytic, 8 functions)',
    'Air Fryer': 'HT-AF80 (8L, digital, 8 presets)',
    'Water Heater': 'HT-WH16 (16L, tankless, CO alarm)',
    'Features': 'Smart Control, Wi-Fi Ready',
    'Style': 'Luxury / Professional',
    'Warranty': '3 Years'
  },
  features: [
    'Premium appliances from each category',
    'Smart-ready features across all products',
    'Professional-grade performance',
    'Elegant stainless steel and glass design',
    'Pyrolytic self-cleaning oven included',
    'High-power extraction hood',
    '5-burner professional gas hob',
    'Complete hot water and cooking solution'
  ],
  applications: [
    'Luxury homes',
    'High-end apartments',
    'Home renovation projects',
    'Discerning homeowners',
    'Gourmet kitchens'
  ]
};

const relatedProducts = [
  { name: 'Starter Kitchen Set', slug: '/products/kitchen-set/starter-set', sku: 'HT-KS100' },
  { name: 'Commercial Kitchen Set', slug: '/products/kitchen-set/commercial-set', sku: 'HT-KS300' },
  { name: 'Hotel Apartment Kitchen Set', slug: '/products/kitchen-set/hotel-set', sku: 'HT-KS400' }
];
---

<Layout title={title} description={description}>
  <Header activeNav="products" />
  <section class="page-hero"><div class="container"><h1>{product.name}</h1><p>SKU: {product.sku}</p><nav class="breadcrumb"><a href="/">Home</a><span class="separator">/</span><a href="/products">Products</a><span class="separator">/</span><a href="/products/kitchen-set">Kitchen Sets</a><span class="separator">/</span><span>{product.name}</span></nav></div></section>
  <section class="content-section"><div class="container"><div class="product-detail-grid"><div class="product-gallery"><div class="product-gallery-main"><img src={product.image} alt={product.name} /></div><div class="product-gallery-thumbs"><div class="product-thumb active"><img src={product.image} alt={product.name} /></div></div></div><div class="product-info"><h1>{product.name}</h1><p class="product-sku">SKU: {product.sku} | Category: {product.category}</p><p class="product-short-desc">{product.shortDesc}</p><p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Curated by HouseTech, this Premium Kitchen Set includes 5 top-of-the-line appliances with smart-ready features. As part of HouseTech's luxury kitchen solutions, it delivers professional-grade performance for discerning homeowners. Every HouseTech product is CE/CB certified.</p><table class="product-specs-table"><tbody>{Object.entries(product.specs).map(([key, value]) => (<tr><th>{key}</th><td>{value}</td></tr>))}</tbody></table><div class="product-cta-area"><a href="/contact" class="btn btn-primary">Get Quote</a><a href="/download" class="btn btn-outline">Download Spec Sheet</a></div></div></div><div style="margin-top: var(--spacing-3xl);"><h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">Key Features</h2><div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">{product.features.map((feature) => (<div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"></polyline></svg><span style="color: var(--color-text);">{feature}</span></div>))}</div></div><div style="margin-top: var(--spacing-3xl);"><h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">Applications</h2><div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">{product.applications.map((app) => (<span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">{app}</span>))}</div></div><div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);"><h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2><p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p><a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a></div><div class="related-products"><h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">Other Kitchen Sets</h2><div class="news-grid">{relatedProducts.map((rel) => (<a href={rel.slug} class="news-card"><div class="news-card-body"><h3>{rel.name}</h3><p>SKU: {rel.sku}</p><span class="news-card-read-more">View Details →</span></div></a>))}</div></div></div></section><Footer />
</Layout>