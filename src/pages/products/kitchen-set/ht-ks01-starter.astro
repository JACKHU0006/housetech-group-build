---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'HT-KS01 Starter Kitchen Set - HouseTech Group | 3-Piece Kitchen Appliance Set, Range Hood + Gas Stove + Sterilizer';
const description = 'HouseTech HT-KS01 Starter Kitchen Set: 3-piece combo including range hood, gas stove, and sterilizer cabinet. Affordable complete kitchen solution for first-time homeowners.';

const product = {
  name: 'HT-KS01 Starter Kitchen Set',
  sku: 'HT-KS01',
  category: 'Kitchen Sets',
  price: 'Contact for Quote',
  image: '/images/products/kitchen-set/ht-ks01.jpg',
  shortDesc: 'Entry-level 3-piece kitchen set combining range hood, gas stove, and sterilizer cabinet. Affordable, reliable, and perfectly matched for first-time homeowners and budget-conscious buyers.',
  specs: {
    'Set Type': '3-Piece Starter Kitchen Set',
    'Included Items': 'Range Hood + Gas Stove + Sterilizer Cabinet',
    'Range Hood Model': 'HT-RH600 Slim Range Hood',
    'Range Hood Extraction': '800m³/h',
    'Range Hood Width': '60cm',
    'Gas Stove Model': 'HT-GS60 Double Burner Gas Stove',
    'Gas Stove Power': 'Left 4.0kW + Right 4.0kW',
    'Gas Stove Surface': 'Tempered Glass',
    'Gas Type': 'LPG / NG Dual Use',
    'Sterilizer Model': 'HT-SC60 Cabinet Sterilizer',
    'Sterilizer Capacity': '60L',
    'Sterilization Method': 'UV + Ozone',
    'Overall Style': 'Matching Stainless Steel & Black Glass',
    'Installation': 'Wall-mounted Hood + Countertop Stove + Built-in Sterilizer',
    'Warranty': '2 Years (Parts & Labor)',
    'Color': 'Silver / Black',
    'Set Savings': 'Up to 15% vs Individual Purchase'
  },
  features: [
    'Complete 3-piece kitchen solution at an affordable price point',
    'Perfectly matched design for cohesive kitchen aesthetics',
    'Range hood with 800m³/h extraction handles everyday cooking',
    'Double burner gas stove with 4.0kW per burner for efficient cooking',
    '60L sterilizer cabinet with UV + Ozone dual sterilization',
    'LPG/NG dual-use gas stove adapts to any gas supply',
    'Tempered glass stove surface for easy cleaning',
    'Coordinated silver and black finish across all three appliances',
    'Up to 15% savings compared to individual purchases',
    '2-year warranty covering parts and labor for peace of mind'
  ],
  applications: [
    'First-time homeowner kitchens',
    'Budget-conscious kitchen setups',
    'Apartment renovation projects',
    'Rental property kitchen upgrades',
    'Small family kitchen solutions'
  ]
};

const relatedProducts = [
  { name: 'HT-KS05 Premium Kitchen Set', slug: '/products/kitchen-set/ht-ks05-premium', sku: 'HT-KS05' },
  { name: 'HT-KS08 Luxury Kitchen Set', slug: '/products/kitchen-set/ht-ks08-luxury', sku: 'HT-KS08' },
  { name: 'HT-KS Commercial Kitchen Set', slug: '/products/kitchen-set/ht-ks-commercial', sku: 'HT-KS' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": "https://housetech-ch.com/images/products/kitchen-set/ht-ks01.jpg",
    "description": description,
    "brand": { "@type": "Brand", "name": "HouseTech" },
    "manufacturer": { "@type": "Organization", "name": "HouseTech Group" },
    "sku": product.sku,
    "category": "Kitchen Sets",
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "USD",
      "lowPrice": "0",
      "highPrice": "0",
      "offerCount": "1",
      "availability": "https://schema.org/InStock"
    }
  })} />
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the warranty period for HT-KS01 Starter Kitchen Set?",
        "acceptedAnswer": { "@type": "Answer", "Text": "All HouseTech products come with a comprehensive warranty. The HT-KS01 Starter Kitchen Set includes a 2-year manufacturer warranty covering all three appliances in the set." }
      },
      {
        "@type": "Question",
        "name": "Does HouseTech offer OEM/ODM customization for the HT-KS01?",
        "acceptedAnswer": { "@type": "Answer", "Text": "Yes, HouseTech offers full OEM/ODM services for kitchen sets including custom logo branding, appliance configurations, color matching, and packaging design to create a complete branded kitchen solution." }
      },
      {
        "@type": "Question",
        "name": "What is included in the HT-KS01 Starter Kitchen Set?",
        "acceptedAnswer": { "@type": "Answer", "Text": "The HT-KS01 includes: HT-RH600 Slim Range Hood (60cm, 800m³/h), HT-GS60 Double Burner Gas Stove (4.0kW x 2, tempered glass), and HT-SC60 Cabinet Sterilizer (60L, UV+Ozone)." }
      },
      {
        "@type": "Question",
        "name": "What certifications do the appliances in HT-KS01 have?",
        "acceptedAnswer": { "@type": "Answer", "Text": "All appliances in the HT-KS01 are certified with CE, CB, ETL, and RoHS standards, meeting safety and environmental requirements for European, Asian, and North American markets." }
      },
      {
        "@type": "Question",
        "name": "What is the delivery time for HT-KS01 orders?",
        "acceptedAnswer": { "@type": "Answer", "Text": "Standard delivery time for HT-KS01 orders is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days." }
      }
    ]
  })} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>{product.name}</h1>
      <p>SKU: {product.sku}</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <a href="/products/kitchen-set">Kitchen Sets</a>
        <span class="separator">/</span>
        <span>{product.name}</span>
      </nav>
    </div>
  </section>

  <!-- Product Detail -->
  <section class="content-section">
    <div class="container">
      <div class="product-detail-grid">
        <!-- Gallery -->
        <div class="product-gallery">
          <div class="product-gallery-main">
            <img src={product.image} alt={product.name} />
          </div>
          <div class="product-gallery-thumbs">
            <div class="product-thumb active">
              <img src={product.image} alt={`${product.name} - Main View`} />
            </div>
          </div>
        </div>

        <!-- Product Info -->
        <div class="product-info">
          <h1>{product.name}</h1>
          <p class="product-sku">SKU: {product.sku} | Category: {product.category}</p>
          <p class="product-short-desc">{product.shortDesc}</p>
          <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Curated by HouseTech, the HT-KS01 Starter Set provides essential matched appliances for new homeowners. As part of HouseTech's complete kitchen solutions, every set shares a unified design aesthetic. Every HouseTech product is CE/CB certified.</p>

          <!-- Specs Table -->
          <table class="product-specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr>
                  <th>{key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <!-- CTA Area -->
          <div class="product-cta-area">
            <a href="/contact" class="btn btn-primary">Get Quote</a>
            <a href="/download" class="btn btn-outline">Download Spec Sheet</a>
          </div>
        </div>
      </div>

      <!-- Features Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Key Features
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
          {product.features.map((feature) => (
            <div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="color: var(--color-text);">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Applications Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Applications
        </h2>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
          {product.applications.map((app) => (
            <span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">
              {app}
            </span>
          ))}
        </div>
      </div>

      <!-- Why Choose HouseTech -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p>
        <a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a>
      </div>

      <!-- Related Products -->
      <div class="related-products">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Related Products
        </h2>
        <div class="news-grid">
          {relatedProducts.map((rel) => (
            <a href={rel.slug} class="news-card">
              <div class="news-card-body">
                <h3>{rel.name}</h3>
                <p>SKU: {rel.sku}</p>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
