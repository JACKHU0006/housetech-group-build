---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'HT-OV80 Built-in Electric Oven - HouseTech Group | 80L Electric Oven, Pyrolytic Cleaning';
const description = 'HouseTech HT-OV80 Built-in Electric Oven: 80L capacity, 8 functions, pyrolytic self-cleaning. Premium built-in oven manufacturer.';

const product = {
  name: 'HT-OV80 Built-in Electric Oven',
  sku: 'HT-OV80',
  category: 'Ovens',
  image: '/images/products/oven/ht-ov80.jpg',
  shortDesc: '80L large capacity built-in electric oven with 8 cooking functions and pyrolytic self-cleaning for effortless maintenance.',
  specs: {
    'Capacity': '80L',
    'Functions': '8 (Top/Bottom Heat, Grill, Convection, etc.)',
    'Control Type': 'Digital Touch Control',
    'Cleaning': 'Pyrolytic Self-cleaning',
    'Timer': 'Digital Timer with Auto Shut-off',
    'Dimensions': '59.5 x 59.5 x 56cm',
    'Cut-out Size': '56 x 55 x 60cm',
    'Finish': 'Black Glass / Stainless Steel',
    'Door': 'Triple-glazed Cool-touch',
    'Energy Class': 'A',
    'Voltage': '220-240V / 50Hz',
    'Power': '2800W',
    'Gross Weight': '38kg'
  },
  features: [
    'Large 80L capacity for family cooking',
    '8 cooking functions: top/bottom heat, grill, convection, etc.',
    'Pyrolytic self-cleaning - eliminates manual scrubbing',
    'Digital touch control panel',
    'Triple-glazed cool-touch door',
    'Rotisserie function included',
    'Energy efficient Class A rating',
    'Catalytic back wall for easy cleaning',
    'Interior lighting for visibility'
  ],
  applications: [
    'Family kitchens',
    'Modern apartments',
    'Luxury homes',
    'Home baking enthusiasts',
    'Gourmet cooks'
  ]
};

const relatedProducts = [
  { name: 'HT-OV65 Convection Steam Oven', slug: '/products/oven/ht-ov65-convection-steam', sku: 'HT-OV65' },
  { name: 'HT-OV45 Compact Built-in Oven', slug: '/products/oven/ht-ov45-compact', sku: 'HT-OV45' },
  { name: 'HT-OV100 Professional Gas Oven', slug: '/products/oven/ht-ov100-professional', sku: 'HT-OV100' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": "https://housetech-ch.com/images/products/oven/ht-ov80.jpg",
    "description": description,
    "brand": { "@type": "Brand", "name": "HouseTech" },
    "manufacturer": { "@type": "Organization", "name": "HouseTech Group" },
    "sku": product.sku,
    "category": "Ovens",
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "USD",
      "lowPrice": "0",
      "highPrice": "0",
      "offerCount": "1",
      "availability": "https://schema.org/InStock"
    }
  })} />
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the warranty period for HT-OV80 Built-in Oven?",
        "acceptedAnswer": { "@type": "Answer", "Text": "All HouseTech products come with a comprehensive warranty. The HT-OV80 Built-in Oven includes a 2-year manufacturer warranty covering defects in materials and workmanship. Extended warranty options are available for B2B partners." }
      },
      {
        "@type": "Question",
        "name": "Does HouseTech offer OEM/ODM customization for the HT-OV80?",
        "acceptedAnswer": { "@type": "Answer", "Text": "Yes, HouseTech offers full OEM/ODM services for built-in ovens including custom logo branding, finish options (Black Glass/Stainless Steel), cooking function configurations, and packaging design to meet your market requirements." }
      },
      {
        "@type": "Question",
        "name": "What certifications does the HT-OV80 Built-in Oven have?",
        "acceptedAnswer": { "@type": "Answer", "Text": "The HT-OV80 is certified with CE, CB, ETL, and RoHS standards, meeting safety and environmental requirements for European, Asian, and North American markets." }
      },
      {
        "@type": "Question",
        "name": "What is the delivery time for HT-OV80 orders?",
        "acceptedAnswer": { "@type": "Answer", "Text": "Standard delivery time for HT-OV80 orders is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days. Express shipping options are available." }
      },
      {
        "@type": "Question",
        "name": "What cooking functions does the HT-OV80 support?",
        "acceptedAnswer": { "@type": "Answer", "Text": "The HT-OV80 features 8 cooking functions including top/bottom heat, grill, convection, fan-assisted cooking, and more. It also includes a rotisserie function and pyrolytic self-cleaning mode." }
      }
    ]
  })} />
  <Header activeNav="products" />
  <section class="page-hero">
    <div class="container">
      <h1>{product.name}</h1>
      <p>SKU: {product.sku}</p>
      <nav class="breadcrumb">
        <a href="/">Home</a><span class="separator">/</span>
        <a href="/products">Products</a><span class="separator">/</span>
        <a href="/products/oven">Ovens</a><span class="separator">/</span>
        <span>{product.name}</span>
      </nav>
    </div>
  </section>
  <section class="content-section">
    <div class="container">
      <div class="product-detail-grid">
        <div class="product-gallery">
          <div class="product-gallery-main"><img src={product.image} alt={product.name} /></div>
          <div class="product-gallery-thumbs"><div class="product-thumb active"><img src={product.image} alt={product.name} /></div></div>
        </div>
        <div class="product-info">
          <h1>{product.name}</h1>
          <p class="product-sku">SKU: {product.sku} | Category: {product.category}</p>
          <p class="product-short-desc">{product.shortDesc}</p>
          <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Engineered by HouseTech, the HT-OV80 is an 80L built-in electric oven with 8 functions and pyrolytic self-cleaning. As part of HouseTech's premium oven lineup, it combines large capacity with modern features. Every HouseTech product is CE/CB certified.</p>

          <table class="product-specs-table">
            <tbody>{Object.entries(product.specs).map(([key, value]) => (<tr><th>{key}</th><td>{value}</td></tr>))}</tbody>
          </table>
          <div class="product-cta-area">
            <a href="/contact" class="btn btn-primary">Get Quote</a>
            <a href="/download" class="btn btn-outline">Download Spec Sheet</a>
          </div>
        </div>
      </div>
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">Key Features</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
          {product.features.map((feature) => (<div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"></polyline></svg><span style="color: var(--color-text);">{feature}</span></div>))}
        </div>
      </div>
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">Applications</h2>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
          {product.applications.map((app) => (<span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">{app}</span>))}
        </div>
      </div>
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p>
        <a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a>
      </div>

      <div class="related-products">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">Related Products</h2>
        <div class="news-grid">{relatedProducts.map((rel) => (<a href={rel.slug} class="news-card"><div class="news-card-body"><h3>{rel.name}</h3><p>SKU: {rel.sku}</p><span class="news-card-read-more">View Details →</span></div></a>))}</div>
      </div>
    </div>
  </section>
  <Footer />
</Layout>
