---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'HT-AF80 Digital Air Fryer - HouseTech Group | 8L Air Fryer, 8 Presets, Digital Display';
const description = 'HouseTech HT-AF80 Digital Air Fryer: 8L capacity, 8 preset programs, digital touch control. Healthy cooking with 80% less oil.';

const product = {
  name: 'HT-AF80 Digital Air Fryer',
  sku: 'HT-AF80',
  category: 'Air Fryers',
  image: '/images/products/air-fryer/ht-af80.jpg',
  shortDesc: '8L digital air fryer with 8 preset cooking programs and easy-to-use digital display. Cook healthier meals with up to 80% less oil.',
  specs: {
    'Capacity': '8L',
    'Control Type': 'Digital Touch Control',
    'Presets': '8 Programs (Fries, Chicken, Steak, Fish, Vegetables, etc.)',
    'Temperature Range': '80-200°C',
    'Timer': '60 Minutes with Auto Shut-off',
    'Power': '1800W',
    'Dimensions': '33 x 33 x 38cm',
    'Finish': 'Black',
    'Basket': 'Non-stick Coating',
    'Material': 'BPA-Free Plastic & Metal',
    'Voltage': '220-240V / 50Hz',
    'Gross Weight': '7.5kg'
  },
  features: [
    'Large 8L capacity for family meals',
    '8 preset cooking programs for easy operation',
    'Digital touch control with LED display',
    'Temperature range 80-200°C',
    '60-minute timer with auto shut-off',
    'Rapid air circulation technology',
    'Non-stick basket for easy cleaning',
    'BPA-free materials for safe cooking',
    'Overheat protection'
  ],
  applications: [
    'Family cooking',
    'Healthy eating',
    'Quick weeknight meals',
    'Batch cooking',
    'Meal prep'
  ]
};

const relatedProducts = [
  { name: 'HT-AF55 Compact Air Fryer', slug: '/products/air-fryer/ht-af55-compact', sku: 'HT-AF55' },
  { name: 'HT-AF12L Large Capacity Air Fryer', slug: '/products/air-fryer/ht-af12l-large', sku: 'HT-AF12L' },
  { name: 'HT-AFS Smart Air Fryer', slug: '/products/air-fryer/ht-afs-smart', sku: 'HT-AFS' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": "https://housetech-ch.com/images/products/air-fryer/ht-af80.jpg",
    "description": description,
    "brand": { "@type": "Brand", "name": "HouseTech" },
    "manufacturer": { "@type": "Organization", "name": "HouseTech Group" },
    "sku": product.sku,
    "category": "Air Fryers",
    "offers": { "@type": "AggregateOffer", "priceCurrency": "USD", "lowPrice": "0", "highPrice": "0", "offerCount": "1", "availability": "https://schema.org/InStock" }
  })} />
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the warranty period for HT-AF80 Air Fryer?", "acceptedAnswer": { "@type": "Answer", "Text": "All HouseTech products come with a comprehensive warranty. The HT-AF80 includes a 2-year manufacturer warranty covering defects in materials and workmanship." } },
      { "@type": "Question", "name": "Does HouseTech offer OEM/ODM customization for the HT-AF80?", "acceptedAnswer": { "@type": "Answer", "Text": "Yes, HouseTech offers full OEM/ODM services including custom logo branding, color options, and packaging design." } },
      { "@type": "Question", "name": "What certifications does the HT-AF80 have?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-AF80 is certified with CE, CB, ETL, GS, and RoHS standards, meeting safety requirements for global markets." } },
      { "@type": "Question", "name": "What is the delivery time for HT-AF80 orders?", "acceptedAnswer": { "@type": "Answer", "Text": "Standard delivery time is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days." } },
      { "@type": "Question", "name": "How much oil can the HT-AF80 reduce compared to traditional frying?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-AF80 uses rapid air circulation technology to cook with up to 80% less oil than traditional deep frying methods." } }
    ]
  })} />
  <Header activeNav="products" />
  <section class="page-hero"><div class="container"><h1>{product.name}</h1><p>SKU: {product.sku}</p><nav class="breadcrumb"><a href="/">Home</a><span class="separator">/</span><a href="/products">Products</a><span class="separator">/</span><a href="/products/air-fryer">Air Fryers</a><span class="separator">/</span><span>{product.name}</span></nav></div></section>
  <section class="content-section"><div class="container"><div class="product-detail-grid"><div class="product-gallery"><div class="product-gallery-main"><img src={product.image} alt={product.name} /></div><div class="product-gallery-thumbs"><div class="product-thumb active"><img src={product.image} alt={product.name} /></div></div></div><div class="product-info"><h1>{product.name}</h1><p class="product-sku">SKU: {product.sku} | Category: {product.category}</p><p class="product-short-desc">{product.shortDesc}</p><p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Designed by HouseTech engineers, the HT-AF80 combines 8L capacity with intuitive digital controls to deliver healthier meals with up to 80% less oil. As part of HouseTech's premium kitchen appliance lineup, this air fryer reflects our commitment to quality and innovation. Every HouseTech product undergoes rigorous testing to ensure reliable performance for years to come.</p><table class="product-specs-table"><tbody>{Object.entries(product.specs).map(([key, value]) => (<tr><th>{key}</th><td>{value}</td></tr>))}</tbody></table><div class="product-cta-area"><a href="/contact" class="btn btn-primary">Get Quote</a><a href="/download" class="btn btn-outline">Download Spec Sheet</a></div></div></div><div style="margin-top: var(--spacing-3xl);"><h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">Key Features</h2><div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">{product.features.map((feature) => (<div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"></polyline></svg><span style="color: var(--color-text);">{feature}</span></div>))}</div></div><div style="margin-top: var(--spacing-3xl);"><h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">Applications</h2><div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">{product.applications.map((app) => (<span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">{app}</span>))}</div></div><div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);"><h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2><p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p><a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a></div><div class="related-products"><h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">Related Products</h2><div class="news-grid">{relatedProducts.map((rel) => (<a href={rel.slug} class="news-card"><div class="news-card-body"><h3>{rel.name}</h3><p>SKU: {rel.sku}</p><span class="news-card-read-more">View Details →</span></div></a>))}</div></div></div></section><Footer />
</Layout>
