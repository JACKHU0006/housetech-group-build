---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Schema from '../../../components/Schema.astro';

const title = 'HT-AF12L Large Capacity Air Fryer - HouseTech Group | 12L Air Fryer, 2000W, Digital Touch Control';
const description = 'HouseTech HT-AF12L Large Capacity Air Fryer: 12L capacity, 2000W powerful heating, digital touch control with 10 preset programs, ideal for commercial and large family use.';

const product = {
  name: 'HT-AF12L Large Capacity Air Fryer',
  sku: 'HT-AF12L',
  category: 'Air Fryers',
  price: 'Contact for Quote',
  image: '/images/products/air-fryer/ht-af12l.jpg',
  shortDesc: '12L large capacity air fryer with 2000W powerful heating, digital touch control, 10 preset cooking programs, and dual-layer basket design. Designed for commercial kitchens and large families.',
  specs: {
    'Capacity': '12L',
    'Power': '2000W',
    'Voltage': '220-240V / 50Hz',
    'Temperature Range': '80-200°C',
    'Timer': '60 Minutes',
    'Control Type': 'Digital Touch Control',
    'Preset Programs': '10 (Fries, Chicken, Steak, Fish, Pizza, Bake, Roast, Reheat, Dehydrate, Custom)',
    'Basket Design': 'Dual-Layer Rotating Basket',
    'Heating Technology': '360° 3D Rapid Air Circulation',
    'Display': 'LED Digital Display',
    'Cool Touch Handle': 'Yes',
    'Non-slip Feet': 'Yes',
    'Dishwasher Safe Parts': 'Yes',
    'Overheat Protection': 'Yes',
    'Auto Shut-off': 'Yes',
    'Color': 'Black / Stainless Steel',
    'Gross Weight': '7.8kg',
    'Product Dimensions': '380 × 380 × 420mm'
  },
  features: [
    '12L extra-large capacity for whole chicken and family-size meals',
    '2000W high-power heating system for rapid preheating in 2 minutes',
    'Digital touch control with intuitive LED display',
    '10 preset cooking programs for one-touch convenience',
    'Dual-layer rotating basket for even cooking on all sides',
    '360° 3D rapid air circulation technology',
    '60-minute timer with auto shut-off for unattended cooking',
    'Stainless steel heating element for durability',
    'Dishwasher safe removable basket and drip tray',
    'Overheat protection and safety lock mechanism'
  ],
  applications: [
    'Commercial kitchens',
    'Large family households',
    'Catering services',
    'Restaurant kitchens',
    'Food service businesses'
  ]
};

const relatedProducts = [
  { name: 'HT-AF55 Compact Air Fryer', slug: '/products/air-fryer/ht-af55-compact', sku: 'HT-AF55' },
  { name: 'HT-AFS Smart Air Fryer', slug: '/products/air-fryer/ht-afs-smart', sku: 'HT-AFS' },
  { name: 'HT-IC35 Commercial Induction Cooker', slug: '/products/induction-cooker/ht-ic35-commercial', sku: 'HT-IC35' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <Schema type="product" data={{
    name: product.name,
    description: description,
    image: [`https://housetech-ch.com${product.image}`],
    brand: "HouseTech",
    model: product.sku,
    certifications: ["CE", "CB", "ETL", "GS", "RoHS"],
    availability: "https://schema.org/InStock"
  }} />
  
  <!-- FAQ Schema -->
  <Schema type="faq" data={{
    items: [
      {
        question: "What is the warranty period for HT-AF12L Air Fryer?",
        answer: "All HouseTech products come with a comprehensive warranty. The HT-AF12L Air Fryer includes a 2-year manufacturer warranty covering defects in materials and workmanship. Extended warranty options are available for B2B partners."
      },
      {
        question: "Does HouseTech offer OEM/ODM customization for the HT-AF12L?",
        answer: "Yes, HouseTech offers full OEM/ODM services for air fryers including custom logo branding, color options (Black/Stainless Steel), packaging design, and preset program customization to meet your market requirements."
      },
      {
        question: "What certifications does the HT-AF12L Air Fryer have?",
        answer: "The HT-AF12L is certified with CE, CB, ETL, GS, and RoHS standards, meeting safety and environmental requirements for European, Asian, and North American markets."
      },
      {
        question: "What is the minimum order quantity (MOQ) for HT-AF12L?",
        answer: "HouseTech offers flexible MOQ starting from 50 units per model for OEM orders. For standard catalog products, smaller quantities may be available. Contact us for specific MOQ details."
      },
      {
        question: "What is the delivery time for HT-AF12L orders?",
        answer: "Standard delivery time for HT-AF12L orders is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days. Express shipping options are available."
      }
    ]
  }} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>{product.name}</h1>
      <p>SKU: {product.sku}</p>
      <Breadcrumb items={[
        { label: 'Home', href: '/' },
        { label: 'Products', href: '/products' },
        { label: 'Air Fryers', href: '/products/air-fryer' },
        { label: product.name, current: true }
      ]} />
    </div>
  </section>

  <!-- Product Detail -->
  <section class="content-section">
    <div class="container">
      <div class="product-detail-grid">
        <!-- Gallery -->
        <div class="product-gallery">
          <div class="product-gallery-main">
            <img src={product.image} alt={product.name} />
          </div>
          <div class="product-gallery-thumbs">
            <div class="product-thumb active">
              <img src={product.image} alt={`${product.name} - Main View`} />
            </div>
          </div>
        </div>

        <!-- Product Info -->
        <div class="product-info">
          <h1>{product.name}</h1>
          <p class="product-sku">SKU: {product.sku} | Category: {product.category}</p>
          <p class="product-short-desc">{product.shortDesc}</p>
          <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Designed by HouseTech engineers, the HT-AF12L delivers extra-large 12L capacity perfect for family gatherings and entertaining. As part of HouseTech's premium air fryer lineup, this model includes a rotisserie function and 10 cooking presets. Every HouseTech product is built to the highest quality standards with CE/CB certification.</p>

          <!-- Specs Table -->
          <table class="product-specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr>
                  <th>{key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <!-- CTA Area -->
          <div class="product-cta-area">
            <a href="/contact" class="btn btn-primary">Get Quote</a>
            <a href="/download" class="btn btn-outline">Download Spec Sheet</a>
          </div>
        </div>
      </div>

      <!-- Features Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Key Features
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
          {product.features.map((feature) => (
            <div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="color: var(--color-text);">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Applications Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Applications
        </h2>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
          {product.applications.map((app) => (
            <span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">
              {app}
            </span>
          ))}
        </div>
      </div>

      <!-- Why Choose HouseTech -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p>
        <a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a>
      </div>

      <!-- Related Products -->
      <div class="related-products">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Related Products
        </h2>
        <div class="news-grid">
          {relatedProducts.map((rel) => (
            <a href={rel.slug} class="news-card">
              <div class="news-card-body">
                <h3>{rel.name}</h3>
                <p>SKU: {rel.sku}</p>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
