---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'HT-AF55 Compact Air Fryer - HouseTech Group | 5.5L Air Fryer, 1300W, 80-200°C';
const description = 'HouseTech HT-AF55 Compact Air Fryer: 5.5L capacity, 1300W power, mechanical knob control, 80-200°C temperature range, 30-minute timer. Perfect for small families and compact kitchens.';

const product = {
  name: 'HT-AF55 Compact Air Fryer',
  sku: 'HT-AF55',
  category: 'Air Fryers',
  price: 'Contact for Quote',
  image: '/images/products/air-fryer/ht-af55.jpg',
  shortDesc: '5.5L compact air fryer with mechanical knob control, 1300W high power, 80-200°C precise temperature range, and 30-minute timer. Ideal for small families and everyday cooking.',
  specs: {
    'Capacity': '5.5L',
    'Power': '1300W',
    'Voltage': '220-240V / 50Hz',
    'Temperature Range': '80-200°C',
    'Timer': '30 Minutes',
    'Control Type': 'Mechanical Knob',
    'Basket Material': 'Non-stick Coated',
    'Heating Technology': '360° Rapid Air Circulation',
    'Cool Touch Handle': 'Yes',
    'Non-slip Feet': 'Yes',
    'Dishwasher Safe Parts': 'Yes',
    'Overheat Protection': 'Yes',
    'Color': 'Black / White',
    'Gross Weight': '4.2kg',
    'Product Dimensions': '315 × 315 × 350mm'
  },
  features: [
    '5.5L capacity perfect for 2-3 person families',
    '1300W high-power heating for fast preheating',
    'Mechanical knob control for intuitive operation',
    '80-200°C wide temperature range for versatile cooking',
    '30-minute timer with auto shut-off',
    '360° rapid air circulation for even cooking results',
    'Non-stick coated basket for easy food release and cleaning',
    'Cool touch handle for safe operation',
    'Dishwasher safe removable parts',
    'Overheat protection for enhanced safety'
  ],
  applications: [
    'Small family kitchens',
    'Apartment cooking',
    'Dormitory kitchens',
    'Office pantries',
    'Quick healthy meal preparation'
  ]
};

const relatedProducts = [
  { name: 'HT-AF12L Large Capacity Air Fryer', slug: '/products/air-fryer/ht-af12l-large', sku: 'HT-AF12L' },
  { name: 'HT-AFS Smart Air Fryer', slug: '/products/air-fryer/ht-afs-smart', sku: 'HT-AFS' },
  { name: 'HT-IC20 Portable Induction Cooker', slug: '/products/induction-cooker/ht-ic20-portable', sku: 'HT-IC20' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": "https://housetech-ch.com/images/products/air-fryer/ht-af55.jpg",
    "description": description,
    "brand": { "@type": "Brand", "name": "HouseTech" },
    "manufacturer": { "@type": "Organization", "name": "HouseTech Group" },
    "sku": product.sku,
    "category": "Air Fryers",
    "offers": { "@type": "AggregateOffer", "priceCurrency": "USD", "lowPrice": "0", "highPrice": "0", "offerCount": "1", "availability": "https://schema.org/InStock" }
  })} />
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the warranty period for HT-AF55 Air Fryer?", "acceptedAnswer": { "@type": "Answer", "Text": "All HouseTech products come with a comprehensive warranty. The HT-AF55 includes a 2-year manufacturer warranty covering defects in materials and workmanship." } },
      { "@type": "Question", "name": "Does HouseTech offer OEM/ODM customization for the HT-AF55?", "acceptedAnswer": { "@type": "Answer", "Text": "Yes, HouseTech offers full OEM/ODM services including custom logo branding, color options (Black/White), and packaging design." } },
      { "@type": "Question", "name": "What certifications does the HT-AF55 have?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-AF55 is certified with CE, CB, ETL, GS, and RoHS standards, meeting safety requirements for global markets." } },
      { "@type": "Question", "name": "What is the minimum order quantity (MOQ) for HT-AF55?", "acceptedAnswer": { "@type": "Answer", "Text": "HouseTech offers flexible MOQ starting from 50 units per model for OEM orders. Contact us for specific details." } },
      { "@type": "Question", "name": "What is the delivery time for HT-AF55 orders?", "acceptedAnswer": { "@type": "Answer", "Text": "Standard delivery time is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days." } }
    ]
  })} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>{product.name}</h1>
      <p>SKU: {product.sku}</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <a href="/products/air-fryer">Air Fryers</a>
        <span class="separator">/</span>
        <span>{product.name}</span>
      </nav>
    </div>
  </section>

  <!-- Product Detail -->
  <section class="content-section">
    <div class="container">
      <div class="product-detail-grid">
        <!-- Gallery -->
        <div class="product-gallery">
          <div class="product-gallery-main">
            <img src={product.image} alt={product.name} />
          </div>
          <div class="product-gallery-thumbs">
            <div class="product-thumb active">
              <img src={product.image} alt={`${product.name} - Main View`} />
            </div>
          </div>
        </div>

        <!-- Product Info -->
        <div class="product-info">
          <h1>{product.name}</h1>
          <p class="product-sku">SKU: {product.sku} | Category: {product.category}</p>
          <p class="product-short-desc">{product.shortDesc}</p>
          <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Designed by HouseTech engineers, the HT-AF55 combines 5.5L capacity with intuitive knob control for effortless everyday cooking. As part of HouseTech's premium air fryer lineup, this compact model delivers powerful 360° rapid air circulation. Every HouseTech product is built to the highest quality standards with CE/CB certification.</p>

          <!-- Specs Table -->
          <table class="product-specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr>
                  <th>{key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <!-- CTA Area -->
          <div class="product-cta-area">
            <a href="/contact" class="btn btn-primary">Get Quote</a>
            <a href="/download" class="btn btn-outline">Download Spec Sheet</a>
          </div>
        </div>
      </div>

      <!-- Features Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Key Features
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
          {product.features.map((feature) => (
            <div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="color: var(--color-text);">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Applications Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Applications
        </h2>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
          {product.applications.map((app) => (
            <span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">
              {app}
            </span>
          ))}
        </div>
      </div>

      <!-- Why Choose HouseTech -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p>
        <a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a>
      </div>

      <!-- Related Products -->
      <div class="related-products">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Related Products
        </h2>
        <div class="news-grid">
          {relatedProducts.map((rel) => (
            <a href={rel.slug} class="news-card">
              <div class="news-card-body">
                <h3>{rel.name}</h3>
                <p>SKU: {rel.sku}</p>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
