---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'HT-AFS Smart Air Fryer - HouseTech Group | 6.5L WiFi Air Fryer, App Control, 9 Presets';
const description = 'HouseTech HT-AFS Smart Air Fryer: 6.5L capacity, WiFi/App remote control, 9 preset programs, LED display, 1700W. Smart kitchen appliance for connected homes.';

const product = {
  name: 'HT-AFS Smart Air Fryer',
  sku: 'HT-AFS',
  category: 'Air Fryers',
  price: 'Contact for Quote',
  image: '/images/products/air-fryer/ht-afs.jpg',
  shortDesc: '6.5L smart air fryer with WiFi and App control, 9 preset cooking programs, LED display, 1700W powerful heating. Seamlessly integrates with your smart home ecosystem.',
  specs: {
    'Capacity': '6.5L',
    'Power': '1700W',
    'Voltage': '220-240V / 50Hz',
    'Temperature Range': '80-200°C',
    'Timer': '60 Minutes',
    'Control Type': 'WiFi / App / Touch Control',
    'Preset Programs': '9 (Fries, Chicken, Steak, Seafood, Bake, Roast, Reheat, Dehydrate, Custom)',
    'Connectivity': 'WiFi 802.11 b/g/n (2.4GHz)',
    'App Compatibility': 'iOS 10+ / Android 6.0+',
    'Display': 'LED Digital Display',
    'Heating Technology': '360° Rapid Air Circulation',
    'Voice Control': 'Alexa / Google Assistant Compatible',
    'Cool Touch Handle': 'Yes',
    'Non-slip Feet': 'Yes',
    'Dishwasher Safe Parts': 'Yes',
    'Overheat Protection': 'Yes',
    'Auto Shut-off': 'Yes',
    'Color': 'Matte Black',
    'Gross Weight': '5.1kg',
    'Product Dimensions': '330 × 330 × 380mm'
  },
  features: [
    'WiFi connectivity for remote monitoring and control via smartphone App',
    '6.5L capacity ideal for medium-sized families',
    '9 preset cooking programs with one-touch start',
    '1700W rapid heating with 360° air circulation technology',
    'LED digital display with intuitive touch interface',
    'Voice control compatible with Alexa and Google Assistant',
    'Real-time cooking notifications and remote timer adjustment',
    'Custom cooking profiles save your favorite recipes',
    'Dishwasher safe non-stick basket for easy cleanup',
    'Smart scheduling for delayed cooking start'
  ],
  applications: [
    'Smart home kitchens',
    'Modern family households',
    'Tech-savvy home cooks',
    'Health-conscious cooking',
    'Busy professionals'
  ]
};

const relatedProducts = [
  { name: 'HT-AF55 Compact Air Fryer', slug: '/products/air-fryer/ht-af55-compact', sku: 'HT-AF55' },
  { name: 'HT-AF12L Large Capacity Air Fryer', slug: '/products/air-fryer/ht-af12l-large', sku: 'HT-AF12L' },
  { name: 'HT-IC-Integrated Induction Hob', slug: '/products/induction-cooker/ht-ic-integrated', sku: 'HT-IC' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": "https://housetech-ch.com/images/products/air-fryer/ht-afs.jpg",
    "description": description,
    "brand": { "@type": "Brand", "name": "HouseTech" },
    "manufacturer": { "@type": "Organization", "name": "HouseTech Group" },
    "sku": product.sku,
    "category": "Air Fryers",
    "offers": { "@type": "AggregateOffer", "priceCurrency": "USD", "lowPrice": "0", "highPrice": "0", "offerCount": "1", "availability": "https://schema.org/InStock" }
  })} />
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the warranty period for HT-AFS Smart Air Fryer?", "acceptedAnswer": { "@type": "Answer", "Text": "All HouseTech products come with a comprehensive warranty. The HT-AFS includes a 2-year manufacturer warranty covering defects in materials and workmanship." } },
      { "@type": "Question", "name": "Does HouseTech offer OEM/ODM customization for the HT-AFS?", "acceptedAnswer": { "@type": "Answer", "Text": "Yes, HouseTech offers full OEM/ODM services including custom logo branding, App customization, and packaging design." } },
      { "@type": "Question", "name": "What certifications does the HT-AFS have?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-AFS is certified with CE, CB, ETL, GS, and RoHS standards, meeting safety requirements for global markets." } },
      { "@type": "Question", "name": "What smart home platforms does the HT-AFS support?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-AFS supports WiFi connectivity and is compatible with Alexa and Google Assistant for voice control, plus a dedicated mobile App for iOS and Android." } },
      { "@type": "Question", "name": "What is the delivery time for HT-AFS orders?", "acceptedAnswer": { "@type": "Answer", "Text": "Standard delivery time is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days." } }
    ]
  })} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>{product.name}</h1>
      <p>SKU: {product.sku}</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <a href="/products/air-fryer">Air Fryers</a>
        <span class="separator">/</span>
        <span>{product.name}</span>
      </nav>
    </div>
  </section>

  <!-- Product Detail -->
  <section class="content-section">
    <div class="container">
      <div class="product-detail-grid">
        <!-- Gallery -->
        <div class="product-gallery">
          <div class="product-gallery-main">
            <img src={product.image} alt={product.name} />
          </div>
          <div class="product-gallery-thumbs">
            <div class="product-thumb active">
              <img src={product.image} alt={`${product.name} - Main View`} />
            </div>
          </div>
        </div>

        <!-- Product Info -->
        <div class="product-info">
          <h1>{product.name}</h1>
          <p class="product-sku">SKU: {product.sku} | Category: {product.category}</p>
          <p class="product-short-desc">{product.shortDesc}</p>
          <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Designed by HouseTech engineers, the HT-AFS brings smart Wi-Fi connectivity to air frying. As part of HouseTech's innovative smart appliance lineup, this model allows remote control via smartphone app with 12 cooking presets. Every HouseTech product is built to the highest quality standards with CE/CB certification.</p>

          <!-- Specs Table -->
          <table class="product-specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr>
                  <th>{key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <!-- CTA Area -->
          <div class="product-cta-area">
            <a href="/contact" class="btn btn-primary">Get Quote</a>
            <a href="/download" class="btn btn-outline">Download Spec Sheet</a>
          </div>
        </div>
      </div>

      <!-- Features Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Key Features
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
          {product.features.map((feature) => (
            <div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="color: var(--color-text);">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Applications Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Applications
        </h2>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
          {product.applications.map((app) => (
            <span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">
              {app}
            </span>
          ))}
        </div>
      </div>

      <!-- Why Choose HouseTech -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p>
        <a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a>
      </div>

      <!-- Related Products -->
      <div class="related-products">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Related Products
        </h2>
        <div class="news-grid">
          {relatedProducts.map((rel) => (
            <a href={rel.slug} class="news-card">
              <div class="news-card-body">
                <h3>{rel.name}</h3>
                <p>SKU: {rel.sku}</p>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
