      'Family cooking',
      'Healthy eating',
      'Quick meals',
      'Batch cooking'
    ]
  },
  {
    name: 'HT-AF55 Compact Air Fryer',
    slug: 'ht-af55-compact',
    sku: 'HT-AF55',
    category: 'Air Fryers',
    shortDesc: '5.5L compact air fryer with one-touch operation. Perfect for small households.',
    image: '/images/products/air-fryer/ht-af55.jpg',
