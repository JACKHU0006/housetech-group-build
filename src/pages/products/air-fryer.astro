      'Small households',
      'Couples',
      'Single person kitchens',
      'Office pantries'
    ]
  },
  {
    name: 'HT-AF12L Large Capacity Air Fryer',
    slug: 'ht-af12l-large',
    sku: 'HT-AF12L',
    category: 'Air Fryers',
    shortDesc: '12L extra-large family size air fryer for big batches and whole meals.',
    image: '/images/products/air-fryer/ht-af12l.jpg',
    specs: {
      'Capacity': '12L',
      'Control': 'Digital Touch',
      'Presets': '10 Programs',
      'Temperature': '35-200°C',
      'Timer': '60 Minutes',
      'Power': '2100W',
      'Dimensions': '38 x 38 x 42cm',
      'Accessories': 'Rotisserie, Rack, Basket'
    },
    features: [
      'Extra-large 12L capacity',
      'Whole meals in one batch',
      'Includes rotisserie and accessories',
      '10 cooking presets',
      'Wide temperature range 35-200°C',
      'Digital display with easy controls',
      'Stainless steel heating element',
      'Transparent viewing window'
