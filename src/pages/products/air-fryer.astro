  {
    name: 'HT-AFS Smart Air Fryer',
    slug: 'ht-afs-smart',
    sku: 'HT-AFS',
    category: 'Air Fryers',
    shortDesc: 'Smart Wi-Fi enabled air fryer with app control. Remote monitoring and recipes.',
