---

<Layout title={title} description={description}>
  <!-- BreadcrumbList Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://housetech-ch.com/" },
      { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://housetech-ch.com/products/" },
      { "@type": "ListItem", "position": 3, "name": "Air Fryers", "item": "https://housetech-ch.com/products/air-fryer/" }
    ]
  })} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>Air Fryers</h1>
      <p>Healthy cooking appliances - Air Fryers, Digital Air Fryers, Electric Air Fryers, Oil Free Air Fryers, Large Air Fryers, Compact Air Fryers, Healthy Air Fryers, Multi-function Air Fryers, Smart Air Fryers</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <span>Air Fryers</span>
      </nav>
    </div>
  </section>

  <!-- Category Introduction -->
  <section class="content-section">
    <div class="container">
      <div style="max-width: 900px; margin: 0 auto;">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-md);">
          Smart Air Fryers by HouseTech Group
        </h2>
        <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">
          HouseTech Group is a leading air fryer manufacturer offering comprehensive healthy cooking solutions for global B2B partners. Our air fryer collection includes Digital Air Fryers, Compact Air Fryers, Large Capacity Air Fryers, and Smart Wi-Fi Air Fryers designed for modern households. As an experienced OEM/ODM kitchen appliance factory, we provide custom manufacturing services including capacity options, control systems, smart features, and branding.
        </p>
        <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-lg);">
          Our air fryers use rapid air circulation technology to cook food with little to no oil, reducing fat content by up to 80% compared to traditional frying. From compact 5.5L models for singles to extra-large 12L models for families, HouseTech has options for every household size. Smart Wi-Fi enabled models allow remote control via smartphone apps, making healthy cooking more convenient than ever. Each HouseTech air fryer is manufactured with BPA-free materials and undergoes strict quality testing.
        </p>
      </div>

      <!-- Products Grid -->
      <div class="news-grid" style="margin-top: var(--spacing-2xl);">
        {products.map((product) => (
          <a href={`/products/air-fryer/${product.slug}`} class="news-card">
            <div class="news-card-image">
              <img src={product.image} alt={product.name} loading="lazy" />
              <span class="news-card-category">{product.category}</span>
            </div>
            <div class="news-card-body">
              <h3>{product.name}</h3>
              <p>{product.shortDesc}</p>
              <div class="news-card-meta">
                <span>SKU: {product.sku}</span>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- OEM/ODM Section -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Need Custom Air Fryers?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">
          HouseTech Group offers full OEM/ODM services for air fryers including custom capacities, control systems, smart features, and branding options. Contact us to discuss your requirements.
        </p>
        <a href="/service" class="btn btn-primary">Learn About OEM/ODM Services →</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>