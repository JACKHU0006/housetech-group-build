    specs: {
      'Capacity': '6L',
      'Control': 'App + Touch',
      'Connectivity': 'Wi-Fi / Smart Home',
      'Presets': '12 Programs',
      'Temperature': '80-200°C',
      'Timer': '24 Hours',
      'Power': '1700W',
      'App': 'iOS / Android Compatible'
    },
    features: [
      'Wi-Fi connectivity for remote control',
      'Compatible with smartphone app',
      '12 smart cooking presets',
      'Voice control compatible (Alexa/Google)',
      '24-hour programmable timer',
      'Recipe library in app',
      'Push notification when cooking is done',
