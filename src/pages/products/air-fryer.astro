---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = 'Air Fryers - HouseTech Group | Digital Air Fryer, Electric Air Fryer, Healthy Cooking';
const description = 'Discover HouseTech Group\'s premium air fryer collection: Digital Air Fryers, Electric Air Fryers, Large Air Fryers, Compact Air Fryers, Smart Air Fryers with Wi-Fi. OEM/ODM available for global B2B partners.';

// Products data
const products = [
  {
    name: 'HT-AF80 Digital Air Fryer',
    slug: 'ht-af80-digital',
    sku: 'HT-AF80',
    category: 'Air Fryers',
    shortDesc: '8L digital air fryer with 8 preset programs and easy-to-use digital display.',
    image: '/images/products/air-fryer/ht-af80.jpg',
    specs: {
