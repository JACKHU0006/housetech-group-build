---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'HT-IC4Q 4-Burner Induction Cooktop - HouseTech Group | Professional 4 Zone Induction';
const description = 'HouseTech HT-IC4Q Built-in 4-Burner Induction Cooktop: 7200W, 2 bridge zones, boost function. Professional-grade performance.';

const product = {
  name: 'HT-IC4Q 4-Burner Induction Cooktop',
  sku: 'HT-IC4Q',
  category: 'Induction Cookers',
  image: '/images/products/induction-cooker/ht-ic4q.jpg',
  shortDesc: 'Built-in 4-burner induction cooktop with bridge zones. Professional-grade performance for serious home chefs.',
  specs: {
    'Type': 'Induction Cooktop',
    'Power': '7200W (total)',
    'Burners': '4',
    'Control Type': 'Touch Control',
    'Dimensions': '77 x 52 x 6cm',
    'Cut-out Size': '74 x 49cm',
    'Surface': 'Black Glass',
    'Bridge Zones': '2',
    'Power Levels': '9 + Boost',
    'Timer': '99 Minutes (each zone)',
    'Safety': 'Child Lock, Auto Pan Detection',
    'Voltage': '220-240V / 50Hz',
    'Gross Weight': '14kg'
  },
  features: [
    'Professional-grade 4 burners',
    '7200W total power',
    '2 bridge zones for large cookware',
    'Precise temperature control',
    'Boost function for rapid heating',
    'Auto pan detection',
    'Child lock safety feature',
    'Timer on each zone',
    'Sleek modern design'
  ],
  applications: [
    'Large families',
    'Home chefs',
    'Cooking enthusiasts',
    'Professional-style kitchens',
    'Entertaining frequently'
  ]
};

const relatedProducts = [
  { name: 'HT-IC35 Induction Cooktop', slug: '/products/induction-cooker/ht-ic35-single', sku: 'HT-IC35' },
  { name: 'HT-IC21 Dual Induction Hob', slug: '/products/induction-cooker/ht-ic21-dual', sku: 'HT-IC21' },
  { name: 'HT-CC30 Ceramic Cooker', slug: '/products/induction-cooker/ht-cc30-ceramic', sku: 'HT-CC30' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": "https://housetech-ch.com/images/products/induction-cooker/ht-ic4q.jpg",
    "description": description,
    "brand": { "@type": "Brand", "name": "HouseTech" },
    "manufacturer": { "@type": "Organization", "name": "HouseTech Group" },
    "sku": product.sku,
    "category": "Induction Cookers",
    "offers": { "@type": "AggregateOffer", "priceCurrency": "USD", "lowPrice": "0", "highPrice": "0", "offerCount": "1", "availability": "https://schema.org/InStock" }
  })} />
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the warranty period for HT-IC4Q Induction Cooktop?", "acceptedAnswer": { "@type": "Answer", "Text": "All HouseTech products come with a comprehensive warranty. The HT-IC4Q includes a 2-year manufacturer warranty covering defects in materials and workmanship." } },
      { "@type": "Question", "name": "Does HouseTech offer OEM/ODM customization for the HT-IC4Q?", "acceptedAnswer": { "@type": "Answer", "Text": "Yes, HouseTech offers full OEM/ODM services including custom logo branding and packaging design." } },
      { "@type": "Question", "name": "What certifications does the HT-IC4Q have?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-IC4Q is certified with CE, CB, ETL, and RoHS standards, meeting safety requirements for global markets." } },
      { "@type": "Question", "name": "What is the delivery time for HT-IC4Q orders?", "acceptedAnswer": { "@type": "Answer", "Text": "Standard delivery time is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days." } },
      { "@type": "Question", "name": "What special features does the HT-IC4Q include?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-IC4Q includes 2 bridge zones for large cookware, boost function for rapid heating, child lock, and timer on each zone." } }
    ]
  })} />
  <Header activeNav="products" />
  <section class="page-hero"><div class="container"><h1>{product.name}</h1><p>SKU: {product.sku}</p><nav class="breadcrumb"><a href="/">Home</a><span class="separator">/</span><a href="/products">Products</a><span class="separator">/</span><a href="/products/induction-cooker">Induction Cookers</a><span class="separator">/</span><span>{product.name}</span></nav></div></section>
  <section class="content-section"><div class="container"><div class="product-detail-grid"><div class="product-gallery"><div class="product-gallery-main"><img src={product.image} alt={product.name} /></div><div class="product-gallery-thumbs"><div class="product-thumb active"><img src={product.image} alt={product.name} /></div></div></div><div class="product-info"><h1>{product.name}</h1><p class="product-sku">SKU: {product.sku} | Category: {product.category}</p><p class="product-short-desc">{product.shortDesc}</p><p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Engineered by HouseTech, the HT-IC4Q is a professional-grade 4-burner induction cooktop with 7200W total power. As part of HouseTech's premium induction lineup, it suits large family kitchens. Every HouseTech product is CE/CB certified.</p><table class="product-specs-table"><tbody>{Object.entries(product.specs).map(([key, value]) => (<tr><th>{key}</th><td>{value}</td></tr>))}</tbody></table><div class="product-cta-area"><a href="/contact" class="btn btn-primary">Get Quote</a><a href="/download" class="btn btn-outline">Download Spec Sheet</a></div></div></div><div style="margin-top: var(--spacing-3xl);"><h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">Key Features</h2><div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">{product.features.map((feature) => (<div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"></polyline></svg><span style="color: var(--color-text);">{feature}</span></div>))}</div></div><div style="margin-top: var(--spacing-3xl);"><h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">Applications</h2><div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">{product.applications.map((app) => (<span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">{app}</span>))}</div></div><div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);"><h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2><p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p><a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a></div><div class="related-products"><h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">Related Products</h2><div class="news-grid">{relatedProducts.map((rel) => (<a href={rel.slug} class="news-card"><div class="news-card-body"><h3>{rel.name}</h3><p>SKU: {rel.sku}</p><span class="news-card-read-more">View Details →</span></div></a>))}</div></div></div></section><Footer />
</Layout>