---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'HT-IC20 Portable Induction Cooker - HouseTech Group | 2000W Single Burner, Touch & Button Control';
const description = 'HouseTech HT-IC20 Portable Induction Cooker: 2000W single burner, touch and button dual control, 10 power levels, compact portable design for flexible cooking anywhere.';

const product = {
  name: 'HT-IC20 Portable Induction Cooker',
  sku: 'HT-IC20',
  category: 'Induction Cookers',
  price: 'Contact for Quote',
  image: '/images/products/induction-cooker/ht-ic20.jpg',
  shortDesc: '2000W portable single induction cooker with touch and button dual control, 10 power levels, compact flat design. Versatile cooking solution for home, office, and outdoor use.',
  specs: {
    'Type': 'Portable Single Induction Cooker',
    'Power': '2000W',
    'Voltage': '220-240V / 50Hz',
    'Number of Zones': '1',
    'Zone Diameter': 'Φ200mm',
    'Control Type': 'Touch + Button Dual Control',
    'Power Levels': '10',
    'Temperature Range': '60-240°C',
    'Timer': '0-180 Minutes',
    'Panel Material': 'Black Crystal Glass (Microcrystalline)',
    'Heating Mode': 'Electromagnetic Induction',
    'Pan Detection': 'Auto Pan Detection',
    'Safety Features': 'Over-heat Protection, Auto Shut-off, Child Lock',
    'Fan Cooling': 'Yes (Low-noise)',
    'Cord Length': '1.5m',
    'Color': 'Black',
    'Gross Weight': '2.8kg',
    'Product Dimensions': '340 × 280 × 65mm'
  },
  features: [
    '2000W high power for rapid heating and stir-frying',
    'Touch and button dual control for intuitive operation',
    '10 precision power levels for versatile cooking',
    'Black crystal glass panel — durable and easy to clean',
    'Auto pan detection shuts off when cookware is removed',
    '0-180 minute timer with auto shut-off',
    'Compact and portable for use anywhere with a power outlet',
    'Low-noise fan cooling system for continuous operation',
    'Child lock prevents accidental activation',
    'Compatible with all ferromagnetic cookware (cast iron, stainless steel)'
  ],
  applications: [
    'Home kitchen supplementary cooking',
    'Student dormitory cooking',
    'Office pantry cooking',
    'Outdoor camping (with power supply)',
    'Small apartment kitchens'
  ]
};

const relatedProducts = [
  { name: 'HT-IC32 Double Induction Cooker', slug: '/products/induction-cooker/ht-ic32-double', sku: 'HT-IC32' },
  { name: 'HT-IC35 Commercial Induction Cooker', slug: '/products/induction-cooker/ht-ic35-commercial', sku: 'HT-IC35' },
  { name: 'HT-IC Integrated Induction Hob', slug: '/products/induction-cooker/ht-ic-integrated', sku: 'HT-IC' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": "https://housetech-ch.com/images/products/induction-cooker/ht-ic20.jpg",
    "description": description,
    "brand": { "@type": "Brand", "name": "HouseTech" },
    "manufacturer": { "@type": "Organization", "name": "HouseTech Group" },
    "sku": product.sku,
    "category": "Induction Cookers",
    "offers": { "@type": "AggregateOffer", "priceCurrency": "USD", "lowPrice": "0", "highPrice": "0", "offerCount": "1", "availability": "https://schema.org/InStock" }
  })} />
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the warranty period for HT-IC20 Portable Induction Cooker?", "acceptedAnswer": { "@type": "Answer", "Text": "All HouseTech products come with a comprehensive warranty. The HT-IC20 includes a 2-year manufacturer warranty covering defects in materials and workmanship." } },
      { "@type": "Question", "name": "Does HouseTech offer OEM/ODM customization for the HT-IC20?", "acceptedAnswer": { "@type": "Answer", "Text": "Yes, HouseTech offers full OEM/ODM services including custom logo branding, color options, and packaging design." } },
      { "@type": "Question", "name": "What certifications does the HT-IC20 have?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-IC20 is certified with CE, CB, ETL, and RoHS standards, meeting safety requirements for European, Asian, and North American markets." } },
      { "@type": "Question", "name": "What safety features does the HT-IC20 include?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-IC20 includes overheat protection, auto shut-off, child lock, and auto pan detection for enhanced safety." } },
      { "@type": "Question", "name": "What is the delivery time for HT-IC20 orders?", "acceptedAnswer": { "@type": "Answer", "Text": "Standard delivery time is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days." } }
    ]
  })} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>{product.name}</h1>
      <p>SKU: {product.sku}</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <a href="/products/induction-cooker">Induction Cookers</a>
        <span class="separator">/</span>
        <span>{product.name}</span>
      </nav>
    </div>
  </section>

  <!-- Product Detail -->
  <section class="content-section">
    <div class="container">
      <div class="product-detail-grid">
        <!-- Gallery -->
        <div class="product-gallery">
          <div class="product-gallery-main">
            <img src={product.image} alt={product.name} />
          </div>
          <div class="product-gallery-thumbs">
            <div class="product-thumb active">
              <img src={product.image} alt={`${product.name} - Main View`} />
            </div>
          </div>
        </div>

        <!-- Product Info -->
        <div class="product-info">
          <h1>{product.name}</h1>
          <p class="product-sku">SKU: {product.sku} | Category: {product.category}</p>
          <p class="product-short-desc">{product.shortDesc}</p>
          <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Engineered by HouseTech, the HT-IC20 is a portable single-burner induction cooktop for flexible cooking anywhere. As part of HouseTech's versatile induction lineup, it offers instant heat with energy efficiency. Every HouseTech product is CE/CB certified.</p>

          <!-- Specs Table -->
          <table class="product-specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr>
                  <th>{key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <!-- CTA Area -->
          <div class="product-cta-area">
            <a href="/contact" class="btn btn-primary">Get Quote</a>
            <a href="/download" class="btn btn-outline">Download Spec Sheet</a>
          </div>
        </div>
      </div>

      <!-- Features Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Key Features
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
          {product.features.map((feature) => (
            <div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="color: var(--color-text);">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Applications Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Applications
        </h2>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
          {product.applications.map((app) => (
            <span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">
              {app}
            </span>
          ))}
        </div>
      </div>

      <!-- Why Choose HouseTech -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p>
        <a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a>
      </div>

      <!-- Related Products -->
      <div class="related-products">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Related Products
        </h2>
        <div class="news-grid">
          {relatedProducts.map((rel) => (
            <a href={rel.slug} class="news-card">
              <div class="news-card-body">
                <h3>{rel.name}</h3>
                <p>SKU: {rel.sku}</p>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
