---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'HT-CC30 Ceramic Cooker - HouseTech Group | Infrared Cooker, No EMF, All Cookware';
const description = 'HouseTech HT-CC30 Ceramic Cooker: Infrared heating technology, no EMF, works with all cookware. Safe alternative to induction.';

const product = {
  name: 'HT-CC30 Ceramic Cooker',
  sku: 'HT-CC30',
  category: 'Induction Cookers',
  image: '/images/products/induction-cooker/ht-cc30.jpg',
  shortDesc: 'Ceramic infrared cooker with no EMF concern. Safe alternative to induction, works with any cookware type.',
  specs: {
    'Type': 'Ceramic Infrared Cooker',
    'Power': '2000W',
    'Burners': '2',
    'Control Type': 'Knob Control',
    'Technology': 'Infrared Heating',
    'Dimensions': '58 x 51 x 8cm',
    'Surface': 'Ceramic Glass',
    'Cookware': 'All Types Compatible',
    'Temperature': '5 Power Levels',
    'Voltage': '220-240V / 50Hz',
    'Gross Weight': '9kg'
  },
  features: [
    'Infrared heating - no EMF',
    'Works with any cookware type',
    'Safe for all cookware materials',
    'Ceramic glass surface',
    'Knob control for easy operation',
    'Instant heat without induction',
    'No magnetic field concerns',
    'Elegant modern design',
    'Easy to clean'
  ],
  applications: [
    'Users with EMF concerns',
    'Traditional cookware users',
    'Family kitchens',
    'Health-conscious households',
    'Those using glass, ceramic, or copper cookware'
  ]
};

const relatedProducts = [
  { name: 'HT-IC35 Induction Cooktop', slug: '/products/induction-cooker/ht-ic35-single', sku: 'HT-IC35' },
  { name: 'HT-IC21 Dual Induction Hob', slug: '/products/induction-cooker/ht-ic21-dual', sku: 'HT-IC21' },
  { name: 'HT-IC4Q 4-Burner Induction Cooktop', slug: '/products/induction-cooker/ht-ic4q-4-burner', sku: 'HT-IC4Q' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": "https://housetech-ch.com/images/products/induction-cooker/ht-cc30.jpg",
    "description": description,
    "brand": { "@type": "Brand", "name": "HouseTech" },
    "manufacturer": { "@type": "Organization", "name": "HouseTech Group" },
    "sku": product.sku,
    "category": "Induction Cookers",
    "offers": { "@type": "AggregateOffer", "priceCurrency": "USD", "lowPrice": "0", "highPrice": "0", "offerCount": "1", "availability": "https://schema.org/InStock" }
  })} />
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the warranty period for HT-CC30 Ceramic Cooker?", "acceptedAnswer": { "@type": "Answer", "Text": "All HouseTech products come with a comprehensive warranty. The HT-CC30 includes a 2-year manufacturer warranty covering defects in materials and workmanship." } },
      { "@type": "Question", "name": "Does HouseTech offer OEM/ODM customization for the HT-CC30?", "acceptedAnswer": { "@type": "Answer", "Text": "Yes, HouseTech offers full OEM/ODM services including custom logo branding and packaging design." } },
      { "@type": "Question", "name": "What certifications does the HT-CC30 have?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-CC30 is certified with CE, CB, ETL, and RoHS standards, meeting safety requirements for global markets." } },
      { "@type": "Question", "name": "What cookware is compatible with the HT-CC30?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-CC30 infrared ceramic cooker works with ALL cookware types including glass, ceramic, copper, and aluminum - no special magnetic cookware required." } },
      { "@type": "Question", "name": "What is the delivery time for HT-CC30 orders?", "acceptedAnswer": { "@type": "Answer", "Text": "Standard delivery time is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days." } }
    ]
  })} />
  <Header activeNav="products" />
  <section class="page-hero"><div class="container"><h1>{product.name}</h1><p>SKU: {product.sku}</p><nav class="breadcrumb"><a href="/">Home</a><span class="separator">/</span><a href="/products">Products</a><span class="separator">/</span><a href="/products/induction-cooker">Induction Cookers</a><span class="separator">/</span><span>{product.name}</span></nav></div></section>
  <section class="content-section"><div class="container"><div class="product-detail-grid"><div class="product-gallery"><div class="product-gallery-main"><img src={product.image} alt={product.name} /></div><div class="product-gallery-thumbs"><div class="product-thumb active"><img src={product.image} alt={product.name} /></div></div></div><div class="product-info"><h1>{product.name}</h1><p class="product-sku">SKU: {product.sku} | Category: {product.category}</p><p class="product-short-desc">{product.shortDesc}</p><p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Engineered by HouseTech, the HT-CC30 uses ceramic infrared heating with no EMF concern, working with all cookware types. As part of HouseTech's versatile hob lineup, it is a safe alternative to induction. Every HouseTech product is CE/CB certified.</p><table class="product-specs-table"><tbody>{Object.entries(product.specs).map(([key, value]) => (<tr><th>{key}</th><td>{value}</td></tr>))}</tbody></table><div class="product-cta-area"><a href="/contact" class="btn btn-primary">Get Quote</a><a href="/download" class="btn btn-outline">Download Spec Sheet</a></div></div></div><div style="margin-top: var(--spacing-3xl);"><h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">Key Features</h2><div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">{product.features.map((feature) => (<div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"></polyline></svg><span style="color: var(--color-text);">{feature}</span></div>))}</div></div><div style="margin-top: var(--spacing-3xl);"><h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">Applications</h2><div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">{product.applications.map((app) => (<span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">{app}</span>))}</div></div><div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);"><h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2><p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p><a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a></div><div class="related-products"><h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">Related Products</h2><div class="news-grid">{relatedProducts.map((rel) => (<a href={rel.slug} class="news-card"><div class="news-card-body"><h3>{rel.name}</h3><p>SKU: {rel.sku}</p><span class="news-card-read-more">View Details →</span></div></a>))}</div></div></div></section><Footer />
</Layout>