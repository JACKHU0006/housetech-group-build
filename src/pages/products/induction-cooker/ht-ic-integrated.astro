---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'HT-IC Integrated Induction Hob - HouseTech Group | Built-in Induction Cooktop, 9 Power Levels, Child Lock';
const description = 'HouseTech HT-IC Integrated Induction Hob: built-in cooktop design, black crystal panel, 9 power levels, child safety lock. Elegant and safe cooking for modern kitchens.';

const product = {
  name: 'HT-IC Integrated Induction Hob',
  sku: 'HT-IC',
  category: 'Induction Cookers',
  price: 'Contact for Quote',
  image: '/images/products/induction-cooker/ht-ic.jpg',
  shortDesc: 'Built-in integrated induction hob with elegant black crystal panel, 9 power levels, child safety lock, and seamless flush-mount design. Premium cooking solution for contemporary kitchens.',
  specs: {
    'Type': 'Integrated Induction Hob (Built-in)',
    'Total Power': '3600W',
    'Left Zone Power': '2000W (Booster: 2500W)',
    'Right Zone Power': '1600W (Booster: 2000W)',
    'Voltage': '220-240V / 50Hz',
    'Number of Zones': '2',
    'Left Zone Diameter': 'Φ210mm',
    'Right Zone Diameter': 'Φ180mm',
    'Control Type': 'Slider Touch Control',
    'Power Levels': '9',
    'Temperature Range': '60-240°C',
    'Timer': '0-99 Minutes (Per Zone)',
    'Panel Material': 'Black Crystal Glass (Schott Ceran)',
    'Safety Features': 'Child Lock, Residual Heat Indicator, Over-heat Protection, Auto Shut-off, Pan Detection',
    'Pause Function': 'Yes',
    'Keep Warm Function': 'Yes (70°C)',
    'Fan Cooling': 'Yes (Smart Speed Control)',
    'Cut-out Dimensions': '560 × 340 × 55mm',
    'Color': 'Black',
    'Gross Weight': '10.2kg',
    'Product Dimensions': '750 × 440 × 55mm'
  },
  features: [
    'Elegant black crystal glass panel with Schott Ceran quality',
    '3600W total power with booster function on both zones',
    'Slider touch control for intuitive, precise power adjustment',
    '9 power levels for fine-tuned heat management',
    'Seamless flush-mount design enhances kitchen aesthetics',
    'Child safety lock prevents accidental activation',
    'Keep warm function maintains food at 70°C',
    'Pause function temporarily suspends cooking with one touch',
    'Smart speed control fan adjusts cooling based on load',
    'Residual heat indicator warns when surface is still hot'
  ],
  applications: [
    'Premium residential kitchens',
    'Modern kitchen renovations',
    'Luxury apartment kitchens',
    'Interior design projects',
    'High-end home builder installations'
  ]
};

const relatedProducts = [
  { name: 'HT-IC20 Portable Induction Cooker', slug: '/products/induction-cooker/ht-ic20-portable', sku: 'HT-IC20' },
  { name: 'HT-IC32 Double Induction Cooker', slug: '/products/induction-cooker/ht-ic32-double', sku: 'HT-IC32' },
  { name: 'HT-KS05 Premium Kitchen Set', slug: '/products/kitchen-set/ht-ks05-premium', sku: 'HT-KS05' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": "https://housetech-ch.com/images/products/induction-cooker/ht-ic.jpg",
    "description": description,
    "brand": { "@type": "Brand", "name": "HouseTech" },
    "manufacturer": { "@type": "Organization", "name": "HouseTech Group" },
    "sku": product.sku,
    "category": "Induction Cookers",
    "offers": { "@type": "AggregateOffer", "priceCurrency": "USD", "lowPrice": "0", "highPrice": "0", "offerCount": "1", "availability": "https://schema.org/InStock" }
  })} />
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the warranty period for HT-IC Integrated Induction Hob?", "acceptedAnswer": { "@type": "Answer", "Text": "All HouseTech products come with a comprehensive warranty. The HT-IC includes a 2-year manufacturer warranty covering defects in materials and workmanship." } },
      { "@type": "Question", "name": "Does HouseTech offer OEM/ODM customization for the HT-IC?", "acceptedAnswer": { "@type": "Answer", "Text": "Yes, HouseTech offers full OEM/ODM services including custom logo branding and packaging design." } },
      { "@type": "Question", "name": "What certifications does the HT-IC have?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-IC is certified with CE, CB, ETL, and RoHS standards, meeting safety requirements for global markets." } },
      { "@type": "Question", "name": "What is the delivery time for HT-IC orders?", "acceptedAnswer": { "@type": "Answer", "Text": "Standard delivery time is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days." } },
      { "@type": "Question", "name": "What special features does the HT-IC include?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-IC includes child lock, residual heat indicator, over-heat protection, auto shut-off, pause function, and keep warm function at 70°C." } }
    ]
  })} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>{product.name}</h1>
      <p>SKU: {product.sku}</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <a href="/products/induction-cooker">Induction Cookers</a>
        <span class="separator">/</span>
        <span>{product.name}</span>
      </nav>
    </div>
  </section>

  <!-- Product Detail -->
  <section class="content-section">
    <div class="container">
      <div class="product-detail-grid">
        <!-- Gallery -->
        <div class="product-gallery">
          <div class="product-gallery-main">
            <img src={product.image} alt={product.name} />
          </div>
          <div class="product-gallery-thumbs">
            <div class="product-thumb active">
              <img src={product.image} alt={`${product.name} - Main View`} />
            </div>
          </div>
        </div>

        <!-- Product Info -->
        <div class="product-info">
          <h1>{product.name}</h1>
          <p class="product-sku">SKU: {product.sku} | Category: {product.category}</p>
          <p class="product-short-desc">{product.shortDesc}</p>
          <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Engineered by HouseTech, this integrated induction hob offers seamless built-in installation for modern kitchens. As part of HouseTech's premium induction lineup, it delivers precise temperature control. Every HouseTech product is CE/CB certified.</p>

          <!-- Specs Table -->
          <table class="product-specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr>
                  <th>{key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <!-- CTA Area -->
          <div class="product-cta-area">
            <a href="/contact" class="btn btn-primary">Get Quote</a>
            <a href="/download" class="btn btn-outline">Download Spec Sheet</a>
          </div>
        </div>
      </div>

      <!-- Features Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Key Features
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
          {product.features.map((feature) => (
            <div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="color: var(--color-text);">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Applications Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Applications
        </h2>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
          {product.applications.map((app) => (
            <span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">
              {app}
            </span>
          ))}
        </div>
      </div>

      <!-- Why Choose HouseTech -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p>
        <a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a>
      </div>

      <!-- Related Products -->
      <div class="related-products">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Related Products
        </h2>
        <div class="news-grid">
          {relatedProducts.map((rel) => (
            <a href={rel.slug} class="news-card">
              <div class="news-card-body">
                <h3>{rel.name}</h3>
                <p>SKU: {rel.sku}</p>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
