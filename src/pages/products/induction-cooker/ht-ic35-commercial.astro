---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'HT-IC35 Commercial Induction Cooker - HouseTech Group | 5000W High Power, 8+ Hours Continuous';
const description = 'HouseTech HT-IC35 Commercial Induction Cooker: 5000W high power, commercial-grade, continuous operation 8+ hours, heavy-duty design for restaurant and catering use.';

const product = {
  name: 'HT-IC35 Commercial Induction Cooker',
  sku: 'HT-IC35',
  category: 'Induction Cookers',
  price: 'Contact for Quote',
  image: '/images/products/induction-cooker/ht-ic35.jpg',
  shortDesc: '5000W commercial induction cooker with heavy-duty design, continuous operation capability of 8+ hours, stainless steel housing. Built for demanding restaurant and catering kitchen environments.',
  specs: {
    'Type': 'Commercial Single Induction Cooker',
    'Power': '5000W',
    'Voltage': '220-240V / 50Hz (Dedicated Circuit Required)',
    'Number of Zones': '1',
    'Zone Diameter': 'Φ300mm',
    'Control Type': 'Knob + Digital Display',
    'Power Levels': '15',
    'Temperature Range': '60-300°C',
    'Timer': '0-240 Minutes',
    'Panel Material': 'Thickened Microcrystalline Glass (8mm)',
    'Housing Material': 'SUS304 Stainless Steel',
    'Continuous Operation': '8+ Hours',
    'Cooling System': 'Industrial-grade Dual Fan',
    'Safety Features': 'Over-heat Protection, Dry-boil Protection, Over-voltage Protection, Auto Shut-off',
    'Wire Requirement': '≥6mm² Copper Wire + 32A Circuit Breaker',
    'Pan Compatibility': 'Flat-bottom cookware Φ120-300mm',
    'Color': 'Stainless Steel',
    'Gross Weight': '15kg',
    'Product Dimensions': '420 × 500 × 160mm'
  },
  features: [
    '5000W high power for intense stir-frying and rapid boiling',
    'Continuous operation rated for 8+ hours without performance drop',
    '8mm thickened microcrystalline glass panel resists heavy impacts',
    'SUS304 stainless steel housing for commercial durability',
    'Industrial-grade dual fan cooling for sustained high-power cooking',
    '15 precision power levels for professional heat control',
    '60-300°C wide temperature range covers all cooking techniques',
    'Dry-boil protection prevents element and pan damage',
    'Knob control with digital display for quick, precise adjustment',
    'Compatible with commercial cookware up to Φ300mm diameter'
  ],
  applications: [
    'Restaurant kitchens',
    'Hotel kitchen operations',
    'Catering service kitchens',
    'Canteen and cafeteria cooking',
    'Food truck and mobile kitchen setups'
  ]
};

const relatedProducts = [
  { name: 'HT-IC20 Portable Induction Cooker', slug: '/products/induction-cooker/ht-ic20-portable', sku: 'HT-IC20' },
  { name: 'HT-IC32 Double Induction Cooker', slug: '/products/induction-cooker/ht-ic32-double', sku: 'HT-IC32' },
  { name: 'HT-KS Commercial Kitchen Set', slug: '/products/kitchen-set/ht-ks-commercial', sku: 'HT-KS' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": "https://housetech-ch.com/images/products/induction-cooker/ht-ic35.jpg",
    "description": description,
    "brand": { "@type": "Brand", "name": "HouseTech" },
    "manufacturer": { "@type": "Organization", "name": "HouseTech Group" },
    "sku": product.sku,
    "category": "Induction Cookers",
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "USD",
      "lowPrice": "0",
      "highPrice": "0",
      "offerCount": "1",
      "availability": "https://schema.org/InStock"
    }
  })} />
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the warranty period for HT-IC35 Commercial Induction Cooker?",
        "acceptedAnswer": { "@type": "Answer", "Text": "All HouseTech products come with a comprehensive warranty. The HT-IC35 Commercial Induction Cooker includes a 2-year manufacturer warranty covering defects in materials and workmanship." }
      },
      {
        "@type": "Question",
        "name": "Does HouseTech offer OEM/ODM customization for the HT-IC35?",
        "acceptedAnswer": { "@type": "Answer", "Text": "Yes, HouseTech offers full OEM/ODM services for commercial induction cookers including custom logo branding, voltage configurations (220V/380V), panel designs, and packaging options for different market requirements." }
      },
      {
        "@type": "Question",
        "name": "What certifications does the HT-IC35 have?",
        "acceptedAnswer": { "@type": "Answer", "Text": "The HT-IC35 is certified with CE, CB, ETL, and RoHS standards, meeting safety and environmental requirements for European, Asian, and North American commercial kitchen equipment markets." }
      },
      {
        "@type": "Question",
        "name": "What electrical requirements does the HT-IC35 need?",
        "acceptedAnswer": { "@type": "Answer", "Text": "The HT-IC35 requires 220-240V / 50Hz with a dedicated circuit. It needs >=6mm² copper wire and a 32A circuit breaker. Professional installation by a licensed electrician is recommended." }
      },
      {
        "@type": "Question",
        "name": "What is the delivery time for HT-IC35 orders?",
        "acceptedAnswer": { "@type": "Answer", "Text": "Standard delivery time for HT-IC35 orders is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days." }
      }
    ]
  })} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>{product.name}</h1>
      <p>SKU: {product.sku}</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <a href="/products/induction-cooker">Induction Cookers</a>
        <span class="separator">/</span>
        <span>{product.name}</span>
      </nav>
    </div>
  </section>

  <!-- Product Detail -->
  <section class="content-section">
    <div class="container">
      <div class="product-detail-grid">
        <!-- Gallery -->
        <div class="product-gallery">
          <div class="product-gallery-main">
            <img src={product.image} alt={product.name} />
          </div>
          <div class="product-gallery-thumbs">
            <div class="product-thumb active">
              <img src={product.image} alt={`${product.name} - Main View`} />
            </div>
          </div>
        </div>

        <!-- Product Info -->
        <div class="product-info">
          <h1>{product.name}</h1>
          <p class="product-sku">SKU: {product.sku} | Category: {product.category}</p>
          <p class="product-short-desc">{product.shortDesc}</p>
          <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Engineered by HouseTech, the HT-IC35 Commercial delivers 3500W of power for fast professional cooking. As part of HouseTech's commercial induction lineup, this single-burner cooktop is built for intensive use. Every HouseTech product is CE/CB certified for quality assurance.</p>

          <!-- Specs Table -->
          <table class="product-specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr>
                  <th>{key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <!-- CTA Area -->
          <div class="product-cta-area">
            <a href="/contact" class="btn btn-primary">Get Quote</a>
            <a href="/download" class="btn btn-outline">Download Spec Sheet</a>
          </div>
        </div>
      </div>

      <!-- Features Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Key Features
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
          {product.features.map((feature) => (
            <div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="color: var(--color-text);">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Applications Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Applications
        </h2>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
          {product.applications.map((app) => (
            <span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">
              {app}
            </span>
          ))}
        </div>
      </div>

      <!-- Why Choose HouseTech -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p>
        <a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a>
      </div>

      <!-- Related Products -->
      <div class="related-products">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Related Products
        </h2>
        <div class="news-grid">
          {relatedProducts.map((rel) => (
            <a href={rel.slug} class="news-card">
              <div class="news-card-body">
                <h3>{rel.name}</h3>
                <p>SKU: {rel.sku}</p>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
