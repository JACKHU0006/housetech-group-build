---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = 'Complete Kitchen Sets - HouseTech Group | Kitchen Appliance Packages, OEM Kitchen Sets';
const description = 'Discover HouseTech Group\'s complete kitchen appliance sets: Starter Sets, Premium Sets, Commercial Sets, Hotel Apartment Sets. Complete solutions for home builders, hotels, and restaurants.';

