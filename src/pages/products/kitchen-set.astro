      'New homeowners',
      'First-time apartment buyers',
      'Rental property upgrades',
      'Student apartments'
    ]
  },
  {
    name: 'Premium Kitchen Set',
    slug: 'premium-set',
    sku: 'HT-KS200',
    category: 'Kitchen Sets',
