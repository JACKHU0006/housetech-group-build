      'Smart-ready features across all products',
      'Professional-grade performance',
      'Elegant stainless steel and glass design',
      'Pyrolytic self-cleaning oven included',
      'High-power extraction hood',
      '5-burner professional gas hob',
      'Complete hot water and cooking solution'
    ],
    applications: [
      'Luxury homes',
      'High-end apartments',
      'Home renovation projects',
      'Discerning homeowners'
    ]
  },
  {
    name: 'Commercial Kitchen Set',
    slug: 'commercial-set',
    sku: 'HT-KS300',
    category: 'Kitchen Sets',
    shortDesc: 'Heavy-duty commercial package for restaurant and hospitality use.',
    image: '/images/products/kitchen-set/commercial.jpg',
    specs: {
      'Package Includes': '6 Products',
      'Range Hood': 'HT-RH1200 (120cm, commercial)',
      'Gas Hob': 'HT-GH354 (x2, dual setup)',
      'Oven': 'HT-OV100 (100L, professional)',
      'Induction': 'HT-IC4Q (4-burner)',
      'Water Heater': 'HT-WH20 (20L, high efficiency)',
