---

<Layout title={title} description={description}>
  <!-- BreadcrumbList Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://housetech-ch.com/" },
      { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://housetech-ch.com/products/" },
      { "@type": "ListItem", "position": 3, "name": "Kitchen Sets", "item": "https://housetech-ch.com/products/kitchen-set/" }
    ]
  })} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>Complete Kitchen Sets</h1>
      <p>Complete kitchen appliance solutions - Kitchen Appliance Packages, Built-in Kitchen Solutions, OEM Kitchen Sets, Hotel Kitchen Equipment, Restaurant Kitchen Packages, Home Builder Kitchen Sets, Real Estate Kitchen Appliances</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <span>Kitchen Sets</span>
      </nav>
    </div>
  </section>

  <!-- Category Introduction -->
  <section class="content-section">
    <div class="container">
      <div style="max-width: 900px; margin: 0 auto;">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-md);">
          Complete Kitchen Solutions by HouseTech Group
        </h2>
        <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">
          HouseTech Group offers comprehensive kitchen appliance packages designed for home builders, real estate developers, hotels, restaurants, and hospitality businesses. Our complete kitchen sets include perfectly matched appliances that work together seamlessly, simplifying procurement and ensuring consistent design across your properties. As an experienced OEM/ODM partner, we can customize packages to meet your specific requirements.
        </p>
        <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-lg);">
          Choose from HouseTech's curated packages: <strong>Starter Set</strong> for new homeowners and apartments, <strong>Premium Set</strong> for luxury homes with smart features, <strong>Commercial Set</strong> for restaurants and hotels requiring heavy-duty equipment, and <strong>Hotel Apartment Set</strong> for compact, durable, and stylish hospitality solutions. Each package includes coordinated appliances with matching aesthetics, comprehensive warranties, and full installation support. When you choose HouseTech, you benefit from our years of manufacturing expertise.
        </p>
      </div>

      <!-- Products Grid -->
      <div class="news-grid" style="margin-top: var(--spacing-2xl);">
        {products.map((product) => (
          <a href={`/products/kitchen-set/${product.slug}`} class="news-card">
            <div class="news-card-image">
              <img src={product.image} alt={product.name} loading="lazy" />
              <span class="news-card-category">{product.category}</span>
            </div>
            <div class="news-card-body">
              <h3>{product.name}</h3>
              <p>{product.shortDesc}</p>
              <div class="news-card-meta">
                <span>SKU: {product.sku}</span>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- OEM/ODM Section -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Need Custom Kitchen Packages?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">
          HouseTech Group offers full OEM/ODM services for kitchen sets including custom appliance combinations, quantities, branding, and packaging for volume orders. Contact us to discuss your project requirements.
        </p>
        <a href="/service" class="btn btn-primary">Learn About OEM/ODM Services →</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>