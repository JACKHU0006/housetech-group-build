---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'HT-RH380 Built-in Range Hood - HouseTech Group | Integrated Range Hood, Hidden Installation';
const description = 'HouseTech HT-RH380 Built-in Range Hood: Integrated design with hidden installation. Seamless kitchen cabinet integration. Premium built-in hood manufacturer.';

// Product data
const product = {
  name: 'HT-RH380 Built-in Range Hood',
  sku: 'HT-RH380',
  category: 'Range Hoods',
  price: 'Contact for Quote',
  image: '/images/products/range-hood/ht-rh380.jpg',
  shortDesc: 'Integrated built-in range hood with hidden installation for seamless kitchen design. Pop-up design activates when cooking.',
  specs: {
    'Width': '72cm',
    'Extraction Rate': '380m³/h',
    'Control Type': 'Push Button',
    'Lighting': 'LED Spots',
    'Installation': 'Built-in / Hidden',
    'Noise Level': '48dB',
    'Finish': 'Stainless Steel',
    'Depth': '28cm',
    'Number of Speeds': '2',
    'Motor Power': '150W',
    'Voltage': '220-240V / 50Hz',
    'Gross Weight': '10kg'
  },
  features: [
    'Hidden installation - invisible when not in use',
    'Seamless integration with kitchen cabinets',
    'Compact 72cm width',
    'Energy-efficient single motor',
    'Low-noise operation at 48dB',
    'Pop-up design activates when cooking',
    'Easy maintenance with slide-out filter',
    'Perfect for minimalist kitchen designs',
    'Space-saving solution'
  ],
  applications: [
    'Modern minimalist kitchens',
    'Integrated kitchen designs',
    'Custom cabinet installations',
    'Hidden appliance layouts',
    'Compact kitchens',
    'Handleless kitchen designs'
  ]
};

const relatedProducts = [
  { name: 'HT-RH900 Wall Mount Range Hood', slug: '/products/range-hood/ht-rh900-wall-mount', sku: 'HT-RH900' },
  { name: 'HT-RH600 Slim Range Hood', slug: '/products/range-hood/ht-rh600-slim', sku: 'HT-RH600' },
  { name: 'HT-RH1200 Island Range Hood', slug: '/products/range-hood/ht-rh1200-island', sku: 'HT-RH1200' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": "https://housetech-ch.com/images/products/range-hood/ht-rh380.jpg",
    "description": description,
    "brand": { "@type": "Brand", "name": "HouseTech" },
    "manufacturer": { "@type": "Organization", "name": "HouseTech Group" },
    "sku": product.sku,
    "category": "Range Hoods",
    "offers": { "@type": "AggregateOffer", "priceCurrency": "USD", "lowPrice": "0", "highPrice": "0", "offerCount": "1", "availability": "https://schema.org/InStock" }
  })} />
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the warranty period for HT-RH380 Range Hood?", "acceptedAnswer": { "@type": "Answer", "Text": "All HouseTech products come with a comprehensive warranty. The HT-RH380 includes a 2-year manufacturer warranty covering defects in materials and workmanship." } },
      { "@type": "Question", "name": "Does HouseTech offer OEM/ODM customization for the HT-RH380?", "acceptedAnswer": { "@type": "Answer", "Text": "Yes, HouseTech offers full OEM/ODM services including custom logo branding, size configurations, and packaging design." } },
      { "@type": "Question", "name": "What certifications does the HT-RH380 have?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-RH380 is certified with CE, CB, and ETL standards, meeting safety requirements for global markets." } },
      { "@type": "Question", "name": "What is the delivery time for HT-RH380 orders?", "acceptedAnswer": { "@type": "Answer", "Text": "Standard delivery time is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days." } },
      { "@type": "Question", "name": "What cabinet dimensions are needed for the HT-RH380?", "acceptedAnswer": { "@type": "Answer", "Text": "The HT-RH380 is designed for built-in installation. The cabinet opening should accommodate the 72cm width x 28cm depth x adjustable height specifications." } }
    ]
  })} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>{product.name}</h1>
      <p>SKU: {product.sku}</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <a href="/products/range-hood">Range Hoods</a>
        <span class="separator">/</span>
        <span>{product.name}</span>
      </nav>
    </div>
  </section>

  <!-- Product Detail -->
  <section class="content-section">
    <div class="container">
      <div class="product-detail-grid">
        <!-- Gallery -->
        <div class="product-gallery">
          <div class="product-gallery-main">
            <img src={product.image} alt={product.name} />
          </div>
          <div class="product-gallery-thumbs">
            <div class="product-thumb active">
              <img src={product.image} alt={`${product.name} - Main View`} />
            </div>
          </div>
        </div>

        <!-- Product Info -->
        <div class="product-info">
          <h1>{product.name}</h1>
          <p class="product-sku">SKU: {product.sku} | Category: {product.category}</p>
          <p class="product-short-desc">{product.shortDesc}</p>
          <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Engineered by HouseTech, the HT-RH380 offers hidden built-in installation for seamless kitchen design. As part of HouseTech's integrated range hood lineup, it pops up when needed for invisible convenience. Every HouseTech product is CE/CB certified.</p>

          <!-- Specs Table -->
          <table class="product-specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr>
                  <th>{key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <!-- CTA Area -->
          <div class="product-cta-area">
            <a href="/contact" class="btn btn-primary">Get Quote</a>
            <a href="/download" class="btn btn-outline">Download Spec Sheet</a>
          </div>
        </div>
      </div>

      <!-- Features Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Key Features
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
          {product.features.map((feature) => (
            <div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="color: var(--color-text);">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Applications Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Applications
        </h2>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
          {product.applications.map((app) => (
            <span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">
              {app}
            </span>
          ))}
        </div>
      </div>

      <!-- Why Choose HouseTech -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p>
        <a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a>
      </div>

      <!-- Related Products -->
      <div class="related-products">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Related Products
        </h2>
        <div class="news-grid">
          {relatedProducts.map((rel) => (
            <a href={rel.slug} class="news-card">
              <div class="news-card-body">
                <h3>{rel.name}</h3>
                <p>SKU: {rel.sku}</p>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
