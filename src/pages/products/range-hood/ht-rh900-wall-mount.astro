---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Testimonials from '../../../components/Testimonials.astro';
import Schema from '../../../components/Schema.astro';

const title = 'HT-RH900 Wall Mount Range Hood - HouseTech Group | 90cm Range Hood, 1100m³/h Extraction';
const description = 'HouseTech HT-RH900 Wall Mount Range Hood: 90cm width, 1100m³/h extraction rate, LED lights, touch control. Premium stainless steel kitchen hood manufacturer.';

// Product data
const product = {
  name: 'HT-RH900 Wall Mount Range Hood',
  sku: 'HT-RH900',
  category: 'Range Hoods',
  price: 'Contact for Quote',
  images: ['/images/products/range-hood/ht-rh900.jpg'],
  shortDesc: '90cm wall mount range hood with powerful 1100m³/h extraction rate, LED lights, and touch control panel. Sleek stainless steel finish suitable for modern kitchens.',
  specs: {
    'Width': '90cm',
    'Extraction Rate': '1100m³/h',
    'Control Type': 'Touch Control',
    'Lighting': 'LED Lights',
    'Filter Type': 'Aluminum Mesh Filter',
    'Noise Level': '58dB',
    'Finish': 'Stainless Steel',
    'Ventilation Type': 'Ducted / Ductless',
    'Number of Speeds': '3',
    'Motor Power': '250W',
    'Voltage': '220-240V / 50Hz',
    'Gross Weight': '18kg'
  },
  features: [
    'Powerful 1100m³/h extraction rate for effective smoke removal',
    'Sleek stainless steel finish with modern design',
    'Touch control panel with 3-speed settings',
    'Energy-efficient LED lighting',
    'Easy-to-clean aluminum mesh filters',
    'Silent motor technology at only 58dB',
    'Suitable for both ducted and ductless installation',
    'Telescopic chimney design for flexible ceiling height',
    'Grease filter reminder indicator'
  ],
  applications: [
    'Residential kitchens',
    'Apartment kitchens',
    'Modern home renovations',
    'Boutique restaurants',
    'Open plan living spaces'
  ]
};

const relatedProducts = [
  { name: 'HT-RH600 Slim Range Hood', slug: '/products/range-hood/ht-rh600-slim', sku: 'HT-RH600' },
  { name: 'HT-RH1200 Island Range Hood', slug: '/products/range-hood/ht-rh1200-island', sku: 'HT-RH1200' },
  { name: 'HT-RH380 Built-in Range Hood', slug: '/products/range-hood/ht-rh380-built-in', sku: 'HT-RH380' }
];
---

<Layout title={title} description={description}>
  <!-- Product Schema with ImageObject -->
  <Schema type="product" data={{
    name: product.name,
    description: description,
    image: product.images.map(img => `https://www.housetech-ch.com${img}`),
    brand: 'HouseTech',
    model: product.sku,
    certifications: ['CE', 'CB', 'ETL', 'ISO9001'],
    price: 'Contact for Quote',
    currency: 'USD'
  }} />
  <!-- Image Gallery Schema -->
  <Schema type="imageGallery" data={{
    images: product.images.map(img => ({
      url: `https://www.housetech-ch.com${img}`,
      caption: `${product.name} - Professional Kitchen Range Hood`,
      width: 800,
      height: 600
    })),
    mainEntityOfPage: `https://www.housetech-ch.com/products/range-hood/ht-rh900-wall-mount`
  }} />
  <!-- FAQPage Schema -->
  <Schema type="faq" data={{
    items: [
      {
        question: 'What is the warranty period for HT-RH900 Range Hood?',
        answer: 'All HouseTech products come with a comprehensive warranty. The HT-RH900 Range Hood includes a 2-year manufacturer warranty covering defects in materials and workmanship. Extended warranty options are available for B2B partners.'
      },
      {
        question: 'Does HouseTech offer OEM/ODM customization for the HT-RH900?',
        answer: 'Yes, HouseTech offers full OEM/ODM services including custom logo branding, color variations, packaging design, and specification modifications to meet your market requirements. Contact our sales team for customization details and minimum order quantities.'
      },
      {
        question: 'What certifications does the HT-RH900 Range Hood have?',
        answer: 'The HT-RH900 Range Hood is certified with CE, CB, and ETL standards, meeting safety and performance requirements for European, Asian, and North American markets. Additional certifications like SASO and GCC are available upon request.'
      },
      {
        question: 'What is the minimum order quantity (MOQ) for HT-RH900?',
        answer: 'HouseTech offers flexible MOQ starting from 50 units per model for OEM orders. For standard catalog products, smaller quantities may be available. Contact us for specific MOQ details based on your requirements.'
      },
      {
        question: 'What is the delivery time for HT-RH900 orders?',
        answer: 'Standard delivery time for HT-RH900 orders is 30-45 days after sample approval and deposit payment. For customized OEM orders, please allow 45-60 days depending on specification requirements. Express shipping options are available.'
      }
    ]
  }} />
  <Header activeNav="products" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>{product.name}</h1>
      <p>SKU: {product.sku}</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/products">Products</a>
        <span class="separator">/</span>
        <a href="/products/range-hood">Range Hoods</a>
        <span class="separator">/</span>
        <span>{product.name}</span>
      </nav>
    </div>
  </section>

  <!-- Product Detail -->
  <section class="content-section">
    <div class="container">
      <div class="product-detail-grid">
        <!-- Gallery -->
        <div class="product-gallery">
          <div class="product-gallery-main">
            <img src={product.image} alt={product.name} />
          </div>
          <div class="product-gallery-thumbs">
            <div class="product-thumb active">
              <img src={product.image} alt={`${product.name} - Main View`} />
            </div>
          </div>
        </div>

        <!-- Product Info -->
        <div class="product-info">
          <h1>{product.name}</h1>
          <p class="product-sku">SKU: {product.sku} | Category: {product.category}</p>
          <p class="product-short-desc">{product.shortDesc}</p>
          <p style="color: var(--color-text-light); line-height: 1.8; margin-bottom: var(--spacing-md);">Engineered by HouseTech, the HT-RH900 delivers 1100m³/h extraction with silent motor technology at only 58dB. As part of HouseTech's premium range hood lineup, it suits modern kitchens perfectly. Every HouseTech product is CE/CB certified.</p>

          <!-- Specs Table -->
          <table class="product-specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr>
                  <th>{key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <!-- CTA Area -->
          <div class="product-cta-area">
            <a href="/contact" class="btn btn-primary">Get Quote</a>
            <a href="/download" class="btn btn-outline">Download Spec Sheet</a>
          </div>
        </div>
      </div>

      <!-- Features Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Key Features
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
          {product.features.map((feature) => (
            <div style="display: flex; align-items: flex-start; gap: var(--spacing-sm);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="color: var(--color-text);">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Applications Section -->
      <div style="margin-top: var(--spacing-3xl);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Applications
        </h2>
        <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
          {product.applications.map((app) => (
            <span style="padding: 0.5rem 1rem; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--color-text);">
              {app}
            </span>
          ))}
        </div>
      </div>

      <!-- Why Choose HouseTech -->
      <div style="margin-top: var(--spacing-3xl); text-align: center; background: var(--color-bg-alt); padding: var(--spacing-2xl); border-radius: var(--radius-lg);">
        <h2 style="margin-bottom: var(--spacing-sm);">Why Choose HouseTech?</h2>
        <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg); max-width: 600px; margin-left: auto; margin-right: auto;">HouseTech Group has been a trusted name in kitchen appliances for years. When you choose HouseTech, you get CE/CB certified products backed by comprehensive warranty and dedicated OEM/ODM support.</p>
        <a href="/contact" class="btn btn-primary">Contact HouseTech for OEM/ODM Inquiries →</a>
      </div>

      <!-- Customer Testimonials -->
      <Testimonials product={product.name} />

      <!-- Related Products -->
      <div class="related-products">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-primary); margin-bottom: var(--spacing-xl);">
          Related Products
        </h2>
        <div class="news-grid">
          {relatedProducts.map((rel) => (
            <a href={rel.slug} class="news-card">
              <div class="news-card-body">
                <h3>{rel.name}</h3>
                <p>SKU: {rel.sku}</p>
                <span class="news-card-read-more">View Details →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
