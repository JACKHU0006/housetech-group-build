---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Download - HouseTech Group | Product Catalogs & Resources';
const description = 'Download product catalogs, company profiles, certifications, and technical specifications for HouseTech Group kitchen appliances.';
---

<Layout title={title} description={description}>
  <Header activeNav="" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>Downloads</h1>
      <p>Product catalogs, company profiles, and technical resources from HouseTech Group</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Download</span>
      </nav>
    </div>
  </section>

  <!-- Content -->
  <section class="content-section">
    <div class="container">

      <div style="text-align: center; margin-bottom: var(--spacing-2xl);">
        <span class="section-tag">Resources</span>
        <h2 style="margin-top: var(--spacing-sm);">HouseTech Document Library</h2>
        <p style="color: var(--color-text-light); max-width: 600px; margin: var(--spacing-md) auto 0;">Access HouseTech Group's complete library of product catalogs, company information, certification documents, and technical specifications. Fill out the form to receive download links.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--spacing-lg); margin-bottom: var(--spacing-3xl);">

        <!-- Product Catalog 2025 -->
        <div style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--spacing-xl); background: white; display: flex; flex-direction: column;">
          <div style="width: 56px; height: 56px; border-radius: var(--radius-md); background: linear-gradient(135deg, #ef4444, #dc2626); display: flex; align-items: center; justify-content: center; margin-bottom: var(--spacing-md);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8" fill="none" stroke="white" stroke-width="2"/><path d="M12 18v-6m-3 3l3-3 3 3" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3 style="font-size: var(--font-size-lg); color: var(--color-primary); margin-bottom: var(--spacing-xs);">Product Catalog 2025</h3>
          <p style="color: var(--color-text-light); font-size: var(--font-size-sm); line-height: 1.6; flex-grow: 1;">HouseTech Group's comprehensive catalog featuring all product categories — Range Hoods, Gas Stoves, Ovens, Air Fryers, and Water Heaters — with full specifications, dimensions, and pricing guidance.</p>
          <div style="margin-top: var(--spacing-md); display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; flex-direction: column; gap: 2px;">
              <span style="font-size: var(--font-size-xs); color: var(--color-text-light);">PDF · 15.2 MB</span>
              <span style="font-size: var(--font-size-xs); color: var(--color-text-light);">Updated: 2025</span>
            </div>
            <span class="btn btn-dark btn-sm" style="font-size: var(--font-size-xs); cursor: pointer;">Download</span>
          </div>
        </div>

        <!-- Company Profile -->
        <div style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--spacing-xl); background: white; display: flex; flex-direction: column;">
          <div style="width: 56px; height: 56px; border-radius: var(--radius-md); background: linear-gradient(135deg, #8b5cf6, #7c3aed); display: flex; align-items: center; justify-content: center; margin-bottom: var(--spacing-md);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8" fill="none" stroke="white" stroke-width="2"/><path d="M12 18v-6m-3 3l3-3 3 3" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3 style="font-size: var(--font-size-lg); color: var(--color-primary); margin-bottom: var(--spacing-xs);">Company Profile</h3>
          <p style="color: var(--color-text-light); font-size: var(--font-size-sm); line-height: 1.6; flex-grow: 1;">Comprehensive overview of HouseTech Group including factory information, manufacturing capabilities, 15+ years of industry experience, global market presence, and key partnerships across 50+ countries.</p>
          <div style="margin-top: var(--spacing-md); display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; flex-direction: column; gap: 2px;">
              <span style="font-size: var(--font-size-xs); color: var(--color-text-light);">PDF · 4.1 MB</span>
              <span style="font-size: var(--font-size-xs); color: var(--color-text-light);">Company Introduction</span>
            </div>
            <span class="btn btn-dark btn-sm" style="font-size: var(--font-size-xs); cursor: pointer;">Download</span>
          </div>
        </div>

        <!-- Certification Documents -->
        <div style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--spacing-xl); background: white; display: flex; flex-direction: column;">
          <div style="width: 56px; height: 56px; border-radius: var(--radius-md); background: linear-gradient(135deg, #10b981, #059669); display: flex; align-items: center; justify-content: center; margin-bottom: var(--spacing-md);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M12 15l-2 5 9-11h-5l2-5-9 11h5z"/></svg>
          </div>
          <h3 style="font-size: var(--font-size-lg); color: var(--color-primary); margin-bottom: var(--spacing-xs);">Certification Documents</h3>
          <p style="color: var(--color-text-light); font-size: var(--font-size-sm); line-height: 1.6; flex-grow: 1;">Official HouseTech Group certificates including ISO9001, CE, CB, ETL, SASO, GCC — plus test reports for major product lines. Updated documents available for verified B2B partners.</p>
          <div style="margin-top: var(--spacing-md); display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; flex-direction: column; gap: 2px;">
              <span style="font-size: var(--font-size-xs); color: var(--color-text-light);">ZIP · 12.4 MB</span>
              <span style="font-size: var(--font-size-xs); color: var(--color-text-light);">ISO, CE, ETL, SASO</span>
            </div>
            <span class="btn btn-dark btn-sm" style="font-size: var(--font-size-xs); cursor: pointer;">Download</span>
          </div>
        </div>

        <!-- Technical Specifications by Category -->
        <div style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--spacing-xl); background: white; display: flex; flex-direction: column;">
          <div style="width: 56px; height: 56px; border-radius: var(--radius-md); background: linear-gradient(135deg, #3b82f6, #2563eb); display: flex; align-items: center; justify-content: center; margin-bottom: var(--spacing-md);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8" fill="none" stroke="white" stroke-width="2"/><path d="M12 18v-6m-3 3l3-3 3 3" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3 style="font-size: var(--font-size-lg); color: var(--color-primary); margin-bottom: var(--spacing-xs);">Technical Specifications</h3>
          <p style="color: var(--color-text-light); font-size: var(--font-size-sm); line-height: 1.6; flex-grow: 1;">Detailed technical datasheets for each HouseTech product category — dimensions, electrical specs, airflow ratings, gas specifications, energy ratings, and installation requirements.</p>
          <div style="margin-top: var(--spacing-md); display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; flex-direction: column; gap: 2px;">
              <span style="font-size: var(--font-size-xs); color: var(--color-text-light);">PDF · 8.7 MB</span>
              <span style="font-size: var(--font-size-xs); color: var(--color-text-light);">All Product Categories</span>
            </div>
            <span class="btn btn-dark btn-sm" style="font-size: var(--font-size-xs); cursor: pointer;">Download</span>
          </div>
        </div>

        <!-- OEM/ODM Service Guide -->
        <div style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--spacing-xl); background: white; display: flex; flex-direction: column;">
          <div style="width: 56px; height: 56px; border-radius: var(--radius-md); background: linear-gradient(135deg, #f59e0b, #d97706); display: flex; align-items: center; justify-content: center; margin-bottom: var(--spacing-md);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <h3 style="font-size: var(--font-size-lg); color: var(--color-primary); margin-bottom: var(--spacing-xs);">OEM/ODM Service Guide</h3>
          <p style="color: var(--color-text-light); font-size: var(--font-size-sm); line-height: 1.6; flex-grow: 1;">Complete guide to HouseTech OEM/ODM partnership — MOQ structure, customization options, sample process, production timelines, payment terms, and certification support for brand partners.</p>
          <div style="margin-top: var(--spacing-md); display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; flex-direction: column; gap: 2px;">
              <span style="font-size: var(--font-size-xs); color: var(--color-text-light);">PDF · 5.3 MB</span>
              <span style="font-size: var(--font-size-xs); color: var(--color-text-light);">Customization Handbook</span>
            </div>
            <span class="btn btn-dark btn-sm" style="font-size: var(--font-size-xs); cursor: pointer;">Download</span>
          </div>
        </div>

        <!-- Installation Manuals -->
        <div style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--spacing-xl); background: white; display: flex; flex-direction: column;">
          <div style="width: 56px; height: 56px; border-radius: var(--radius-md); background: linear-gradient(135deg, #ec4899, #db2777); display: flex; align-items: center; justify-content: center; margin-bottom: var(--spacing-md);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8" fill="none" stroke="white" stroke-width="2"/><path d="M12 18v-6m-3 3l3-3 3 3" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3 style="font-size: var(--font-size-lg); color: var(--color-primary); margin-bottom: var(--spacing-xs);">Installation Manuals</h3>
          <p style="color: var(--color-text-light); font-size: var(--font-size-sm); line-height: 1.6; flex-grow: 1;">Step-by-step installation guides and user manuals for all HouseTech products — covering wall-mount range hoods, built-in appliances, gas connections, electrical setup, and maintenance schedules.</p>
          <div style="margin-top: var(--spacing-md); display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; flex-direction: column; gap: 2px;">
              <span style="font-size: var(--font-size-xs); color: var(--color-text-light);">ZIP · 18.6 MB</span>
              <span style="font-size: var(--font-size-xs); color: var(--color-text-light);">Multi-Language Guides</span>
            </div>
            <span class="btn btn-dark btn-sm" style="font-size: var(--font-size-xs); cursor: pointer;">Download</span>
          </div>
        </div>

      </div>

      <!-- Download Form -->
      <div style="background: var(--color-bg-alt); border-radius: var(--radius-lg); padding: var(--spacing-2xl); max-width: 600px; margin: 0 auto var(--spacing-2xl);">
        <h2 style="text-align: center; margin-bottom: var(--spacing-sm);">Get Download Access</h2>
        <p style="text-align: center; color: var(--color-text-light); margin-bottom: var(--spacing-xl);">Complete the form below to receive download links for HouseTech documents.</p>
        <form style="display: flex; flex-direction: column; gap: var(--spacing-md);">
          <div>
            <label style="display: block; font-weight: 600; margin-bottom: var(--spacing-xs); font-size: var(--font-size-sm);">Business Email *</label>
            <input type="email" placeholder="you@company.com" required style="width: 100%; padding: var(--spacing-sm) var(--spacing-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); font-size: var(--font-size-base);" />
          </div>
          <div>
            <label style="display: block; font-weight: 600; margin-bottom: var(--spacing-xs); font-size: var(--font-size-sm);">Company Name *</label>
            <input type="text" placeholder="Your Company" required style="width: 100%; padding: var(--spacing-sm) var(--spacing-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); font-size: var(--font-size-base);" />
          </div>
          <div>
            <label style="display: block; font-weight: 600; margin-bottom: var(--spacing-xs); font-size: var(--font-size-sm);">Country / Region *</label>
            <input type="text" placeholder="Country" required style="width: 100%; padding: var(--spacing-sm) var(--spacing-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); font-size: var(--font-size-base);" />
          </div>
          <div>
            <label style="display: block; font-weight: 600; margin-bottom: var(--spacing-xs); font-size: var(--font-size-sm);">Products of Interest</label>
            <select style="width: 100%; padding: var(--spacing-sm) var(--spacing-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); font-size: var(--font-size-base);">
              <option value="">Select product category...</option>
              <option>Range Hoods</option>
              <option>Gas Stoves / Hobs</option>
              <option>Ovens</option>
              <option>Air Fryers</option>
              <option>Water Heaters</option>
              <option>Multiple Categories</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary" style="margin-top: var(--spacing-sm);">Get Download Links</button>
        </form>
      </div>

      <!-- CTA -->
      <div style="text-align: center; padding: var(--spacing-lg); background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light)); border-radius: var(--radius-lg); color: white;">
        <h3 style="color: white; margin-bottom: var(--spacing-sm);">Can't Find What You Need?</h3>
        <p style="opacity: 0.85; margin-bottom: var(--spacing-md);">Contact the HouseTech team directly for specific documentation requests.</p>
        <a href="/contact" class="btn btn-white">Contact Our Team</a>
      </div>

    </div>
  </section>

  <Footer />
</Layout>
