---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Download - HouseTech Group | Product Catalogs & Resources';
const description = 'Download product catalogs, company profiles, certifications, and technical specifications for HouseTech Group kitchen appliances.';
---

<Layout title={title} description={description}>
  <Header activeNav="" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>Downloads</h1>
      <p>Product catalogs, company profiles, and technical resources</p>
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Download</span>
      </nav>
    </div>
  </section>

  <!-- Content -->
  <section class="content-section">
    <div class="container">

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--spacing-lg);">

        <!-- Download Item -->
        <div style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--spacing-xl); background: white; display: flex; flex-direction: column;">
          <div style="width: 56px; height: 56px; border-radius: var(--radius-md); background: linear-gradient(135deg, #ef4444, #dc2626); display: flex; align-items: center; justify-content: center; margin-bottom: var(--spacing-md);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8" fill="none" stroke="white" stroke-width="2"/><path d="M12 18v-6m-3 3l3-3 3 3" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3 style="font-size: var(--font-size-lg); color: var(--color-primary); margin-bottom: var(--spacing-xs);">Complete Product Catalog 2024</h3>
          <p style="color: var(--color-text-light); font-size: var(--font-size-sm); line-height: 1.6; flex-grow: 1;">Full catalog featuring all product categories with specifications, dimensions, and pricing ranges.</p>
          <div style="margin-top: var(--spacing-md); display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: var(--font-size-xs); color: var(--color-text-light);">PDF — 15.2 MB</span>
            <a href="#" class="btn btn-primary btn-sm" style="font-size: var(--font-size-xs);">Download</a>
          </div>
        </div>

        <!-- Range Hood Catalog -->
        <div style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--spacing-xl); background: white; display: flex; flex-direction: column;">
          <div style="width: 56px; height: 56px; border-radius: var(--radius-md); background: linear-gradient(135deg, #3b82f6, #2563eb); display: flex; align-items: center; justify-content: center; margin-bottom: var(--spacing-md);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8" fill="none" stroke="white" stroke-width="2"/><path d="M12 18v-6m-3 3l3-3 3 3" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3 style="font-size: var(--font-size-lg); color: var(--color-primary); margin-bottom: var(--spacing-xs);">Range Hood Collection</h3>
          <p style="color: var(--color-text-light); font-size: var(--font-size-sm); line-height: 1.6; flex-grow: 1;">Detailed range hood models: Wall Mount, Island, Built-in, Slim, and Commercial series.</p>
          <div style="margin-top: var(--spacing-md); display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: var(--font-size-xs); color: var(--color-text-light);">PDF — 8.5 MB</span>
            <a href="#" class="btn btn-primary btn-sm" style="font-size: var(--font-size-xs);">Download</a>
          </div>
        </div>

        <!-- Gas Stove Catalog -->
        <div style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--spacing-xl); background: white; display: flex; flex-direction: column;">
          <div style="width: 56px; height: 56px; border-radius: var(--radius-md); background: linear-gradient(135deg, #f59e0b, #d97706); display: flex; align-items: center; justify-content: center; margin-bottom: var(--spacing-md);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8" fill="none" stroke="white" stroke-width="2"/><path d="M12 18v-6m-3 3l3-3 3 3" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3 style="font-size: var(--font-size-lg); color: var(--color-primary); margin-bottom: var(--spacing-xs);">Gas Stove & Hob Series</h3>
          <p style="color: var(--color-text-light); font-size: var(--font-size-sm); line-height: 1.6; flex-grow: 1;">Gas, Electric, Ceramic, and Induction hobs with 2-5 burner configurations.</p>
          <div style="margin-top: var(--spacing-md); display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: var(--font-size-xs); color: var(--color-text-light);">PDF — 6.2 MB</span>
            <a href="#" class="btn btn-primary btn-sm" style="font-size: var(--font-size-xs);">Download</a>
          </div>
        </div>

        <!-- Oven Catalog -->
        <div style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--spacing-xl); background: white; display: flex; flex-direction: column;">
          <div style="width: 56px; height: 56px; border-radius: var(--radius-md); background: linear-gradient(135deg, #10b981, #059669); display: flex; align-items: center; justify-content: center; margin-bottom: var(--spacing-md);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8" fill="none" stroke="white" stroke-width="2"/><path d="M12 18v-6m-3 3l3-3 3 3" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3 style="font-size: var(--font-size-lg); color: var(--color-primary); margin-bottom: var(--spacing-xs);">Oven & Air Fryer Series</h3>
          <p style="color: var(--color-text-light); font-size: var(--font-size-sm); line-height: 1.6; flex-grow: 1;">Built-in ovens (Electric/Gas/Steam) and Air Fryer collections with full specs.</p>
          <div style="margin-top: var(--spacing-md); display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: var(--font-size-xs); color: var(--color-text-light);">PDF — 7.8 MB</span>
            <a href="#" class="btn btn-primary btn-sm" style="font-size: var(--font-size-xs);">Download</a>
          </div>
        </div>

        <!-- Company Profile -->
        <div style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--spacing-xl); background: white; display: flex; flex-direction: column;">
          <div style="width: 56px; height: 56px; border-radius: var(--radius-md); background: linear-gradient(135deg, #8b5cf6, #7c3aed); display: flex; align-items: center; justify-content: center; margin-bottom: var(--spacing-md);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8" fill="none" stroke="white" stroke-width="2"/><path d="M12 18v-6m-3 3l3-3 3 3" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3 style="font-size: var(--font-size-lg); color: var(--color-primary); margin-bottom: var(--spacing-xs);">Company Profile</h3>
          <p style="color: var(--color-text-light); font-size: var(--font-size-sm); line-height: 1.6; flex-grow: 1;">Comprehensive overview of HouseTech Group including factory info, capabilities, and certifications.</p>
          <div style="margin-top: var(--spacing-md); display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: var(--font-size-xs); color: var(--color-text-light);">PDF — 4.1 MB</span>
            <a href="#" class="btn btn-primary btn-sm" style="font-size: var(--font-size-xs);">Download</a>
          </div>
        </div>

        <!-- Certifications -->
        <div style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--spacing-xl); background: white; display: flex; flex-direction: column;">
          <div style="width: 56px; height: 56px; border-radius: var(--radius-md); background: linear-gradient(135deg, #ec4899, #db2777); display: flex; align-items: center; justify-content: center; margin-bottom: var(--spacing-md);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8" fill="none" stroke="white" stroke-width="2"/><path d="M12 18v-6m-3 3l3-3 3 3" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3 style="font-size: var(--font-size-lg); color: var(--color-primary); margin-bottom: var(--spacing-xs);">Certification Documents</h3>
          <p style="color: var(--color-text-light); font-size: var(--font-size-sm); line-height: 1.6; flex-grow: 1;">ISO9001, CE, CB, ETL, SASO, GCC certificates and test reports.</p>
          <div style="margin-top: var(--spacing-md); display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: var(--font-size-xs); color: var(--color-text-light);">ZIP — 12.4 MB</span>
            <a href="#" class="btn btn-primary btn-sm" style="font-size: var(--font-size-xs);">Download</a>
          </div>
        </div>

      </div>

      <!-- Note -->
      <div style="margin-top: var(--spacing-2xl); text-align: center; padding: var(--spacing-lg); background: var(--color-accent-light); border-radius: var(--radius-md);">
        <p style="color: var(--color-primary); font-weight: 500;"><strong>Note:</strong> Some downloads require registration. Contact our sales team for access to detailed pricing and OEM specification sheets.</p>
      </div>

    </div>
  </section>

  <Footer />
</Layout>
