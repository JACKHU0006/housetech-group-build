---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'HouseTech Group - Professional Kitchen Appliance Manufacturer | Range Hood, Gas Stove, Oven, Air Fryer';
const description = 'Leading B2B manufacturer of kitchen appliances: Range Hoods, Gas Stoves/Hobs, Ovens, Air Fryers, Gas Water Heaters. OEM/ODM services available. Factory direct pricing.';
---

<Layout title={title} description={description}>
  <Header activeNav="home" />

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <div class="hero-text">
        <h1>Professional Kitchen Appliance Manufacturer</h1>
        <p class="hero-subtitle">Your Trusted B2B Partner for Quality Range Hoods, Gas Stoves, Ovens & More</p>
        <div class="hero-cta">
          <a href="/products" class="btn btn-primary">Explore Products</a>
          <a href="/contact" class="btn btn-outline">Get a Quote</a>
        </div>
        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-number">15+</span>
            <span class="stat-label">Years Experience</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">50+</span>
            <span class="stat-label">Countries Served</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">500+</span>
            <span class="stat-label">Product Models</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">1000+</span>
            <span class="stat-label">Global Clients</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product Categories -->
  <section class="section products-section">
    <div class="container">
      <div class="section-header">
        <h2>Our Product Categories</h2>
        <p>Comprehensive range of kitchen appliances designed for global markets</p>
      </div>
      <div class="product-grid">
        <a href="/products/range-hood" class="product-card">
          <div class="product-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path d="M9 22V12h6v10"/></svg>
          </div>
          <h3>Range Hoods</h3>
          <p>Wall Mount, Island, Built-in, Slim, Chimney & Commercial Range Hoods with advanced ventilation technology.</p>
          <span class="product-link">View Products →</span>
        </a>
        <a href="/products/gas-stove" class="product-card">
          <div class="product-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M12 1v4m0 14v4M4.22 4.22l2.83 2.83m9.9 9.9l2.83 2.83M1 12h4m14 0h4M4.22 19.78l2.83-2.83m9.9-9.9l2.83-2.83"/></svg>
          </div>
          <h3>Gas Stoves & Hobs</h3>
          <p>Built-in Gas/Electric/Ceramic/Induction Hobs, 2-5 Burners, Portable & Safety-certified options.</p>
          <span class="product-link">View Products →</span>
        </a>
        <a href="/products/oven" class="product-card">
          <div class="product-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          </div>
          <h3>Ovens</h3>
          <p>Built-in Electric/Gas Ovens, Convection Ovens, Steam Ovens, Multi-function Large Capacity models.</p>
          <span class="product-link">View Products →</span>
        </a>
        <a href="/products/air-fryer" class="product-card">
          <div class="product-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <h3>Air Fryers</h3>
          <p>Digital & Electric Air Fryers, Oil-free Cooking, Smart Multi-function, Compact to Large sizes.</p>
          <span class="product-link">View Products →</span>
        </a>
        <a href="/products/water-heater" class="product-card">
          <div class="product-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"/></svg>
          </div>
          <h3>Gas Water Heaters</h3>
          <p>Instant Gas Water Heaters, Tankless Models, Energy Saving Household & Commercial solutions.</p>
          <span class="product-link">View Products →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section why-us-section">
    <div class="container">
      <div class="section-header">
        <h2>Why Choose HouseTech Group</h2>
        <p>Your reliable manufacturing partner with end-to-end capabilities</p>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3>Quality Assurance</h3>
          <p>ISO9001 certified factory with rigorous QC processes. Every product undergoes multi-stage testing before shipment.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>
          </div>
          <h3>OEM / ODM Services</h3>
          <p>Full customization capabilities including logo, color, packaging, and product specifications tailored to your market.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10A15.3 15.3 0 0112 2z"/></svg>
          </div>
          <h3>Global Export Experience</h3>
          <p>15+ years exporting to 50+ countries. Experienced with CE, CB, ETL, SASO, GCC, and other international certifications.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <h3>Competitive Pricing</h3>
          <p>Factory direct pricing with no middlemen. Flexible MOQ and payment terms to support your business growth.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
          </div>
          <h3>R&D Innovation</h3>
          <p>Dedicated R&D team continuously developing new products. 20+ new models launched annually to keep you ahead.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          </div>
          <h3>After-Sales Support</h3>
          <p>Professional technical support team providing installation guidance, troubleshooting, and spare parts supply.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container cta-content">
      <h2>Ready to Start Your Order?</h2>
      <p>Contact our sales team today for product catalogs, quotes, or factory visits.</p>
      <div class="cta-buttons">
        <a href="/contact" class="btn btn-white">Contact Us Now</a>
        <a href="/download" class="btn btn-outline-white">Download Catalog</a>
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="section certifications-section">
    <div class="container">
      <div class="cert-badges">
        <div class="cert-badge">ISO 9001</div>
        <div class="cert-badge">CE Certified</div>
        <div class="cert-badge">CB Certified</div>
        <div class="cert-badge">ETL Listed</div>
        <div class="cert-badge">SASO</div>
        <div class="cert-badge">GCC</div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
