---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'HouseTech Group - Premium Kitchen Appliance Manufacturer | B2B OEM/ODM Partner for Range Hoods, Gas Stoves, Ovens';
const description = 'HouseTech Group: Leading B2B kitchen appliance manufacturer since 2010. Professional OEM/ODM services for Range Hoods, Gas Stoves, Induction/Ceramic Cookers, Ovens, Air Fryers. Factory direct pricing, CE/CB/ETL certified, serving 50+ countries worldwide.';
---

<Layout title={title} description={description}>
  <Header activeNav="home" />

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <div class="hero-text">
        <p class="section-tag" style="display: inline-block; margin-bottom: var(--spacing-md);">Trusted by 1,000+ Global Partners</p>
        <h1><span class="accent-word">HouseTech Group</span> — Premium Kitchen Appliance Manufacturing</h1>
        <p class="hero-subtitle">Your Trusted B2B Partner for Professional Range Hoods, Gas Stoves, Induction & Ceramic Cookers, Built-in Ovens & Smart Air Fryers. Factory Direct. OEM/ODM Customization. Global Export.</p>
        <div class="hero-cta">
          <a href="/products" class="btn btn-primary">Explore Products</a>
          <a href="/contact" class="btn btn-outline">Request a Quote</a>
        </div>
        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-number">15+</span>
            <span class="stat-label">Years of Excellence</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">50+</span>
            <span class="stat-label">Countries Served</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">500+</span>
            <span class="stat-label">Product Models</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">1000+</span>
            <span class="stat-label">Global Clients</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product Categories -->
  <section class="section products-section">
    <div class="container">
      <div class="section-header">
        <p class="section-tag">Product Portfolio</p>
        <h2>Professional Kitchen Appliance Categories</h2>
        <p>Comprehensive B2B product range meeting global market demands — from extraction to cooking, heating to air circulation</p>
      </div>
      <div class="product-grid">
        <a href="/products/range-hood" class="product-card">
          <div class="product-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path d="M9 22V12h6v10"/></svg>
          </div>
          <h3>Range Hoods / Kitchen Hoods</h3>
          <p>Wall Mount, Island, Built-in, Slim, Chimney & Commercial Range Hoods with advanced ventilation technology. Extraction fans, grease filters, LED lighting systems. CE/CB/ETL certified kitchen exhaust hoods for global markets.</p>
          <span class="product-link">View Products →</span>
        </a>
        <a href="/products/gas-stove" class="product-card">
          <div class="product-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M12 1v4m0 14v4M4.22 4.22l2.83 2.83m9.9 9.9l2.83 2.83M1 12h4m14 0h4M4.22 19.78l2.83-2.83m9.9-9.9l2.83-2.83"/></svg>
          </div>
          <h3>Gas Stoves & Built-in Hobs</h3>
          <p>Built-in Gas/Electric/Ceramic/Induction Hobs, 2-5 Burners, Portable & Safety-certified options. Auto-ignition, flame failure protection, tempered glass panels. Professional kitchen cooktops for residential and commercial B2B orders.</p>
          <span class="product-link">View Products →</span>
        </a>
        <a href="/products/induction-cooker" class="product-card">
          <div class="product-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="6" width="20" height="14" rx="2"/><path d="M12 6v14M6 10h4M14 10h4"/></svg>
          </div>
          <h3>Induction Cookers</h3>
          <p>Commercial and household Induction Cookers with touch controls, multiple power levels, timer functions, and rapid heating technology. Energy-efficient electromagnetic cooking solutions. OEM/ODM available for global kitchen appliance brands.</p>
          <span class="product-link">View Products →</span>
        </a>
        <a href="/products/ceramic-cooker" class="product-card">
          <div class="product-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><circle cx="8" cy="10" r="2"/><circle cx="16" cy="14" r="2"/></svg>
          </div>
          <h3>Ceramic Cookers / Radiant Hobs</h3>
          <p>Smooth-top Ceramic Cookers and Radiant Hobs with halogen/radiant heating elements. Easy-clean vitroceramic surface, residual heat indicators, child safety locks. Premium kitchen cooking appliances for modern homes and professional kitchens.</p>
          <span class="product-link">View Products →</span>
        </a>
        <a href="/products/oven" class="product-card">
          <div class="product-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          </div>
          <h3>Built-in Ovens</h3>
          <p>Built-in Electric/Gas Ovens, Convection Ovens, Steam Ovens, Multi-function Large Capacity models. Touchscreen displays, self-cleaning, temperature probes. European standard built-in ovens for global kitchen appliance distributors.</p>
          <span class="product-link">View Products →</span>
        </a>
        <a href="/products/air-fryer" class="product-card">
          <div class="product-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <h3>Air Fryers / Smart Fryers</h3>
          <p>Digital & Electric Air Fryers, Oil-free Cooking, Smart Multi-function, Compact to Large sizes. WiFi connectivity, recipe apps, touch screen controls. Innovative kitchen cooking appliances for health-conscious consumers worldwide.</p>
          <span class="product-link">View Products →</span>
        </a>
        <a href="/products/water-heater" class="product-card">
          <div class="product-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"/></svg>
          </div>
          <h3>Gas Water Heaters</h3>
          <p>Instant Gas Water Heaters, Tankless Models, Energy Saving Household & Commercial solutions. Digital temperature display, multiple safety protections. High-efficiency water heating systems for residential and hospitality applications.</p>
          <span class="product-link">View Products →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section why-us-section">
    <div class="container">
      <div class="section-header">
        <p class="section-tag">Our Advantages</p>
        <h2>Why Partner with HouseTech Group</h2>
        <p>Your reliable manufacturing partner with end-to-end capabilities — from R&D to delivery</p>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3>Quality Assurance</h3>
          <p>ISO9001 certified factory with rigorous QC processes. Every HouseTech product undergoes multi-stage testing before shipment. 99.5% on-time delivery rate.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>
          </div>
          <h3>OEM / ODM Services</h3>
          <p>Full customization capabilities including logo, color, packaging, and product specifications tailored to your market. HouseTech supports brand customization from concept to production.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10A15.3 15.3 0 0112 2z"/></svg>
          </div>
          <h3>Global Export Expertise</h3>
          <p>15+ years exporting to 50+ countries. HouseTech is experienced with CE, CB, ETL, SASO, GCC, NOM, and other international certifications for kitchen appliances.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <h3>Competitive Factory Pricing</h3>
          <p>Factory direct pricing with no middlemen. HouseTech offers flexible MOQ starting from 50 units and flexible payment terms to support your business growth worldwide.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
          </div>
          <h3>R&D Innovation</h3>
          <p>Dedicated R&D team continuously developing new products. HouseTech launches 20+ new models annually to keep your product line ahead of market trends.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          </div>
          <h3>After-Sales Support</h3>
          <p>Professional technical support team providing installation guidance, troubleshooting, and spare parts supply. HouseTech ensures long-term partnership with reliable after-sales service.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
          </div>
          <h3>Global R&D & Innovation Centers</h3>
          <p>HouseTech maintains R&D innovation centers in China and Europe, continuously investing in smart kitchen technology. Patents in induction heating, airflow optimization, and IoT connectivity.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Trusted By Global Brands -->
  <section class="section" style="background: var(--color-bg-alt);">
    <div class="container">
      <div class="section-header">
        <p class="section-tag">Global Partners</p>
        <h2>Trusted by Leading Global Brands</h2>
        <p>HouseTech Group proudly serves distributors, retailers, and brands across 50+ countries</p>
      </div>
      <div style="display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: var(--spacing-2xl); padding: var(--spacing-xl) 0;">
        <!-- Partner Logo SVG Placeholders -->
        <svg width="140" height="56" viewBox="0 0 140 56"><rect width="138" height="54" x="1" y="1" rx="8" fill="white" stroke="#e5e7eb" stroke-width="1"/><text x="70" y="33" text-anchor="middle" fill="#6b7280" font-family="system-ui, sans-serif" font-size="11" font-weight="600">Global Partner</text></svg>
        <svg width="140" height="56" viewBox="0 0 140 56"><rect width="138" height="54" x="1" y="1" rx="8" fill="white" stroke="#e5e7eb" stroke-width="1"/><text x="70" y="33" text-anchor="middle" fill="#6b7280" font-family="system-ui, sans-serif" font-size="11" font-weight="600">Euro Distributor</text></svg>
        <svg width="140" height="56" viewBox="0 0 140 56"><rect width="138" height="54" x="1" y="1" rx="8" fill="white" stroke="#e5e7eb" stroke-width="1"/><text x="70" y="33" text-anchor="middle" fill="#6b7280" font-family="system-ui, sans-serif" font-size="11" font-weight="600">MEA Retailer</text></svg>
        <svg width="140" height="56" viewBox="0 0 140 56"><rect width="138" height="54" x="1" y="1" rx="8" fill="white" stroke="#e5e7eb" stroke-width="1"/><text x="70" y="33" text-anchor="middle" fill="#6b7280" font-family="system-ui, sans-serif" font-size="11" font-weight="600">Americas Brand</text></svg>
        <svg width="140" height="56" viewBox="0 0 140 56"><rect width="138" height="54" x="1" y="1" rx="8" fill="white" stroke="#e5e7eb" stroke-width="1"/><text x="70" y="33" text-anchor="middle" fill="#6b7280" font-family="system-ui, sans-serif" font-size="11" font-weight="600">Asia Pacific</text></svg>
        <svg width="140" height="56" viewBox="0 0 140 56"><rect width="138" height="54" x="1" y="1" rx="8" fill="white" stroke="#e5e7eb" stroke-width="1"/><text x="70" y="33" text-anchor="middle" fill="#6b7280" font-family="system-ui, sans-serif" font-size="11" font-weight="600">OEM Partner</text></svg>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container cta-content">
      <h2>Ready to Source Premium Kitchen Appliances?</h2>
      <p>Partner with HouseTech Group for factory-direct pricing, professional OEM/ODM services, and reliable global delivery. Contact our export team today for customized quotes.</p>
      <div class="cta-buttons">
        <a href="/contact" class="btn btn-white">Get Your Free Quote Now</a>
        <a href="/download" class="btn btn-outline-white">Download Latest Product Catalog</a>
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="section certifications-section">
    <div class="container">
      <div class="section-header" style="margin-bottom: var(--spacing-xl);">
        <p class="section-tag">International Certifications</p>
        <h2>Certified Quality for Global Markets</h2>
        <p>HouseTech Group products meet the highest international standards</p>
      </div>
      <div class="cert-badges">
        <div class="cert-badge">ISO 9001:2015</div>
        <div class="cert-badge">CE Certified</div>
        <div class="cert-badge">CB Certified</div>
        <div class="cert-badge">ETL Listed</div>
        <div class="cert-badge">SASO Approved</div>
        <div class="cert-badge">GCC Certified</div>
        <div class="cert-badge">NOM Certified</div>
        <div class="cert-badge">RoHS Compliant</div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
