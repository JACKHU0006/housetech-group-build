---
import '../styles/global.css';
const currentYear = new Date().getFullYear();

const footerLinks = {
  products: [
    { label: 'Range Hoods', href: '/products/range-hood' },
    { label: 'Gas Stoves & Hobs', href: '/products/gas-stove' },
    { label: 'Ovens', href: '/products/oven' },
    { label: 'Air Fryers', href: '/products/air-fryer' },
    { label: 'Water Heaters', href: '/products/water-heater' },
  ],
  company: [
    { label: 'About Us', href: '/about' },
    { label: 'Factory Tour', href: '/factory' },
    { label: 'Our Team', href: '/team' },
    { label: 'News & Media', href: '/news' },
    { label: 'Careers', href: '/careers' },
  ],
  support: [
    { label: 'Service', href: '/service' },
    { label: 'FAQ', href: '/faq' },
    { label: 'Download Catalog', href: '/download' },
    { label: 'Support Center', href: '/support' },
    { label: 'Privacy Policy', href: '/privacy' },
  ],
};
---

<footer class="footer">
  <!-- Main Footer -->
  <div class="container">
    <div class="footer-grid">
      <!-- Company Info -->
      <div class="footer-brand">
        <a href="/" class="logo footer-logo">
          <img src="/logo-full.png" alt="HouseTech Group" class="footer-logo-img" />
        </a>
        <p class="footer-desc">
          A leading manufacturer of professional kitchen appliances. 
          We provide high-quality Range Hoods, Gas Stoves, Ovens, Air Fryers, 
          and Water Heaters with OEM/ODM services for global B2B partners.
        </p>
        <div class="social-links">
          <a href="#" aria-label="LinkedIn" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="#" aria-label="Facebook" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="#" aria-label="YouTube" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a href="#" aria-label="Alibaba" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.66 13.46c-1.73-1.96-2.98-3.82-2.98-3.82s-.72 2.48-1.62 4.26c-.89 1.78-2.36 3.52-2.36 3.52s1.97.34 4.02-.21c2.05-.55 2.94-3.75 2.94-3.75zm-7.84-3.08S8.76 7.58 7.05 6.54c-1.71-1.04-3.39-.88-3.39-.88s-1.17 2.29-.41 4.71c.75 2.42 2.86 3.65 2.86 3.65s2.87-.67 4.71-3.64zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/></svg>
          </a>
        </div>
      </div>

      <!-- Products -->
      <div class="footer-col">
        <h4>Products</h4>
        <ul>
          {footerLinks.products.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          {footerLinks.company.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Support / Contact -->
      <div class="footer-col">
        <h4>Support</h4>
        <ul>
          {footerLinks.support.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
        <div class="footer-contact">
          <p><strong>Email:</strong> sales@housetech-ch.com</p>
          <p><strong>WhatsApp:</strong> +86 xxx xxxx xxxx</p>
          <p><strong>Working Hours:</strong> Mon - Sat, 8:30 - 18:00 (CST)</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>&copy; {currentYear} HouseTech Group. All rights reserved.</p>
      <div class="footer-bottom-links">
        <a href="/privacy">Privacy Policy</a>
        <span>|</span>
        <a href="/support">Support</a>
      </div>
    </div>
  </div>
</footer>
