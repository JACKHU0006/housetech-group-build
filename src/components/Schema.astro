---
interface ProductSchemaProps {
  name: string;
  description: string;
  image: string[];
  brand: string;
  model: string;
  certifications: string[];
  price?: string;
  currency?: string;
  availability?: string;
}

interface FAQItem {
  question: string;
  answer: string;
}

interface FAQSchemaProps {
  items: FAQItem[];
}

interface OrganizationSchemaProps {
  name: string;
  url: string;
  logo: string;
}

interface LocalBusinessSchemaProps {
  name: string;
  description: string;
  url: string;
  telephone: string;
  email: string;
  address: {
    streetAddress: string;
    addressLocality: string;
    addressRegion: string;
    postalCode?: string;
    addressCountry: string;
  };
  openingHoursSpecification?: {
    dayOfWeek: string[];
    opens: string;
    closes: string;
  };
  priceRange?: string;
  areaServed?: string[];
}

type Props = 
  | { type: 'product'; data: ProductSchemaProps }
  | { type: 'faq'; data: FAQSchemaProps }
  | { type: 'organization'; data: OrganizationSchemaProps }
  | { type: 'localBusiness'; data: LocalBusinessSchemaProps };

const { type, data } = Astro.props;

let schemaData: any;

if (type === 'product') {
  const productData = data as ProductSchemaProps;
  schemaData = {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": productData.name,
    "description": productData.description,
    "image": productData.image,
    "brand": {
      "@type": "Brand",
      "name": productData.brand
    },
    "model": productData.model,
    "manufacturer": {
      "@type": "Organization",
      "name": "HouseTech Group",
      "url": "https://housetech-ch.com"
    },
    "additionalProperty": productData.certifications.map(cert => ({
      "@type": "PropertyValue",
      "name": "Certification",
      "value": cert
    })),
    ...(productData.price && {
      "offers": {
        "@type": "Offer",
        "price": productData.price,
        "priceCurrency": productData.currency || "USD",
        "availability": productData.availability || "https://schema.org/InStock",
        "seller": {
          "@type": "Organization",
          "name": "HouseTech Group",
          "url": "https://housetech-ch.com"
        }
      }
    })
  };
} else if (type === 'faq') {
  const faqData = data as FAQSchemaProps;
  schemaData = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqData.items.map(item => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))
  };
} else if (type === 'organization') {
  const orgData = data as OrganizationSchemaProps;
  schemaData = {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": orgData.name,
    "url": orgData.url,
    "logo": orgData.logo
  };
} else if (type === 'localBusiness') {
  const localData = data as LocalBusinessSchemaProps;
  schemaData = {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": localData.name,
    "description": localData.description,
    "url": localData.url,
    "telephone": localData.telephone,
    "email": localData.email,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": localData.address.streetAddress,
      "addressLocality": localData.address.addressLocality,
      "addressRegion": localData.address.addressRegion,
      ...(localData.address.postalCode && { "postalCode": localData.address.postalCode }),
      "addressCountry": localData.address.addressCountry
    },
    ...(localData.openingHoursSpecification && {
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": localData.openingHoursSpecification.dayOfWeek,
        "opens": localData.openingHoursSpecification.opens,
        "closes": localData.openingHoursSpecification.closes
      }
    }),
    ...(localData.priceRange && { "priceRange": localData.priceRange }),
    ...(localData.areaServed && { "areaServed": localData.areaServed })
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
