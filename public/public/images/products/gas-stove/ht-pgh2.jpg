<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#f8f9fa"/><stop offset="100%" style="stop-color:#e9ecef"/></linearGradient>
    <linearGradient id="metalGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#d0d0d0"/><stop offset="30%" style="stop-color:#b8b8b8"/><stop offset="70%" style="stop-color:#e0e0e0"/><stop offset="100%" style="stop-color:#a0a0a0"/></linearGradient>
    <linearGradient id="bodyGrad" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" style="stop-color:#4a4a4a"/><stop offset="50%" style="stop-color:#333"/><stop offset="100%" style="stop-color:#222"/></linearGradient>
    <linearGradient id="burnerGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#2a2a2a"/><stop offset="100%" style="stop-color:#1a1a1a"/></linearGradient>
    <linearGradient id="copperGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#c9a86c"/><stop offset="50%" style="stop-color:#a67c52"/><stop offset="100%" style="stop-color:#8b6914"/></linearGradient>
    <linearGradient id="flameGrad" x1="0%" y1="100%" x2="0%" y2="0%"><stop offset="0%" style="stop-color:#ff5722"/><stop offset="50%" style="stop-color:#ff9800"/><stop offset="100%" style="stop-color:#ffc107"/></linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000" flood-opacity="0.2"/></filter>
    <filter id="glow"><feGaussianBlur stdDeviation="3" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
  </defs>
  <rect x="0" y="0" width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  <ellipse cx="400" cy="520" rx="300" ry="20" fill="#ccc" opacity="0.3"/>
  <ellipse cx="400" cy="480" rx="200" ry="30" fill="#000" opacity="0.15" filter="url(#shadow)"/>
  <rect x="200" y="450" width="20" height="70" rx="3" fill="url(#metalGrad)" stroke="#888" stroke-width="1"/><rect x="580" y="450" width="20" height="70" rx="3" fill="url(#metalGrad)" stroke="#888" stroke-width="1"/><rect x="270" y="450" width="16" height="60" rx="2" fill="url(#metalGrad)" stroke="#888" stroke-width="1"/><rect x="514" y="450" width="16" height="60" rx="2" fill="url(#metalGrad)" stroke="#888" stroke-width="1"/>
  <rect x="160" y="280" width="480" height="190" rx="15" fill="url(#bodyGrad)" stroke="#555" stroke-width="2"/>
  <rect x="170" y="290" width="460" height="120" rx="10" fill="url(#burnerGrad)"/>
  <g transform="translate(280, 350)">
    <circle cx="0" cy="0" r="48" fill="#222" stroke="#444" stroke-width="2"/><circle cx="0" cy="0" r="38" fill="url(#copperGrad)"/><circle cx="0" cy="0" r="28" fill="#1a1a1a"/><circle cx="0" cy="0" r="20" fill="url(#copperGrad)" opacity="0.6"/>
    <ellipse cx="0" cy="0" rx="14" ry="10" fill="url(#flameGrad)" filter="url(#glow)" opacity="0.9"><animate attributeName="ry" values="10;12;10" dur="0.4s" repeatCount="indefinite"/></ellipse>
  </g>
  <g transform="translate(520, 350)">
    <circle cx="0" cy="0" r="48" fill="#222" stroke="#444" stroke-width="2"/><circle cx="0" cy="0" r="38" fill="url(#copperGrad)"/><circle cx="0" cy="0" r="28" fill="#1a1a1a"/><circle cx="0" cy="0" r="20" fill="url(#copperGrad)" opacity="0.6"/>
    <ellipse cx="0" cy="0" rx="14" ry="10" fill="url(#flameGrad)" filter="url(#glow)" opacity="0.9"><animate attributeName="ry" values="10;12;10" dur="0.45s" repeatCount="indefinite"/></ellipse>
  </g>
  <rect x="170" y="400" width="460" height="55" rx="5" fill="#222"/>
  <g transform="translate(280, 427)"><circle cx="0" cy="0" r="20" fill="url(#metalGrad)" stroke="#777" stroke-width="2"/><circle cx="0" cy="0" r="14" fill="#2a2a2a"/><line x1="0" y1="-6" x2="0" y2="-14" stroke="#ccc" stroke-width="2" stroke-linecap="round"/></g>
  <g transform="translate(520, 427)"><circle cx="0" cy="0" r="20" fill="url(#metalGrad)" stroke="#777" stroke-width="2"/><circle cx="0" cy="0" r="14" fill="#2a2a2a"/><line x1="0" y1="-6" x2="0" y2="-14" stroke="#ccc" stroke-width="2" stroke-linecap="round"/></g>
  <rect x="380" y="415" width="40" height="20" rx="3" fill="#333" stroke="#555" stroke-width="1"/><circle cx="400" cy="425" r="6" fill="#1a1a1a" stroke="#f7931e" stroke-width="1.5"/>
  <ellipse cx="210" cy="518" rx="15" ry="6" fill="#111"/><ellipse cx="590" cy="518" rx="15" ry="6" fill="#111"/><ellipse cx="278" cy="508" rx="12" ry="5" fill="#111"/><ellipse cx="522" cy="508" rx="12" ry="5" fill="#111"/>
  <rect x="680" y="330" width="8" height="40" rx="4" fill="url(#metalGrad)" stroke="#888" stroke-width="1"/><rect x="112" y="330" width="8" height="40" rx="4" fill="url(#metalGrad)" stroke="#888" stroke-width="1"/>
  <rect x="250" y="700" width="300" height="50" rx="10" fill="#0a2540"/>
  <text x="400" y="722" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#fff" text-anchor="middle">HT-PGH2</text>
  <text x="400" y="742" font-family="Arial, sans-serif" font-size="12" fill="#f7931e" text-anchor="middle">PORTABLE 2-BURNER GAS STOVE</text>
</svg>