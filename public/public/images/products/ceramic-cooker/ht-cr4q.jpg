<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#f8f9fa"/><stop offset="100%" style="stop-color:#e9ecef"/></linearGradient>
    <linearGradient id="frameGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#ddd"/><stop offset="40%" style="stop-color:#bbb"/><stop offset="100%" style="stop-color:#999"/></linearGradient>
    <linearGradient id="glassGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#242424"/><stop offset="50%" style="stop-color:#0c0c0c"/><stop offset="100%" style="stop-color:#181818"/></linearGradient>
    <radialGradient id="radiantRed" cx="50%" cy="50%" r="50%"><stop offset="0%" style="stop-color:#ff1a1a"/><stop offset="25%" style="stop-color:#dd0000"/><stop offset="60%" style="stop-color:#990000"/><stop offset="100%" style="stop-color:#660000"/></radialGradient>
    <radialGradient id="radiantGlow" cx="50%" cy="50%" r="50%"><stop offset="0%" style="stop-color:#ff3333;stop-opacity:0.9"/><stop offset="50%" style="stop-color:#ff0000;stop-opacity:0.5"/><stop offset="100%" style="stop-color:#aa0000;stop-opacity:0"/></radialGradient>
    <linearGradient id="controlGrad" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" style="stop-color:#3a3a3a"/><stop offset="100%" style="stop-color:#1c1c1c"/></linearGradient>
    <linearGradient id="touchGrad" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" style="stop-color:#4a4a4a"/><stop offset="100%" style="stop-color:#2a2a2a"/></linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="6" stdDeviation="10" flood-color="#000" flood-opacity="0.2"/></filter>
    <filter id="radiantFilter"><feGaussianBlur stdDeviation="5" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
  </defs>
  <rect x="0" y="0" width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  <rect x="100" y="155" width="600" height="460" rx="8" fill="#000" opacity="0.1" filter="url(#shadow)"/>
  <rect x="95" y="150" width="610" height="470" rx="6" fill="url(#frameGrad)" stroke="#888" stroke-width="2"/>
  <rect x="115" y="170" width="570" height="390" rx="4" fill="url(#glassGrad)"/>
  <line x1="125" y1="180" x2="675" y2="180" stroke="#fff" stroke-width="1" opacity="0.08"/>
  <g transform="translate(260, 290)">
    <circle cx="0" cy="0" r="80" fill="url(#radiantGlow)" filter="url(#radiantFilter)"/>
    <circle cx="0" cy="0" r="65" fill="url(#radiantRed)" filter="url(#radiantFilter)"><animate attributeName="opacity" values="0.95;1;0.95" dur="1.5s" repeatCount="indefinite"/></circle>
    <circle cx="0" cy="0" r="52" fill="none" stroke="#ff4444" stroke-width="3" opacity="0.5"/><circle cx="0" cy="0" r="40" fill="none" stroke="#ff4444" stroke-width="2.5" opacity="0.4"/><circle cx="0" cy="0" r="28" fill="none" stroke="#ff4444" stroke-width="2" opacity="0.3"/>
    <circle cx="0" cy="0" r="12" fill="#880000"/>
  </g>
  <g transform="translate(540, 290)">
    <circle cx="0" cy="0" r="80" fill="url(#radiantGlow)" filter="url(#radiantFilter)"/>
    <circle cx="0" cy="0" r="65" fill="url(#radiantRed)" filter="url(#radiantFilter)"><animate attributeName="opacity" values="1;0.95;1" dur="1.3s" repeatCount="indefinite"/></circle>
    <circle cx="0" cy="0" r="52" fill="none" stroke="#ff4444" stroke-width="3" opacity="0.5"/><circle cx="0" cy="0" r="40" fill="none" stroke="#ff4444" stroke-width="2.5" opacity="0.4"/><circle cx="0" cy="0" r="28" fill="none" stroke="#ff4444" stroke-width="2" opacity="0.3"/>
    <circle cx="0" cy="0" r="12" fill="#880000"/>
  </g>
  <g transform="translate(260, 450)">
    <circle cx="0" cy="0" r="80" fill="url(#radiantGlow)" filter="url(#radiantFilter)"/>
    <circle cx="0" cy="0" r="65" fill="url(#radiantRed)" filter="url(#radiantFilter)"><animate attributeName="opacity" values="0.9;1;0.9" dur="1.4s" repeatCount="indefinite"/></circle>
    <circle cx="0" cy="0" r="52" fill="none" stroke="#ff4444" stroke-width="3" opacity="0.5"/><circle cx="0" cy="0" r="40" fill="none" stroke="#ff4444" stroke-width="2.5" opacity="0.4"/><circle cx="0" cy="0" r="28" fill="none" stroke="#ff4444" stroke-width="2" opacity="0.3"/>
    <circle cx="0" cy="0" r="12" fill="#880000"/>
  </g>
  <g transform="translate(540, 450)">
    <circle cx="0" cy="0" r="80" fill="url(#radiantGlow)" filter="url(#radiantFilter)"/>
    <circle cx="0" cy="0" r="65" fill="url(#radiantRed)" filter="url(#radiantFilter)"><animate attributeName="opacity" values="1;0.9;1" dur="1.2s" repeatCount="indefinite"/></circle>
    <circle cx="0" cy="0" r="52" fill="none" stroke="#ff4444" stroke-width="3" opacity="0.5"/><circle cx="0" cy="0" r="40" fill="none" stroke="#ff4444" stroke-width="2.5" opacity="0.4"/><circle cx="0" cy="0" r="28" fill="none" stroke="#ff4444" stroke-width="2" opacity="0.3"/>
    <circle cx="0" cy="0" r="12" fill="#880000"/>
  </g>
  <rect x="115" y="515" width="570" height="90" rx="4" fill="url(#controlGrad)"/>
  <g transform="translate(200, 560)"><rect x="-35" y="-20" width="70" height="40" rx="8" fill="url(#touchGrad)" stroke="#555" stroke-width="1"/><text x="0" y="5" font-family="Arial" font-size="14" fill="#fff" text-anchor="middle">1</text></g>
  <g transform="translate(320, 560)"><rect x="-35" y="-20" width="70" height="40" rx="8" fill="url(#touchGrad)" stroke="#555" stroke-width="1"/><text x="0" y="5" font-family="Arial" font-size="14" fill="#fff" text-anchor="middle">2</text></g>
  <g transform="translate(480, 560)"><rect x="-35" y="-20" width="70" height="40" rx="8" fill="url(#touchGrad)" stroke="#555" stroke-width="1"/><text x="0" y="5" font-family="Arial" font-size="14" fill="#fff" text-anchor="middle">3</text></g>
  <g transform="translate(600, 560)"><rect x="-35" y="-20" width="70" height="40" rx="8" fill="url(#touchGrad)" stroke="#555" stroke-width="1"/><text x="0" y="5" font-family="Arial" font-size="14" fill="#fff" text-anchor="middle">4</text></g>
  <circle cx="400" cy="560" r="18" fill="#222" stroke="#00ff00" stroke-width="2"><animate attributeName="stroke-opacity" values="1;0.5;1" dur="2s" repeatCount="indefinite"/></circle>
  <text x="400" y="564" font-family="Arial" font-size="10" fill="#00ff00" text-anchor="middle">PWR</text>
  <rect x="250" y="700" width="300" height="50" rx="10" fill="#0a2540"/>
  <text x="400" y="722" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#fff" text-anchor="middle">HT-CR4Q</text>
  <text x="400" y="742" font-family="Arial, sans-serif" font-size="12" fill="#f7931e" text-anchor="middle">QUAD RADIANT CERAMIC COOKER</text>
</svg>