<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#f8f9fa"/><stop offset="100%" style="stop-color:#e9ecef"/></linearGradient>
    <linearGradient id="frameGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#e5e5e5"/><stop offset="35%" style="stop-color:#c5c5c5"/><stop offset="70%" style="stop-color:#e0e0e0"/><stop offset="100%" style="stop-color:#a5a5a5"/></linearGradient>
    <linearGradient id="glassGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#282828"/><stop offset="50%" style="stop-color:#0e0e0e"/><stop offset="100%" style="stop-color:#1c1c1c"/></linearGradient>
    <radialGradient id="ceramicRed" cx="50%" cy="50%" r="50%"><stop offset="0%" style="stop-color:#ff2222"/><stop offset="35%" style="stop-color:#cc0000"/><stop offset="70%" style="stop-color:#880000"/><stop offset="100%" style="stop-color:#550000"/></radialGradient>
    <radialGradient id="redGlowBg" cx="50%" cy="50%" r="50%"><stop offset="0%" style="stop-color:#ff4444;stop-opacity:0.85"/><stop offset="55%" style="stop-color:#ff2222;stop-opacity:0.4"/><stop offset="100%" style="stop-color:#aa0000;stop-opacity:0"/></radialGradient>
    <linearGradient id="controlGrad" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" style="stop-color:#363636"/><stop offset="100%" style="stop-color:#181818"/></linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="6" stdDeviation="10" flood-color="#000" flood-opacity="0.2"/></filter>
    <filter id="heatFilter"><feGaussianBlur stdDeviation="6" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
  </defs>
  <rect x="0" y="0" width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  <rect x="60" y="150" width="680" height="470" rx="8" fill="#000" opacity="0.1" filter="url(#shadow)"/>
  <rect x="55" y="145" width="690" height="480" rx="6" fill="url(#frameGrad)" stroke="#959595" stroke-width="2"/>
  <rect x="75" y="165" width="650" height="400" rx="4" fill="url(#glassGrad)"/>
  <line x1="85" y1="175" x2="715" y2="175" stroke="#fff" stroke-width="1" opacity="0.08"/>
  <g transform="translate(220, 280)">
    <circle cx="0" cy="0" r="75" fill="url(#redGlowBg)" filter="url(#heatFilter)"/>
    <circle cx="0" cy="0" r="60" fill="url(#ceramicRed)" filter="url(#heatFilter)"><animate attributeName="opacity" values="0.9;1;0.9" dur="1.3s" repeatCount="indefinite"/></circle>
    <circle cx="0" cy="0" r="48" fill="none" stroke="#ff5555" stroke-width="2.5" opacity="0.5"/><circle cx="0" cy="0" r="36" fill="none" stroke="#ff5555" stroke-width="2" opacity="0.4"/><circle cx="0" cy="0" r="24" fill="none" stroke="#ff5555" stroke-width="1.5" opacity="0.3"/>
    <circle cx="0" cy="0" r="10" fill="#770000"/>
  </g>
  <g transform="translate(580, 280)">
    <ellipse cx="0" cy="0" rx="90" ry="75" fill="url(#redGlowBg)" filter="url(#heatFilter)"/>
    <ellipse cx="0" cy="0" rx="72" ry="58" fill="url(#ceramicRed)" filter="url(#heatFilter)"><animate attributeName="opacity" values="1;0.9;1" dur="1.5s" repeatCount="indefinite"/></ellipse>
    <ellipse cx="0" cy="0" rx="58" ry="45" fill="none" stroke="#ff5555" stroke-width="2.5" opacity="0.5"/><ellipse cx="0" cy="0" rx="42" ry="32" fill="none" stroke="#ff5555" stroke-width="2" opacity="0.4"/>
    <circle cx="0" cy="0" r="10" fill="#770000"/>
  </g>
  <g transform="translate(220, 440)">
    <circle cx="0" cy="0" r="60" fill="url(#redGlowBg)" filter="url(#heatFilter)"/>
    <circle cx="0" cy="0" r="48" fill="url(#ceramicRed)" filter="url(#heatFilter)"><animate attributeName="opacity" values="0.95;1;0.95" dur="1.2s" repeatCount="indefinite"/></circle>
    <circle cx="0" cy="0" r="38" fill="none" stroke="#ff5555" stroke-width="2" opacity="0.5"/><circle cx="0" cy="0" r="28" fill="none" stroke="#ff5555" stroke-width="1.5" opacity="0.4"/>
    <circle cx="0" cy="0" r="8" fill="#770000"/>
  </g>
  <g transform="translate(580, 440)">
    <ellipse cx="0" cy="0" rx="85" ry="65" fill="url(#redGlowBg)" filter="url(#heatFilter)"/>
    <ellipse cx="0" cy="0" rx="68" ry="50" fill="url(#ceramicRed)" filter="url(#heatFilter)"><animate attributeName="opacity" values="1;0.95;1" dur="1.4s" repeatCount="indefinite"/></ellipse>
    <ellipse cx="0" cy="0" rx="54" ry="40" fill="none" stroke="#ff5555" stroke-width="2.5" opacity="0.5"/><ellipse cx="0" cy="0" rx="38" ry="28" fill="none" stroke="#ff5555" stroke-width="2" opacity="0.4"/>
    <circle cx="0" cy="0" r="10" fill="#770000"/>
  </g>
  <rect x="75" y="520" width="650" height="90" rx="4" fill="url(#controlGrad)"/>
  <g transform="translate(150, 555)"><rect x="-50" y="-4" width="100" height="8" rx="4" fill="#444"/><rect x="-50" y="-4" width="70" height="8" rx="4" fill="#f7931e"/><circle cx="20" cy="0" r="10" fill="url(#frameGrad)" stroke="#f7931e" stroke-width="2"/></g>
  <g transform="translate(310, 555)"><rect x="-50" y="-4" width="100" height="8" rx="4" fill="#444"/><rect x="-50" y="-4" width="55" height="8" rx="4" fill="#f7931e"/><circle cx="5" cy="0" r="10" fill="url(#frameGrad)" stroke="#f7931e" stroke-width="2"/></g>
  <g transform="translate(490, 555)"><rect x="-50" y="-4" width="100" height="8" rx="4" fill="#444"/><rect x="-50" y="-4" width="80" height="8" rx="4" fill="#f7931e"/><circle cx="30" cy="0" r="10" fill="url(#frameGrad)" stroke="#f7931e" stroke-width="2"/></g>
  <g transform="translate(650, 555)"><rect x="-50" y="-4" width="100" height="8" rx="4" fill="#444"/><rect x="-50" y="-4" width="45" height="8" rx="4" fill="#f7931e"/><circle cx="-5" cy="0" r="10" fill="url(#frameGrad)" stroke="#f7931e" stroke-width="2"/></g>
  <rect x="250" y="700" width="300" height="50" rx="10" fill="#0a2540"/>
  <text x="400" y="722" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#fff" text-anchor="middle">HT-CR90</text>
  <text x="400" y="742" font-family="Arial, sans-serif" font-size="12" fill="#f7931e" text-anchor="middle">90CM 4-ZONE CERAMIC HOB</text>
</svg>