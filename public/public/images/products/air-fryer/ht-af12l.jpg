<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <linearGradient id="metalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#d0d5dd"/>
      <stop offset="50%" style="stop-color:#f5f5f5"/>
      <stop offset="100%" style="stop-color:#a0a8b0"/>
    </linearGradient>
    <linearGradient id="darkGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#3a3a3a"/>
      <stop offset="100%" style="stop-color:#1a1a1a"/>
    </linearGradient>
    <linearGradient id="blueGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1a4a7a"/>
      <stop offset="100%" style="stop-color:#0a2540"/>
    </linearGradient>
    <linearGradient id="orangeGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#ffaa33"/>
      <stop offset="100%" style="stop-color:#f7931e"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="15" flood-opacity="0.25"/>
    </filter>
    <filter id="glow">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <rect width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  
  <g filter="url(#shadow)">
    <ellipse cx="400" cy="650" rx="220" ry="45" fill="#2a2a2a" opacity="0.3"/>
    
    <rect x="180" y="180" width="440" height="450" rx="25" fill="url(#darkGrad)"/>
    <rect x="180" y="180" width="440" height="450" rx="25" fill="none" stroke="#4a4a4a" stroke-width="3"/>
    
    <rect x="180" y="180" width="440" height="50" rx="25" fill="#2a2a2a"/>
    <rect x="180" y="210" width="440" height="20" fill="#2a2a2a"/>
    <text x="400" y="212" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" fill="#888">ON</text>
    
    <rect x="210" y="240" width="380" height="200" rx="15" fill="#1a1a1a" opacity="0.85"/>
    <rect x="210" y="240" width="380" height="200" rx="15" fill="none" stroke="#4a4a4a" stroke-width="4"/>
    
    <g fill="none" stroke="#444" stroke-width="2">
      <rect x="230" y="260" width="340" height="70" rx="5"/>
      <line x1="250" y1="260" x2="250" y2="330"/>
      <line x1="290" y1="260" x2="290" y2="330"/>
      <line x1="330" y1="260" x2="330" y2="330"/>
      <line x1="370" y1="260" x2="370" y2="330"/>
      <line x1="410" y1="260" x2="410" y2="330"/>
      <line x1="450" y1="260" x2="450" y2="330"/>
      <line x1="490" y1="260" x2="490" y2="330"/>
      <line x1="530" y1="260" x2="530" y2="330"/>
      <line x1="550" y1="260" x2="550" y2="330"/>
      
      <rect x="230" y="350" width="340" height="70" rx="5"/>
      <line x1="250" y1="350" x2="250" y2="420"/>
      <line x1="290" y1="350" x2="290" y2="420"/>
      <line x1="330" y1="350" x2="330" y2="420"/>
      <line x1="370" y1="350" x2="370" y2="420"/>
      <line x1="410" y1="350" x2="410" y2="420"/>
      <line x1="450" y1="350" x2="450" y2="420"/>
      <line x1="490" y1="350" x2="490" y2="420"/>
      <line x1="530" y1="350" x2="530" y2="420"/>
      <line x1="550" y1="350" x2="550" y2="420"/>
    </g>
    
    <line x1="210" y1="315" x2="590" y2="315" stroke="#555" stroke-width="3"/>
    
    <rect x="210" y="450" width="380" height="170" rx="15" fill="#252525"/>
    <rect x="210" y="450" width="380" height="170" rx="15" fill="none" stroke="#3a3a3a" stroke-width="2"/>
    
    <rect x="230" y="465" width="200" height="100" rx="10" fill="#0a1525"/>
    <rect x="230" y="465" width="200" height="100" rx="10" fill="none" stroke="#1a3a5a" stroke-width="2"/>
    
    <text x="280" y="500" text-anchor="middle" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="#ff6b35" filter="url(#glow)">200C</text>
    <text x="280" y="520" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="#666">TEMPERATURE</text>
    
    <text x="370" y="500" text-anchor="middle" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="#00d4aa" filter="url(#glow)">45MIN</text>
    <text x="370" y="520" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="#666">TIME</text>
    
    <g fill="#555" font-size="10">
      <rect x="245" y="535" width="35" height="25" rx="5" fill="#1a2a3a"/>
      <text x="262" y="552" text-anchor="middle">FRIES</text>
      
      <rect x="290" y="535" width="35" height="25" rx="5" fill="#1a2a3a"/>
      <text x="307" y="552" text-anchor="middle">CHICK</text>
      
      <rect x="335" y="535" width="35" height="25" rx="5" fill="#1a2a3a"/>
      <text x="352" y="552" text-anchor="middle">STEAK</text>
      
      <rect x="380" y="535" width="35" height="25" rx="5" fill="#ff6b35" fill-opacity="0.3"/>
      <text x="397" y="552" text-anchor="middle">VEGGI</text>
    </g>
    
    <g>
      <rect x="450" y="470" width="120" height="30" rx="8" fill="#1a3a5a"/>
      <text x="510" y="490" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#fff">START</text>
      
      <rect x="450" y="510" width="55" height="30" rx="8" fill="#2a2a2a"/>
      <text x="477" y="530" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#fff">-</text>
      
      <rect x="515" y="510" width="55" height="30" rx="8" fill="#2a2a2a"/>
      <text x="542" y="530" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#fff">+</text>
      
      <rect x="450" y="550" width="120" height="30" rx="8" fill="#2a2a2a"/>
      <text x="510" y="570" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="#888">PRESETS</text>
      
      <rect x="450" y="590" width="120" height="30" rx="8" fill="#2a2a2a"/>
      <text x="510" y="610" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="#888">LIGHT</text>
    </g>
    
    <g fill="#222">
      <rect x="190" y="190" width="60" height="8" rx="4"/>
      <rect x="190" y="205" width="60" height="8" rx="4"/>
      <rect x="190" y="220" width="60" height="8" rx="4"/>
      <rect x="550" y="190" width="60" height="8" rx="4"/>
      <rect x="550" y="205" width="60" height="8" rx="4"/>
      <rect x="550" y="220" width="60" height="8" rx="4"/>
    </g>
    
    <rect x="280" y="620" width="240" height="25" rx="12" fill="#3a3a3a"/>
    <rect x="280" y="620" width="240" height="25" rx="12" fill="none" stroke="#555" stroke-width="2"/>
    <rect x="340" y="626" width="120" height="12" rx="6" fill="#4a4a4a"/>
  </g>
  
  <g>
    <rect x="250" y="750" width="300" height="50" rx="10" fill="url(#blueGrad)"/>
    <rect x="250" y="750" width="300" height="50" rx="10" fill="none" stroke="#1a4a7a" stroke-width="2"/>
    <text x="400" y="772" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#ffffff">HT-AF12L</text>
    <text x="400" y="792" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="url(#orangeGrad)" font-weight="bold">LARGE CAPACITY 12L</text>
  </g>
</svg>