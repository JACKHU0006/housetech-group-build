<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <linearGradient id="steelGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e8e8e8"/>
      <stop offset="30%" style="stop-color:#f5f5f5"/>
      <stop offset="50%" style="stop-color:#d4d4d4"/>
      <stop offset="70%" style="stop-color:#c0c0c0"/>
      <stop offset="100%" style="stop-color:#a8a8a8"/>
    </linearGradient>
    <linearGradient id="steelDark" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#c0c0c0"/>
      <stop offset="50%" style="stop-color:#a0a0a0"/>
      <stop offset="100%" style="stop-color:#808080"/>
    </linearGradient>
    <linearGradient id="glassGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2a3a4a"/>
      <stop offset="30%" style="stop-color:#1a2a3a"/>
      <stop offset="100%" style="stop-color:#0a1a2a"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="2" dy="6" stdDeviation="12" flood-color="#000" flood-opacity="0.2"/>
    </filter>
  </defs>
  
  <rect width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  
  <g filter="url(#shadow)" transform="translate(400, 430)">
    <rect x="-45" y="-280" width="90" height="180" fill="url(#steelGrad)" rx="2"/>
    <rect x="-50" y="-110" width="100" height="40" fill="url(#steelDark)" rx="2"/>
    <rect x="-160" y="-60" width="320" height="55" fill="url(#steelGrad)" rx="5"/>
    <rect x="-150" y="-55" width="300" height="45" fill="url(#glassGrad)" rx="3"/>
    <rect x="-145" y="-52" width="140" height="38" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="1" rx="2"/>
    <rect x="-130" y="-60" width="260" height="12" fill="#0a1a2a" rx="2"/>
    <rect x="-25" y="-58" width="50" height="8" fill="#001a0a" rx="1"/>
    <text x="0" y="-52" text-anchor="middle" fill="#00ff88" font-family="monospace" font-size="8">600</text>
    <circle cx="-80" cy="-54" r="3" fill="#2a3a4a"/>
    <circle cx="-60" cy="-54" r="3" fill="#2a3a4a"/>
    <circle cx="60" cy="-54" r="3" fill="#2a3a4a"/>
    <circle cx="80" cy="-54" r="3" fill="#2a3a4a"/>
    <rect x="-150" y="-5" width="300" height="8" fill="#a0a0a0" rx="2"/>
    <rect x="-158" y="-58" width="316" height="3" fill="white" opacity="0.35" rx="1"/>
  </g>
  
  <g transform="translate(400, 680)">
    <rect x="-100" y="-22" width="200" height="44" fill="#0a2540" rx="8" filter="url(#shadow)"/>
    <text x="0" y="-2" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="18" font-weight="bold">HT-RH600</text>
    <text x="0" y="15" text-anchor="middle" fill="#f7931e" font-family="Arial, sans-serif" font-size="10" letter-spacing="1">SLIM RANGE HOOD</text>
  </g>
</svg>