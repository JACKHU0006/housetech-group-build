<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs><linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#f8f9fa"/><stop offset="100%" style="stop-color:#e9ecef"/></linearGradient><linearGradient id="glass" x1="0%" y1="0%" x2="100%" x2="0%"><stop offset="0%" style="stop-color:#1a1a24"/><stop offset="50%" style="stop-color:#2a2a35"/><stop offset="100%" style="stop-color:#1a1a24"/></linearGradient><linearGradient id="accent" x1="0%" y1="0%" x2="100%" x2="0%"><stop offset="0%" style="stop-color:#0a2540"/><stop offset="100%" style="stop-color:#1a3a5c"/></linearGradient><filter id="shadow"><feDropShadow dx="0" dy="8" stdDeviation="12" flood-opacity="0.15"/></filter></defs>
  <rect width="800" height="800" fill="url(#bg)" rx="20"/>
  <g transform="translate(80, 180)" filter="url(#shadow)">
    <rect x="20" y="10" width="600" height="300" rx="12" fill="url(#glass)" stroke="#444" stroke-width="2"/>
    <!-- Left zone (larger) -->
    <circle cx="190" cy="160" r="105" fill="none" stroke="#f7931e" stroke-opacity="0.35" stroke-width="3" stroke-dasharray="8,4"/>
    <circle cx="190" cy="160" r="82" fill="rgba(247,147,30,0.06)"/><circle cx="190" cy="160" r="50" fill="rgba(247,147,30,0.04)"/>
    <circle cx="190" cy="160" r="14" fill="#f7931e" opacity="0.45"/>
    <!-- Right zone (smaller) -->
    <circle cx="450" cy="160" r="85" fill="none" stroke="#f7931e" stroke-opacity="0.35" stroke-width="3" stroke-dasharray="8,4"/>
    <circle cx="450" cy="160" r="65" fill="rgba(247,147,30,0.05)"/>
    <circle cx="450" cy="160" r="11" fill="#f7931e" opacity="0.4"/>
    <!-- Control panel center between zones -->
    <rect x="290" y="230" width="60" height="65" rx="6" fill="#111" stroke="#333" stroke-width="1"/>
    <circle cx="320" cy="250" r="7" fill="#f7931e" opacity="0.8"/>
    <rect x="300" y="265" width="40" height="10" rx="2" fill="#0a2540"/>
    <text x="320" y="273" text-anchor="middle" font-family="monospace" font-size="7" fill="#4af">210</text>
    <!-- Frame -->
    <rect x="16" y="6" width="608" height="308" rx="14" fill="none" stroke="#c0c7d0" stroke-width="3"/>
    <!-- Indicators -->
    <circle cx="55" cy="42" r="5" fill="#4ade80" opacity="0.7"/><circle cx="555" cy="42" r="5" fill="#f7931e" opacity="0.7"/>
  </g>
  <g transform="translate(400, 700)"><rect x="-110" y="-28" width="220" height="56" rx="28" fill="url(#accent)"/><text x="0" y="6" text-anchor="middle" font-family="'Inter',sans-serif" font-weight="800" font-size="18" fill="white">HT-IC21</text><text x="0" y="20" text-anchor="middle" font-family="'Inter',sans-serif" font-weight="500" font-size="10" fill="#f7931e" letter-spacing="3">DUAL INDUCTION HOB</text></g>
</svg>