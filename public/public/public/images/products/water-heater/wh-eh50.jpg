<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <linearGradient id="whiteGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#ffffff"/>
      <stop offset="100%" style="stop-color:#e8e8e8"/>
    </linearGradient>
    <linearGradient id="cylinderGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#d0d0d0"/>
      <stop offset="30%" style="stop-color:#f5f5f5"/>
      <stop offset="60%" style="stop-color:#ffffff"/>
      <stop offset="100%" style="stop-color:#c0c0c0"/>
    </linearGradient>
    <linearGradient id="blueGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1a4a7a"/>
      <stop offset="100%" style="stop-color:#0a2540"/>
    </linearGradient>
    <linearGradient id="orangeGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#ffaa33"/>
      <stop offset="100%" style="stop-color:#f7931e"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="10" stdDeviation="20" flood-opacity="0.25"/>
    </filter>
    <filter id="glow">
      <feGaussianBlur stdDeviation="2" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <rect width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  
  <g filter="url(#shadow)">
    <ellipse cx="400" cy="700" rx="160" ry="30" fill="#aaa" opacity="0.2"/>
    
    <rect x="240" y="180" width="320" height="500" rx="160" fill="url(#cylinderGrad)"/>
    <rect x="240" y="180" width="320" height="500" rx="160" fill="none" stroke="#b0b0b0" stroke-width="2"/>
    
    <rect x="255" y="200" width="80" height="460" rx="80" fill="#ffffff" opacity="0.3"/>
    
    <line x1="245" y1="280" x2="555" y2="280" stroke="#ccc" stroke-width="1"/>
    <line x1="245" y1="380" x2="555" y2="380" stroke="#ccc" stroke-width="1"/>
    <line x1="245" y1="480" x2="555" y2="480" stroke="#ccc" stroke-width="1"/>
    <line x1="245" y1="580" x2="555" y2="580" stroke="#ccc" stroke-width="1"/>
    
    <rect x="280" y="320" width="240" height="140" rx="20" fill="#f0f0f0"/>
    <rect x="280" y="320" width="240" height="140" rx="20" fill="none" stroke="#ddd" stroke-width="2"/>
    
    <rect x="310" y="340" width="180" height="70" rx="12" fill="#1a2530"/>
    <rect x="310" y="340" width="180" height="70" rx="12" fill="none" stroke="#2a3a4a" stroke-width="3"/>
    
    <text x="400" y="385" text-anchor="middle" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#00d4aa" filter="url(#glow)">55</text>
    <text x="445" y="375" text-anchor="start" font-family="Arial, sans-serif" font-size="18" fill="#888">C</text>
    <text x="400" y="405" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="#666">CURRENT TEMP</text>
    
    <g transform="translate(320, 430)">
      <circle cx="0" cy="0" r="8" fill="#00d4aa"/>
      <text x="0" y="18" text-anchor="middle" font-size="7" fill="#888">HEAT</text>
      
      <circle cx="50" cy="0" r="8" fill="#f7931e"/>
      <text x="50" y="18" text-anchor="middle" font-size="7" fill="#888">WARM</text>
      
      <circle cx="100" cy="0" r="8" fill="#3399ff"/>
      <text x="100" y="18" text-anchor="middle" font-size="7" fill="#888">POWER</text>
      
      <circle cx="150" cy="0" r="8" fill="#ff6b6b"/>
      <text x="150" y="18" text-anchor="middle" font-size="7" fill="#888">ERROR</text>
    </g>
    
    <g transform="translate(400, 530)">
      <circle cx="0" cy="0" r="40" fill="#e0e0e0"/>
      <circle cx="0" cy="0" r="40" fill="none" stroke="#c0c0c0" stroke-width="3"/>
      <circle cx="0" cy="0" r="28" fill="#e8e8e8"/>
      <circle cx="0" cy="0" r="28" fill="none" stroke="#d0d0d0" stroke-width="1"/>
      <g stroke="#999" stroke-width="1">
        <line x1="0" y1="-35" x2="0" y2="-28"/>
        <line x1="25" y1="-25" x2="20" y2="-20"/>
        <line x1="35" y1="0" x2="28" y2="0"/>
        <line x1="25" y1="25" x2="20" y2="20"/>
        <line x1="0" y1="35" x2="0" y2="28"/>
        <line x1="-25" y1="25" x2="-20" y2="20"/>
        <line x1="-35" y1="0" x2="-28" y2="0"/>
        <line x1="-25" y1="-25" x2="-20" y2="-20"/>
      </g>
      <line x1="0" y1="-20" x2="0" y2="-30" stroke="#0a2540" stroke-width="4" stroke-linecap="round"/>
    </g>
    
    <circle cx="400" cy="620" r="30" fill="#0a2540"/>
    <circle cx="400" cy="620" r="30" fill="none" stroke="#1a4a7a" stroke-width="2"/>
    <text x="400" y="628" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" fill="#fff">ON</text>
    
    <text x="400" y="670" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#666">50 LITERS</text>
    
    <ellipse cx="400" cy="180" rx="160" ry="40" fill="url(#whiteGrad)"/>
    <ellipse cx="400" cy="180" rx="160" ry="40" fill="none" stroke="#b0b0b0" stroke-width="2"/>
    <ellipse cx="400" cy="175" rx="100" ry="25" fill="#e0e0e0"/>
    
    <g>
      <rect x="240" y="240" width="25" height="60" rx="5" fill="#3399ff"/>
      <rect x="240" y="240" width="25" height="60" rx="5" fill="none" stroke="#2277cc" stroke-width="1"/>
      <text x="252" y="275" text-anchor="middle" font-size="7" fill="#fff" transform="rotate(-90, 252, 275)">COLD</text>
      
      <rect x="535" y="240" width="25" height="60" rx="5" fill="#ff6b6b"/>
      <rect x="535" y="240" width="25" height="60" rx="5" fill="none" stroke="#dd5555" stroke-width="1"/>
      <text x="547" y="275" text-anchor="middle" font-size="7" fill="#fff" transform="rotate(90, 547, 275)">HOT</text>
    </g>
    
    <ellipse cx="400" cy="680" rx="160" ry="40" fill="url(#whiteGrad)"/>
    <ellipse cx="400" cy="680" rx="160" ry="40" fill="none" stroke="#b0b0b0" stroke-width="2"/>
    
    <circle cx="400" cy="685" r="35" fill="#d8d8d8"/>
    <circle cx="400" cy="685" r="35" fill="none" stroke="#bbb" stroke-width="2"/>
    <circle cx="400" cy="685" r="20" fill="#c0c0c0"/>
    <text x="400" y="690" text-anchor="middle" font-size="8" fill="#666">HEATER</text>
  </g>
  
  <g>
    <rect x="250" y="745" width="300" height="50" rx="10" fill="url(#blueGrad)"/>
    <rect x="250" y="745" width="300" height="50" rx="10" fill="none" stroke="#1a4a7a" stroke-width="2"/>
    <text x="400" y="767" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#ffffff">WH-EH50</text>
    <text x="400" y="787" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="url(#orangeGrad)" font-weight="bold">ELECTRIC STORAGE 50L</text>
  </g>
</svg>