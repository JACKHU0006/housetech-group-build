<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <linearGradient id="metalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#d0d5dd"/>
      <stop offset="50%" style="stop-color:#f5f5f5"/>
      <stop offset="100%" style="stop-color:#a0a8b0"/>
    </linearGradient>
    <linearGradient id="silverGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e0e0e0"/>
      <stop offset="30%" style="stop-color:#ffffff"/>
      <stop offset="70%" style="stop-color:#e8e8e8"/>
      <stop offset="100%" style="stop-color:#c8c8c8"/>
    </linearGradient>
    <linearGradient id="blueGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1a4a7a"/>
      <stop offset="100%" style="stop-color:#0a2540"/>
    </linearGradient>
    <linearGradient id="orangeGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#ffaa33"/>
      <stop offset="100%" style="stop-color:#f7931e"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="15" flood-opacity="0.25"/>
    </filter>
    <filter id="glow">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <rect width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  
  <g filter="url(#shadow)">
    <ellipse cx="400" cy="660" rx="200" ry="35" fill="#aaa" opacity="0.2"/>
    
    <rect x="180" y="180" width="440" height="460" rx="20" fill="url(#silverGrad)"/>
    <rect x="180" y="180" width="440" height="460" rx="20" fill="none" stroke="#b0b0b0" stroke-width="2"/>
    
    <rect x="200" y="190" width="400" height="70" rx="12" fill="#d8d8d8"/>
    <rect x="200" y="190" width="400" height="70" rx="12" fill="none" stroke="#c0c0c0" stroke-width="1"/>
    
    <g fill="#aaa">
      <rect x="220" y="205" width="60" height="40" rx="4"/>
      <rect x="290" y="205" width="60" height="40" rx="4"/>
      <rect x="450" y="205" width="60" height="40" rx="4"/>
      <rect x="520" y="205" width="60" height="40" rx="4"/>
    </g>
    
    <rect x="200" y="270" width="400" height="140" rx="15" fill="#e8e8e8"/>
    <rect x="200" y="270" width="400" height="140" rx="15" fill="none" stroke="#d0d0d0" stroke-width="2"/>
    
    <rect x="240" y="290" width="320" height="100" rx="12" fill="#0a1520"/>
    <rect x="240" y="290" width="320" height="100" rx="12" fill="none" stroke="#1a3a5a" stroke-width="3"/>
    
    <text x="320" y="355" text-anchor="middle" font-family="Arial, sans-serif" font-size="60" font-weight="bold" fill="#00d4aa" filter="url(#glow)">42C</text>
    <text x="320" y="380" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#666">OUTLET TEMP</text>
    
    <text x="500" y="340" text-anchor="middle" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="#3399ff" filter="url(#glow)">8</text>
    <text x="500" y="360" text-anchor="middle" font-size="10" fill="#666">L/min</text>
    
    <g transform="translate(270, 410)">
      <circle cx="0" cy="0" r="8" fill="#00d4aa"/>
      <text x="0" y="18" text-anchor="middle" font-size="8" fill="#888">PWR</text>
      
      <circle cx="60" cy="0" r="8" fill="#f7931e"/>
      <text x="60" y="18" text-anchor="middle" font-size="8" fill="#888">HEAT</text>
      
      <circle cx="120" cy="0" r="8" fill="#3399ff"/>
      <text x="120" y="18" text-anchor="middle" font-size="8" fill="#888">WATER</text>
    </g>
    
    <g transform="translate(530, 395)">
      <rect x="-35" y="-25" width="70" height="50" rx="8" fill="#4caf50"/>
      <rect x="-35" y="-25" width="70" height="50" rx="8" fill="none" stroke="#388e3c" stroke-width="1"/>
      <text x="0" y="-5" text-anchor="middle" font-size="20" fill="#fff">ECO</text>
      <text x="0" y="15" text-anchor="middle" font-size="9" font-weight="bold" fill="#fff">SAVING</text>
    </g>
    
    <rect x="200" y="420" width="400" height="200" rx="15" fill="#f0f0f0"/>
    <rect x="200" y="420" width="400" height="200" rx="15" fill="none" stroke="#ddd" stroke-width="1"/>
    
    <g transform="translate(280, 520)">
      <circle cx="0" cy="0" r="50" fill="#e0e0e0"/>
      <circle cx="0" cy="0" r="50" fill="none" stroke="#c0c0c0" stroke-width="3"/>
      <circle cx="0" cy="0" r="38" fill="#e8e8e8"/>
      <circle cx="0" cy="0" r="38" fill="none" stroke="#d0d0d0" stroke-width="1"/>
      
      <g stroke="#999" stroke-width="1.5">
        <line x1="0" y1="-45" x2="0" y2="-36"/>
        <line x1="32" y1="-32" x2="26" y2="-26"/>
        <line x1="45" y1="0" x2="36" y2="0"/>
        <line x1="32" y1="32" x2="26" y2="26"/>
        <line x1="0" y1="45" x2="0" y2="36"/>
        <line x1="-32" y1="32" x2="-26" y2="26"/>
        <line x1="-45" y1="0" x2="-36" y2="0"/>
        <line x1="-32" y1="-32" x2="-26" y2="-26"/>
      </g>
      
      <line x1="0" y1="-25" x2="0" y2="-38" stroke="#0a2540" stroke-width="4" stroke-linecap="round"/>
      
      <text x="0" y="70" text-anchor="middle" font-size="12" fill="#666">TEMP</text>
    </g>
    
    <g transform="translate(400, 520)">
      <circle cx="0" cy="0" r="50" fill="#e0e0e0"/>
      <circle cx="0" cy="0" r="50" fill="none" stroke="#c0c0c0" stroke-width="3"/>
      <circle cx="0" cy="0" r="38" fill="#e8e8e8"/>
      <circle cx="0" cy="0" r="38" fill="none" stroke="#d0d0d0" stroke-width="1"/>
      
      <g stroke="#999" stroke-width="1.5">
        <line x1="0" y1="-45" x2="0" y2="-36"/>
        <line x1="32" y1="-32" x2="26" y2="-26"/>
        <line x1="45" y1="0" x2="36" y2="0"/>
        <line x1="32" y1="32" x2="26" y2="26"/>
        <line x1="0" y1="45" x2="0" y2="36"/>
        <line x1="-32" y1="32" x2="-26" y2="26"/>
        <line x1="-45" y1="0" x2="-36" y2="0"/>
        <line x1="-32" y1="-32" x2="-26" y2="-26"/>
      </g>
      
      <line x1="20" y1="-20" x2="28" y2="-28" stroke="#0a2540" stroke-width="4" stroke-linecap="round"/>
      
      <text x="0" y="70" text-anchor="middle" font-size="12" fill="#666">FLOW</text>
    </g>
    
    <circle cx="520" cy="520" r="40" fill="#0a2540"/>
    <circle cx="520" cy="520" r="40" fill="none" stroke="#1a4a7a" stroke-width="3"/>
    <text x="520" y="530" text-anchor="middle" font-size="28" fill="#fff">ON</text>
    
    <g transform="translate(220, 630)">
      <rect x="0" y="0" width="50" height="30" rx="6" fill="#3399ff"/>
      <text x="25" y="20" text-anchor="middle" font-size="10" fill="#fff">COLD</text>
      
      <rect x="70" y="0" width="50" height="30" rx="6" fill="#ff6b6b"/>
      <text x="95" y="20" text-anchor="middle" font-size="10" fill="#fff">HOT</text>
    </g>
  </g>
  
  <g>
    <rect x="250" y="745" width="300" height="50" rx="10" fill="url(#blueGrad)"/>
    <rect x="250" y="745" width="300" height="50" rx="10" fill="none" stroke="#1a4a7a" stroke-width="2"/>
    <text x="400" y="767" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#ffffff">HT-WH60</text>
    <text x="400" y="787" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="url(#orangeGrad)" font-weight="bold">ELECTRIC INSTANT</text>
  </g>
</svg>