<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <linearGradient id="steelGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e8e8e8"/>
      <stop offset="25%" style="stop-color:#f2f2f2"/>
      <stop offset="50%" style="stop-color:#d8d8d8"/>
      <stop offset="75%" style="stop-color:#c0c0c0"/>
      <stop offset="100%" style="stop-color:#a8a8a8"/>
    </linearGradient>
    <linearGradient id="steelDark" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#b0b0b0"/>
      <stop offset="50%" style="stop-color:#909090"/>
      <stop offset="100%" style="stop-color:#707070"/>
    </linearGradient>
    <linearGradient id="doorGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e0e0e0"/>
      <stop offset="50%" style="stop-color:#c8c8c8"/>
      <stop offset="100%" style="stop-color:#a8a8a8"/>
    </linearGradient>
    <linearGradient id="glassGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#3a4a5a"/>
      <stop offset="50%" style="stop-color:#2a3a4a"/>
      <stop offset="100%" style="stop-color:#1a2a3a"/>
    </linearGradient>
    <linearGradient id="handleGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#d0d0d0"/>
      <stop offset="50%" style="stop-color:#f0f0f0"/>
      <stop offset="100%" style="stop-color:#b0b0b0"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="2" dy="6" stdDeviation="12" flood-color="#000" flood-opacity="0.2"/>
    </filter>
  </defs>
  
  <rect width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  
  <g filter="url(#shadow)" transform="translate(400, 450)">
    <rect x="-140" y="-160" width="280" height="300" fill="url(#steelGrad)" rx="8"/>
    <rect x="-132" y="-152" width="264" height="284" fill="none" stroke="#c0c0c0" stroke-width="2" rx="6"/>
    <rect x="-135" y="-157" width="270" height="45" fill="url(#steelDark)" rx="4"/>
    <rect x="-40" y="-148" width="80" height="25" fill="#0a1a2a" rx="3"/>
    <rect x="-35" y="-144" width="35" height="17" fill="#001a0a" rx="1"/>
    <text x="-17" y="-131" text-anchor="middle" fill="#00ff88" font-family="monospace" font-size="11" font-weight="bold">180</text>
    <text x="15" y="-131" text-anchor="middle" fill="#00ffaa" font-family="monospace" font-size="9">C</text>
    <circle cx="-100" cy="-135" r="12" fill="#404040" stroke="#606060" stroke-width="1.5"/>
    <circle cx="-65" cy="-135" r="12" fill="#404040" stroke="#606060" stroke-width="1.5"/>
    <circle cx="65" cy="-135" r="12" fill="#404040" stroke="#606060" stroke-width="1.5"/>
    <circle cx="100" cy="-135" r="12" fill="#404040" stroke="#606060" stroke-width="1.5"/>
    <line x1="-100" y1="-143" x2="-100" y2="-138" stroke="#a0a0a0" stroke-width="1.5"/>
    <line x1="-65" y1="-143" x2="-65" y2="-138" stroke="#a0a0a0" stroke-width="1.5"/>
    <line x1="65" y1="-143" x2="65" y2="-138" stroke="#a0a0a0" stroke-width="1.5"/>
    <line x1="100" y1="-143" x2="100" y2="-138" stroke="#a0a0a0" stroke-width="1.5"/>
    <rect x="-125" y="-105" width="250" height="195" fill="url(#doorGrad)" rx="6"/>
    <rect x="-115" y="-95" width="230" height="170" fill="url(#glassGrad)" rx="4"/>
    <rect x="-108" y="-88" width="216" height="156" fill="#1a1a1a" rx="3"/>
    <rect x="-103" y="-83" width="206" height="146" fill="#252525" rx="2"/>
    <line x1="-98" y1="-55" x2="98" y2="-55" stroke="#606060" stroke-width="2"/>
    <line x1="-98" y1="-25" x2="98" y2="-25" stroke="#606060" stroke-width="2"/>
    <line x1="-98" y1="5" x2="98" y2="5" stroke="#606060" stroke-width="2"/>
    <line x1="-98" y1="35" x2="98" y2="35" stroke="#606060" stroke-width="2"/>
    <rect x="-100" y="92" width="200" height="14" fill="url(#handleGrad)" rx="7"/>
    <rect x="-123" y="-103" width="246" height="3" fill="white" opacity="0.3" rx="1"/>
  </g>
  
  <g transform="translate(400, 730)">
    <rect x="-100" y="-22" width="200" height="44" fill="#0a2540" rx="8" filter="url(#shadow)"/>
    <text x="0" y="-2" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="18" font-weight="bold">HT-OV45</text>
    <text x="0" y="15" text-anchor="middle" fill="#f7931e" font-family="Arial, sans-serif" font-size="10" letter-spacing="1">COMPACT OVEN 45L</text>
  </g>
</svg>