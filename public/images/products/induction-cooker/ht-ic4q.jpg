<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs><linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#f8f9fa"/><stop offset="100%" style="stop-color:#e9ecef"/></linearGradient><linearGradient id="glass" x1="0%" y1="0%" x2="100%" x2="0%"><stop offset="0%" style="stop-color:#1a1a24"/><stop offset="50%" style="stop-color:#2a2a35"/><stop offset="100%" style="stop-color:#1a1a24"/></linearGradient><linearGradient id="accent" x1="0%" y1="0%" x2="100%" x2="0%"><stop offset="0%" style="stop-color:#0a2540"/><stop offset="100%" style="stop-color:#1a3a5c"/></linearGradient><filter id="shadow"><feDropShadow dx="0" dy="8" stdDeviation="12" flood-opacity="0.15"/></filter></defs>
  <rect width="800" height="800" fill="url(#bg)" rx="20"/>
  <g transform="translate(50, 160)" filter="url(#shadow)">
    <rect x="20" y="10" width="660" height="320" rx="12" fill="url(#glass)" stroke="#444" stroke-width="2"/>
    <!-- 4 zones in 2x2 grid -->
    <!-- Top-left (large) -->
    <circle cx="180" cy="120" r="90" fill="none" stroke="#f7931e" stroke-opacity="0.35" stroke-width="3" stroke-dasharray="6,3"/>
    <circle cx="180" cy="120" r="68" fill="rgba(247,147,30,0.05)"/><circle cx="180" cy="120" r="12" fill="#f7931e" opacity="0.45"/>
    <!-- Top-right (large) -->
    <circle cx="520" cy="120" r="90" fill="none" stroke="#f7931e" stroke-opacity="0.35" stroke-width="3" stroke-dasharray="6,3"/>
    <circle cx="520" cy="120" r="68" fill="rgba(247,147,30,0.05)"/><circle cx="520" cy="120" r="12" fill="#f7931e" opacity="0.45"/>
    <!-- Bottom-left (small) -->
    <circle cx="180" cy="240" r="70" fill="none" stroke="#f7931e" stroke-opacity="0.3" stroke-width="2.5" stroke-dasharray="6,3"/>
    <circle cx="180" cy="240" r="52" fill="rgba(247,147,30,0.04)"/><circle cx="180" cy="240" r="10" fill="#f7931e" opacity="0.4"/>
    <!-- Bottom-right (small) -->
    <circle cx="520" cy="240" r="70" fill="none" stroke="#f7931e" stroke-opacity="0.3" stroke-width="2.5" stroke-dasharray="6,3"/>
    <circle cx="520" cy="240" r="52" fill="rgba(247,147,30,0.04)"/><circle cx="520" cy="240" r="10" fill="#f7931e" opacity="0.4"/>
    <!-- Center control bridge between zones -->
    <rect x="300" y="165" width="100" height="40" rx="6" fill="#111" stroke="#333" stroke-width="1"/>
    <circle cx="320" cy="185" r="5" fill="#f7931e" opacity="0.8"/><circle cx="340" cy="185" r="5" fill="#555" stroke="#666" stroke-width="1"/><circle cx="360" cy="185" r="5" fill="#555" stroke="#666" stroke-width="1"/><circle cx="380" cy="185" r="5" fill="#555" stroke="#666" stroke-width="1"/>
    <!-- Frame -->
    <rect x="16" y="6" width="668" height="328" rx="14" fill="none" stroke="#c0c7d0" stroke-width="3"/>
    <circle cx="55" cy="42" r="5" fill="#4ade80" opacity="0.7"/><circle cx="645" cy="42" r="5" fill="#4ade80" opacity="0.7"/>
  </g>
  <g transform="translate(400, 700)"><rect x="-105" y="-28" width="210" height="56" rx="28" fill="url(#accent)"/><text x="0" y="6" text-anchor="middle" font-family="'Inter',sans-serif" font-weight="800" font-size="18" fill="white">HT-IC4Q</text><text x="0" y="20" text-anchor="middle" font-family="'Inter',sans-serif" font-weight="500" font-size="10" fill="#f7931e" letter-spacing="3">QUAD BURNER</text></g>
</svg>