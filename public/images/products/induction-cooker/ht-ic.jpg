<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <!-- Background gradient -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <!-- Stainless steel gradient -->
    <linearGradient id="steelGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#e8e8e8"/>
      <stop offset="25%" style="stop-color:#c0c0c0"/>
      <stop offset="50%" style="stop-color:#d8d8d8"/>
      <stop offset="75%" style="stop-color:#a8a8a8"/>
      <stop offset="100%" style="stop-color:#b8b8b8"/>
    </linearGradient>
    <!-- Premium black glass panel -->
    <linearGradient id="glassGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#383838"/>
      <stop offset="100%" style="stop-color:#181818"/>
    </linearGradient>
    <!-- Heating zone gradient -->
    <radialGradient id="heatZone" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#ff4444"/>
      <stop offset="40%" style="stop-color:#cc0000"/>
      <stop offset="70%" style="stop-color:#880000"/>
      <stop offset="100%" style="stop-color:#440000"/>
    </radialGradient>
    <!-- Shadow filter -->
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="14" flood-color="#000" flood-opacity="0.28"/>
    </filter>
    <!-- Slider touch control gradient -->
    <linearGradient id="sliderGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#2a2a2a"/>
      <stop offset="50%" style="stop-color:#333"/>
      <stop offset="100%" style="stop-color:#2a2a2a"/>
    </linearGradient>
    <!-- LED gradient -->
    <linearGradient id="ledGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#0a0a0a"/>
      <stop offset="100%" style="stop-color:#050505"/>
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="800" height="800" fill="url(#bgGrad)" rx="20"/>
  
  <!-- Main body shadow -->
  <rect x="90" y="120" width="620" height="500" rx="25" fill="#000" opacity="0.15" filter="url(#shadow)"/>
  
  <!-- Outer stainless steel frame - thin elegant border -->
  <rect x="90" y="120" width="620" height="500" rx="25" fill="url(#steelGrad)" stroke="#aaa" stroke-width="1"/>
  
  <!-- Inner premium black glass panel -->
  <rect x="105" y="135" width="590" height="420" rx="15" fill="url(#glassGrad)"/>
  
  <!-- Left heating zone (210mm with booster) -->
  <circle cx="310" cy="340" r="105" fill="url(#heatZone)" opacity="0.9"/>
  <circle cx="310" cy="340" r="112" fill="none" stroke="#ff6666" stroke-width="2" opacity="0.5"/>
  <circle cx="310" cy="340" r="75" fill="none" stroke="#ff4444" stroke-width="1.5" opacity="0.4" stroke-dasharray="6,6"/>
  <circle cx="310" cy="340" r="45" fill="none" stroke="#ff4444" stroke-width="1" opacity="0.3" stroke-dasharray="4,4"/>
  
  <!-- Right heating zone (180mm) -->
  <circle cx="490" cy="340" r="85" fill="url(#heatZone)" opacity="0.9"/>
  <circle cx="490" cy="340" r="92" fill="none" stroke="#ff6666" stroke-width="2" opacity="0.5"/>
  <circle cx="490" cy="340" r="60" fill="none" stroke="#ff4444" stroke-width="1.5" opacity="0.4" stroke-dasharray="5,5"/>
  
  <!-- Center crosshairs for precision -->
  <line x1="310" y1="235" x2="310" y2="252" stroke="#ff6666" stroke-width="2" opacity="0.6"/>
  <line x1="310" y1="428" x2="310" y2="445" stroke="#ff6666" stroke-width="2" opacity="0.6"/>
  <line x1="205" y1="340" x2="222" y2="340" stroke="#ff6666" stroke-width="2" opacity="0.6"/>
  <line x1="398" y1="340" x2="415" y2="340" stroke="#ff6666" stroke-width="2" opacity="0.6"/>
  
  <line x1="490" y1="255" x2="490" y2="270" stroke="#ff6666" stroke-width="2" opacity="0.6"/>
  <line x1="490" y1="410" x2="490" y2="425" stroke="#ff6666" stroke-width="2" opacity="0.6"/>
  <line x1="405" y1="340" x2="420" y2="340" stroke="#ff6666" stroke-width="2" opacity="0.6"/>
  <line x1="575" y1="340" x2="590" y2="340" stroke="#ff6666" stroke-width="2" opacity="0.6"/>
  
  <!-- Premium slider touch control panel -->
  <rect x="120" y="580" width="560" height="70" rx="12" fill="url(#sliderGrad)"/>
  
  <!-- Left zone slider area -->
  <g transform="translate(200, 615)">
    <!-- Minus -->
    <rect x="-25" y="-20" width="40" height="40" rx="8" fill="#222"/>
    <text x="-5" y="8" fill="#fff" font-family="Arial" font-size="22" text-anchor="middle">−</text>
    <!-- Power level indicator -->
    <rect x="25" y="-15" width="100" height="30" rx="5" fill="#111"/>
    <text x="75" y="6" fill="#00ff00" font-family="monospace" font-size="14" text-anchor="middle">LEVEL 9</text>
    <!-- Plus -->
    <rect x="135" y="-20" width="40" height="40" rx="8" fill="#222"/>
    <text x="155" y="8" fill="#fff" font-family="Arial" font-size="22" text-anchor="middle">+</text>
    <!-- Zone indicator dot -->
    <circle cx="-55" cy="0" r="8" fill="#ff4444"/>
  </g>
  
  <!-- Right zone slider area -->
  <g transform="translate(500, 615)">
    <!-- Minus -->
    <rect x="-25" y="-20" width="40" height="40" rx="8" fill="#222"/>
    <text x="-5" y="8" fill="#fff" font-family="Arial" font-size="22" text-anchor="middle">−</text>
    <!-- Power level indicator -->
    <rect x="25" y="-15" width="100" height="30" rx="5" fill="#111"/>
    <text x="75" y="6" fill="#00ff00" font-family="monospace" font-size="14" text-anchor="middle">LEVEL 7</text>
    <!-- Plus -->
    <rect x="135" y="-20" width="40" height="40" rx="8" fill="#222"/>
    <text x="155" y="8" fill="#fff" font-family="Arial" font-size="22" text-anchor="middle">+</text>
    <!-- Zone indicator dot -->
    <circle cx="-55" cy="0" r="8" fill="#ff4444"/>
  </g>
  
  <!-- Center functions -->
  <g transform="translate(350, 615)">
    <!-- Timer -->
    <rect x="-35" y="-20" width="70" height="40" rx="8" fill="#222"/>
    <text x="0" y="8" fill="#f7931e" font-family="monospace" font-size="14" text-anchor="middle">99:00</text>
  </g>
  
  <!-- Power and lock buttons on far right -->
  <circle cx="640" cy="595" r="18" fill="#222"/>
  <circle cx="640" cy="595" r="6" fill="#00ff00"/>
  
  <circle cx="680" cy="635" r="18" fill="#222"/>
  <text x="680" y="641" fill="#fff" font-family="Arial" font-size="10" text-anchor="middle">🔒</text>
  
  <!-- LED displays for temperature -->
  <rect x="130" y="665" width="200" height="35" rx="6" fill="url(#ledGrad)"/>
  <text x="230" y="688" fill="#00ff00" font-family="monospace" font-size="14" text-anchor="middle">L: 2000W / 240°C</text>
  
  <rect x="350" y="665" width="100" height="35" rx="6" fill="url(#ledGrad)"/>
  <text x="400" y="688" fill="#f7931e" font-family="monospace" font-size="12" text-anchor="middle">T: 45:00</text>
  
  <rect x="470" y="665" width="200" height="35" rx="6" fill="url(#ledGrad)"/>
  <text x="570" y="688" fill="#00ff00" font-family="monospace" font-size="14" text-anchor="middle">R: 1600W / 200°C</text>
  
  <!-- Premium glass reflection -->
  <rect x="115" y="145" width="350" height="90" rx="10" fill="white" opacity="0.05"/>
  
  <!-- Brand label -->
  <rect x="200" y="720" width="400" height="55" rx="12" fill="#0a2540"/>
  <text x="400" y="748" fill="#ffffff" font-family="Arial" font-size="22" font-weight="bold" text-anchor="middle">HT-IC</text>
  <text x="400" y="765" fill="#f7931e" font-family="Arial" font-size="14" text-anchor="middle">INTEGRATED INDUCTION HOB</text>
</svg>