<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs><linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#f8f9fa"/><stop offset="100%" style="stop-color:#e9ecef"/></linearGradient><linearGradient id="glass" x1="0%" y1="0%" x2="100%" x2="0%"><stop offset="0%" style="stop-color:#1a1a24"/><stop offset="50%" style="stop-color:#2a2a35"/><stop offset="100%" style="stop-color:#1a1a24"/></linearGradient><linearGradient id="steel" x1="0%" y1="0%" x2="100%" x2="0%"><stop offset="0%" style="stop-color:#c0c7d0"/><stop offset="50%" style="stop-color:#f5f6f7"/><stop offset="100%" style="stop-color:#b8bec8"/></linearGradient><linearGradient id="accent" x1="0%" y1="0%" x2="100%" x2="0%"><stop offset="0%" style="stop-color:#0a2540"/><stop offset="100%" style="stop-color:#1a3a5c"/></linearGradient><filter id="shadow"><feDropShadow dx="0" dy="8" stdDeviation="12" flood-opacity="0.15"/></filter></defs>
  <rect width="800" height="800" fill="url(#bg)" rx="20"/>
  <g transform="translate(80, 180)" filter="url(#shadow)">
    <!-- Slim built-in body -->
    <rect x="10" y="-20" width="620" height="50" rx="4" fill="url(#steel)" stroke="#a0a8b4" stroke-width="1.5"/>
    <!-- Glass panel -->
    <rect x="20" y="30" width="600" height="280" rx="10" fill="url(#glass)" stroke="#444" stroke-width="2"/>
    <!-- Dual heating zones -->
    <circle cx="190" cy="170" r="95" fill="none" stroke="#f7931e" stroke-opacity="0.35" stroke-width="3" stroke-dasharray="8,4"/>
    <circle cx="190" cy="170" r="72" fill="rgba(247,147,30,0.05)"/><circle cx="190" cy="170" r="13" fill="#f7931e" opacity="0.45"/>
    <circle cx="450" cy="170" r="85" fill="none" stroke="#f7931e" stroke-opacity="0.35" stroke-width="3" stroke-dasharray="8,4"/>
    <circle cx="450" cy="170" r="64" fill="rgba(247,147,30,0.05)"/><circle cx="450" cy="170" r="11" fill="#f7931e" opacity="0.4"/>
    <!-- Touch slider controls -->
    <rect x="290" y="245" width="70" height="55" rx="6" fill="#111" stroke="#333" stroke-width="1"/>
    <line x1="305" y1="265" x2="345" y2="265" stroke="#333" stroke-width="3" stroke-linecap="round"/>
    <circle cx="330" cy="265" r="6" fill="#f7931e"/>
    <line x1="305" y1="283" x2="345" y2="283" stroke="#333" stroke-width="3" stroke-linecap="round"/>
    <circle cx="315" cy="283" r="5" fill="#f7931e" opacity="0.7"/>
    <!-- LED display -->
    <rect x="380" y="253" width="80" height="38" rx="3" fill="#0a2540"/>
    <text x="420" y="277" text-anchor="middle" font-family="monospace" font-weight="bold" font-size="14" fill="#4af">3200</text>
    <!-- Frame -->
    <rect x="16" y="26" width="608" height="288" rx="12" fill="none" stroke="#c0c7d0" stroke-width="3"/>
    <circle cx="52" cy="54" r="5" fill="#4ade80" opacity="0.7"/>
  </g>
  <g transform="translate(400, 700)"><rect x="-105" y="-28" width="210" height="56" rx="28" fill="url(#accent)"/><text x="0" y="6" text-anchor="middle" font-family="'Inter',sans-serif" font-weight="800" font-size="18" fill="white">HT-IC32</text><text x="0" y="20" text-anchor="middle" font-family="'Inter',sans-serif" font-weight="500" font-size="10" fill="#f7931e" letter-spacing="3">DOUBLE INDUCTION</text></g>
</svg>