<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#f8f9fa"/><stop offset="100%" style="stop-color:#e9ecef"/></linearGradient>
    <linearGradient id="frameGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#e0e0e0"/><stop offset="40%" style="stop-color:#c8c8c8"/><stop offset="100%" style="stop-color:#a0a0a0"/></linearGradient>
    <linearGradient id="glassGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#1e1e1e"/><stop offset="50%" style="stop-color:#0a0a0a"/><stop offset="100%" style="stop-color:#151515"/></linearGradient>
    <radialGradient id="redHeat" cx="50%" cy="50%" r="50%"><stop offset="0%" style="stop-color:#ff4444"/><stop offset="40%" style="stop-color:#cc0000"/><stop offset="70%" style="stop-color:#990000"/><stop offset="100%" style="stop-color:#660000"/></radialGradient>
    <radialGradient id="redHeatGlow" cx="50%" cy="50%" r="50%"><stop offset="0%" style="stop-color:#ff6b6b;stop-opacity:0.8"/><stop offset="60%" style="stop-color:#ff4444;stop-opacity:0.4"/><stop offset="100%" style="stop-color:#cc0000;stop-opacity:0"/></radialGradient>
    <linearGradient id="controlGrad" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" style="stop-color:#333"/><stop offset="100%" style="stop-color:#1a1a1a"/></linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="6" stdDeviation="10" flood-color="#000" flood-opacity="0.2"/></filter>
    <filter id="heatGlow"><feGaussianBlur stdDeviation="6" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    <filter id="redGlow"><feGaussianBlur stdDeviation="8" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
  </defs>
  <rect x="0" y="0" width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  <rect x="130" y="160" width="540" height="450" rx="10" fill="#000" opacity="0.12" filter="url(#shadow)"/>
  <rect x="125" y="155" width="550" height="460" rx="8" fill="url(#frameGrad)" stroke="#909090" stroke-width="2"/>
  <rect x="145" y="175" width="510" height="375" rx="5" fill="url(#glassGrad)"/>
  <line x1="155" y1="185" x2="645" y2="185" stroke="#fff" stroke-width="1" opacity="0.1"/>
  <g transform="translate(280, 330)">
    <circle cx="0" cy="0" r="100" fill="url(#redHeatGlow)" filter="url(#redGlow)"/>
    <circle cx="0" cy="0" r="85" fill="url(#redHeat)" filter="url(#heatGlow)"><animate attributeName="opacity" values="0.9;1;0.9" dur="1.5s" repeatCount="indefinite"/></circle>
    <circle cx="0" cy="0" r="70" fill="none" stroke="#ff6666" stroke-width="3" opacity="0.6"/><circle cx="0" cy="0" r="55" fill="none" stroke="#ff6666" stroke-width="2.5" opacity="0.5"/><circle cx="0" cy="0" r="40" fill="none" stroke="#ff6666" stroke-width="2" opacity="0.4"/><circle cx="0" cy="0" r="25" fill="none" stroke="#ff6666" stroke-width="1.5" opacity="0.3"/>
    <circle cx="0" cy="0" r="15" fill="#aa0000"/>
  </g>
  <g transform="translate(520, 330)">
    <circle cx="0" cy="0" r="100" fill="url(#redHeatGlow)" filter="url(#redGlow)"/>
    <circle cx="0" cy="0" r="85" fill="url(#redHeat)" filter="url(#heatGlow)"><animate attributeName="opacity" values="1;0.9;1" dur="1.3s" repeatCount="indefinite"/></circle>
    <circle cx="0" cy="0" r="70" fill="none" stroke="#ff6666" stroke-width="3" opacity="0.6"/><circle cx="0" cy="0" r="55" fill="none" stroke="#ff6666" stroke-width="2.5" opacity="0.5"/><circle cx="0" cy="0" r="40" fill="none" stroke="#ff6666" stroke-width="2" opacity="0.4"/><circle cx="0" cy="0" r="25" fill="none" stroke="#ff6666" stroke-width="1.5" opacity="0.3"/>
    <circle cx="0" cy="0" r="15" fill="#aa0000"/>
  </g>
  <rect x="145" y="500" width="510" height="100" rx="5" fill="url(#controlGrad)"/>
  <rect x="190" y="530" width="180" height="8" rx="4" fill="#444"/><rect x="190" y="530" width="120" height="8" rx="4" fill="#f7931e"/><circle cx="310" cy="534" r="12" fill="url(#frameGrad)" stroke="#f7931e" stroke-width="2"/>
  <rect x="430" y="530" width="180" height="8" rx="4" fill="#444"/><rect x="430" y="530" width="100" height="8" rx="4" fill="#f7931e"/><circle cx="530" cy="534" r="12" fill="url(#frameGrad)" stroke="#f7931e" stroke-width="2"/>
  <g transform="translate(400, 570)"><rect x="-25" y="-12" width="50" height="24" rx="12" fill="#222" stroke="#555" stroke-width="1"/><circle cx="0" cy="0" r="8" fill="#1a1a1a" stroke="#00ff00" stroke-width="2"><animate attributeName="stroke-opacity" values="1;0.5;1" dur="2s" repeatCount="indefinite"/></circle></g>
  <rect x="250" y="700" width="300" height="50" rx="10" fill="#0a2540"/>
  <text x="400" y="722" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#fff" text-anchor="middle">HT-EH32</text>
  <text x="400" y="742" font-family="Arial, sans-serif" font-size="12" fill="#f7931e" text-anchor="middle">CERAMIC ELECTRIC HOB</text>
</svg>