<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <linearGradient id="steelGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e8e8e8"/>
      <stop offset="25%" style="stop-color:#d4d4d4"/>
      <stop offset="50%" style="stop-color:#f5f5f5"/>
      <stop offset="75%" style="stop-color:#c0c0c0"/>
      <stop offset="100%" style="stop-color:#a8a8a8"/>
    </linearGradient>
    <linearGradient id="glassGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2d2d2d"/>
      <stop offset="30%" style="stop-color:#1a1a1a"/>
      <stop offset="70%" style="stop-color:#0d0d0d"/>
      <stop offset="100%" style="stop-color:#252525"/>
    </linearGradient>
    <linearGradient id="copperGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#d4a574"/>
      <stop offset="50%" style="stop-color:#b8860b"/>
      <stop offset="100%" style="stop-color:#8b6914"/>
    </linearGradient>
    <linearGradient id="flameGrad" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" style="stop-color:#ff6b35"/>
      <stop offset="40%" style="stop-color:#f7931e"/>
      <stop offset="100%" style="stop-color:#ffd700"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000" flood-opacity="0.25"/>
    </filter>
    <filter id="glow">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>
  <rect x="0" y="0" width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  <rect x="55" y="145" width="690" height="510" rx="15" fill="#000" opacity="0.15" filter="url(#shadow)"/>
  <rect x="50" y="140" width="700" height="510" rx="12" fill="url(#steelGrad)" stroke="#b0b0b0" stroke-width="2"/>
  <rect x="70" y="160" width="660" height="430" rx="8" fill="url(#glassGrad)"/>
  <line x1="90" y1="170" x2="710" y2="170" stroke="#fff" stroke-width="1" opacity="0.15"/>
  <g transform="translate(130, 230)">
    <circle cx="0" cy="0" r="55" fill="#1f1f1f" stroke="#333" stroke-width="2"/>
    <circle cx="0" cy="0" r="45" fill="url(#copperGrad)"/>
    <circle cx="0" cy="0" r="35" fill="#1a1a1a"/>
    <circle cx="0" cy="0" r="25" fill="url(#copperGrad)" opacity="0.7"/>
    <ellipse cx="0" cy="0" rx="18" ry="12" fill="url(#flameGrad)" filter="url(#glow)" opacity="0.9">
      <animate attributeName="ry" values="12;14;12" dur="0.5s" repeatCount="indefinite"/>
    </ellipse>
  </g>
  <g transform="translate(670, 230)">
    <circle cx="0" cy="0" r="55" fill="#1f1f1f" stroke="#333" stroke-width="2"/>
    <circle cx="0" cy="0" r="45" fill="url(#copperGrad)"/>
    <circle cx="0" cy="0" r="35" fill="#1a1a1a"/>
    <circle cx="0" cy="0" r="25" fill="url(#copperGrad)" opacity="0.7"/>
    <ellipse cx="0" cy="0" rx="18" ry="12" fill="url(#flameGrad)" filter="url(#glow)" opacity="0.9">
      <animate attributeName="ry" values="12;14;12" dur="0.5s" repeatCount="indefinite"/>
    </ellipse>
  </g>
  <g transform="translate(180, 420)">
    <circle cx="0" cy="0" r="65" fill="#1f1f1f" stroke="#333" stroke-width="2"/>
    <circle cx="0" cy="0" r="52" fill="url(#copperGrad)"/>
    <circle cx="0" cy="0" r="40" fill="#1a1a1a"/>
    <circle cx="0" cy="0" r="30" fill="url(#copperGrad)" opacity="0.7"/>
    <ellipse cx="0" cy="0" rx="22" ry="15" fill="url(#flameGrad)" filter="url(#glow)" opacity="0.9">
      <animate attributeName="ry" values="15;17;15" dur="0.4s" repeatCount="indefinite"/>
    </ellipse>
  </g>
  <g transform="translate(620, 420)">
    <circle cx="0" cy="0" r="65" fill="#1f1f1f" stroke="#333" stroke-width="2"/>
    <circle cx="0" cy="0" r="52" fill="url(#copperGrad)"/>
    <circle cx="0" cy="0" r="40" fill="#1a1a1a"/>
    <circle cx="0" cy="0" r="30" fill="url(#copperGrad)" opacity="0.7"/>
    <ellipse cx="0" cy="0" rx="22" ry="15" fill="url(#flameGrad)" filter="url(#glow)" opacity="0.9">
      <animate attributeName="ry" values="15;17;15" dur="0.45s" repeatCount="indefinite"/>
    </ellipse>
  </g>
  <g transform="translate(400, 380)">
    <circle cx="0" cy="0" r="80" fill="#1f1f1f" stroke="#333" stroke-width="3"/>
    <circle cx="0" cy="0" r="65" fill="url(#copperGrad)"/>
    <circle cx="0" cy="0" r="50" fill="#1a1a1a"/>
    <circle cx="0" cy="0" r="38" fill="url(#copperGrad)" opacity="0.7"/>
    <ellipse cx="0" cy="0" rx="28" ry="20" fill="url(#flameGrad)" filter="url(#glow)" opacity="0.95">
      <animate attributeName="ry" values="20;24;20" dur="0.35s" repeatCount="indefinite"/>
    </ellipse>
    <ellipse cx="0" cy="0" rx="38" ry="28" fill="none" stroke="url(#flameGrad)" stroke-width="4" opacity="0.6" filter="url(#glow)">
      <animate attributeName="ry" values="28;32;28" dur="0.4s" repeatCount="indefinite"/>
    </ellipse>
  </g>
  <rect x="70" y="540" width="660" height="90" rx="5" fill="#1a1a1a"/>
  <g transform="translate(115, 585)"><circle cx="0" cy="0" r="28" fill="url(#steelGrad)" stroke="#888" stroke-width="2"/><circle cx="0" cy="0" r="20" fill="#333"/><line x1="0" y1="-8" x2="0" y2="-18" stroke="#fff" stroke-width="3" stroke-linecap="round"/></g>
  <g transform="translate(250, 585)"><circle cx="0" cy="0" r="28" fill="url(#steelGrad)" stroke="#888" stroke-width="2"/><circle cx="0" cy="0" r="20" fill="#333"/><line x1="0" y1="-8" x2="0" y2="-18" stroke="#fff" stroke-width="3" stroke-linecap="round"/></g>
  <g transform="translate(400, 585)"><circle cx="0" cy="0" r="28" fill="url(#steelGrad)" stroke="#888" stroke-width="2"/><circle cx="0" cy="0" r="20" fill="#333"/><line x1="0" y1="-8" x2="0" y2="-18" stroke="#fff" stroke-width="3" stroke-linecap="round"/></g>
  <g transform="translate(550, 585)"><circle cx="0" cy="0" r="28" fill="url(#steelGrad)" stroke="#888" stroke-width="2"/><circle cx="0" cy="0" r="20" fill="#333"/><line x1="0" y1="-8" x2="0" y2="-18" stroke="#fff" stroke-width="3" stroke-linecap="round"/></g>
  <g transform="translate(685, 585)"><circle cx="0" cy="0" r="28" fill="url(#steelGrad)" stroke="#888" stroke-width="2"/><circle cx="0" cy="0" r="20" fill="#333"/><line x1="0" y1="-8" x2="0" y2="-18" stroke="#fff" stroke-width="3" stroke-linecap="round"/></g>
  <rect x="250" y="700" width="300" height="50" rx="10" fill="#0a2540"/>
  <text x="400" y="722" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#fff" text-anchor="middle">HT-GH354</text>
  <text x="400" y="742" font-family="Arial, sans-serif" font-size="12" fill="#f7931e" text-anchor="middle">5-BURNER GAS HOB 90CM</text>
</svg>