<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <linearGradient id="steelGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e8e8e8"/>
      <stop offset="30%" style="stop-color:#f5f5f5"/>
      <stop offset="50%" style="stop-color:#d4d4d4"/>
      <stop offset="70%" style="stop-color:#c0c0c0"/>
      <stop offset="100%" style="stop-color:#a8a8a8"/>
    </linearGradient>
    <linearGradient id="steelDark" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#b8b8b8"/>
      <stop offset="50%" style="stop-color:#989898"/>
      <stop offset="100%" style="stop-color:#787878"/>
    </linearGradient>
    <linearGradient id="glassGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2a3a4a"/>
      <stop offset="50%" style="stop-color:#1a2a3a"/>
      <stop offset="100%" style="stop-color:#0a1a2a"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="2" dy="5" stdDeviation="10" flood-color="#000" flood-opacity="0.2"/>
    </filter>
  </defs>
  
  <rect width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  
  <g opacity="0.3">
    <rect x="150" y="280" width="500" height="350" fill="none" stroke="#999" stroke-width="2" stroke-dasharray="10,5" rx="5"/>
  </g>
  
  <g filter="url(#shadow)" transform="translate(400, 480)">
    <rect x="-180" y="-30" width="360" height="80" fill="url(#steelGrad)" rx="5"/>
    <rect x="-200" y="40" width="400" height="15" fill="url(#steelDark)" rx="3"/>
    <g transform="translate(-180, 42)">
      <rect width="360" height="10" fill="#606060" rx="2"/>
      <rect x="10" y="2" width="30" height="6" fill="#404040" rx="1"/>
      <rect x="50" y="2" width="30" height="6" fill="#404040" rx="1"/>
      <rect x="90" y="2" width="30" height="6" fill="#404040" rx="1"/>
      <rect x="130" y="2" width="30" height="6" fill="#404040" rx="1"/>
      <rect x="170" y="2" width="30" height="6" fill="#404040" rx="1"/>
      <rect x="210" y="2" width="30" height="6" fill="#404040" rx="1"/>
      <rect x="250" y="2" width="30" height="6" fill="#404040" rx="1"/>
      <rect x="290" y="2" width="30" height="6" fill="#404040" rx="1"/>
      <rect x="330" y="2" width="20" height="6" fill="#404040" rx="1"/>
    </g>
    <rect x="-170" y="55" width="340" height="18" fill="#0a1a2a" rx="2"/>
    <rect x="-30" y="58" width="60" height="12" fill="#001a0a" rx="1"/>
    <text x="0" y="68" text-anchor="middle" fill="#00ff88" font-family="monospace" font-size="9" font-weight="bold">380</text>
    <circle cx="-80" cy="64" r="4" fill="#1a2a3a"/>
    <circle cx="-55" cy="64" r="4" fill="#1a2a3a"/>
    <circle cx="55" cy="64" r="4" fill="#1a2a3a"/>
    <circle cx="80" cy="64" r="4" fill="#1a2a3a"/>
    <rect x="-200" y="38" width="400" height="3" fill="white" opacity="0.3" rx="1"/>
  </g>
  
  <g transform="translate(400, 720)">
    <rect x="-100" y="-22" width="200" height="44" fill="#0a2540" rx="8" filter="url(#shadow)"/>
    <text x="0" y="-2" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="18" font-weight="bold">HT-RH380</text>
    <text x="0" y="15" text-anchor="middle" fill="#f7931e" font-family="Arial, sans-serif" font-size="10" letter-spacing="1">BUILT-IN RANGE HOOD</text>
  </g>
</svg>