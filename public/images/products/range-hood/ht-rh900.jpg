<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <linearGradient id="steelGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e8e8e8"/>
      <stop offset="30%" style="stop-color:#f5f5f5"/>
      <stop offset="50%" style="stop-color:#d4d4d4"/>
      <stop offset="70%" style="stop-color:#c0c0c0"/>
      <stop offset="100%" style="stop-color:#a8a8a8"/>
    </linearGradient>
    <linearGradient id="steelDark" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#c0c0c0"/>
      <stop offset="50%" style="stop-color:#a0a0a0"/>
      <stop offset="100%" style="stop-color:#808080"/>
    </linearGradient>
    <linearGradient id="glassGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2a3a4a"/>
      <stop offset="30%" style="stop-color:#1a2a3a"/>
      <stop offset="100%" style="stop-color:#0a1a2a"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="3" dy="8" stdDeviation="15" flood-color="#000" flood-opacity="0.25"/>
    </filter>
  </defs>
  
  <rect width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  
  <g filter="url(#shadow)" transform="translate(400, 420)">
    <rect x="-60" y="-320" width="120" height="200" fill="url(#steelGrad)" rx="3"/>
    <rect x="-55" y="-315" width="110" height="190" fill="none" stroke="#b0b0b0" stroke-width="1" rx="2"/>
    <rect x="-65" y="-130" width="130" height="50" fill="url(#steelDark)" rx="3"/>
    <rect x="-200" y="-80" width="400" height="100" fill="url(#steelGrad)" rx="8"/>
    <rect x="-190" y="-70" width="380" height="80" fill="none" stroke="#c0c0c0" stroke-width="2" rx="5"/>
    <path d="M-180 0 Q-180 -60 -100 -65 L100 -65 Q180 -60 180 0 L180 20 L-180 20 Z" fill="url(#glassGrad)"/>
    <path d="M-170 5 Q-170 -50 -95 -55 L95 -55 Q170 -50 170 5" fill="none" stroke="#4a5a6a" stroke-width="1" opacity="0.6"/>
    <rect x="-150" y="-75" width="300" height="30" fill="#0a1a2a" rx="3"/>
    <rect x="-40" y="-72" width="80" height="24" fill="#001a0a" rx="2"/>
    <text x="0" y="-54" text-anchor="middle" fill="#00ff88" font-family="monospace" font-size="18" font-weight="bold">900</text>
    <circle cx="-90" cy="-60" r="8" fill="#1a2a3a" stroke="#3a4a5a" stroke-width="1"/>
    <circle cx="-60" cy="-60" r="8" fill="#1a2a3a" stroke="#3a4a5a" stroke-width="1"/>
    <circle cx="-120" cy="-60" r="8" fill="#1a2a3a" stroke="#3a4a5a" stroke-width="1"/>
    <circle cx="70" cy="-60" r="8" fill="#1a2a3a" stroke="#3a4a5a" stroke-width="1"/>
    <circle cx="100" cy="-60" r="8" fill="#1a2a3a" stroke="#3a4a5a" stroke-width="1"/>
    <g transform="translate(-160, -30)">
      <rect width="80" height="40" fill="#c0c0c0" rx="3"/>
      <line x1="0" y1="0" x2="80" y2="0" stroke="#909090" stroke-width="0.5"/>
      <line x1="0" y1="8" x2="80" y2="8" stroke="#909090" stroke-width="0.5"/>
      <line x1="0" y1="16" x2="80" y2="16" stroke="#909090" stroke-width="0.5"/>
      <line x1="0" y1="24" x2="80" y2="24" stroke="#909090" stroke-width="0.5"/>
      <line x1="0" y1="32" x2="80" y2="32" stroke="#909090" stroke-width="0.5"/>
      <line x1="10" y1="0" x2="10" y2="40" stroke="#909090" stroke-width="0.5"/>
      <line x1="20" y1="0" x2="20" y2="40" stroke="#909090" stroke-width="0.5"/>
      <line x1="30" y1="0" x2="30" y2="40" stroke="#909090" stroke-width="0.5"/>
      <line x1="40" y1="0" x2="40" y2="40" stroke="#909090" stroke-width="0.5"/>
      <line x1="50" y1="0" x2="50" y2="40" stroke="#909090" stroke-width="0.5"/>
      <line x1="60" y1="0" x2="60" y2="40" stroke="#909090" stroke-width="0.5"/>
      <line x1="70" y1="0" x2="70" y2="40" stroke="#909090" stroke-width="0.5"/>
    </g>
    <g transform="translate(80, -30)">
      <rect width="80" height="40" fill="#c0c0c0" rx="3"/>
      <line x1="0" y1="0" x2="80" y2="0" stroke="#909090" stroke-width="0.5"/>
      <line x1="0" y1="8" x2="80" y2="8" stroke="#909090" stroke-width="0.5"/>
      <line x1="0" y1="16" x2="80" y2="16" stroke="#909090" stroke-width="0.5"/>
      <line x1="0" y1="24" x2="80" y2="24" stroke="#909090" stroke-width="0.5"/>
      <line x1="0" y1="32" x2="80" y2="32" stroke="#909090" stroke-width="0.5"/>
      <line x1="10" y1="0" x2="10" y2="40" stroke="#909090" stroke-width="0.5"/>
      <line x1="20" y1="0" x2="20" y2="40" stroke="#909090" stroke-width="0.5"/>
      <line x1="30" y1="0" x2="30" y2="40" stroke="#909090" stroke-width="0.5"/>
      <line x1="40" y1="0" x2="40" y2="40" stroke="#909090" stroke-width="0.5"/>
      <line x1="50" y1="0" x2="50" y2="40" stroke="#909090" stroke-width="0.5"/>
      <line x1="60" y1="0" x2="60" y2="40" stroke="#909090" stroke-width="0.5"/>
      <line x1="70" y1="0" x2="70" y2="40" stroke="#909090" stroke-width="0.5"/>
    </g>
    <rect x="-195" y="-75" width="390" height="5" fill="white" opacity="0.3" rx="2"/>
    <path d="M-170 -55 Q0 -75 170 -55" fill="none" stroke="white" stroke-width="2" opacity="0.4"/>
  </g>
  
  <g transform="translate(400, 680)">
    <rect x="-120" y="-25" width="240" height="50" fill="#0a2540" rx="8" filter="url(#shadow)"/>
    <text x="0" y="-3" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="20" font-weight="bold">HT-RH900</text>
    <text x="0" y="18" text-anchor="middle" fill="#f7931e" font-family="Arial, sans-serif" font-size="11" letter-spacing="1">WALL MOUNT RANGE HOOD</text>
  </g>
</svg>