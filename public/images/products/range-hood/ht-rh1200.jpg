<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <linearGradient id="steelGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e8e8e8"/>
      <stop offset="30%" style="stop-color:#f5f5f5"/>
      <stop offset="50%" style="stop-color:#d4d4d4"/>
      <stop offset="70%" style="stop-color:#c0c0c0"/>
      <stop offset="100%" style="stop-color:#a8a8a8"/>
    </linearGradient>
    <linearGradient id="steelDark" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#c0c0c0"/>
      <stop offset="50%" style="stop-color:#a0a0a0"/>
      <stop offset="100%" style="stop-color:#808080"/>
    </linearGradient>
    <linearGradient id="glassGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2a3a4a"/>
      <stop offset="40%" style="stop-color:#1a2a3a"/>
      <stop offset="100%" style="stop-color:#0a1a2a"/>
    </linearGradient>
    <filter id="shadow" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="10" stdDeviation="20" flood-color="#000" flood-opacity="0.25"/>
    </filter>
  </defs>
  
  <rect width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  
  <g filter="url(#shadow)" transform="translate(400, 480)">
    <rect x="-80" y="-380" width="160" height="30" fill="url(#steelDark)" rx="5"/>
    <circle cx="-60" cy="-365" r="8" fill="#707070"/>
    <circle cx="60" cy="-365" r="8" fill="#707070"/>
    <rect x="-70" y="-350" width="15" height="200" fill="url(#steelGrad)" rx="2"/>
    <rect x="55" y="-350" width="15" height="200" fill="url(#steelGrad)" rx="2"/>
    <rect x="-140" y="-160" width="280" height="140" fill="url(#steelGrad)" rx="10"/>
    <rect x="-130" y="-150" width="260" height="120" fill="none" stroke="#c0c0c0" stroke-width="2" rx="8"/>
    <rect x="-125" y="-145" width="250" height="110" fill="url(#glassGrad)" rx="5"/>
    <rect x="-118" y="-138" width="100" height="95" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1" rx="3"/>
    <rect x="-120" y="25" width="240" height="20" fill="#0a1a2a" rx="3"/>
    <rect x="-35" y="29" width="70" height="12" fill="#001a0a" rx="2"/>
    <text x="0" y="39" text-anchor="middle" fill="#00ff88" font-family="monospace" font-size="10" font-weight="bold">1200</text>
    <circle cx="-85" cy="35" r="5" fill="#1a2a3a" stroke="#3a4a5a"/>
    <circle cx="-60" cy="35" r="5" fill="#1a2a3a" stroke="#3a4a5a"/>
    <circle cx="60" cy="35" r="5" fill="#1a2a3a" stroke="#3a4a5a"/>
    <circle cx="85" cy="35" r="5" fill="#1a2a3a" stroke="#3a4a5a"/>
    <rect x="-135" y="-120" width="8" height="80" fill="#b0b0b0" rx="1"/>
    <rect x="127" y="-120" width="8" height="80" fill="#b0b0b0" rx="1"/>
    <rect x="-140" y="-160" width="280" height="15" fill="url(#steelDark)" rx="5"/>
    <rect x="-136" y="-156" width="272" height="4" fill="white" opacity="0.4" rx="2"/>
    <rect x="-123" y="-143" width="246" height="3" fill="white" opacity="0.2" rx="1"/>
  </g>
  
  <g transform="translate(400, 720)">
    <rect x="-100" y="-22" width="200" height="44" fill="#0a2540" rx="8" filter="url(#shadow)"/>
    <text x="0" y="-2" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="18" font-weight="bold">HT-RH1200</text>
    <text x="0" y="15" text-anchor="middle" fill="#f7931e" font-family="Arial, sans-serif" font-size="10" letter-spacing="1">ISLAND RANGE HOOD</text>
  </g>
</svg>