<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <linearGradient id="metalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#d0d5dd"/>
      <stop offset="50%" style="stop-color:#f5f5f5"/>
      <stop offset="100%" style="stop-color:#a0a8b0"/>
    </linearGradient>
    <linearGradient id="darkGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#3a3a3a"/>
      <stop offset="100%" style="stop-color:#1a1a1a"/>
    </linearGradient>
    <linearGradient id="blueGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1a4a7a"/>
      <stop offset="100%" style="stop-color:#0a2540"/>
    </linearGradient>
    <linearGradient id="orangeGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#ffaa33"/>
      <stop offset="100%" style="stop-color:#f7931e"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="15" flood-opacity="0.25"/>
    </filter>
    <filter id="innerGlow">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>
  
  <rect width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  
  <g filter="url(#shadow)">
    <ellipse cx="400" cy="580" rx="200" ry="40" fill="#2a2a2a" opacity="0.3"/>
    <rect x="200" y="220" width="400" height="360" rx="20" fill="url(#darkGrad)"/>
    <rect x="200" y="220" width="400" height="360" rx="20" fill="none" stroke="#4a4a4a" stroke-width="3"/>
    
    <rect x="210" y="230" width="380" height="120" rx="15" fill="#2d2d2d"/>
    <rect x="210" y="230" width="380" height="120" rx="15" fill="none" stroke="#4a4a4a" stroke-width="2"/>
    
    <rect x="280" y="250" width="240" height="60" rx="8" fill="#0a0a0a"/>
    <rect x="280" y="250" width="240" height="60" rx="8" fill="none" stroke="#333" stroke-width="1"/>
    
    <text x="340" y="285" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="#ff6b35">200</text>
    <text x="400" y="285" font-family="Arial, sans-serif" font-size="14" fill="#888">C</text>
    <text x="420" y="285" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="#00d4aa">30</text>
    <text x="455" y="285" font-family="Arial, sans-serif" font-size="14" fill="#888">MIN</text>
    <text x="340" y="300" font-family="Arial, sans-serif" font-size="10" fill="#666">TEMP</text>
    <text x="420" y="300" font-family="Arial, sans-serif" font-size="10" fill="#666">TIME</text>
    
    <rect x="200" y="350" width="400" height="8" fill="url(#metalGrad)"/>
    <rect x="200" y="358" width="400" height="2" fill="#888"/>
    
    <rect x="210" y="370" width="380" height="200" rx="10" fill="#252525"/>
    <line x1="400" y1="370" x2="400" y2="570" stroke="#333" stroke-width="1"/>
    <line x1="220" y1="400" x2="220" y2="560" stroke="#333" stroke-width="0.5"/>
    <line x1="580" y1="400" x2="580" y2="560" stroke="#333" stroke-width="0.5"/>
    
    <rect x="320" y="500" width="160" height="25" rx="12" fill="#3a3a3a"/>
    <rect x="320" y="500" width="160" height="25" rx="12" fill="none" stroke="#555" stroke-width="2"/>
    <rect x="360" y="507" width="80" height="10" rx="5" fill="#555"/>
  </g>
  
  <g filter="url(#shadow)">
    <rect x="195" y="580" width="410" height="120" rx="15" fill="#2a2a2a"/>
    <rect x="195" y="580" width="410" height="120" rx="15" fill="none" stroke="#3a3a3a" stroke-width="2"/>
    
    <rect x="230" y="595" width="340" height="90" rx="10" fill="#1a1a1a" opacity="0.8"/>
    <rect x="230" y="595" width="340" height="90" rx="10" fill="none" stroke="#444" stroke-width="3"/>
    
    <g stroke="#555" stroke-width="1" fill="none">
      <ellipse cx="400" cy="640" rx="150" ry="35"/>
      <line x1="280" y1="620" x2="280" y2="660"/>
      <line x1="320" y1="610" x2="320" y2="670"/>
      <line x1="360" y1="605" x2="360" y2="675"/>
      <line x1="400" y1="605" x2="400" y2="675"/>
      <line x1="440" y1="605" x2="440" y2="675"/>
      <line x1="480" y1="610" x2="480" y2="670"/>
      <line x1="520" y1="620" x2="520" y2="660"/>
    </g>
    
    <rect x="280" y="700" width="240" height="20" rx="10" fill="#3a3a3a"/>
    <rect x="280" y="700" width="240" height="20" rx="10" fill="none" stroke="#555" stroke-width="2"/>
  </g>
  
  <g>
    <rect x="250" y="740" width="300" height="50" rx="10" fill="url(#blueGrad)"/>
    <rect x="250" y="740" width="300" height="50" rx="10" fill="none" stroke="#1a4a7a" stroke-width="2"/>
    <text x="400" y="762" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#ffffff">HT-AF80</text>
    <text x="400" y="782" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="url(#orangeGrad)" font-weight="bold">DIGITAL AIR FRYER 8L</text>
  </g>
</svg>