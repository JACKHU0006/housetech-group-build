<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#f8f9fa"/><stop offset="100%" style="stop-color:#e9ecef"/></linearGradient>
    <linearGradient id="frameGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#e0e0e0"/><stop offset="40%" style="stop-color:#c0c0c0"/><stop offset="100%" style="stop-color:#a8a8a8"/></linearGradient>
    <linearGradient id="glassGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#252525"/><stop offset="50%" style="stop-color:#0d0d0d"/><stop offset="100%" style="stop-color:#1a1a1a"/></linearGradient>
    <radialGradient id="ceramicHeat" cx="50%" cy="50%" r="50%"><stop offset="0%" style="stop-color:#ff3333"/><stop offset="30%" style="stop-color:#cc0000"/><stop offset="70%" style="stop-color:#880000"/><stop offset="100%" style="stop-color:#550000"/></radialGradient>
    <radialGradient id="heatGlow" cx="50%" cy="50%" r="50%"><stop offset="0%" style="stop-color:#ff5555;stop-opacity:0.9"/><stop offset="50%" style="stop-color:#ff3333;stop-opacity:0.5"/><stop offset="100%" style="stop-color:#cc0000;stop-opacity:0"/></radialGradient>
    <linearGradient id="controlGrad" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" style="stop-color:#383838"/><stop offset="100%" style="stop-color:#1a1a1a"/></linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="6" stdDeviation="10" flood-color="#000" flood-opacity="0.2"/></filter>
    <filter id="redGlow"><feGaussianBlur stdDeviation="5" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
  </defs>
  <rect x="0" y="0" width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  <rect x="150" y="165" width="500" height="440" rx="8" fill="#000" opacity="0.1" filter="url(#shadow)"/>
  <rect x="145" y="160" width="510" height="450" rx="6" fill="url(#frameGrad)" stroke="#909090" stroke-width="2"/>
  <rect x="160" y="175" width="480" height="380" rx="4" fill="url(#glassGrad)"/>
  <line x1="170" y1="185" x2="630" y2="185" stroke="#fff" stroke-width="1" opacity="0.1"/>
  <g transform="translate(290, 330)">
    <circle cx="0" cy="0" r="95" fill="url(#heatGlow)" filter="url(#redGlow)"/>
    <circle cx="0" cy="0" r="75" fill="url(#ceramicHeat)" filter="url(#redGlow)"><animate attributeName="opacity" values="0.95;1;0.95" dur="1.2s" repeatCount="indefinite"/></circle>
    <circle cx="0" cy="0" r="60" fill="none" stroke="#ff6666" stroke-width="3" opacity="0.5"/><circle cx="0" cy="0" r="45" fill="none" stroke="#ff6666" stroke-width="2.5" opacity="0.4"/><circle cx="0" cy="0" r="30" fill="none" stroke="#ff6666" stroke-width="2" opacity="0.3"/>
    <circle cx="0" cy="0" r="12" fill="#880000"/>
  </g>
  <g transform="translate(510, 330)">
    <circle cx="0" cy="0" r="95" fill="url(#heatGlow)" filter="url(#redGlow)"/>
    <circle cx="0" cy="0" r="75" fill="url(#ceramicHeat)" filter="url(#redGlow)"><animate attributeName="opacity" values="1;0.95;1" dur="1.4s" repeatCount="indefinite"/></circle>
    <circle cx="0" cy="0" r="60" fill="none" stroke="#ff6666" stroke-width="3" opacity="0.5"/><circle cx="0" cy="0" r="45" fill="none" stroke="#ff6666" stroke-width="2.5" opacity="0.4"/><circle cx="0" cy="0" r="30" fill="none" stroke="#ff6666" stroke-width="2" opacity="0.3"/>
    <circle cx="0" cy="0" r="12" fill="#880000"/>
  </g>
  <rect x="160" y="510" width="480" height="85" rx="4" fill="url(#controlGrad)"/>
  <rect x="210" y="540" width="150" height="6" rx="3" fill="#444"/><rect x="210" y="540" width="100" height="6" rx="3" fill="#f7931e"/><circle cx="310" cy="543" r="10" fill="url(#frameGrad)" stroke="#f7931e" stroke-width="2"/>
  <rect x="440" y="540" width="150" height="6" rx="3" fill="#444"/><rect x="440" y="540" width="110" height="6" rx="3" fill="#f7931e"/><circle cx="550" cy="543" r="10" fill="url(#frameGrad)" stroke="#f7931e" stroke-width="2"/>
  <circle cx="400" cy="560" r="6" fill="#1a1a1a" stroke="#00ff00" stroke-width="2"><animate attributeName="stroke-opacity" values="1;0.6;1" dur="1.5s" repeatCount="indefinite"/></circle>
  <rect x="250" y="700" width="300" height="50" rx="10" fill="#0a2540"/>
  <text x="400" y="722" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#fff" text-anchor="middle">HT-CR60</text>
  <text x="400" y="742" font-family="Arial, sans-serif" font-size="12" fill="#f7931e" text-anchor="middle">60CM DUAL CERAMIC COOKTOP</text>
</svg>