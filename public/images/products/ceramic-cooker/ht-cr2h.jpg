<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#f8f9fa"/><stop offset="100%" style="stop-color:#e9ecef"/></linearGradient>
    <linearGradient id="frameGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#e2e2e2"/><stop offset="35%" style="stop-color:#c2c2c2"/><stop offset="100%" style="stop-color:#a0a0a0"/></linearGradient>
    <linearGradient id="glassGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#1e1e1e"/><stop offset="50%" style="stop-color:#0a0a0a"/><stop offset="100%" style="stop-color:#141414"/></linearGradient>
    <radialGradient id="dualRed" cx="50%" cy="50%" r="50%"><stop offset="0%" style="stop-color:#ff1111"/><stop offset="30%" style="stop-color:#cc0000"/><stop offset="65%" style="stop-color:#880000"/><stop offset="100%" style="stop-color:#550000"/></radialGradient>
    <radialGradient id="dualGlow" cx="50%" cy="50%" r="50%"><stop offset="0%" style="stop-color:#ff2222;stop-opacity:0.85"/><stop offset="50%" style="stop-color:#ee0000;stop-opacity:0.45"/><stop offset="100%" style="stop-color:#aa0000;stop-opacity:0"/></radialGradient>
    <linearGradient id="controlGrad" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" style="stop-color:#353535"/><stop offset="100%" style="stop-color:#191919"/></linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="5" stdDeviation="8" flood-color="#000" flood-opacity="0.2"/></filter>
    <filter id="heatFilter"><feGaussianBlur stdDeviation="5" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
  </defs>
  <rect x="0" y="0" width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  <rect x="140" y="180" width="520" height="420" rx="6" fill="#000" opacity="0.1" filter="url(#shadow)"/>
  <rect x="135" y="175" width="530" height="430" rx="5" fill="url(#frameGrad)" stroke="#929292" stroke-width="1.5"/>
  <rect x="150" y="190" width="500" height="360" rx="3" fill="url(#glassGrad)"/>
  <line x1="160" y1="198" x2="640" y2="198" stroke="#fff" stroke-width="0.8" opacity="0.08"/>
  <g transform="translate(290, 340)">
    <ellipse cx="0" cy="0" rx="120" ry="90" fill="url(#dualGlow)" filter="url(#heatFilter)"/>
    <ellipse cx="0" cy="0" rx="95" ry="70" fill="url(#dualRed)" filter="url(#heatFilter)"><animate attributeName="opacity" values="0.95;1;0.95" dur="1.4s" repeatCount="indefinite"/></ellipse>
    <ellipse cx="0" cy="0" rx="78" ry="56" fill="none" stroke="#ff4444" stroke-width="3" opacity="0.5"/><ellipse cx="0" cy="0" rx="60" ry="42" fill="none" stroke="#ff4444" stroke-width="2.5" opacity="0.4"/><ellipse cx="0" cy="0" rx="42" ry="28" fill="none" stroke="#ff4444" stroke-width="2" opacity="0.3"/>
    <ellipse cx="0" cy="0" rx="15" ry="10" fill="#770000"/>
  </g>
  <g transform="translate(510, 340)">
    <ellipse cx="0" cy="0" rx="120" ry="90" fill="url(#dualGlow)" filter="url(#heatFilter)"/>
    <ellipse cx="0" cy="0" rx="95" ry="70" fill="url(#dualRed)" filter="url(#heatFilter)"><animate attributeName="opacity" values="1;0.95;1" dur="1.2s" repeatCount="indefinite"/></ellipse>
    <ellipse cx="0" cy="0" rx="78" ry="56" fill="none" stroke="#ff4444" stroke-width="3" opacity="0.5"/><ellipse cx="0" cy="0" rx="60" ry="42" fill="none" stroke="#ff4444" stroke-width="2.5" opacity="0.4"/><ellipse cx="0" cy="0" rx="42" ry="28" fill="none" stroke="#ff4444" stroke-width="2" opacity="0.3"/>
    <ellipse cx="0" cy="0" rx="15" ry="10" fill="#770000"/>
  </g>
  <rect x="150" y="510" width="500" height="80" rx="3" fill="url(#controlGrad)"/>
  <rect x="200" y="540" width="160" height="6" rx="3" fill="#444"/><rect x="200" y="540" width="110" height="6" rx="3" fill="#f7931e"/><circle cx="310" cy="543" r="9" fill="url(#frameGrad)" stroke="#f7931e" stroke-width="2"/>
  <rect x="440" y="540" width="160" height="6" rx="3" fill="#444"/><rect x="440" y="540" width="95" height="6" rx="3" fill="#f7931e"/><circle cx="535" cy="543" r="9" fill="url(#frameGrad)" stroke="#f7931e" stroke-width="2"/>
  <g transform="translate(370, 565)"><rect x="-20" y="-12" width="40" height="24" rx="4" fill="#333" stroke="#555" stroke-width="1"/><text x="0" y="4" font-family="Arial" font-size="10" fill="#fff" text-anchor="middle">TIMER</text></g>
  <circle cx="400" cy="555" r="5" fill="#1a1a1a" stroke="#00ff00" stroke-width="1.5"><animate attributeName="stroke-opacity" values="1;0.4;1" dur="1.8s" repeatCount="indefinite"/></circle>
  <rect x="250" y="700" width="300" height="50" rx="10" fill="#0a2540"/>
  <text x="400" y="722" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#fff" text-anchor="middle">HT-CR2H</text>
  <text x="400" y="742" font-family="Arial, sans-serif" font-size="12" fill="#f7931e" text-anchor="middle">DUAL HOB CERAMIC 90CM</text>
</svg>