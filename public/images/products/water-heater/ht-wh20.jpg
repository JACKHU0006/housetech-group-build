<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <linearGradient id="metalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e8e8e8"/>
      <stop offset="50%" style="stop-color:#ffffff"/>
      <stop offset="100%" style="stop-color:#c8c8c8"/>
    </linearGradient>
    <linearGradient id="blueGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1a4a7a"/>
      <stop offset="100%" style="stop-color:#0a2540"/>
    </linearGradient>
    <linearGradient id="orangeGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#ffaa33"/>
      <stop offset="100%" style="stop-color:#f7931e"/>
    </linearGradient>
    <linearGradient id="flameBlue" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" style="stop-color:#0066cc"/>
      <stop offset="50%" style="stop-color:#3399ff"/>
      <stop offset="100%" style="stop-color:#66ccff"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="15" flood-opacity="0.25"/>
    </filter>
    <filter id="glow">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <rect width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  
  <g filter="url(#shadow)">
    <ellipse cx="400" cy="680" rx="220" ry="40" fill="#aaa" opacity="0.2"/>
    
    <rect x="170" y="180" width="460" height="480" rx="18" fill="url(#metalGrad)"/>
    <rect x="170" y="180" width="460" height="480" rx="18" fill="none" stroke="#b0b0b0" stroke-width="2"/>
    
    <rect x="190" y="190" width="420" height="90" rx="12" fill="#d5d5d5"/>
    <rect x="190" y="190" width="420" height="90" rx="12" fill="none" stroke="#c0c0c0" stroke-width="1"/>
    
    <ellipse cx="400" cy="235" rx="55" ry="30" fill="#888"/>
    <ellipse cx="400" cy="235" rx="42" ry="22" fill="#666"/>
    
    <g fill="#aaa">
      <rect x="220" y="218" width="60" height="35" rx="4"/>
      <rect x="520" y="218" width="60" height="35" rx="4"/>
    </g>
    
    <rect x="190" y="290" width="420" height="350" rx="14" fill="#f5f5f5"/>
    <rect x="190" y="290" width="420" height="350" rx="14" fill="none" stroke="#ddd" stroke-width="1"/>
    
    <rect x="210" y="310" width="380" height="100" rx="12" fill="#e8e8e8"/>
    <rect x="210" y="310" width="380" height="100" rx="12" fill="none" stroke="#ccc" stroke-width="1"/>
    
    <rect x="260" y="325" width="200" height="70" rx="10" fill="#0a1520"/>
    <rect x="260" y="325" width="200" height="70" rx="10" fill="none" stroke="#1a3a5a" stroke-width="3"/>
    
    <text x="360" y="365" text-anchor="middle" font-family="Arial, sans-serif" font-size="42" font-weight="bold" fill="#00d4aa" filter="url(#glow)">45C</text>
    <text x="360" y="385" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="#666">HOT WATER</text>
    
    <g transform="translate(500, 335)">
      <rect x="-35" y="-25" width="70" height="50" rx="8" fill="url(#flameBlue)"/>
      <rect x="-35" y="-25" width="70" height="50" rx="8" fill="none" stroke="#3399ff" stroke-width="1"/>
      <path d="M0,-15 Q-8,0 -5,10 Q0,5 5,10 Q8,0 0,-15" fill="#ffffff" opacity="0.9"/>
      <text x="0" y="18" text-anchor="middle" font-family="Arial, sans-serif" font-size="9" font-weight="bold" fill="#fff">ECO</text>
    </g>
    
    <g transform="translate(500, 395)">
      <rect x="-30" y="-20" width="60" height="40" rx="6" fill="#cd7f32"/>
      <rect x="-30" y="-20" width="60" height="40" rx="6" fill="none" stroke="#b8722e" stroke-width="1"/>
      <text x="0" y="5" text-anchor="middle" font-family="Arial, sans-serif" font-size="9" font-weight="bold" fill="#fff">COPPER</text>
      <text x="0" y="16" text-anchor="middle" font-family="Arial, sans-serif" font-size="7" fill="#fff">TANK</text>
    </g>
    
    <g transform="translate(230, 435)">
      <circle cx="0" cy="0" r="10" fill="#00d4aa"/>
      <text x="0" y="22" text-anchor="middle" font-size="7" fill="#888">ON</text>
      
      <circle cx="50" cy="0" r="10" fill="#f7931e"/>
      <text x="50" y="22" text-anchor="middle" font-size="7" fill="#888">GAS</text>
      
      <circle cx="100" cy="0" r="10" fill="#3399ff"/>
      <text x="100" y="22" text-anchor="middle" font-size="7" fill="#888">WATER</text>
      
      <circle cx="150" cy="0" r="10" fill="#ff6b6b"/>
      <text x="150" y="22" text-anchor="middle" font-size="7" fill="#888">ERROR</text>
    </g>
    
    <rect x="210" y="480" width="380" height="140" rx="12" fill="#ececec"/>
    <rect x="210" y="480" width="380" height="140" rx="12" fill="none" stroke="#ddd" stroke-width="1"/>
    
    <circle cx="290" cy="550" r="45" fill="#ddd"/>
    <circle cx="290" cy="550" r="45" fill="none" stroke="#bbb" stroke-width="3"/>
    <circle cx="290" cy="550" r="32" fill="#e5e5e5"/>
    <circle cx="290" cy="550" r="32" fill="none" stroke="#ccc" stroke-width="1"/>
    <line x1="290" y1="508" x2="290" y2="525" stroke="#0a2540" stroke-width="4" stroke-linecap="round"/>
    <text x="290" y="580" text-anchor="middle" font-size="10" fill="#666">TEMP</text>
    
    <circle cx="400" cy="550" r="45" fill="#ddd"/>
    <circle cx="400" cy="550" r="45" fill="none" stroke="#bbb" stroke-width="3"/>
    <circle cx="400" cy="550" r="32" fill="#e5e5e5"/>
    <circle cx="400" cy="550" r="32" fill="none" stroke="#ccc" stroke-width="1"/>
    <line x1="400" y1="508" x2="400" y2="525" stroke="#0a2540" stroke-width="4" stroke-linecap="round"/>
    <text x="400" y="580" text-anchor="middle" font-size="10" fill="#666">FLOW</text>
    
    <circle cx="510" cy="550" r="35" fill="#0a2540"/>
    <circle cx="510" cy="550" r="35" fill="none" stroke="#1a4a7a" stroke-width="2"/>
    <text x="510" y="558" text-anchor="middle" font-family="Arial, sans-serif" font-size="24" fill="#fff">ON</text>
    
    <g transform="translate(190, 630)">
      <rect x="10" y="0" width="50" height="35" rx="6" fill="#3399ff"/>
      <text x="35" y="22" text-anchor="middle" font-size="9" fill="#fff">COLD</text>
      
      <rect x="80" y="0" width="50" height="35" rx="6" fill="#ff6b6b"/>
      <text x="105" y="22" text-anchor="middle" font-size="9" fill="#fff">HOT</text>
      
      <rect x="150" y="0" width="50" height="35" rx="6" fill="#f7931e"/>
      <text x="175" y="22" text-anchor="middle" font-size="9" fill="#fff">GAS</text>
    </g>
  </g>
  
  <g>
    <rect x="250" y="755" width="300" height="50" rx="10" fill="url(#blueGrad)"/>
    <rect x="250" y="755" width="300" height="50" rx="10" fill="none" stroke="#1a4a7a" stroke-width="2"/>
    <text x="400" y="777" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#ffffff">HT-WH20</text>
    <text x="400" y="797" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="url(#orangeGrad)" font-weight="bold">HIGH EFFICIENCY GAS</text>
  </g>
</svg>