<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <linearGradient id="metalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e0e0e0"/>
      <stop offset="50%" style="stop-color:#ffffff"/>
      <stop offset="100%" style="stop-color:#c0c0c0"/>
    </linearGradient>
    <linearGradient id="blueGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1a4a7a"/>
      <stop offset="100%" style="stop-color:#0a2540"/>
    </linearGradient>
    <linearGradient id="orangeGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#ffaa33"/>
      <stop offset="100%" style="stop-color:#f7931e"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="10" stdDeviation="20" flood-opacity="0.3"/>
    </filter>
    <filter id="glow">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <rect width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  
  <g filter="url(#shadow)">
    <ellipse cx="400" cy="700" rx="280" ry="50" fill="#aaa" opacity="0.2"/>
    
    <rect x="120" y="160" width="560" height="520" rx="25" fill="url(#metalGrad)"/>
    <rect x="120" y="160" width="560" height="520" rx="25" fill="none" stroke="#a8a8a8" stroke-width="3"/>
    
    <rect x="140" y="170" width="520" height="100" rx="18" fill="#d0d0d0"/>
    <rect x="140" y="170" width="520" height="100" rx="18" fill="none" stroke="#b8b8b8" stroke-width="2"/>
    
    <ellipse cx="400" cy="220" rx="80" ry="35" fill="#888"/>
    <ellipse cx="400" cy="220" rx="60" ry="25" fill="#666"/>
    
    <g fill="#999">
      <rect x="160" y="200" width="80" height="40" rx="5"/>
      <rect x="560" y="200" width="80" height="40" rx="5"/>
    </g>
    
    <rect x="340" y="180" width="120" height="30" rx="5" fill="#0a2540"/>
    <text x="400" y="200" text-anchor="middle" font-size="12" font-weight="bold" fill="#fff">HOUSETECH</text>
    
    <rect x="140" y="280" width="520" height="380" rx="18" fill="#f2f2f2"/>
    <rect x="140" y="280" width="520" height="380" rx="18" fill="none" stroke="#d8d8d8" stroke-width="2"/>
    
    <rect x="170" y="300" width="460" height="130" rx="15" fill="#1a2530"/>
    <rect x="170" y="300" width="460" height="130" rx="15" fill="none" stroke="#2a3a4a" stroke-width="3"/>
    
    <text x="300" y="380" text-anchor="middle" font-family="Arial, sans-serif" font-size="72" font-weight="bold" fill="#00d4aa" filter="url(#glow)">48C</text>
    <text x="300" y="410" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" fill="#666">OUTLET TEMPERATURE</text>
    
    <text x="550" y="360" text-anchor="middle" font-family="Arial, sans-serif" font-size="36" font-weight="bold" fill="#3399ff" filter="url(#glow)">16</text>
    <text x="550" y="385" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" fill="#666">L/min</text>
    <text x="550" y="410" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#555">FLOW RATE</text>
    
    <g transform="translate(200, 450)">
      <rect x="0" y="0" width="80" height="35" rx="8" fill="#00d4aa"/>
      <text x="40" y="23" text-anchor="middle" font-size="12" font-weight="bold" fill="#fff">POWER</text>
      
      <rect x="100" y="0" width="80" height="35" rx="8" fill="#f7931e"/>
      <text x="140" y="23" text-anchor="middle" font-size="12" font-weight="bold" fill="#fff">GAS</text>
      
      <rect x="200" y="0" width="80" height="35" rx="8" fill="#3399ff"/>
      <text x="240" y="23" text-anchor="middle" font-size="12" font-weight="bold" fill="#fff">WATER</text>
      
      <rect x="300" y="0" width="80" height="35" rx="8" fill="#ddd"/>
      <text x="340" y="23" text-anchor="middle" font-size="12" fill="#888">ERROR</text>
    </g>
    
    <g transform="translate(170, 510)">
      <rect x="0" y="0" width="460" height="60" rx="10" fill="#e8e8e8"/>
      <rect x="0" y="0" width="460" height="60" rx="10" fill="none" stroke="#d0d0d0" stroke-width="1"/>
      
      <text x="230" y="25" text-anchor="middle" font-size="14" font-weight="bold" fill="#0a2540">PARALLEL INSTALLATION READY</text>
      <text x="230" y="45" text-anchor="middle" font-size="11" fill="#666">Commercial Grade - Multiple Units Supported</text>
    </g>
    
    <rect x="170" y="590" width="460" height="60" rx="10" fill="#ddd"/>
    <rect x="170" y="590" width="460" height="60" rx="10" fill="none" stroke="#c0c0c0" stroke-width="1"/>
    
    <circle cx="260" cy="620" r="25" fill="#ccc"/>
    <circle cx="260" cy="620" r="25" fill="none" stroke="#aaa" stroke-width="2"/>
    <text x="260" y="626" text-anchor="middle" font-size="20" fill="#666">-</text>
    
    <text x="340" y="626" text-anchor="middle" font-size="14" fill="#666">TEMP</text>
    
    <circle cx="420" cy="620" r="25" fill="#ccc"/>
    <circle cx="420" cy="620" r="25" fill="none" stroke="#aaa" stroke-width="2"/>
    <text x="420" y="626" text-anchor="middle" font-size="20" fill="#666">+</text>
    
    <rect x="500" y="598" width="110" height="44" rx="10" fill="#0a2540"/>
    <rect x="500" y="598" width="110" height="44" rx="10" fill="none" stroke="#1a4a7a" stroke-width="2"/>
    <text x="555" y="627" text-anchor="middle" font-size="16" font-weight="bold" fill="#fff">ON/OFF</text>
    
    <g transform="translate(140, 660)">
      <rect x="20" y="0" width="60" height="35" rx="6" fill="#3399ff"/>
      <text x="50" y="22" text-anchor="middle" font-size="10" fill="#fff">COLD 1</text>
      
      <rect x="100" y="0" width="60" height="35" rx="6" fill="#3399ff"/>
      <text x="130" y="22" text-anchor="middle" font-size="10" fill="#fff">COLD 2</text>
      
      <rect x="300" y="0" width="60" height="35" rx="6" fill="#ff6b6b"/>
      <text x="330" y="22" text-anchor="middle" font-size="10" fill="#fff">HOT 1</text>
      
      <rect x="380" y="0" width="60" height="35" rx="6" fill="#ff6b6b"/>
      <text x="410" y="22" text-anchor="middle" font-size="10" fill="#fff">HOT 2</text>
      
      <rect x="200" y="0" width="70" height="35" rx="6" fill="#f7931e"/>
      <text x="235" y="22" text-anchor="middle" font-size="10" fill="#fff">GAS</text>
    </g>
  </g>
  
  <g>
    <rect x="250" y="755" width="300" height="50" rx="10" fill="url(#blueGrad)"/>
    <rect x="250" y="755" width="300" height="50" rx="10" fill="none" stroke="#1a4a7a" stroke-width="2"/>
    <text x="400" y="777" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#ffffff">HT-WH80</text>
    <text x="400" y="797" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="url(#orangeGrad)" font-weight="bold">HIGH FLOW INSTANT</text>
  </g>
</svg>