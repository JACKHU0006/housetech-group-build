<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <linearGradient id="metalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e8e8e8"/>
      <stop offset="50%" style="stop-color:#ffffff"/>
      <stop offset="100%" style="stop-color:#c8c8c8"/>
    </linearGradient>
    <linearGradient id="whiteGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#ffffff"/>
      <stop offset="100%" style="stop-color:#e8e8e8"/>
    </linearGradient>
    <linearGradient id="blueGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1a4a7a"/>
      <stop offset="100%" style="stop-color:#0a2540"/>
    </linearGradient>
    <linearGradient id="orangeGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#ffaa33"/>
      <stop offset="100%" style="stop-color:#f7931e"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="6" stdDeviation="12" flood-opacity="0.2"/>
    </filter>
    <filter id="glow">
      <feGaussianBlur stdDeviation="2" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <rect width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  
  <g filter="url(#shadow)">
    <ellipse cx="400" cy="660" rx="200" ry="35" fill="#aaa" opacity="0.2"/>
    
    <rect x="200" y="200" width="400" height="440" rx="15" fill="url(#metalGrad)"/>
    <rect x="200" y="200" width="400" height="440" rx="15" fill="none" stroke="#b0b0b0" stroke-width="2"/>
    
    <rect x="220" y="210" width="360" height="80" rx="10" fill="#d0d0d0"/>
    <rect x="220" y="210" width="360" height="80" rx="10" fill="none" stroke="#b8b8b8" stroke-width="1"/>
    
    <ellipse cx="400" cy="250" rx="45" ry="25" fill="#888"/>
    <ellipse cx="400" cy="250" rx="35" ry="18" fill="#666"/>
    
    <g fill="#999">
      <rect x="260" y="235" width="50" height="30" rx="3"/>
      <rect x="490" y="235" width="50" height="30" rx="3"/>
    </g>
    
    <rect x="220" y="300" width="360" height="320" rx="12" fill="#f0f0f0"/>
    <rect x="220" y="300" width="360" height="320" rx="12" fill="none" stroke="#ddd" stroke-width="1"/>
    
    <rect x="240" y="320" width="320" height="100" rx="10" fill="#e0e0e0"/>
    <rect x="240" y="320" width="320" height="100" rx="10" fill="none" stroke="#ccc" stroke-width="1"/>
    
    <rect x="280" y="335" width="150" height="55" rx="8" fill="#1a2530"/>
    <rect x="280" y="335" width="150" height="55" rx="8" fill="none" stroke="#2a3a4a" stroke-width="2"/>
    
    <text x="355" y="370" text-anchor="middle" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="#00d4aa" filter="url(#glow)">42C</text>
    <text x="355" y="385" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#666">OUTLET TEMP</text>
    
    <g transform="translate(480, 355)">
      <circle cx="0" cy="0" r="8" fill="#00d4aa"/>
      <text x="0" y="20" text-anchor="middle" font-family="Arial, sans-serif" font-size="8" fill="#888">PWR</text>
      
      <circle cx="0" cy="45" r="8" fill="#f7931e"/>
      <text x="0" y="65" text-anchor="middle" font-family="Arial, sans-serif" font-size="8" fill="#888">GAS</text>
      
      <circle cx="0" cy="90" r="8" fill="#3399ff"/>
      <text x="0" y="110" text-anchor="middle" font-family="Arial, sans-serif" font-size="8" fill="#888">FLOW</text>
    </g>
    
    <circle cx="310" cy="480" r="35" fill="#ddd"/>
    <circle cx="310" cy="480" r="35" fill="none" stroke="#bbb" stroke-width="2"/>
    <circle cx="310" cy="480" r="25" fill="#e8e8e8"/>
    <circle cx="310" cy="480" r="25" fill="none" stroke="#ccc" stroke-width="1"/>
    <line x1="310" y1="448" x2="310" y2="460" stroke="#0a2540" stroke-width="3" stroke-linecap="round"/>
    
    <circle cx="400" cy="480" r="25" fill="#ddd"/>
    <circle cx="400" cy="480" r="25" fill="none" stroke="#bbb" stroke-width="2"/>
    <text x="400" y="486" text-anchor="middle" font-family="Arial, sans-serif" font-size="20" fill="#0a2540">ON</text>
    
    <circle cx="490" cy="480" r="35" fill="#ddd"/>
    <circle cx="490" cy="480" r="35" fill="none" stroke="#bbb" stroke-width="2"/>
    <circle cx="490" cy="480" r="25" fill="#e8e8e8"/>
    <text x="490" y="484" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#666">MODE</text>
    
    <text x="400" y="545" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="#0a2540">CONSTANT TEMPERATURE</text>
    <text x="400" y="562" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#888">Instant Hot Water</text>
    
    <g transform="translate(220, 580)">
      <rect x="0" y="0" width="40" height="30" rx="5" fill="#3399ff"/>
      <rect x="0" y="0" width="40" height="30" rx="5" fill="none" stroke="#2277cc" stroke-width="1"/>
      <text x="20" y="20" text-anchor="middle" font-family="Arial, sans-serif" font-size="8" fill="#fff">COLD</text>
      
      <rect x="60" y="0" width="40" height="30" rx="5" fill="#ff6b6b"/>
      <rect x="60" y="0" width="40" height="30" rx="5" fill="none" stroke="#dd5555" stroke-width="1"/>
      <text x="80" y="20" text-anchor="middle" font-family="Arial, sans-serif" font-size="8" fill="#fff">HOT</text>
      
      <rect x="120" y="0" width="40" height="30" rx="5" fill="#f7931e"/>
      <rect x="120" y="0" width="40" height="30" rx="5" fill="none" stroke="#dd7710" stroke-width="1"/>
      <text x="140" y="20" text-anchor="middle" font-family="Arial, sans-serif" font-size="8" fill="#fff">GAS</text>
    </g>
  </g>
  
  <g>
    <rect x="250" y="745" width="300" height="50" rx="10" fill="url(#blueGrad)"/>
    <rect x="250" y="745" width="300" height="50" rx="10" fill="none" stroke="#1a4a7a" stroke-width="2"/>
    <text x="400" y="767" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#ffffff">HT-WH16</text>
    <text x="400" y="787" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="url(#orangeGrad)" font-weight="bold">INSTANT GAS HEATER</text>
  </g>
</svg>