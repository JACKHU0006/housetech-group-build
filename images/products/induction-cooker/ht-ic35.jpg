<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs><linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#f8f9fa"/><stop offset="100%" style="stop-color:#e9ecef"/></linearGradient><linearGradient id="glass" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" style="stop-color:#1a1a24"/><stop offset="50%" style="stop-color:#2a2a35"/><stop offset="100%" style="stop-color:#1a1a24"/></linearGradient><linearGradient id="accent" x1="0%" y1="0%" x2="100%" x2="0%"><stop offset="0%" style="stop-color:#0a2540"/><stop offset="100%" style="stop-color:#1a3a5c"/></linearGradient><filter id="shadow"><feDropShadow dx="0" dy="8" stdDeviation="12" flood-opacity="0.15"/></filter></defs>
  <rect width="800" height="800" fill="url(#bg)" rx="20"/>
  <g transform="translate(120, 180)" filter="url(#shadow)">
    <!-- Black glass panel -->
    <rect x="20" y="10" width="520" height="300" rx="12" fill="url(#glass)" stroke="#444" stroke-width="2"/>
    <!-- Single large heating zone -->
    <circle cx="280" cy="160" r="130" fill="none" stroke="#f7931e" stroke-opacity="0.4" stroke-width="3" stroke-dasharray="8,4">
      <animate attributeName="stroke-opacity" values="0.4;0.8;0.4" dur="3s" repeatCount="indefinite"/>
    </circle>
    <circle cx="280" cy="160" r="105" fill="none" stroke="#f7931e" stroke-opacity="0.6" stroke-width="2" stroke-dasharray="6,3"/>
    <circle cx="280" cy="160" r="80" fill="rgba(247,147,30,0.08)"/><circle cx="280" cy="160" r="50" fill="rgba(247,147,30,0.06)"/>
    <circle cx="280" cy="160" r="15" fill="#f7931e" opacity="0.5"/>
    <!-- Touch control panel -->
    <rect x="400" y="250" width="120" height="45" rx="6" fill="#111" stroke="#333" stroke-width="1"/>
    <circle cx="420" cy="272" r="7" fill="#f7931e" opacity="0.85"/>
    <rect x="440" y="260" width="65" height="14" rx="2" fill="#0a2540"/>
    <text x="472" y="271" text-anchor="middle" font-family="monospace" font-size="9" fill="#4af">3500W</text>
    <!-- Stainless steel frame -->
    <rect x="16" y="6" width="528" height="308" rx="14" fill="none" stroke="#c0c7d0" stroke-width="3"/>
    <!-- Power indicator -->
    <circle cx="60" cy="45" r="6" fill="#4ade80" opacity="0.7"/>
  </g>
  <g transform="translate(400, 700)"><rect x="-110" y="-28" width="220" height="56" rx="28" fill="url(#accent)"/><text x="0" y="6" text-anchor="middle" font-family="'Inter',sans-serif" font-weight="800" font-size="18" fill="white">HT-IC35</text><text x="0" y="20" text-anchor="middle" font-family="'Inter',sans-serif" font-weight="500" font-size="10" fill="#f7931e" letter-spacing="3">SINGLE INDUCTION</text></g>
</svg>