<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <linearGradient id="metalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#d0d5dd"/>
      <stop offset="50%" style="stop-color:#f5f5f5"/>
      <stop offset="100%" style="stop-color:#a0a8b0"/>
    </linearGradient>
    <linearGradient id="darkGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#3a3a3a"/>
      <stop offset="100%" style="stop-color:#1a1a1a"/>
    </linearGradient>
    <linearGradient id="blueGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1a4a7a"/>
      <stop offset="100%" style="stop-color:#0a2540"/>
    </linearGradient>
    <linearGradient id="orangeGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#ffaa33"/>
      <stop offset="100%" style="stop-color:#f7931e"/>
    </linearGradient>
    <linearGradient id="glassGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a2a3a" stop-opacity="0.9"/>
      <stop offset="50%" style="stop-color:#0a1520" stop-opacity="0.95"/>
      <stop offset="100%" style="stop-color:#1a2a3a" stop-opacity="0.9"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="10" stdDeviation="18" flood-opacity="0.3"/>
    </filter>
    <filter id="glow">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <rect width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  
  <g filter="url(#shadow)">
    <ellipse cx="400" cy="660" rx="230" ry="50" fill="#2a2a2a" opacity="0.3"/>
    
    <rect x="160" y="160" width="480" height="480" rx="20" fill="url(#darkGrad)"/>
    <rect x="160" y="160" width="480" height="480" rx="20" fill="none" stroke="#4a4a4a" stroke-width="3"/>
    
    <g fill="#222">
      <rect x="180" y="170" width="80" height="6" rx="3"/>
      <rect x="180" y="182" width="80" height="6" rx="3"/>
      <rect x="180" y="194" width="80" height="6" rx="3"/>
      <rect x="540" y="170" width="80" height="6" rx="3"/>
      <rect x="540" y="182" width="80" height="6" rx="3"/>
      <rect x="540" y="194" width="80" height="6" rx="3"/>
    </g>
    
    <rect x="175" y="210" width="450" height="90" rx="15" fill="#252525"/>
    <rect x="175" y="210" width="450" height="90" rx="15" fill="none" stroke="#3a3a3a" stroke-width="2"/>
    
    <g transform="translate(200, 235)">
      <circle cx="0" cy="0" r="18" fill="#1a3a5a"/>
      <path d="M-8,2 Q0,-10 8,2" fill="none" stroke="#00d4aa" stroke-width="2"/>
      <path d="M-5,4 Q0,-2 5,4" fill="none" stroke="#00d4aa" stroke-width="2"/>
      <circle cx="0" cy="6" r="2" fill="#00d4aa"/>
      <text x="0" y="35" text-anchor="middle" font-family="Arial, sans-serif" font-size="8" fill="#666">WiFi</text>
    </g>
    
    <rect x="250" y="225" width="200" height="60" rx="8" fill="#0a1525"/>
    <rect x="250" y="225" width="200" height="60" rx="8" fill="none" stroke="#1a4a7a" stroke-width="2"/>
    <text x="350" y="255" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" font-weight="bold" fill="#ff6b35" filter="url(#glow)">180C</text>
    <text x="350" y="275" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" fill="#00d4aa" filter="url(#glow)">30 MIN</text>
    
    <g>
      <rect x="470" y="230" width="60" height="25" rx="6" fill="#1a3a5a"/>
      <text x="500" y="247" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#fff">FRY</text>
      
      <rect x="540" y="230" width="60" height="25" rx="6" fill="#2a2a2a"/>
      <text x="570" y="247" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#888">BAKE</text>
      
      <rect x="470" y="265" width="60" height="25" rx="6" fill="#2a2a2a"/>
      <text x="500" y="282" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#888">ROAST</text>
      
      <rect x="540" y="265" width="60" height="25" rx="6" fill="#2a2a2a"/>
      <text x="570" y="282" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#888">REHEAT</text>
    </g>
    
    <rect x="175" y="310" width="450" height="220" rx="12" fill="url(#glassGrad)"/>
    <rect x="175" y="310" width="450" height="220" rx="12" fill="none" stroke="#4a4a4a" stroke-width="4"/>
    
    <rect x="190" y="325" width="420" height="190" rx="8" fill="#0a0a0a" opacity="0.8"/>
    <rect x="190" y="325" width="420" height="190" rx="8" fill="#ffcc66" opacity="0.05"/>
    
    <g stroke="#555" stroke-width="2" fill="none">
      <rect x="210" y="360" width="380" height="80" rx="3"/>
      <line x1="240" y1="360" x2="240" y2="440"/>
      <line x1="280" y1="360" x2="280" y2="440"/>
      <line x1="320" y1="360" x2="320" y2="440"/>
      <line x1="360" y1="360" x2="360" y2="440"/>
      <line x1="400" y1="360" x2="400" y2="440"/>
      <line x1="440" y1="360" x2="440" y2="440"/>
      <line x1="480" y1="360" x2="480" y2="440"/>
      <line x1="520" y1="360" x2="520" y2="440"/>
      <line x1="560" y1="360" x2="560" y2="440"/>
    </g>
    
    <line x1="210" y1="470" x2="590" y2="470" stroke="#444" stroke-width="1.5" stroke-dasharray="5,3"/>
    
    <g stroke="#ff6b35" stroke-width="3" fill="none" opacity="0.6">
      <path d="M220 345 Q300 335 380 345 Q460 335 540 345"/>
      <path d="M220 500 Q300 510 380 500 Q460 510 540 500"/>
    </g>
    
    <path d="M185 320 Q300 310 500 320 L490 400 Q300 390 195 400 Z" fill="#ffffff" opacity="0.03"/>
    
    <rect x="280" y="535" width="240" height="22" rx="11" fill="#3a3a3a"/>
    <rect x="280" y="535" width="240" height="22" rx="11" fill="none" stroke="#555" stroke-width="2"/>
    <rect x="340" y="540" width="120" height="12" rx="6" fill="#4a4a4a"/>
    
    <rect x="175" y="570" width="450" height="70" rx="12" fill="#252525"/>
    <rect x="175" y="570" width="450" height="70" rx="12" fill="none" stroke="#3a3a3a" stroke-width="2"/>
    
    <g transform="translate(220, 605)">
      <rect x="-25" y="-20" width="50" height="40" rx="8" fill="#1a3a5a"/>
      <rect x="-20" y="-15" width="40" height="25" rx="4" fill="#0a1525"/>
      <circle cx="0" cy="20" r="4" fill="#00d4aa"/>
      <text x="0" y="-2" text-anchor="middle" font-family="Arial, sans-serif" font-size="8" fill="#fff">APP</text>
    </g>
    
    <rect x="290" y="585" width="100" height="40" rx="8" fill="#0a1525"/>
    <text x="340" y="612" text-anchor="middle" font-family="Arial, sans-serif" font-size="20" font-weight="bold" fill="#00d4aa" filter="url(#glow)">25:00</text>
    
    <rect x="410" y="585" width="100" height="40" rx="8" fill="#1a1525"/>
    <text x="460" y="612" text-anchor="middle" font-family="Arial, sans-serif" font-size="20" font-weight="bold" fill="#ff6b35" filter="url(#glow)">180C</text>
    
    <rect x="530" y="590" width="80" height="35" rx="8" fill="#ff6b35"/>
    <rect x="530" y="590" width="80" height="35" rx="8" fill="none" stroke="#ff8855" stroke-width="2"/>
    <text x="570" y="613" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#fff">START</text>
  </g>
  
  <g>
    <rect x="250" y="755" width="300" height="50" rx="10" fill="url(#blueGrad)"/>
    <rect x="250" y="755" width="300" height="50" rx="10" fill="none" stroke="#1a4a7a" stroke-width="2"/>
    <text x="400" y="777" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#ffffff">HT-AFS</text>
    <text x="400" y="797" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="url(#orangeGrad)" font-weight="bold">SMART MULTI-FUNCTION</text>
  </g>
</svg>