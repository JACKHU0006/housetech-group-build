<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <linearGradient id="metalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e0e0e0"/>
      <stop offset="50%" style="stop-color:#ffffff"/>
      <stop offset="100%" style="stop-color:#c0c0c0"/>
    </linearGradient>
    <linearGradient id="darkGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#3a3a3a"/>
      <stop offset="100%" style="stop-color:#1a1a1a"/>
    </linearGradient>
    <linearGradient id="blueGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1a4a7a"/>
      <stop offset="100%" style="stop-color:#0a2540"/>
    </linearGradient>
    <linearGradient id="orangeGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#ffaa33"/>
      <stop offset="100%" style="stop-color:#f7931e"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="6" stdDeviation="12" flood-opacity="0.2"/>
    </filter>
  </defs>
  
  <rect width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  
  <g filter="url(#shadow)">
    <ellipse cx="400" cy="620" rx="180" ry="35" fill="#2a2a2a" opacity="0.25"/>
    
    <rect x="220" y="280" width="360" height="320" rx="40" fill="url(#darkGrad)"/>
    <rect x="220" y="280" width="360" height="320" rx="40" fill="none" stroke="#4a4a4a" stroke-width="2"/>
    
    <rect x="240" y="300" width="320" height="280" rx="30" fill="#2d2d2d"/>
    <rect x="240" y="300" width="320" height="280" rx="30" fill="none" stroke="#3a3a3a" stroke-width="1"/>
    
    <circle cx="310" cy="380" r="45" fill="#222"/>
    <circle cx="310" cy="380" r="45" fill="none" stroke="#444" stroke-width="3"/>
    <circle cx="310" cy="380" r="35" fill="#1a1a1a"/>
    <circle cx="310" cy="380" r="35" fill="none" stroke="#333" stroke-width="1"/>
    <line x1="310" y1="340" x2="310" y2="355" stroke="#ff6b35" stroke-width="3" stroke-linecap="round"/>
    <line x1="310" y1="380" x2="340" y2="365" stroke="#555" stroke-width="2"/>
    <text x="310" y="440" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#888">TEMP</text>
    <text x="310" y="458" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#fff">180C</text>
    
    <circle cx="490" cy="380" r="45" fill="#222"/>
    <circle cx="490" cy="380" r="45" fill="none" stroke="#444" stroke-width="3"/>
    <circle cx="490" cy="380" r="35" fill="#1a1a1a"/>
    <circle cx="490" cy="380" r="35" fill="none" stroke="#333" stroke-width="1"/>
    <line x1="490" y1="340" x2="490" y2="355" stroke="#00d4aa" stroke-width="3" stroke-linecap="round"/>
    <line x1="490" y1="380" x2="460" y2="400" stroke="#555" stroke-width="2"/>
    <text x="490" y="440" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#888">TIME</text>
    <text x="490" y="458" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#fff">25 MIN</text>
    
    <g fill="#333">
      <circle cx="370" cy="500" r="6" fill="#222"/>
      <circle cx="390" cy="500" r="6" fill="#222"/>
      <circle cx="410" cy="500" r="6" fill="#222"/>
      <circle cx="430" cy="500" r="6" fill="#222"/>
    </g>
    <circle cx="370" cy="500" r="6" fill="#00d4aa"/>
    
    <circle cx="400" cy="530" r="20" fill="#222"/>
    <circle cx="400" cy="530" r="20" fill="none" stroke="#444" stroke-width="2"/>
    <text x="400" y="535" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#fff">ON</text>
    
    <rect x="280" y="580" width="240" height="20" rx="10" fill="#3a3a3a"/>
    <rect x="280" y="580" width="240" height="20" rx="10" fill="none" stroke="#555" stroke-width="1"/>
  </g>
  
  <g filter="url(#shadow)">
    <rect x="215" y="600" width="370" height="100" rx="20" fill="#252525"/>
    <rect x="215" y="600" width="370" height="100" rx="20" fill="none" stroke="#3a3a3a" stroke-width="2"/>
    
    <rect x="245" y="615" width="310" height="70" rx="8" fill="#1a1a1a" opacity="0.9"/>
    <rect x="245" y="615" width="310" height="70" rx="8" fill="none" stroke="#444" stroke-width="2"/>
    
    <g stroke="#4a4a4a" stroke-width="0.8" fill="none">
      <ellipse cx="400" cy="650" rx="130" ry="28"/>
      <line x1="290" y1="635" x2="290" y2="665"/>
      <line x1="330" y1="628" x2="330" y2="672"/>
      <line x1="370" y1="625" x2="370" y2="675"/>
      <line x1="400" y1="625" x2="400" y2="675"/>
      <line x1="430" y1="625" x2="430" y2="675"/>
      <line x1="470" y1="628" x2="470" y2="672"/>
      <line x1="510" y1="635" x2="510" y2="665"/>
    </g>
    
    <rect x="320" y="705" width="160" height="18" rx="9" fill="#3a3a3a"/>
    <rect x="320" y="705" width="160" height="18" rx="9" fill="none" stroke="#555" stroke-width="1"/>
  </g>
  
  <g>
    <rect x="250" y="745" width="300" height="50" rx="10" fill="url(#blueGrad)"/>
    <rect x="250" y="745" width="300" height="50" rx="10" fill="none" stroke="#1a4a7a" stroke-width="2"/>
    <text x="400" y="767" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#ffffff">HT-AF55</text>
    <text x="400" y="787" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="url(#orangeGrad)" font-weight="bold">COMPACT AIR FRYER</text>
  </g>
</svg>