<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <linearGradient id="steelGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e8e8e8"/>
      <stop offset="20%" style="stop-color:#f2f2f2"/>
      <stop offset="40%" style="stop-color:#e0e0e0"/>
      <stop offset="60%" style="stop-color:#d0d0d0"/>
      <stop offset="80%" style="stop-color:#b8b8b8"/>
      <stop offset="100%" style="stop-color:#a0a0a0"/>
    </linearGradient>
    <linearGradient id="steelDark" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#a8a8a8"/>
      <stop offset="50%" style="stop-color:#888888"/>
      <stop offset="100%" style="stop-color:#686868"/>
    </linearGradient>
    <linearGradient id="doorGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e0e0e0"/>
      <stop offset="30%" style="stop-color:#d0d0d0"/>
      <stop offset="70%" style="stop-color:#b8b8b8"/>
      <stop offset="100%" style="stop-color:#a0a0a0"/>
    </linearGradient>
    <linearGradient id="glassGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#2a3a4a"/>
      <stop offset="30%" style="stop-color:#1a2a3a"/>
      <stop offset="70%" style="stop-color:#0a1a2a"/>
      <stop offset="100%" style="stop-color:#050a15"/>
    </linearGradient>
    <linearGradient id="handleGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#c0c0c0"/>
      <stop offset="30%" style="stop-color:#f0f0f0"/>
      <stop offset="50%" style="stop-color:#d8d8d8"/>
      <stop offset="70%" style="stop-color:#e8e8e8"/>
      <stop offset="100%" style="stop-color:#a0a0a0"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="4" dy="10" stdDeviation="18" flood-color="#000" flood-opacity="0.3"/>
    </filter>
  </defs>
  
  <rect width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  
  <g filter="url(#shadow)" transform="translate(400, 420)">
    <rect x="-200" y="-200" width="400" height="420" fill="url(#steelGrad)" rx="12"/>
    <rect x="-188" y="-188" width="376" height="396" fill="none" stroke="#b0b0b0" stroke-width="2" rx="10"/>
    <rect x="-193" y="-195" width="386" height="65" fill="url(#steelDark)" rx="6"/>
