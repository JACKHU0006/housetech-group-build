    <circle cx="-155" cy="-162" r="12" fill="none" stroke="#606060" stroke-width="0.5"/>
    <circle cx="-110" cy="-162" r="12" fill="none" stroke="#606060" stroke-width="0.5"/>
    <circle cx="110" cy="-162" r="12" fill="none" stroke="#606060" stroke-width="0.5"/>
    <circle cx="155" cy="-162" r="12" fill="none" stroke="#606060" stroke-width="0.5"/>
    <rect x="-183" y="-118" width="366" height="310" fill="url(#doorGrad)" rx="10"/>
    <rect x="-170" y="-105" width="340" height="285" fill="url(#glassGrad)" rx="6"/>
    <rect x="-162" y="-97" width="324" height="269" fill="none" stroke="#1a2a3a" stroke-width="4"/>
    <rect x="-155" y="-90" width="310" height="255" fill="url(#glassGrad)" opacity="0.8" rx="4"/>
    <rect x="-148" y="-83" width="296" height="238" fill="#101010" rx="3"/>
    <rect x="-142" y="-77" width="284" height="226" fill="#1a1a1a" rx="2"/>
    <line x1="-137" y1="-50" x2="137" y2="-50" stroke="#707070" stroke-width="4"/>
    <line x1="-137" y1="-15" x2="137" y2="-15" stroke="#707070" stroke-width="4"/>
