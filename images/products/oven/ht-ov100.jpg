    <rect x="-25" y="140" width="50" height="18" fill="#0a2540" rx="2"/>
    <text x="0" y="152" text-anchor="middle" fill="white" font-size="8" font-weight="bold">PRO</text>
  </g>
  
  <g transform="translate(400, 750)">
    <rect x="-110" y="-25" width="220" height="50" fill="#0a2540" rx="8" filter="url(#shadow)"/>
    <text x="0" y="-4" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="20" font-weight="bold">HT-OV100</text>
    <text x="0" y="16" text-anchor="middle" fill="#f7931e" font-family="Arial, sans-serif" font-size="11" letter-spacing="1">PROFESSIONAL OVEN</text>
  </g>
</svg>