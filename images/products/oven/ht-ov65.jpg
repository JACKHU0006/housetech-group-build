<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <linearGradient id="steelGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e8e8e8"/>
      <stop offset="25%" style="stop-color:#f2f2f2"/>
      <stop offset="50%" style="stop-color:#d8d8d8"/>
      <stop offset="75%" style="stop-color:#c0c0c0"/>
      <stop offset="100%" style="stop-color:#a8a8a8"/>
    </linearGradient>
    <linearGradient id="steelDark" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#b0b0b0"/>
      <stop offset="50%" style="stop-color:#909090"/>
      <stop offset="100%" style="stop-color:#707070"/>
    </linearGradient>
    <linearGradient id="doorGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e0e0e0"/>
      <stop offset="50%" style="stop-color:#c8c8c8"/>
      <stop offset="100%" style="stop-color:#a8a8a8"/>
    </linearGradient>
    <linearGradient id="glassGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#4a6a7a"/>
      <stop offset="30%" style="stop-color:#3a5a6a"/>
      <stop offset="70%" style="stop-color:#2a4a5a"/>
      <stop offset="100%" style="stop-color:#1a3a4a"/>
    </linearGradient>
    <linearGradient id="handleGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#d0d0d0"/>
      <stop offset="50%" style="stop-color:#f0f0f0"/>
      <stop offset="100%" style="stop-color:#b0b0b0"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="3" dy="8" stdDeviation="15" flood-color="#000" flood-opacity="0.25"/>
    </filter>
  </defs>
  
  <rect width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  
  <g filter="url(#shadow)" transform="translate(400, 430)">
    <rect x="-170" y="-175" width="340" height="370" fill="url(#steelGrad)" rx="10"/>
    <rect x="-160" y="-165" width="320" height="350" fill="none" stroke="#c0c0c0" stroke-width="2" rx="8"/>
    <rect x="-165" y="-170" width="330" height="55" fill="url(#steelDark)" rx="5"/>
    <rect x="-55" y="-160" width="110" height="32" fill="#0a1a2a" rx="4"/>
    <rect x="-50" y="-155" width="45" height="22" fill="#001a0a" rx="2"/>
    <text x="-27" y="-139" text-anchor="middle" fill="#00ff88" font-family="monospace" font-size="13" font-weight="bold">165</text>
    <rect x="0" y="-155" width="50" height="22" fill="#001a0a" rx="2"/>
    <text x="25" y="-139" text-anchor="middle" fill="#00ffaa" font-family="monospace" font-size="11">C</text>
    <path d="M35 -148 Q40 -152 45 -148 Q50 -144 55 -148" fill="none" stroke="#00aaff" stroke-width="1.5"/>
    <path d="M35 -143 Q40 -147 45 -143 Q50 -139 55 -143" fill="none" stroke="#00aaff" stroke-width="1.5"/>
    <rect x="-130" y="-155" width="35" height="20" fill="#2a3a4a" rx="3"/>
    <rect x="-85" y="-155" width="35" height="20" fill="#2a3a4a" rx="3"/>
    <rect x="50" y="-155" width="35" height="20" fill="#2a3a4a" rx="3"/>
    <rect x="95" y="-155" width="35" height="20" fill="#2a3a4a" rx="3"/>
    <text x="-112" y="-141" text-anchor="middle" fill="#aaa" font-size="8">Menu</text>
    <text x="-67" y="-141" text-anchor="middle" fill="#aaa" font-size="8">Steam</text>
    <text x="68" y="-141" text-anchor="middle" fill="#aaa" font-size="8">Temp</text>
    <text x="113" y="-141" text-anchor="middle" fill="#aaa" font-size="8">Time</text>
    <rect x="-155" y="-105" width="310" height="260" fill="url(#doorGrad)" rx="12"/>
    <path d="M-140 -90 Q0 -75 140 -90 L140 145 Q0 160 -140 145 Z" fill="url(#glassGrad)"/>
    <rect x="-130" y="-80" width="260" height="200" fill="#1a2a2a" rx="5"/>
    <ellipse cx="0" cy="20" rx="100" ry="60" fill="none" stroke="#00aacc" stroke-width="0.5" opacity="0.4"/>
    <ellipse cx="0" cy="10" rx="80" ry="40" fill="none" stroke="#00aacc" stroke-width="0.5" opacity="0.3"/>
    <line x1="-125" y1="-40" x2="125" y2="-40" stroke="#606060" stroke-width="3"/>
    <line x1="-125" y1="-10" x2="125" y2="-10" stroke="#606060" stroke-width="3"/>
    <line x1="-125" y1="20" x2="125" y2="20" stroke="#606060" stroke-width="3"/>
    <line x1="-125" y1="50" x2="125" y2="50" stroke="#606060" stroke-width="3"/>
    <line x1="-125" y1="80" x2="125" y2="80" stroke="#606060" stroke-width="3"/>
    <path d="M-120 155 Q0 165 120 155" fill="none" stroke="url(#handleGrad)" stroke-width="18" stroke-linecap="round"/>
    <path d="M-118 155 Q0 163 118 155" fill="none" stroke="#d0d0d0" stroke-width="2" stroke-linecap="round"/>
    <path d="M-150 -95 Q-50 -82 50 -95" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="3"/>
    <rect x="-168" y="20" width="6" height="100" fill="#0a2540" rx="2"/>
    <rect x="162" y="20" width="6" height="100" fill="#0a2540" rx="2"/>
  </g>
  
  <g transform="translate(400, 730)">
    <rect x="-110" y="-25" width="220" height="50" fill="#0a2540" rx="8" filter="url(#shadow)"/>
    <text x="0" y="-4" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="20" font-weight="bold">HT-OV65</text>
    <text x="0" y="16" text-anchor="middle" fill="#f7931e" font-family="Arial, sans-serif" font-size="11" letter-spacing="1">CONVECTION STEAM OVEN</text>
  </g>
</svg>