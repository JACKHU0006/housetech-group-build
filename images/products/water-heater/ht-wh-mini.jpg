<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <linearGradient id="metalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e8e8e8"/>
      <stop offset="50%" style="stop-color:#ffffff"/>
      <stop offset="100%" style="stop-color:#c8c8c8"/>
    </linearGradient>
    <linearGradient id="blueGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1a4a7a"/>
      <stop offset="100%" style="stop-color:#0a2540"/>
    </linearGradient>
    <linearGradient id="orangeGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#ffaa33"/>
      <stop offset="100%" style="stop-color:#f7931e"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="8" flood-opacity="0.2"/>
    </filter>
    <filter id="glow">
      <feGaussianBlur stdDeviation="2" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <rect width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  
  <g filter="url(#shadow)">
    <ellipse cx="400" cy="580" rx="140" ry="25" fill="#aaa" opacity="0.2"/>
    
    <rect x="250" y="220" width="300" height="340" rx="15" fill="url(#metalGrad)"/>
    <rect x="250" y="220" width="300" height="340" rx="15" fill="none" stroke="#b0b0b0" stroke-width="2"/>
    
    <rect x="270" y="230" width="260" height="40" rx="8" fill="#d5d5d5"/>
    <rect x="270" y="230" width="260" height="40" rx="8" fill="none" stroke="#c0c0c0" stroke-width="1"/>
    
    <g fill="#aaa">
      <rect x="285" y="242" width="30" height="16" rx="2"/>
      <rect x="325" y="242" width="30" height="16" rx="2"/>
      <rect x="445" y="242" width="30" height="16" rx="2"/>
      <rect x="485" y="242" width="30" height="16" rx="2"/>
    </g>
    
    <rect x="265" y="280" width="270" height="265" rx="12" fill="#f5f5f5"/>
    <rect x="265" y="280" width="270" height="265" rx="12" fill="none" stroke="#ddd" stroke-width="1"/>
    
    <rect x="300" y="300" width="100" height="45" rx="8" fill="#0a1520"/>
    <rect x="300" y="300" width="100" height="45" rx="8" fill="none" stroke="#1a3a5a" stroke-width="2"/>
    
    <text x="350" y="330" text-anchor="middle" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="#00d4aa" filter="url(#glow)">40C</text>
    <text x="350" y="342" text-anchor="middle" font-family="Arial, sans-serif" font-size="8" fill="#666">TEMP</text>
    
    <g transform="translate(450, 305)">
      <circle cx="0" cy="0" r="6" fill="#00d4aa"/>
      <circle cx="0" cy="20" r="6" fill="#3399ff"/>
      <circle cx="0" cy="40" r="6" fill="#ddd"/>
    </g>
    
    <g>
      <circle cx="400" cy="420" r="35" fill="#ddd"/>
      <circle cx="400" cy="420" r="35" fill="none" stroke="#bbb" stroke-width="2"/>
      <circle cx="400" cy="420" r="24" fill="#e5e5e5"/>
      <circle cx="400" cy="420" r="24" fill="none" stroke="#ccc" stroke-width="1"/>
      <line x1="420" y1="420" x2="432" y2="420" stroke="#0a2540" stroke-width="3" stroke-linecap="round"/>
    </g>
    
    <circle cx="400" cy="490" r="22" fill="#0a2540"/>
    <circle cx="400" cy="490" r="22" fill="none" stroke="#1a4a7a" stroke-width="2"/>
    <text x="400" y="497" text-anchor="middle" font-size="16" fill="#fff">ON</text>
    
    <text x="400" y="530" text-anchor="middle" font-size="10" fill="#888">COMPACT DESIGN</text>
    
    <g transform="translate(290, 545)">
      <rect x="0" y="0" width="35" height="22" rx="4" fill="#3399ff"/>
      <text x="17" y="15" text-anchor="middle" font-size="7" fill="#fff">C</text>
      
      <rect x="45" y="0" width="35" height="22" rx="4" fill="#ff6b6b"/>
      <text x="62" y="15" text-anchor="middle" font-size="7" fill="#fff">H</text>
      
      <rect x="90" y="0" width="35" height="22" rx="4" fill="#f7931e"/>
      <text x="107" y="15" text-anchor="middle" font-size="7" fill="#fff">PWR</text>
    </g>
    
    <g transform="translate(400, 380)">
      <ellipse cx="0" cy="30" rx="50" ry="15" fill="none" stroke="#ccc" stroke-width="2" stroke-dasharray="4,2"/>
      <path d="M0,50 L0,65 M-8,58 L0,68 L8,58" fill="none" stroke="#999" stroke-width="2"/>
      <text x="0" y="85" text-anchor="middle" font-size="9" fill="#999">UNDER SINK</text>
    </g>
  </g>
  
  <g transform="translate(620, 300)">
    <rect x="0" y="0" width="100" height="70" rx="8" fill="#ddd" opacity="0.5"/>
    <rect x="0" y="0" width="100" height="70" rx="8" fill="none" stroke="#bbb" stroke-width="1"/>
    <text x="50" y="40" text-anchor="middle" font-size="10" fill="#888">Router Size</text>
  </g>
  
  <g>
    <rect x="250" y="650" width="300" height="50" rx="10" fill="url(#blueGrad)"/>
    <rect x="250" y="650" width="300" height="50" rx="10" fill="none" stroke="#1a4a7a" stroke-width="2"/>
    <text x="400" y="672" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#ffffff">HT-WH-MINI</text>
    <text x="400" y="692" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="url(#orangeGrad)" font-weight="bold">MINI TANKLESS</text>
  </g>
</svg>