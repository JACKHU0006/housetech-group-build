<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <linearGradient id="metalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e8e8e8"/>
      <stop offset="50%" style="stop-color:#ffffff"/>
      <stop offset="100%" style="stop-color:#c8c8c8"/>
    </linearGradient>
    <linearGradient id="blueGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1a4a7a"/>
      <stop offset="100%" style="stop-color:#0a2540"/>
    </linearGradient>
    <linearGradient id="orangeGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#ffaa33"/>
      <stop offset="100%" style="stop-color:#f7931e"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="6" stdDeviation="12" flood-opacity="0.2"/>
    </filter>
    <filter id="glow">
      <feGaussianBlur stdDeviation="2" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <rect width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  
  <g filter="url(#shadow)">
    <rect x="250" y="220" width="300" height="400" rx="15" fill="#888" opacity="0.1"/>
    
    <rect x="250" y="200" width="300" height="380" rx="15" fill="url(#metalGrad)"/>
    <rect x="250" y="200" width="300" height="380" rx="15" fill="none" stroke="#b0b0b0" stroke-width="2"/>
    
    <rect x="265" y="210" width="270" height="50" rx="10" fill="#d5d5d5"/>
    <rect x="265" y="210" width="270" height="50" rx="10" fill="none" stroke="#c0c0c0" stroke-width="1"/>
    
    <g fill="#aaa">
      <rect x="285" y="225" width="40" height="20" rx="3"/>
      <rect x="335" y="225" width="40" height="20" rx="3"/>
      <rect x="475" y="225" width="40" height="20" rx="3"/>
    </g>
    
    <ellipse cx="400" cy="235" rx="35" ry="18" fill="#888"/>
    <ellipse cx="400" cy="235" rx="25" ry="12" fill="#666"/>
    
    <rect x="265" y="270" width="270" height="295" rx="12" fill="#f0f0f0"/>
    <rect x="265" y="270" width="270" height="295" rx="12" fill="none" stroke="#ddd" stroke-width="1"/>
    
    <rect x="300" y="290" width="120" height="50" rx="8" fill="#1a2530"/>
    <rect x="300" y="290" width="120" height="50" rx="8" fill="none" stroke="#2a3a4a" stroke-width="2"/>
    
    <text x="360" y="320" text-anchor="middle" font-family="Arial, sans-serif" font-size="26" font-weight="bold" fill="#00d4aa" filter="url(#glow)">38C</text>
    <text x="360" y="335" text-anchor="middle" font-family="Arial, sans-serif" font-size="8" fill="#666">TEMP</text>
    
    <g transform="translate(460, 295)">
      <circle cx="0" cy="0" r="7" fill="#00d4aa"/>
      <circle cx="0" cy="25" r="7" fill="#f7931e"/>
      <circle cx="0" cy="50" r="7" fill="#3399ff"/>
    </g>
    
    <g transform="translate(400, 420)">
      <circle cx="0" cy="0" r="40" fill="#ddd"/>
      <circle cx="0" cy="0" r="40" fill="none" stroke="#bbb" stroke-width="3"/>
      <circle cx="0" cy="0" r="28" fill="#e5e5e5"/>
      <circle cx="0" cy="0" r="28" fill="none" stroke="#ccc" stroke-width="1"/>
      <line x1="20" y1="-20" x2="28" y2="-28" stroke="#0a2540" stroke-width="3" stroke-linecap="round"/>
    </g>
    
    <text x="400" y="480" text-anchor="middle" font-size="10" fill="#888">TAP TO ADJUST</text>
    
    <circle cx="400" cy="520" r="25" fill="#0a2540"/>
    <circle cx="400" cy="520" r="25" fill="none" stroke="#1a4a7a" stroke-width="2"/>
    <text x="400" y="528" text-anchor="middle" font-size="18" fill="#fff">ON</text>
    
    <g transform="translate(280, 560)">
      <rect x="0" y="0" width="35" height="25" rx="4" fill="#3399ff"/>
      <text x="17" y="17" text-anchor="middle" font-size="7" fill="#fff">C</text>
      
      <rect x="45" y="0" width="35" height="25" rx="4" fill="#ff6b6b"/>
      <text x="62" y="17" text-anchor="middle" font-size="7" fill="#fff">H</text>
    </g>
  </g>
  
  <g>
    <rect x="250" y="680" width="300" height="50" rx="10" fill="url(#blueGrad)"/>
    <rect x="250" y="680" width="300" height="50" rx="10" fill="none" stroke="#1a4a7a" stroke-width="2"/>
    <text x="400" y="702" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#ffffff">HT-WH12</text>
    <text x="400" y="722" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="url(#orangeGrad)" font-weight="bold">COMPACT WATER HEATER</text>
  </g>
</svg>