<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8f9fa"/>
      <stop offset="100%" style="stop-color:#e9ecef"/>
    </linearGradient>
    <linearGradient id="metalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e0e0e0"/>
      <stop offset="50%" style="stop-color:#ffffff"/>
      <stop offset="100%" style="stop-color:#c0c0c0"/>
    </linearGradient>
    <linearGradient id="blueGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1a4a7a"/>
      <stop offset="100%" style="stop-color:#0a2540"/>
    </linearGradient>
    <linearGradient id="orangeGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#ffaa33"/>
      <stop offset="100%" style="stop-color:#f7931e"/>
    </linearGradient>
    <linearGradient id="greenGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#4caf50"/>
      <stop offset="100%" style="stop-color:#2e7d32"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="10" stdDeviation="18" flood-opacity="0.25"/>
    </filter>
    <filter id="glow">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
    <filter id="greenGlow">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <rect width="800" height="800" rx="20" fill="url(#bgGrad)"/>
  
  <g transform="translate(600, 150)">
    <rect x="0" y="0" width="140" height="100" rx="5" fill="#2a3a4a"/>
    <rect x="0" y="0" width="140" height="100" rx="5" fill="none" stroke="#3a4a5a" stroke-width="2"/>
    
    <g fill="#1a2a3a">
      <rect x="10" y="10" width="35" height="25"/>
      <rect x="52" y="10" width="35" height="25"/>
      <rect x="95" y="10" width="35" height="25"/>
      <rect x="10" y="42" width="35" height="25"/>
      <rect x="52" y="42" width="35" height="25"/>
      <rect x="95" y="42" width="35" height="25"/>
      <rect x="10" y="74" width="35" height="16"/>
      <rect x="52" y="74" width="35" height="16"/>
      <rect x="95" y="74" width="35" height="16"/>
    </g>
    
    <rect x="10" y="10" width="120" height="80" fill="#4a6a8a" opacity="0.1"/>
    
    <path d="M0,50 L-40,50 L-40,450 L200,450" fill="none" stroke="#4caf50" stroke-width="3" stroke-dasharray="8,4"/>
    <circle cx="-40" cy="50" r="8" fill="#4caf50"/>
    <circle cx="-40" cy="50" r="8" fill="none" stroke="#2e7d32" stroke-width="2"/>
    
    <text x="70" y="60" text-anchor="middle" font-size="20">SUN</text>
  </g>
  
  <g filter="url(#shadow)">
    <ellipse cx="350" cy="680" rx="220" ry="40" fill="#aaa" opacity="0.2"/>
    
    <rect x="130" y="180" width="440" height="480" rx="20" fill="url(#metalGrad)"/>
    <rect x="130" y="180" width="440" height="480" rx="20" fill="none" stroke="#a8a8a8" stroke-width="2"/>
    
    <rect x="150" y="190" width="400" height="70" rx="12" fill="#d5d5d5"/>
    <rect x="150" y="190" width="400" height="70" rx="12" fill="none" stroke="#c0c0c0" stroke-width="1"/>
    
    <g fill="#aaa">
      <rect x="170" y="205" width="60" height="40" rx="4"/>
      <rect x="240" y="205" width="60" height="40" rx="4"/>
      <rect x="500" y="205" width="60" height="40" rx="4"/>
    </g>
    
    <ellipse cx="350" cy="225" rx="50" ry="25" fill="#888"/>
    <ellipse cx="350" cy="225" rx="38" ry="18" fill="#666"/>
    
    <g transform="translate(500, 200)">
      <rect x="-40" y="-30" width="80" height="55" rx="10" fill="url(#greenGrad)"/>
      <rect x="-40" y="-30" width="80" height="55" rx="10" fill="none" stroke="#388e3c" stroke-width="2"/>
      <circle cx="0" cy="-5" r="12" fill="#ffeb3b"/>
      <g stroke="#ffeb3b" stroke-width="2">
        <line x1="0" y1="-22" x2="0" y2="-18"/>
        <line x1="15" y1="-5" x2="18" y2="-5"/>
        <line x1="10" y1="10" x2="13" y2="13"/>
        <line x1="-10" y1="10" x2="-13" y2="13"/>
        <line x1="-15" y1="-5" x2="-18" y2="-5"/>
        <line x1="-10" y1="-20" x2="-13" y2="-17"/>
        <line x1="10" y1="-20" x2="13" y2="-17"/>
      </g>
      <text x="0" y="18" text-anchor="middle" font-size="14">ECO</text>
    </g>
    
    <rect x="150" y="270" width="400" height="160" rx="15" fill="#f0f0f0"/>
    <rect x="150" y="270" width="400" height="160" rx="15" fill="none" stroke="#ddd" stroke-width="2"/>
    
    <rect x="180" y="290" width="340" height="120" rx="12" fill="#0a1520"/>
    <rect x="180" y="290" width="340" height="120" rx="12" fill="none" stroke="#1a3a5a" stroke-width="3"/>
    
    <text x="280" y="365" text-anchor="middle" font-family="Arial, sans-serif" font-size="56" font-weight="bold" fill="#00d4aa" filter="url(#glow)">50C</text>
    <text x="280" y="395" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#666">WATER TEMPERATURE</text>
    
    <g transform="translate(420, 320)">
      <rect x="-50" y="-25" width="100" height="50" rx="10" fill="url(#greenGrad)"/>
      <rect x="-50" y="-25" width="100" height="50" rx="10" fill="none" stroke="#388e3c" stroke-width="2"/>
      <text x="0" y="-5" text-anchor="middle" font-size="20">SUN</text>
      <text x="0" y="15" text-anchor="middle" font-size="10" font-weight="bold" fill="#fff">SOLAR</text>
    </g>
    
    <g transform="translate(350, 420)">
      <circle cx="-40" cy="0" r="8" fill="#f7931e"/>
      <text x="-40" y="20" text-anchor="middle" font-size="8" fill="#888">GAS</text>
      
      <circle cx="0" cy="0" r="8" fill="#4caf50"/>
      <text x="0" y="20" text-anchor="middle" font-size="8" fill="#888">SOLAR</text>
      
      <circle cx="40" cy="0" r="8" fill="#3399ff"/>
      <text x="40" y="20" text-anchor="middle" font-size="8" fill="#888">ELECTRIC</text>
    </g>
    
    <rect x="150" y="440" width="400" height="200" rx="15" fill="#e8e8e8"/>
    <rect x="150" y="440" width="400" height="200" rx="15" fill="none" stroke="#d0d0d0" stroke-width="1"/>
    
    <text x="350" y="465" text-anchor="middle" font-size="14" font-weight="bold" fill="#0a2540">SMART HYBRID MODE</text>
    
    <g transform="translate(200, 500)">
      <rect x="0" y="0" width="90" height="40" rx="8" fill="#4caf50"/>
      <text x="45" y="25" text-anchor="middle" font-size="11" font-weight="bold" fill="#fff">AUTO</text>
      
      <rect x="110" y="0" width="90" height="40" rx="8" fill="#e8e8e8"/>
      <text x="155" y="25" text-anchor="middle" font-size="11" fill="#666">SOLAR ONLY</text>
      
      <rect x="220" y="0" width="90" height="40" rx="8" fill="#e8e8e8"/>
      <text x="265" y="25" text-anchor="middle" font-size="11" fill="#666">GAS BOOST</text>
    </g>
    
    <g transform="translate(280, 590)">
      <circle cx="0" cy="0" r="45" fill="#ddd"/>
      <circle cx="0" cy="0" r="45" fill="none" stroke="#bbb" stroke-width="3"/>
      <circle cx="0" cy="0" r="32" fill="#e5e5e5"/>
      <circle cx="0" cy="0" r="32" fill="none" stroke="#ccc" stroke-width="1"/>
      <line x1="0" y1="-22" x2="0" y2="-35" stroke="#0a2540" stroke-width="4" stroke-linecap="round"/>
    </g>
    
    <circle cx="420" cy="590" r="40" fill="#0a2540"/>
    <circle cx="420" cy="590" r="40" fill="none" stroke="#1a4a7a" stroke-width="3"/>
    <text x="420" y="600" text-anchor="middle" font-size="28" fill="#fff">ON</text>
    
    <g transform="translate(180, 650)">
      <rect x="0" y="0" width="50" height="30" rx="6" fill="#3399ff"/>
      <text x="25" y="20" text-anchor="middle" font-size="10" fill="#fff">COLD</text>
      
      <rect x="70" y="0" width="50" height="30" rx="6" fill="#ff6b6b"/>
      <text x="95" y="20" text-anchor="middle" font-size="10" fill="#fff">HOT</text>
      
      <rect x="140" y="0" width="50" height="30" rx="6" fill="#f7931e"/>
      <text x="165" y="20" text-anchor="middle" font-size="10" fill="#fff">GAS</text>
    </g>
    
    <rect x="350" y="650" width="100" height="30" rx="6" fill="#4caf50"/>
    <text x="400" y="670" text-anchor="middle" font-size="10" fill="#fff">SUN SOLAR IN</text>
  </g>
  
  <g>
    <rect x="250" y="755" width="300" height="50" rx="10" fill="url(#blueGrad)"/>
    <rect x="250" y="755" width="300" height="50" rx="10" fill="none" stroke="#1a4a7a" stroke-width="2"/>
    <text x="400" y="777" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#ffffff">HT-WH100</text>
    <text x="400" y="797" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="url(#orangeGrad)" font-weight="bold">SOLAR HYBRID</text>
  </g>
</svg>